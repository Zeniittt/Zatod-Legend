  optional battle_bonus        _bonus              = 8; // 战斗加成
}

// 联机副本战斗校验
message multi_stage_check_msg {
  required uint32 _checkid                      = 1;
  required uint32 _userid                       = 2;
  required uint32 _pointid                      = 3;
  required uint32 _stageid                      = 4;
  required uint32 _rseed                        = 5;
  repeated hero   _self_heroes                  = 6;
  repeated hero_dyna _self_dyna_start           = 7;
  repeated hero_dyna _self_dyna_end             = 8;
  repeated hero_dyna _oppo_dyna_start           = 9;
  repeated hero_dyna _oppo_dyna_end             = 10;
  repeated operation _operations                = 11;
  optional uint32 _cli_battle_time              = 12;
  repeated warschool_book _self_warschool_books = 13;
  optional uint32 _self_bookreading_level       = 14;
