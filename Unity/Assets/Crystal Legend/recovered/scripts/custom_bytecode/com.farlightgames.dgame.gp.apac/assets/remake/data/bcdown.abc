  repeated uint32  _hire_heroids                = 16;
  optional battle_bonus _self_bonus             = 17; // 己方战斗加成
}

message msb_unit {
    required ms_deviceid            _key        = 1;
    repeated uint32                 _ops        = 2;    // 同一帧有多个操作
}

message msb_operations {
    required uint32            _tick       = 1;    // 有操作的帧
    repeated msb_unit          _unit       = 2;    // 玩家操作
}

message ms_deviceid {
    required uint32 _svr_id = 1; //服务器ID
    required uint32 _uid    = 2; //玩家ID
}

message msb_user_info {
  required ms_deviceid            _key                = 1;
  required uint32                 _book_level         = 2;
  repeated warschool_book         _warschool_books    = 3;
  repeated uint32                 _select_hero_id     = 4;
  optional battle_bonus           _bonus              = 5; // 战斗加成
}
message msb_check_msg {
  required uint32                  _checkid           = 1;
  required uint32                  _userid            = 2;
  required uint32                  _stageid           = 3;
  repeated hero_dyna               _stage_dyna_start  = 4;
  repeated hero                    _heroes            = 5;
  repeated hero_dyna               _self_dyna_start   = 6;
  required uint32                  _rseed             = 7;
  optional bool                    _is_manual_battle  = 8;
  repeated msb_operations          _operations        = 9;
  repeated msb_user_info           _devicehero        = 10;
  required uint32                  _bt_st             = 11; 
}

