  optional uint32 _userid                         = 2; // 左方UID
  optional uint32 _oppo_userid                    = 3; // 右方UID
  optional user_summary _user_summary             = 4; // 我方头像信息
  optional user_summary _oppo_summary             = 5; // 敌方头像信息
  repeated hero   _self_heroes                    = 6; // 我方英雄
  repeated hero   _oppo_heroes                    = 7; // 敌方英雄
  required uint32 _rseed                          = 8; // 种子
  optional uint32 _start_time                     = 9; // 战斗开始时间
  optional uint32 _battle_time                    = 10; // 战斗时间
  optional uint32 _win_team                       = 11; // 胜利队伍
  repeated hero_dyna   _self_hero_dynas           = 12; // 我方血量
  repeated hero_dyna   _oppo_hero_dynas           = 13; // 对方血量
  optional uint32       _end_hp_list              = 14; // 结束时我方血量
  optional uint32       _end_mp_list              = 15; // 结束时对方血量
  repeated uint32       _user1_runes              = 16; // 我方神符加成
  repeated uint32       _user2_runes              = 17; // 对方神符加成
  optional battle_bonus _self_bonus               = 18; // 己方战斗加成
  optional battle_bonus _oppo_bonus               = 19; // 对手战斗加成
  optional uint32       _camp1_win_times          = 20; // 进攻方胜场次数
  optional uint32       _camp2_win_times          = 21; // 防守方胜场次数
}

message rogue_bless {
    optional uint32   _bless = 1; // 祝福ID
    optional uint32   _level = 2; // 等级
}

message rogue_check_msg {
    required uint32 _checkid                     = 1; // 校验ID
    required uint32 _userid                      = 2; // 玩家ID
    required uint32 _stageid                     = 3; // 关卡ID
    required uint32 _chapter_id                  = 4; // 章节ID
    required uint32 _wave                        = 5; // 波数
    repeated uint32 _chapter_buff                = 6; // 章节buff
    required uint32 _chapter_diff                = 7; // 章节难度
    optional uint32 _crisis                      = 8; // 危机
    required result _result                      = 9 [default = victory]; // 结果
    optional uint32 _destiny                     = 10; // 命途
    optional uint32 _des_energy_start            = 11; // 命途能量开始
    optional uint32 _des_energy_end              = 12; // 命途能量结束
    repeated hero   _heroes                      = 13; // 英雄
    repeated operation _operations               = 14; // 操作
    required uint32 _rseed                       = 15; // 随机种子
    repeated rogue_hero_info _dyna_start         = 16; // 开始时英雄信息
    repeated rogue_hero_info _dyna_end           = 17; // 结束时英雄信息
    optional uint32 _cli_battle_time             = 18; // 客户端战斗时间
    repeated rogue_bless _bless                  = 19; // 祝福
    repeated rogue_charm_battle _charm_list      = 20; // 护符
    repeated uint32 _tech_ids                    = 21; // 天赋
    optional battle_bonus _bonus                 = 22; // 战斗加成
}

// 多队梦境战斗校验
message crevice_defend_check_msg {
  required uint32               _checkid            = 1;  // 战斗校验ID
  required uint32               _rseed              = 2;  // 随机种子
  required uint32               _userid             = 3;  // 玩家ID
  optional string               _self_roleid        = 4;  // 自己的角色ID
  optional user_summary         _self_user          = 5;  // 自己的简要信息
  repeated arena_team           _self_heroes        = 6;  // 自己的英雄
  optional battle_bonus         _self_bonus         = 7;  // 己方战斗加成
  repeated uint32               _stage_ids          = 8;  // 关卡列表
  repeated arena_pvp_hero_data  _battle_summary     = 9;  // 战斗简报
  repeated empty_data           _result             = 10; // 结果
}

// 选技战斗校验协议
message solo_check_msg {
  required uint32           _checkid      = 1;
  required uint32           _gameid       = 2; // 游戏ID
  required uint32           _round        = 4; // 回合数
  repeated solo_battle      _battles      = 5; // 战斗列表
  repeated empty_data       _results      = 6; // 每场战斗结果
  optional bool             _is_dump      = 7; // 是否是dump请求
}