package bcdown;

import "common.proto";

message battlecheck {
  optional uint32                     _open_rank                 = 1;
  repeated pve_check_msg              _pve_msg                   = 2;
  repeated pvp_check_msg              _pvp_msg                   = 3;
  repeated tbc_check_msg              _tbc_msg                   = 4;
  repeated excav_check_msg            _excav_msg                 = 5;
  repeated guild_pve_check_msg        _guild_msg                 = 6;
  repeated rtpvp_check_msg            _rtpvp_msg                 = 7;
  repeated toppvp_check_msg           _toppvp_msg                = 8;
  repeated ancients_check_msg         _ancients_msg              = 9;
  repeated gvg_check_msg              _gvg_check_msg             = 10;
  repeated throne_tower_check_msg     _throne_tower_msg          = 11;
  repeated dreamland_check_msg        _dreamland_msg             = 12;
  repeated gcw_check_msg              _gcw_msg                   = 13;
  repeated quest_check_msg            _quest_msg                 = 14;
  repeated devilseal_check_msg        _devilseal_msg             = 15;
  repeated test_battle_check_msg      _test_battle_check_msg     = 16;
  repeated siege_check_msg            _siege_check_msg           = 17;
  repeated nightmare_check_msg        _nightmare_check_msg       = 18;
  repeated ass_check_msg              _ass_check_msg             = 19;
  repeated multiplayer_check_msg      _multiplayer_check_msg     = 20;
  repeated babel_check_msg            _babel_msg                 = 21;
  repeated nian_check_msg             _nian_check_msg            = 22;
  repeated legend_check_msg           _legend_check_msg          = 23;
  repeated multi_arena_check_msg      _multi_arena_check_msg     = 24;
  repeated multi_stage_check_msg      _multi_stage_check_msg     = 25;
  repeated msb_check_msg              _msb_check_msg             = 26;
  repeated stargate_check_msg         _stargate_check_msg        = 27;
  repeated chaos_tower_check_msg      _chaos_tower_check_msg     = 28;
  repeated chess_check_msg            _chess_check_msg           = 29;
  repeated arcana_trial_check_msg     _arcana_trial_check_msg    = 30;
  repeated cup_arena_check_msg        _cup_arena_check_msg       = 31;
  repeated myth_boss_check_msg        _myth_boss_check_msg       = 32;
  repeated five_boss_check_msg        _five_boss_check_msg       = 33;
  repeated race_tower_check_msg       _race_tower_check_msg      = 34;
  repeated guild_mount_check_msg      _guild_mount_check_msg     = 35;
  optional bool                       _bclog_only                = 36; // 是否仅生成bclog
  repeated season_arena_check_msg     _season_arena_check_msg    = 37;
  repeated season_tower_check_msg     _season_tower_check_msg    = 38;
  optional bool                       _bot_mode                  = 39; // 机器人战斗模式,自动放大招
  repeated fancy_tower_check_msg      _fancy_tower_check_msg     = 40;
  repeated act_adventure_check_msg    _act_adventure_check_msg   = 41; // 活动关卡
  repeated fancy_abyss_check_msg      _fancy_abyss_check_msg     = 42; // 幻境深渊
  repeated peak_arena_check_msg       _peak_arena_check_msg      = 43; // 巅峰竞技场
  repeated awake_dungeon_check_msg    _awake_dungeon_check_msg   = 44; // 地底历险
  repeated heat_check_msg             _heat_check_msg            = 45; // 热力挑战
  repeated guild_clash_check_msg      _guild_clash_check_msg     = 46; // 公会战
  repeated rogue_check_msg            _rogue_check_msg           = 47; // rogue
  repeated crevice_defend_check_msg   _crevice_defend_check_msg  = 48; // 多队梦境
  repeated solo_check_msg             _solo_check_msg            = 49; // 选技
}

message pve_check_msg {
  required uint32 _checkid                     = 1;
  required uint32 _userid                      = 2;
  required uint32 _stageid                     = 3;
  required result _result                      = 4 [default = victory];
  required uint32 _stars                       = 5;
  repeated hero   _heroes                      = 6;
  repeated operation _operations               = 7;
  required uint32 _rseed                       = 8;
  optional uint32 _cli_battle_time             = 9;
  repeated unit_battle_data  _unit_battle_data = 10;
  repeated warschool_book    _warschool_books  = 11;
  optional uint32 _bookreading_level           = 12;
  optional bool   _is_manual_battle            = 13;
  optional battle_bonus _bonus                 = 14; // 战斗加成
}

message unit_battle_data {
  optional uint32        _unit_max_damage = 1;
  repeated uint32        _unit_kill_list  = 2;
  optional uint32        _unit_hid        = 3;
}

message pvp_check_msg{
  enum type {
    arena = 1;
    fight = 2;
  }
  required uint32 _checkid                        = 1;
  required type   _type                           = 2;
  required uint32 _userid                         = 3;
  optional string _username                       = 4;
  optional uint32 _level                          = 5;
  optional uint32 _avatar                         = 6;
  optional uint32 _vip                            = 7;
  required uint32 _oppo_userid                    = 8;
  optional string _oppo_name                      = 9;
  optional uint32 _oppo_level                     = 10;
  optional uint32 _oppo_avatar                    = 11;
  optional uint32 _oppo_vip                       = 12;
  optional uint32 _oppo_robot                     = 13;
  optional result _result                         = 14 [default = victory];
  repeated hero   _self_heroes                    = 15;
  repeated hero   _oppo_heroes                    = 16;
  required uint32 _rseed                          = 17;
  optional uint32 _self_robot                     = 18;
  repeated warschool_book  _self_warschool_books  = 19;
  repeated warschool_book  _oppo_warschool_books  = 20;
  optional uint32 _self_bookreading_level         = 21;
  optional uint32 _oppo_bookreading_level         = 22;
  repeated arena_pvp_hero_data _arena_pvp_summary = 23;
  optional uint32 _ladder_buff_id                 = 24;
  optional uint32 _battle_time                    = 25;
  optional uint32 _bt_st                          = 26;
  optional battle_bonus _self_bonus               = 27; // 己方战斗加成
  optional battle_bonus _oppo_bonus               = 28; // 对手战斗加成
  optional medal_item   _self_medal = 29; // 我方徽章
  optional medal_item   _oppo_medal = 30; // 敌方徽章
  optional uint32       _oppo_svr_id = 31; // 对手服务器ID
  optional uint32       _background_id = 32; // 正在使用中的背景id
  optional uint32       _home_ground = 33; // 0代表自己为主场；1代表对手为主场；2 代表无主场
}

message arena_pvp_hero_data {
  repeated arena_pvp_hero _arena_pvp_hero = 1;
}

message gvg_check_msg{
  required uint32 _checkid                        = 1;
  required uint32 _userid                         = 2;
  required user_summary _user_summary             = 3;
  required user_summary _oppo_summary             = 4;
  repeated hero   _self_heroes                    = 5;
  repeated hero   _oppo_heroes                    = 6;
  required uint32 _rseed                          = 7;
  optional uint32 _cli_battle_time                = 8;
  repeated hero_dyna   _self_gvg_heroes           = 9;
  repeated hero_dyna   _oppo_gvg_heroes           = 10;
  required uint32 _oppo_userid                    = 11;
  optional uint32 _end_hp_list                    = 12;
  optional uint32 _end_mp_list                    = 13;
  optional uint32 _winteam                        = 14;
  repeated warschool_book  _self_warschool_books  = 15;
  repeated warschool_book  _oppo_warschool_books  = 16;
  optional uint32 _self_bookreading_level         = 17;
  optional uint32 _oppo_bookreading_level         = 18;
  optional battle_bonus _self_bonus               = 19; // 己方战斗加成
  optional battle_bonus _oppo_bonus               = 20; // 对手战斗加成
}

message gcw_check_msg{
  required uint32 _checkid                       = 1;
  required uint32 _userid                         = 2;
  required user_summary _user_summary             = 3;
  required user_summary _oppo_summary             = 4;
  repeated hero   _self_heroes                    = 5;
  repeated hero   _oppo_heroes                    = 6;
  required uint32 _rseed                          = 7;
  optional uint32 _cli_battle_time                = 8;
  repeated hero_dyna  _self_hero_dynas            = 9;
  repeated hero_dyna  _oppo_hero_dynas            = 10;
  required uint32 _oppo_userid                    = 11;
  optional uint32 _end_hp_list                    = 12;
  optional uint32 _end_mp_list                    = 13;
  optional uint32 _winteam                        = 14;
  repeated warschool_book  _self_warschool_books  = 15;
  repeated warschool_book  _oppo_warschool_books  = 16;
  repeated uint32 _self_buffs                     = 17;
  repeated uint32 _oppo_buffs                     = 18;
  optional uint32 _self_bookreading_level         = 19;
  optional uint32 _oppo_bookreading_level         = 20;
  optional battle_bonus _self_bonus               = 21; // 己方战斗加成
  optional battle_bonus _oppo_bonus               = 22; // 对手战斗加成
}

message tbc_check_msg{
  enum tbc_mode {
    normal = 1;       // 正常模式
    hell  = 2;        // 地狱模式
  }
  required uint32 _checkid                       = 1;
  required uint32 _userid                        = 2;
  optional string _username                      = 3;
  required uint32 _oppo_userid                   = 4;
  optional string _oppo_name                     = 5;
  optional uint32 _oppo_robot                    = 6;
  optional result _result                        = 7 [default = victory];
  repeated hero   _self_heroes                   = 8;
  repeated hero   _oppo_heroes                   = 9;
  required uint32 _rseed                         = 10;
  optional uint32 _self_robot                    = 11;
  repeated hero_dyna _self_dyna_start            = 12;
  repeated hero_dyna _self_dyna_end              = 13;
  repeated hero_dyna _oppo_dyna_start            = 14;
  repeated hero_dyna _oppo_dyna_end              = 15;
  repeated operation _operations                 = 16;
  optional uint32 _cli_battle_time               = 17;
  optional tbc_mode _mode                        = 18;
  repeated warschool_book  _self_warschool_books = 19;
  repeated warschool_book  _oppo_warschool_books = 20;
  optional uint32 _self_bookreading_level        = 21;
  optional uint32 _oppo_bookreading_level        = 22;
  optional uint32 _energy_beans                  = 23;
  repeated arena_pvp_hero_data arena_pvp_summary = 24;
  optional battle_bonus        _self_bonus       = 25; // 己方战斗加成
  optional battle_bonus        _oppo_bonus       = 26; // 对手战斗加成
}

message throne_tower_check_msg{
  required uint32 _checkid              = 1;
  required uint32 _userid               = 2;
  optional string _username             = 3;
  required uint32 _oppo_userid          = 4;
  optional string _oppo_name            = 5;
  required uint32 _floor_id             = 6;
  optional result _result               = 7 [default = victory];
  repeated hero   _self_heroes          = 8;
  repeated hero   _oppo_heroes          = 9;
  required uint32 _rseed                = 10;
  repeated hero_dyna _self_dyna_start   = 11;
  repeated hero_dyna _self_dyna_end     = 12;
  repeated hero_dyna _oppo_dyna_start   = 13;
  repeated hero_dyna _oppo_dyna_end     = 14;
  repeated operation _operations        = 15;
  optional uint32 _cli_battle_time      = 16;
  repeated warschool_book   _self_warschool_books  = 17;
  repeated warschool_book   _oppo_warschool_books  = 18;
  optional uint32 _self_bookreading_level = 19;
  optional uint32 _oppo_bookreading_level = 20;
  optional battle_bonus _self_bonus       = 21; // 己方战斗加成
  optional battle_bonus _oppo_bonus       = 22; // 对手战斗加成
}
message dreamland_check_msg {
  required uint32 _checkid    = 1;
  required uint32 _userid     = 2;
  required uint32 _stageid    = 3;
  required result _result     = 4 [default = victory];
  repeated hero   _heroes     = 5;
  repeated operation _operations  = 6;
  required uint32 _rseed      = 7;
  optional uint32 _cli_battle_time = 8;
  required uint32 _damage     = 9;
  repeated warschool_book    _warschool_books  = 10;
  optional uint32 _bookreading_level = 11;
  required uint32 _bt_st      = 12;
  optional uint32 _scene_buff = 13; //场景BUFFID
  optional battle_bonus _bonus = 14; // 战斗加成
  optional string _username    = 15;
  repeated arena_pvp_hero_data _arena_pvp_hero_summary = 16;
  optional medal_item _self_medal = 17; // 我方徽章
}

message devilseal_check_msg {
  required uint32 _checkid    = 1;
  required uint32 _userid     = 2;
  required uint32 _stageid    = 3;
  required result _result     = 4 [default = victory];
  repeated hero   _heroes     = 5;
  repeated operation _operations  = 6;
  required uint32 _rseed      = 7;
  optional uint32 _cli_battle_time = 8;
  required uint32 _damage     = 9;
  repeated warschool_book    _warschool_books  = 10;
  optional uint32 _bookreading_level = 11;
  optional battle_bonus _bonus       = 12; // 战斗加成
}

message excav_check_msg{
  enum oppo_type {
    monster = 1;
    player  = 2;
  }
  enum battle_type {
    pvp   = 1;
    robot = 2;
  }
  required uint32 _checkid              = 1;
  required uint32 _userid               = 2;
  optional string _username             = 3;
  optional uint32 _level                = 4;
  optional uint32 _avatar               = 5;
  optional uint32 _robot                = 6;
  optional uint32 _vip                  = 7;
  required uint32 _oppo_userid          = 8;    // 如果oppo_type是monster，这个字段是enemy id
  optional string _oppo_username        = 9;
  optional uint32 _oppo_level           = 10;
  optional uint32 _oppo_avatar          = 11;
  optional uint32 _oppo_vip             = 12;
  optional uint32 _oppo_roboto          = 13;
  required oppo_type _oppo_type         = 14;
  optional result _result               = 15 [default = victory];
  repeated hero   _self_heroes          = 16;
  repeated hero   _oppo_heroes          = 17;   // 如果oppo_type是monster，这个字段无效
  required uint32 _rseed                = 18;
  repeated hero_dyna _self_dyna_start   = 19;
  repeated hero_dyna _self_dyna_end     = 20;
  repeated hero_dyna _oppo_dyna_start   = 21;
  repeated hero_dyna _oppo_dyna_end     = 22;
  optional uint32    _param1            = 23;
  repeated operation _operations        = 24;
  optional uint32 _cli_battle_time      = 25;
  repeated warschool_book   _self_warschool_books  = 26;
  repeated warschool_book   _oppo_warschool_books  = 27;
  optional battle_type _battle_type      = 28;
  optional uint32 _self_bookreading_level = 29;
  optional uint32 _oppo_bookreading_level = 30;
  optional battle_bonus _self_bonus       = 31; // 己方战斗加成
  optional battle_bonus _oppo_bonus       = 32; // 对手战斗加成
}

message guild_pve_check_msg{
  required uint32 _checkid              = 1;
  required uint32 _userid               = 2;
  required string _username             = 3;
  required result _result               = 4 [default = victory];
  repeated hero   _self_heroes          = 5;
  required uint32 _stageid              = 6;
  required uint32 _start_wave           = 7;
  required uint32 _end_wave             = 8;
  required uint32 _rseed                = 9;
  repeated uint32 _hp_start             = 10;
  repeated uint32 _hp_end               = 11;
  repeated operation _operations        = 12;
  optional uint32 _cli_battle_time      = 13;
  required uint32 _dps                  = 14;
  repeated warschool_book _self_warschool_books  = 15;
  optional uint32 _bookreading_level    = 16;
  required uint32 _bt_st                = 17;
  optional battle_bonus _self_bonus     = 18; // 己方战斗加成
}

message rtpvp_check_msg {
  required uint32 _checkid                        = 1;
  required uint32 _userid                         = 2;
  optional string _username                       = 3;
  optional uint32 _level                          = 4;
  optional uint32 _avatar                         = 5;
  optional uint32 _vip                            = 6;
  required uint32 _oppo_userid                    = 7;
  optional string _oppo_username                  = 8;
  optional uint32 _oppo_level                     = 9;
  optional uint32 _oppo_avatar                    = 10;
  optional uint32 _oppo_vip                       = 11;
  repeated hero   _self_heroes                    = 12;
  repeated hero   _oppo_heroes                    = 13;
  repeated sync_operation _self_operation         = 14;
  repeated sync_operation _oppo_operation         = 15;
  required result _result                         = 16 [default = victory];
  required uint32 _rseed                          = 17;
  repeated warschool_book _self_warschool_books   = 18;
  repeated warschool_book _oppo_warschool_books   = 19;
  optional uint32 _self_bookreading_level         = 20;
  optional uint32 _oppo_bookreading_level         = 21;
  repeated arena_pvp_hero_data _arena_pvp_summary = 22;
  optional battle_bonus        _self_bonus        = 23; // 己方战斗加成
  optional battle_bonus        _oppo_bonus        = 24; // 对手战斗加成
}

message toppvp_check_msg{
  required uint32 _checkid                         = 1;
  required uint32 _userid                          = 2;
  optional string _username                        = 3;
  optional uint32 _level                           = 4;
  optional uint32 _avatar                          = 5;
  optional uint32 _vip                             = 6;
  required uint32 _oppo_userid                     = 7;
  optional string _oppo_name                       = 8;
  optional uint32 _oppo_level                      = 9;
  optional uint32 _oppo_avatar                     = 10;
  optional uint32 _oppo_vip                        = 11;
  optional uint32 _oppo_robot                      = 12;
  repeated result _result                          = 13 [default = victory];
  repeated arena_team   _self_heroes               = 14;
  repeated arena_team   _oppo_heroes               = 15;
  required uint32 _rseed                           = 16;
  optional uint32 _self_robot                      = 17;
  repeated warschool_book   _self_warschool_books  = 18;
  repeated warschool_book   _oppo_warschool_books  = 19;
  optional uint32 _self_bookreading_level          = 20;
  optional uint32 _oppo_bookreading_level          = 21;
  repeated arena_pvp_hero_data _arena_pvp_summary  = 22;
  optional battle_bonus        _self_bonus         = 23; // 己方战斗加成
  optional battle_bonus        _oppo_bonus         = 24; // 对手战斗加成
}

message ancients_check_msg{
  required uint32 _checkid              = 1;
  required uint32 _userid               = 2;
  required string _username             = 3;
  optional uint32 _level                = 4;
  optional uint32 _avatar               = 5;
  optional uint32 _vip                  = 6;
  required result _result               = 7 [default = victory];
  repeated hero   _self_heroes          = 8;
  required uint32 _difficulty           = 9;
  required uint32 _rseed                = 10;
  repeated uint32 _hp_start             = 11;
  repeated uint32 _hp_end               = 12;
  repeated operation _operations        = 13;
  optional uint32 _cli_battle_time      = 14;
  optional uint32 _target_id            = 15;
  repeated warschool_book _self_warschool_books = 16;
  optional uint32 _bookreading_level    = 17;
  optional battle_bonus _self_bonus     = 18; // 己方战斗加成
}

enum rune_type {
  sun  = 0;
  moon = 1;
  star = 2;
}

message hero_dyna {
  required uint32     _hp_perc        = 1;
  required uint32     _mp_perc        = 2;
  optional uint32     _custom_data    = 3;
}

enum result {
  victory  = 0;
  defeat   = 1;
  canceled = 2;
  timeout  = 3;
}


message sync_operation{
  required uint32 _tick      = 1;
  repeated uint32 _operation = 2;
}

message quest_check_msg {
  required uint32            _checkid           = 1;
  required uint32            _userid            = 2;
  required uint32            _jobid             = 3;
  required uint32            _enemyid           = 4;
  repeated hero              _heroes            = 5;
  required uint32            _rseed             = 6;
  repeated warschool_book    _warschool_book    = 7;
  optional uint32            _bookreading_level = 8;
  optional result            _result            = 9 [default = victory];
  optional battle_bonus      _bonus             = 10; // 战斗加成
}

message battle_check_hero {
    required uint32 _heroid         = 1;
    required uint32 _hp_perc        = 2;
    required uint32 _mp_perc        = 3;
    optional uint32 _custom_data    = 4;
}

message test_battle_check_msg {
  enum type{
  pvp       = 1;
  guild     = 2;
  dreamland = 3;
  }
  required uint32       _checkid              = 1;
  required uint32       _userid               = 2;
  required type         _type                 = 3;
  repeated hero         _self_heroes          = 4;
  repeated hero         _oppo_heroes          = 5;
  repeated operation    _operations           = 6;
  required result       _result               = 7 [default = victory];
  required uint32       _self_demage          = 8;
  required uint32       _oppo_demage          = 9;
  required uint32       _rseed                = 10;
  repeated battle_check_hero _self_hero_hp_mp = 11;
  repeated battle_check_hero _oppo_hero_hp_mp = 12;
  optional uint32       _stage_id             = 13;
}

// 超觉醒战斗校验
message siege_check_msg {
  required uint32       _checkid                = 1;
  required uint32       _userid                 = 2;
  repeated hero         _self_heroes            = 3;
  repeated operation    _operations             = 4;
  required uint32       _rseed                  = 5;
  required uint32       _superHeroID            = 6;  // 超觉醒战斗英雄id
  required uint32       _siegeStageID           = 7;  // 超觉醒关卡id
  repeated warschool_book _self_warschool_books = 8;
  optional uint32       _bookreading_level      = 9;
  optional result       _result                 = 10 [default = victory];
  repeated siege_hero_position   _positions     = 11; //超觉醒英雄位置
  optional battle_bonus          _self_bonus    = 12; // 己方战斗加成
}

message siege_hero_position {
    required uint32  _index = 1;    // 英雄索引
    required uint32  _x     = 2;    // 英雄x位置
    required uint32  _y     = 3;    // 英雄y位置
}

// 无尽梦魇战斗校验
message nightmare_check_msg {
  required uint32       _checkid                = 1;
  required uint32       _userid                 = 2;
  repeated hero         _self_heroes            = 3;
  repeated operation     _operations             = 4;
  required uint32       _rseed                  = 5;
  required uint32       _stageId                = 6;  // 无尽梦魇关卡id
  repeated warschool_book _self_warschool_books = 7;
  optional uint32       _bookreading_level      = 8;
  repeated siege_hero_position   _positions     = 9;  // 无尽梦魇位置
  required uint32       _current_wave_idx       = 10; // 玩家当前打到的波数
  repeated uint32       _dead_monster_infos     = 11; // <<waveid:7,monster_idx:3,dir_flag:1,item_id: 16>>
  repeated uint32       _all_drop_infos         = 12; // <<waveid:7,monster_idx:3,dir_flag:1,item_id: 16>>
  optional battle_bonus _self_bonus             = 13; // 己方战斗加成
}

// 工会战刺杀战斗校验
message ass_check_msg {
  required uint32 _checkid                      = 1;
  required uint32 _userid                       = 2;
  optional string _username                     = 3;
  required uint32 _oppo_userid                  = 4;
  optional string _oppo_name                    = 5;
  repeated hero   _self_heroes                  = 6;
  repeated hero   _oppo_heroes                  = 7;
  required uint32 _rseed                        = 8;
  required uint32 _ass_ticks                    = 9; //刺杀帧
  required uint32 _time_limit                   = 10; //战斗超时时间，单位/秒
  repeated hero_dyna _self_dyna_start           = 11;
  repeated hero_dyna _self_dyna_end             = 12;
  repeated hero_dyna _oppo_dyna_start           = 13;
  repeated hero_dyna _oppo_dyna_end             = 14;
  repeated operation _operations                = 15;
  optional uint32 _cli_battle_time              = 16;
  repeated warschool_book _self_warschool_books = 17;
  repeated warschool_book _oppo_warschool_books = 18;
  optional uint32 _self_bookreading_level       = 19;
  optional uint32 _oppo_bookreading_level       = 20;
  optional battle_bonus _self_bonus             = 21; // 己方战斗加成
  optional battle_bonus _oppo_bonus             = 22; // 对手战斗加成
}

