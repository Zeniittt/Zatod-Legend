.hero-balance { padding: 12px; }
#hero-title { font-size: 20px; -unity-font-style: bold; margin-bottom: 6px; }
.toolbar { flex-direction: row; flex-wrap: wrap; margin-top: 6px; margin-bottom: 6px; }
.columns { flex-direction: row; flex-grow: 1; margin-top: 10px; }
.authoring { flex-grow: 3; flex-basis: 0; margin-right: 16px; }
.sandbox { flex-grow: 2; flex-basis: 0; }
.wrapped { white-space: normal; margin-bottom: 8px; }
.raw-json { min-height: 160px; margin-top: 6px; margin-bottom: 6px; }
.raw-json .unity-text-field__input { white-space: normal; }
#preview-rank { font-size: 16px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 8px; }
#preview-skills { -unity-font-style: bold; margin-top: 12px; }
.hero-balance .unity-foldout { margin-top: 4px; }
.hero-balance .unity-help-box { margin-top: 10px; }
