package down;

import "common.proto";

///////////////////////////////base ///////////////////////////////////////////
// 通用结果
enum result {
    success = 0;
    fail    = 1;
}

// 战斗结果
enum battle_result {
    victory  = 0;
    defeat   = 1;
    canceled = 2;
    timeout  = 3;
    cheat    = 4;
    honest   = 5;
    unknown  = 6;
}

// 货币类型
enum money_type {
    gold            = 1;        // 金币
    diamond         = 2;        // 钻石
    tbc_point       = 3;        // 远征币
    ladder_point    = 4;        // 竞技场币
}

// 雇佣数据
message hire_data {
    optional uint32         _uid   = 1;
    optional string         _name  = 2;
    optional hire_hero      _hero  = 3;
    optional string         _role_id = 4;
}

message hire_hero {
    optional hero           _base       = 1;
    optional hero_dyna      _dyna       = 2;
}

// header
message down_msg {
    optional login_reply              _login_reply               = 1; // 登录返回
    optional reset                    _reset                     = 2; // GM命令重置玩家
    optional enter_stage_reply        _enter_stage_reply         = 3; // 进入关卡
    optional exit_stage_reply         _exit_stage_reply          = 4; // 离开关卡
    optional hero_upgrade_reply       _hero_upgrade_reply        = 5; // 英雄升级
    optional equip_synthesis_reply    _equip_synthesis_reply     = 6; // 装备合成
    optional wear_equip_reply         _wear_equip_reply          = 7; // 穿装备
    optional consume_item_reply       _consume_item_reply        = 8; // 使用道具
    optional shop_refresh_reply       _shop_refresh_reply        = 9; // 商店刷新
    optional shop_consume_reply       _shop_consume_reply        = 10; // 商店购买
    optional skill_levelup_reply      _skill_levelup_reply       = 11; // 技能升级
    optional sell_item_reply          _sell_item_reply           = 12; // 出售道具
    optional fragment_compose_reply   _fragment_compose_reply    = 13; // 碎片合成
    optional hero_equip_upgrade_reply _hero_equip_upgrade_reply  = 14; // 英雄装备附魔
    optional trigger_task_reply       _trigger_task_reply        = 15;  // 触发任务的返回
    optional require_rewards_reply    _require_rewards_reply     = 16;  // 请求奖励的返回
    optional trigger_job_reply        _trigger_job_reply         = 17;  // 触发每日活动的返回
    optional job_rewards_reply        _job_rewards_reply         = 18;  // 领取每日活动奖励的返回
    optional reset_elite_reply        _reset_elite_reply         = 19;  // 精英关卡次数重置
    optional sweep_stage_reply        _sweep_stage_reply         = 20;  // 关卡扫荡的返回
    optional equip_sweep_reply        _equip_sweep_reply         = 21;  // 装备扫荡的返回

    optional recharge_polling_reply   _recharge_polling_reply    = 23;  // 充值轮询
    optional hero_evolve_reply        _hero_evolve_reply         = 24;  // 英雄进化的返回
    optional sync_vitality_reply      _sync_vitality_reply       = 25;  // 同步体力
    optional user_check               _user_check                = 26;  // 用于给客户端校验数据一致性
    optional tutorial_reply           _tutorial_reply            = 27;  // 设置新手引导的返回
    optional error_info               _error_info                = 28;  // 错误信息
    optional ladder_reply             _ladder_reply              = 29;  // pvp天梯
    optional set_name_reply           _set_name_reply            = 30;  // 设置名字
    optional midas_reply              _midas_reply               = 31;  // 点金手
    optional open_shop_reply          _open_shop_reply           = 32;  // 打开商店

    optional sdk_login_reply          _sdk_login_reply           = 34;  // SDK登陆的返回
    optional set_avatar_reply         _set_avatar_reply          = 35;  // 设置头像
    optional notify_msg               _notify_msg                = 36;  // 玩家的通知
    optional ask_daily_login_reply    _ask_daily_login_reply     = 37;  // 领取每日登陆奖励
    optional tbc_reply                _tbc_reply                 = 38;  // 燃烧的远征
    optional get_maillist_reply       _get_maillist_reply        = 39;  // 获取邮件列表
    optional read_mail_reply          _read_mail_reply           = 40;  // 处理邮件的返回
    optional uint32                   _svr_time                  = 41;  // 服务器时间
    optional get_vip_gift_reply       _get_vip_gift_reply        = 42;  // 获取VIP礼包奖励
    optional chat_reply               _chat_reply                = 43;  // 聊天
    optional cdkey_gift_reply         _cdkey_gift_reply          = 44;  // 兑换码
    optional guild_reply              _guild_reply               = 45;  // 公会

    optional system_setting_reply     _system_setting_reply      = 49;   // 系统设置

    optional battle_check_fail        _battle_check_fail         = 54;   // 战斗校验失败
    optional query_replay             _query_replay              = 55; // 查询战斗录像回复
    optional super_link               _super_link                = 56; // 超链接跳转
    optional query_ranklist_reply     _query_ranklist_reply      = 57; // 查询排行榜信息

    optional change_task_status_reply _change_task_status_reply  = 59; // 冻结任务回复
    optional request_guild_log_reply  _request_guild_log_reply   = 60; // 公会日志返回
    optional client_update_version    _client_update_version     = 61; // 客户端热更新版本号
    optional query_act_stage_reply    _query_act_stage_reply     = 62; // 查询活动关卡
    optional real_pvp                 _real_pvp                  = 64; // 实时对战相关

    optional ask_pred_stage_reply     _ask_pred_stage_reply      = 72; // 预言之池7天预告

    optional realtime_notify_reply    _realtime_notify_reply     = 82; // 长连接实时推送系统回应

    optional dailyjob_reply           _dailyjob_reply            = 84; // 每日活动
    optional dreamland_reply          _dreamland_reply           = 85; // 永生梦境
    optional shop_switch_reply        _shop_switch_reply         = 86; // 商店切换

    optional real_arena_reply         _real_arena_reply          = 90; // 诸王争霸

    optional update_backdoor_reply    _update_backdoor_reply     = 104; // backdoor
    optional star_shop_refresh_reply  _star_shop_refresh_reply   = 105; // 刷新星际商人回执

    optional test_battle_check_reply _test_battle_check_reply    = 108; // 测试战斗校验
    optional migrate_reply            _migrate_reply             = 109; // 转服

    optional consume_exp_items_reply  _consume_exp_items_reply   = 112; // 批量使用混合升级道具
    optional medal_reply              _medal_reply               = 119; // 徽章操作

    optional remote_setting_reply     _remote_setting_reply      = 122;  // 跨服设置头像和徽章
    optional sort_item_reply          _sort_item_reply           = 125;  // 装备整理排序

    optional multiplayer_battle_reply _multiplayer_reply         = 129;  // 多人联机对战

    optional monster_reply            _monster_reply             = 133;  // 年兽
    optional lantern_reply            _lantern_reply             = 134;  // 走马灯

    optional multi_arena_reply        _multi_arena_reply         = 138;  // 诸神对决
    optional query_guild_members_reply _query_guild_members_reply = 139;  // 查询公会成员信息返回

    optional herohot_reply            _herohot_reply             = 143;  // 英雄推荐

    optional personal_home_page_reply _personal_home_page_reply  = 147;  // 个人主页
    optional video_reply              _video_reply               = 148;  // 录像
    optional onekey_sweep_stage_reply _onekey_sweep_stage_reply  = 149;  // 一键扫荡

    optional gm_ext_reply             _gm_ext_reply              = 151;  // GM扩展协议
    optional achievement_reply        _achievement_reply         = 152;  // 成就返回
    optional binding_reply            _binding_reply             = 153;  // 绑定
    optional fragment_compose_auto_reply    _fragment_compose_auto_reply    = 154;  // 碎片装备一键合成

    optional world_cup_reply          _world_cup_reply           = 162; // 世界杯

    optional goback_reply             _goback_reply              = 169; // 重返战场
    optional chess_reply              _chess_reply               = 170; // 自走棋回复
    optional chess_game_reply         _chess_game_reply          = 171; // 自走棋游戏回复
    optional chess_game_notify        _chess_game_notify         = 172; // 自走棋游戏通知

    optional team_reply               _team_reply                = 174; // 队伍回复
    optional team_notify              _team_notify               = 175; // 队伍通知
    optional impulse_gift_reply       _impulse_gift_reply        = 176; // 心动礼包
    optional cup_arena_reply          _cup_arena_reply           = 177; // 杯赛
    optional myth_reply               _myth_reply                = 178; // 时空秘境
    optional mall_gift_reply          _mall_gift_reply           = 179; // 商城礼包回复
    optional open_simple_chest_reply  _open_simple_chest_reply   = 180; // 打开随机宝箱回复
    optional activity_hint_reply      _activity_hint_reply       = 181; // 活动提示

    optional guild_mount_reply        _guild_mount_reply         = 185; // 公会山
    optional newplayer_reply          _newplayer_reply           = 187; // 萌新助力
    optional daily_pass_reply         _daily_pass_reply          = 188; // 日常pass
    optional hero_man_reply           _hero_man_reply            = 189; // 英雄小人

    optional btc_ctrl_notify          _btc_ctrl_notify           = 192; // 校验控制通知

    optional simple_shop_reply        _simple_shop_reply         = 196; // 简单商店
    optional fast_equip_chest_use_reply   _fast_equip_chest_use_reply   = 205; // 快速装备选择箱
    optional new_compose_reply        _new_compose_reply         = 206; // 新信使兑换活动

    optional summon_circle_reply      _summon_circle_reply       = 208; // 召唤法阵
    optional cut_read_mail_reply      _cut_read_mail_reply       = 209; // 删除已读邮件
    optional timely_item_notify       _timely_item_notify        = 210; // 同步限时道具通知
    repeated achievement_notify       _achievement_notify        = 211; // 成就通知
    optional daily_login_reward_reply _daily_login_reward_reply  = 212; // 签到奖励
    optional fancy_tower_reply        _fancy_tower_reply         = 213; // 幻境塔
    optional stage_star_reward_reply  _stage_star_reward_reply   = 214; // 战役章节星星宝箱奖励
    optional guild_raid_reply         _guild_raid_reply          = 215; // 新团本
    optional monthcard_reply          _monthcard_reply           = 216; // 月卡返回
    optional resolve_expired_item_reply   _resolve_expired_reply = 217; // 处理过期道具
    optional activity_reply           _activity_reply            = 218; // 活动
    optional daily_vitality_reply     _daily_vitality_reply      = 219; // 每日体力
    optional simple_pass_reply        _simple_pass_reply         = 220; // 通用通行证
    optional pull_hero_info_reply     _pull_hero_info_reply      = 221; // 拉取英雄数据
    optional fashion_reply            _fashion_reply             = 222; // 皮肤
    optional charge_vault_reply       _charge_vault_reply        = 223; // 活动宝库
    optional act_adventure_reply      _act_adventure_reply       = 224; // 活动关卡
    optional dap_report_notify        _dap_report_notify         = 225; // dap上报通知
    optional sevenday_assist_reply    _sevenday_assist_reply     = 226; // 七日助力
    optional fancy_abyss_reply        _fancy_abyss_reply         = 227; // 幻境深渊
    optional lottery_reply            _lottery_reply             = 228; // 戳戳乐
    optional peak_arena_reply         _peak_arena_reply          = 229; // 巅峰竞技场
    optional soul_exchange_reply      _soul_exchange_reply       = 230; // 灵魂石回收
    optional preset_lineup_reply      _preset_lineup_reply       = 231; // 预设阵容
    optional shard_reply              _shard_reply               = 232; // 英雄觉醒
    optional awake_dungeon_reply      _awake_dungeon_reply       = 233; // 地底历险
    optional heat_reply               _heat_reply                = 234; // 热力挑战
    optional sync_timestamps_reply    _sync_timestamps_reply     = 235; // 同步服务器时间戳
    optional nian_monster_reply       _nian_monster_reply        = 236; // 年兽活动
    optional guild_enlist_reply       _guild_enlist_reply        = 237; // 公会招募大厅
    optional guild_clash_reply        _guild_clash_reply         = 238; // 公会战
    optional retrieval_reward_reply   _retrieval_reward_reply    = 239; // 奖励找回
    optional manual_trigger_reply     _manual_trigger_reply      = 240; // 手动触发
    optional cosmetic_shop_reply      _cosmetic_shop_reply       = 241; // 外观商店
    optional select_stage_reward_reply _select_stage_reward_reply = 242;// 关卡自选奖励
    optional rogue_reply              _rogue_reply               = 243; // 魔力豫州(rogue
    optional pet_reply                _pet_reply                 = 244; // 信使
    optional astrolabe_reply          _astrolabe_reply           = 245; // 星盘
    optional all_star_reply           _all_star_reply            = 246; // 送花
    optional hero_recycle_reply       _hero_recycle_reply        = 247; // 英雄重生
    optional sweet_party_reply        _sweet_party_reply         = 248; // 甜心派对
    optional time_corridor_reply      _time_corridor_reply       = 249; // 时空回廊
    optional guild_contest_reply      _guild_contest_reply       = 250; // 天下角逐
    optional point_sync_reply         _point_sync_reply          = 251; // 代币主动同步
    optional dreamland_new_year_reply _dreamland_new_year_reply  = 252; // 永生梦境新年活动
    optional sync_tiger_tool_reply    _sync_tiger_tool_reply     = 253; // 白虎同步
    optional legend_equip_reply       _legend_equip_reply        = 254; // 传奇装备
    optional legend_equip_item_notify _legend_equip_item_notify  = 255; // 同步传奇装备通知
    optional pirate_shop_reply        _pirate_shop_reply         = 256; // 海盗商店
    optional simple_assist_reply      _simple_assist_reply       = 257; // 简单助力
    optional collection_point_reply   _collection_point_reply    = 258; // 收藏排行榜
    optional player_shift_reply       _player_shift_reply        = 259; // 玩家导流
    optional dragon_boat_reply        _dragon_boat_reply         = 260; // 划龙舟
    optional crevice_defend_reply     _crevice_defend_reply      = 261; // 多队梦境
    optional hero_haggle_reply        _hero_haggle_reply         = 262; // 英雄砍一刀
    optional solo_reply               _solo_reply                = 263; // 小冰冰全明星回复
    optional solo_game_reply          _solo_game_reply           = 264; // 小冰冰全明星游戏回复
    optional solo_game_notify         _solo_game_notify          = 265; // 小冰冰全明星游戏通知
    optional feature_preview_reply    _feature_preview_reply     = 266; // 功能预告
    // down_msg_end
    // 需要改动record.hrl:down_msg
    // 需要改动mysql iAction
}

message sort_item_reply{
    optional result _result = 1[default = success];
}


/////////////////////////////////////////////////////////////////////////////////////////////////////

message module_switch {
    enum otherpay_switch_type {
        all_off              = 0;
        all_on               = 1;
        android_on_gp_off    = 2;
        android_off_gp_on    = 3;
    }
    optional uint32 _open_level                  = 1;
    optional uint32 _open_chapter                = 2;
    optional uint32 _open_rank                   = 3;
    repeated uint32 _ban_item                    = 4;
    repeated uint32 _ban_hero                    = 5;
    repeated uint32 _ban_module                  = 6;
    optional otherpay_switch_type _other_payment = 7;
}

message global_config {
    optional module_switch _module_switch     = 2; // 游戏模块开关
}

// 登录返回
message login_reply {
    optional result            _result                  = 1;  // 登录结果
    optional user              _user                    = 2;  // 玩家数据
    optional global_config     _cfg                     = 3;  // 全局配置
    repeated string            _fca_md5                 = 4;  // fca资源md5黑名单
    optional string            _rt_lobby_addr           = 5;  // 实时对战大厅服务器地址 ip:port, 无IP按照服务器列表IP, 端口<10000表示服务器列表端口+偏移量，如端口为1表示主端口+1
    repeated string            _fca_name                = 6;  // fca资源名字黑名单
    optional string            _rt_notify_addr          = 7;  // 实时消息通知服务器地址 ip:port, 无IP按照服务器列表IP, 端口<10000表示服务器列表端口+偏移量
    optional dreamland_summary _dreamland               = 8;  // 永生梦境信息
    optional migrate_info      _migrate_info            = 10; // 迁移服务器信息
    optional int32             _svr_zone                = 12; // 服务器所在时区
    optional uint32            _real_game_server_id     = 15; // 实际登录的服务器ID
    optional string            _real_game_server_name   = 16; // 实际登录的服务器名字
    repeated activity_hint_record     _activity_hints   = 19; // 活动提示数组
    optional string            _global_chat_udp_address = 20; // 全服聊天UDP地址
    optional bool              _is_new_acc              = 21; // 是否是新账号注册
    repeated server_timestamp  _server_timestamps       = 22; // 服务器时间戳
    repeated merge_svr         _merge_svr_list          = 23; // 合服信息
}

// 合服服务器信息
message merge_svr {
    optional uint32     _svr_id         = 1; // 服务器ID
    optional uint32     _show_svr_id    = 2; // 显示服务器ID
    optional string     _show_svr_mame  = 3; // 显示服务器名称
}

message sdk_login_reply {
    optional result     _result        = 1 [default = fail];
    optional string     _uin           = 2;
    optional string     _recharge_url  = 3;
    optional uint32     _bd_ver        = 4;
    optional bytes      _bd_data       = 5; // backdoor
    optional string     _mapped_device_id = 6; // 映射账号ID，格式: plat_id-uin
    optional string     _charge_env       = 7; // 充值环境,用于充值请求中填充park_env参数
    optional bool       _enable_net_svrid = 8; // 是否启用网络数据包头部加入svrid
}

message user_check {
    optional user _user = 1;
}

message reset {
    optional user _user = 1;
}

message gm_ext_reply {
    optional gm_query_replay_reply   _query_replay          = 1; // 查询录像
    optional result                  _reset_activity_season = 2; // 重置赛季活动
    optional string                  _server_full_version   = 3; // 服务器完整版本号
    optional string                  _upload_user_data      = 4; // 上传玩家数据
    optional result                  _open_guild_enlist     = 6; // 打开公会招募大厅
    optional string                  _upload_guild_data     = 7; // 上传公会数据
    optional gm_download_guild_data_reply _download_guild_data   = 8; // 下载公会数据
}

message gm_query_replay_reply {
    enum replay_type {
      ladder          = 1;
      dreamland       = 2;
      babel           = 3;
      tbc             = 4;
      real_arena      = 5;
      multi_arena     = 7;
      cup_arena       = 9;
      peak_arena      = 10;
      guild_clash     = 11;
      crevice_defend  = 12;
      other           = 99;
    }
    optional replay_type                    _type         = 1; // 录像类型
    repeated query_summary                  _summary      = 2; // 战斗简介
    optional battle_record                  _general      = 3; // 通用录像

    optional multi_arena_battle_record      _multi_arena  = 5; // 诸神对决录像

    optional cup_arena_battle_replay        _cup_arena    = 7; // 女神之战
    optional peak_arena_battle_replay       _peak_arena   = 8; // 巅峰竞技场
    optional guild_clash_query_replay_reply _guild_clash  = 9; // 公会战
    optional crevice_defend_query_records_reply _crevice_defend  = 10; // 多队梦境

}

message gm_download_guild_data_reply {
    optional uint32 _guild_id = 1; // 下载到本服的公会ID
    optional user   _user     = 2; // 自己成为会长，会修改自己的数据
}

message enter_stage_reply {
    optional uint32             _rseed  = 1;
    repeated uint32             _loots  = 2; // <<wave_idx:3, monster_idx:3, id:16>>
}

// stage.erl
message exit_stage_reply {
    enum exit_stage_result {
        known   = 0;
        unknown = 1;
    }
    optional exit_stage_result  _result     = 1 [default = known];
    optional user_shop          _shop       = 2; // maybe a shop
    optional discount_shop      _dshop      = 3; // 折扣商店
    optional medal_item         _medal_item = 5; // 徽章信息
    optional uint32             _exp_bonus  = 6; // 其他系统增加的经验
}

message hero_upgrade_reply {
    optional result     _result = 1 [default = fail];
    optional hero       _hero   = 2;  //
    repeated item       _items  = 3;  // 返还的物品列表
    optional uint32     _equip_id = 4;
    //协议修改！如果结果是success，则服务器重置这个英雄的信息
}

message equip_synthesis_reply {
    optional result     _result = 1 [default = fail];
}

message wear_equip_reply {
    optional result     _result = 1 [default = fail];
    optional uint32     _gs     = 2;
    repeated item      _items  = 3;  // 返还的物品列表
}

message sync_vitality_reply {
    optional vitality _vitality     = 1;
}


message consume_item_reply {
    enum error_code {
        item_is_expire   = 1;
    }
    optional hero         _hero = 1;        // 吃经验丹后，服务器重置客户端的英雄信息
    optional uint32       _vitality = 2;    // 新体力
    repeated user_point   _user_point = 3;  // 使用物品还有可能得到use_point: wood,icon,crystal
    repeated uint32       _items = 4;       // 返回的物品
    optional error_code   _error_code= 5;   // 错误码
}

// 普通商店、地精、黑市
message user_shop {
    optional uint32  _id                        = 1; // shopid，如果为0的话表示没有商店
    optional uint32  _last_auto_refresh_time    = 2; // 上次自动刷新的时间，0表示不会自动刷新
    optional uint32  _expire_time               = 3; // expire time left, 0: never expire
    optional uint32  _last_manual_refresh_time  = 4; // 上次手动刷新时间
    optional uint32  _today_times               = 5; // 今日手动刷新的次数
    repeated goods   _current_goods             = 6; // 刷出来的商店物件
    repeated simple_goods   _simple_goods       = 7; // 简单商品
}

// 刷新商店的回执
message shop_refresh_reply{
    optional user_shop _user_shop      = 1;//用户的商店
    optional uint32    _can_switch     = 2;//商店是否可以切换
    repeated user_shop _user_shop_list = 3;//用户商店列表,用来同时查询多个商店
}

// 刷新星际商人商店回执
message star_shop_refresh_reply{
    optional star_shop _star_shop = 1;  // 星际商店
}

// 星际商店
message star_shop {
    optional uint32     _id                        = 1; // shopid，如果为0的话表示没有商店
    optional uint32     _expire_time               = 2; // expire time left, 0: never expire
    repeated star_goods _star_goods                = 3; // 星际商店物品
    optional uint32     _last_auto_refresh_time    = 4; // 上次自动刷新的时间，0表示不会自动刷新
}

// 折扣商店
message discount_shop {
    optional uint32     _id                      = 1; // shopid
    optional uint32     _create_time             = 2; // 刷新时间
    optional uint32     _expire_time             = 3; // 过期时间
    repeated goods      _goods_list              = 4; // 商品列表
}

// 购买物品的反馈
message shop_consume_reply {
    optional result     _result = 1 [default = success];
}

// 升级技能的反馈
message skill_levelup_reply {
    optional result     _result = 1 [default = fail];
    optional uint32     _gs     = 2;
}


// 卖东西的反馈，考虑到有可能存在不能卖的装备，还是返回把
message sell_item_reply {
    optional result     _result = 1 [default = success];
}


// 碎片合成的返回
message fragment_compose_reply {
    optional result     _result = 1 [default = fail];
}

// 一键碎片装备合成的返回
message fragment_compose_auto_reply {
    optional result     _result = 1 [default = fail];
}

// 英雄身上装备进阶的返回
message hero_equip_upgrade_reply {
    optional result     _result = 1 [default = fail];
    optional hero       _hero   = 2;        // 成功则返回完整信息，失败则无效
}

// 设置新手引导的返回
message tutorial_reply {
    optional result     _result = 1 [default = success];
}

message error_info {
    enum type {
        common  = 0;
        quit    = 1;
        tip     = 2;
    }
    optional type   _type = 1;
    optional string _info = 2;
}

//-------------------------------------------------------------------------------

message goods {
    enum price_type {
        gold          = 0;
        diamond       = 1;
        crusadepoint  = 2;
        arenapoint    = 3;
        raid_point    = 4;
        dreampoint    = 7;
        soulstone     = 12;
        shard_point   = 13;
        purple_pet_point = 14;
        blue_pet_point   = 15;
        tavern_point = 16;
        plain_shop_point = 17; // 点数
    }
    enum discount_type {
        six_discount    = 0; //打六折
        eight_discount  = 1; //打八折
        dynamic_discount = 2; //动态折扣
    }

    optional uint32       _id     = 1; // 物品ID
    optional uint32       _amount = 2; // 物品数量
    optional price_type   _type   = 3; // 价格类型
    optional uint32       _price  = 4; // 物品单价
    optional discount_type  _discount_type  = 5; // 打折配置
    optional uint32       _price_value = 6; // 与"价格类型"匹配的价格值，各类型有自己的含义，如soulstone表示灵魂石id
    optional uint32       _discount_perct = 7; // 折扣百分比，_discount_type=dynamic_discount时使用，30表示3折
    optional uint32         _cur_buy_times    = 8; // 当前购买次数
    optional uint32         _max_buy_times    = 9; // 最大购买次数
    optional bool           _limited          = 10; // 终身限购
}

message star_goods {
    enum box_type {
        stone_green  = 0;   // 小
        stone_blue   = 1;   // 中
        stone_purple = 2;   // 大
    }
    optional box_type _type         = 1; //宝箱品质
    optional uint32   _amount       = 2 [default = 1]; // 物品数量
    optional uint32   _stone_id     = 3; //购买宝箱所需的灵魂石id
    optional uint32   _stone_amount = 4; //购买宝箱所需的灵魂石数量
}

message user {
    optional uint32             _userid                 = 1;  // 玩家ID
    optional name_card          _name_card              = 2;  // 姓名卡
    optional uint32             _level                  = 3;  // 等级
    optional uint32             _exp                    = 4;  // 经验
    optional uint32             _vip_exp                = 5;  // 累计VIP经验
    optional double             _money                  = 6;  // 金币
    optional packed_diamond     _diamond                = 7;  // 钻石
    optional sint32             _bbp                    = 8;  // 冰冰点
    optional vitality           _vitality               = 9;  // 体力
    optional string             _role_id                = 10;  // 角色ID
    repeated hero               _heroes                 = 11; // 英雄
    repeated item               _items                  = 12; // 道具 (id, amount)

    optional userstage          _userstage              = 15; // 玩家关卡相关信息
    repeated user_shop          _shops                  = 16; // 商店
    repeated uint32             _tutorial               = 17; // 新手引导的内容
    repeated usertask           _tasks                  = 18; // 任务记录
    repeated task_finished      _task_finished          = 19; // 已经完成的任务链记录
    optional uint32             _last_login             = 20; // 上次登陆时间
    repeated dailyjob           _dailyjobs              = 21; // 每日任务
    optional usermidas          _usermidas              = 23; // 点金手
    optional daily_login        _daily_login            = 24; // 每日登陆
    repeated item               _recharge_limits        = 25; // 充值限次 (id, times)

    repeated user_point         _points                 = 27; // 玩家消耗点数，新型货币集合
    repeated monthcard          _monthcards             = 28; // 玩家月卡数据
    optional user_guild         _user_guild             = 29; // 用户公会数据
    optional chat               _chat                   = 30; // 聊天数据

    optional string             _reg_ip_region          = 40; // 注册IP地区
    optional consume_vitality_daily _consume_vitality   = 41; // 体力消耗时间戳

    repeated item_expiry          _item_expiry          = 45; // 时效道具过期时间

    repeated medal_item         _medal_list             = 47; // 徽章列表

    repeated uint32             _favorite               = 52;  // 英雄收藏夹

    repeated hh_hero            _herohot                = 54;  // 英雄热度

    optional user_binding       _binding                = 56;  // 绑定信息
    optional string             _uuid                   = 57;  // 唯一ID
    optional uint32             _create_time            = 58;  // 角色创建时间

    optional bool               _is_gm                  = 59;  // 是否是gm账号
    optional gender             _gender                 = 60;  // 性别
    repeated system_setting_item _system_setting_item   = 61;  // 系统设置信息

    optional user_goback        _goback                 = 65;  // 重返战场数据

    repeated activity_hint_record   _hint_records       = 67;  // 活动提示记录

    optional user_newplayer     _newplayer              = 69;  // 萌新助力

    repeated timely_item        _timely_items            = 81;  // 限时道具
    optional expired_item_history  _expired_item_history    = 82;  // 过期道具历史
    optional daily_vitality     _daily_vitality          = 83; // 每日体力
    repeated packed_simple_pass _pass_list               = 84; // 通行证列表
    optional packed_sevenday_assist    _sevenday_assist         = 85; // 七日助力
    repeated preset_lineup             _preset_lineups          = 86; // 预设阵容
    repeated pet                       _pets                    = 87; // 信使
    repeated user_astrolabe_info       _astrolabe_infos         = 88; // 洗练信息
    repeated legend_equip              _legend_equips           = 89; // 传奇装备
    // user_tail 跳转
    // 需要更新users:pack_user
}

message task_finished {
    optional uint32 _task_line  = 1;    //任务链id
    optional uint32 _task_id    = 2;    //任务链内id
}
message consume_vitality_daily {
    optional uint32 _consume     =  1;//消耗体力
    optional uint32 _timestamp   =  2;//消耗体力的有效时间戳
}

message user_id_summary {
    optional uint32       _user_id   = 1;
    optional user_summary _summary   = 2;
    optional uint32       _svrid     = 3;
}

//雇佣结果
enum hire_result {
    success = 0;
    fail    = 1;
    stage_invalid = 2;
}

// 名字卡
message name_card {
    optional string _name               = 1;    // 玩家名字
    optional uint32 _last_set_name_time = 2;    // 上次设置名字的时间，默认是0
    optional uint32 _avatar             = 3;    // 玩家头像，默认头像为0
    optional medal_item _medal          = 4;    // 玩家的徽章
}

//每日登陆领取奖励
message ask_daily_login_reply {
    optional result _result               = 1;
    repeated reward _rewards              = 2;
}

message hero_dyna {
    optional uint32     _hp_perc        = 1;
    optional uint32     _mp_perc        = 2;
    optional uint32     _custom_data    = 3;
}


message usertask {
    enum status {
        finished = 0;
        working = 1;
        suspend = 2;
    }
    optional uint32 _line               = 1;                      // 任务线ID
    optional uint32 _id                 = 2;                      // 任务ID
    optional status _status             = 3 [default = working];  // 任务当前状况：当奖励领完时，设置为finished
    optional uint32 _task_target        = 4;                      // 任务计数器
    repeated uint32 _sweepStages        = 5;                      // 英雄任务可以扫荡的关卡id
    optional uint32 _item_stage         = 6;                      // 有道具的任务
}

message dailyjob {
    optional uint32 _id                   = 1; // 每日活动ID
    optional uint32 _last_rewards_time    = 2; // 上次领取时间
    optional uint32 _task_target          = 3; // 当日任务累计
}

message sweeploot {
    optional uint32 _exp         = 1; // 经验
    optional uint32 _money       = 2; // 金钱
    repeated item _items         = 3; // 道具列表
    optional uint32 _exp_bonus   = 4; // 其他系统增加的经验
}

message usermidas {
    optional uint32 _last_change = 1; // 上次改动时间
    optional uint32 _today_times = 2; // 今天使用次数
    optional uint32 _free_times  = 3; // 使用免费次数
}

message item_expiry {
    optional uint32 _item_id     = 1; // 道具ID
    optional uint32 _expire_time = 2; // 过期时间
}

message timely_item {
    optional uint32 _insid       = 1; // 实例ID
    optional uint32 _timely_id   = 2; // 限时ID
    optional uint32 _amount      = 3; // 道具数量
    optional uint32 _expire_time = 4; // 过期时刻
}

// 过期道具历史
message expired_item_history {
  repeated item         _items        = 1; // 普通道具
  repeated timely_item  _timely_items = 2; // 限时道具
}


//-------------------------------------------------------------------------------
// 触发任务的返回
message trigger_task_reply {
    repeated task_result     _result = 1;
}

message task_result {
    optional result   _result = 1; // triger结果
    optional uint32   _target = 2; //返回任务进度
    optional uint32   _item_stage = 3;// 仅对觉醒任务第一步道具获取任务有效
}

// 要求任务奖励的返回
message require_rewards_reply {
    optional result     _result     = 1 [default = success];
    repeated reward     _rewards    = 2;
    repeated hero       _heroes     = 3;      // 如果有英雄获得，为英雄完整信息
    repeated monthcard  _monthcard  = 4;      // 如果有月卡获得，为玩家的月卡数据
    optional uint32     _exp_bonus  = 5;      // 导师系统增加的经验
}

// 通用奖励
message reward {
    enum type {
        diamond      = 1;           // 钻石（免费）
        gold         = 2;           // 金币
        item         = 3;           // 物品
        hero         = 4;           // 英雄
        vitality     = 5;           // 体力
        playerexp    = 6;           // 经验
        crusadepoint = 7;           // 远征币
        arenapoint   = 8;           // 竞技场币
        dreampoint   = 11;          // 梦境币
        achievement_pixel = 101;    // 成就pixel
        simple_chest = 25;          // 宝箱
        timely_item  = 26;          // 限时道具
        raid_point  = 27;           // 团本币
        free_monthcard = 28;        // 免费月卡
        payed_monthcard = 29;       // 付费月卡
        bbp             = 30;       // 冰冰点
        taskcount       = 31;       // 任务点
        level_chest     = 32;       // 等级宝箱
        medal           = 33;       // 徽章
        actpoint        = 34;       // 每日点数
	pay_diamond     = 35;       // 付费钻石
        simple_pass_exp     = 37;   // Pass经验
	blue_pet_point      = 38;   // 蓝色宠物代币
        purple_pet_point    = 39;   // 紫色宠物代币
	legend_equip        = 40;   // 传奇装备
        tavern_point      = 41;     // 酒馆点数
        choose_group      = 42; // 选择组
    }
    optional type   _type   = 1; // 类型
    optional uint32 _id     = 2; // id
    optional double _amount = 3; // 数量
}

message change_task_status_reply {
    optional uint32  _line = 1;  // 任务线ID
    optional uint32  _id   = 2;  // 任务ID
    optional uint32  _operation = 3; //任务操作  1:冻结任务，2：resume冻结的任务
    optional result  _result = 4 [default = success];
}

// 每日活动触发返回
message trigger_job_reply {
    repeated result     _result = 1 [default = success];
}

// 活动奖励
message  dailyjob_reward {
    enum type {
        diamond      = 1;   // 钻石
        money        = 2;   // 金币
        item         = 3;   // 物品
        hero         = 4;   // 英雄
        vitality     = 5;   // 体力
        playerexp    = 6;   // 经验
        crusadepoint = 7;   // 远征币
        arenapoint   = 8;   // 竞技场币
        dreampoint   = 10;  // 梦境币
        actpoint     = 17;  // 活跃点
        medal        = 18;  // 徽章
        shard_point  = 19;  // 觉醒币
    }
    optional type   _type   = 1; // 类型
    optional uint32 _id     = 2; // id
    optional uint32 _amount = 3; // 数量
}

message dailyjob_reply {
    optional dailyjob_open_panel _dailyjob_open_panel = 1;
    optional dailyjob_open_chest _dailyjob_open_chest = 2;
    optional dailyjob_onekey     _dailyjob_onekey     = 3;
}

message dailyjob_open_panel {
    optional uint32             _vitality_activity          = 1;  // 体力活动开启标志，1为开启，0为关闭

    optional uint32             _actpoint                   = 4;  // 活动点数
    repeated uint32             _opened_chest_ids           = 5;  // 打开的箱子ID
    repeated uint32             _top_trigger_ids            = 6;  // 紧急任务的ID
    repeated weeklyjob          _weeklyjobs                 = 7;  // 周常活动
    optional uint32             _weekly_actpoint            = 8; // 周常活动点数
    repeated uint32             _opened_weekly_chest_ids    = 9; // 打开的周常箱子ID
    optional uint32             _nowtime                    = 11; // 服务器时间
    optional daily_pass_daily    _daily_pass_daily          = 12; // 日常通行证
    optional uint32             _finish_daily_job_num       = 14; // 已完成的每日任务数量
    optional dailyjob_module    _module_type                = 15; // 玩法模块
}

// 活动箱子领取的返回
message dailyjob_open_chest {
    optional result          _result            = 1 [default = success];
    repeated dailyjob_reward _chest_reward      = 2;
    repeated uint32          _opened_chest_ids  = 3;  // 打开的箱子ID
}

message dailyjob_onekey {
    optional result          _result           = 1 [default = success];
    repeated dailyjob_reward _activity_reward  = 2;
    optional uint32          _exp_bonus        = 3;  //其他系统增加的经验
    optional daily_pass_daily _daily_pass_daily  = 4;  //英雄通行证等级
}

message weeklyjob {
    optional uint32 _id                   = 1; // 每日活动ID
    optional uint32 _last_rewards_time    = 2; // 上次领取时间
    optional uint32 _task_target          = 3; // 当日任务累计
    optional uint32 _optional_task_target = 4; // 任务目标
}

// 活动奖励领取的返回
message job_rewards_reply {
    optional result          _result           = 1 [default = success];
    repeated dailyjob_reward _activity_reward  = 2;
    optional uint32          _exp_bonus        = 3;  //其他系统增加的经验
    optional daily_pass_daily _daily_pass_daily  = 4;  //英雄通行证等级
}

// 打开随机宝箱回复
message open_simple_chest_reply {
    repeated reward      _rewards   = 1; // 奖励列表
}

//-------------------------------------------------------------------------------

// 精英关卡重置的返回
message reset_elite_reply {
    optional result     _result = 1 [default = success];
}

// 关卡扫荡的返回
message sweep_stage_reply {
    repeated sweeploot            _loot         = 1;
    repeated item                 _items        = 2; // 道具列表
    optional user_shop            _shop         = 3; // maybe a shop
    optional discount_shop        _dshop        = 4; // 折扣商店
}

// 装备扫荡的返回
message equip_sweep_reply {
  enum end_type {
    time_end      = 1; // 到次数
    vitality_end  = 2; // 体力不足
    equip_end     = 3; // 材料已足够
    daily_end   = 4; // 到达每日次数
  }
  repeated sweeploot            _loot         = 1;
  repeated item                 _items        = 2; // 道具列表
  optional user_shop            _shop         = 3; // maybe a shop
  optional discount_shop        _dshop        = 4; // 折扣商店
  optional uint32               _equip_cnt    = 5; // 获得的装备数量
  optional end_type             _end_type     = 6; // 扫荡结束原因
}

// 扫荡相关信息
message sweep {
    optional uint32 _last_reset_time          = 1;
    optional uint32 _today_free_sweep_times   = 2;
}


// 英雄进化返回
message hero_evolve_reply {
    optional result     _result = 1 [default = success];
    optional hero       _hero   = 2;
}

// 体力值相关数据
message vitality {
    optional uint32 _current     = 1;
    optional uint32 _lastchange  = 2;
    optional uint32 _todaybuy    = 3;
    optional uint32 _lastbuy     = 4;
}

// 玩家关卡相关信息
message userstage {
    repeated uint32           _normal_stage_stars    = 1;  // (2bits * 16) * N
    repeated uint32           _elite_stage_stars     = 2;  // 精英本的星星记录，ID从10000开始
    repeated uint32           _elite_daily_record    = 3;  // 精英本今日的通关记录，<<id:10, dailylimit:5, reset:5>>
    // id:           精英本ID - 10000
    // dailylimit:   今天已经打过的次数，最多为15次！
    optional uint32           _elite_reset_time      = 4;  // 精英关卡重置记录
    optional sweep            _sweep                 = 5;  // 扫荡相关信息
    repeated act_daily_record _act_daily_record      = 6;  // 今日进入活动关卡的记录
    optional uint32           _act_reset_time        = 7;  // 活动的上次重置时间，初始化时设置为当前时间
    repeated stage_star       _act_stage_stars       = 8;  // 活动关卡的星星数量
    repeated uint32           _chapter_star_ids      = 12; // 已开启的章节星星宝箱id
    repeated stage_select_reward _stage_select_reward = 13; // 关卡自选奖励记录
}

message stage_star {
    optional uint32 _stage_id = 1;  // 关卡ID
    optional uint32 _stars    = 2;  // 星星数量
}

message stage_select_reward {
    optional uint32 _stage_id       = 1;  // 关卡id
    optional uint32 _reward_id      = 2;  // 奖励id
}

// 活动每日记录
message act_daily_record {
    optional uint32     _id           = 1;  // 活动组ID
    optional uint32     _frequency    = 2;  // 今日进入次数
    optional uint32     _last_change  = 3;  // 上次进入活动的时间
}

// pvp天梯
message ladder_reply{
    optional open_panel                  _open_panel         = 1;   // 打开联赛面板
    optional apply_opponent              _apply_oppo         = 2;   // 请求比赛对手
    optional start_battle                _start_battle       = 3;   // 开始战斗数据
    optional end_battle                  _end_battle         = 4;   // 结束战斗数据
    optional set_lineup                  _set_lineup         = 5;   // 设置阵容
    optional query_records               _query_records      = 6;   // 查询比赛记录
    optional query_replay                _query_replay       = 7;   // 查询回放数据
    optional query_rankboard             _query_rankborad    = 8;   // 查询排行榜数据
    optional query_oppo_info             _query_oppo         = 9;   // 查询对手信息
    optional clear_battle_cd             _clear_battle_cd    = 10;  // 重置战斗cd
    optional draw_rank_reward            _draw_rank_reward   = 11;  // 领取排名奖励
    optional buy_battle_chance           _buy_battle_chance  = 12;  // 购买战斗次数
    optional share_fight                 _share_fight        = 13;  // 分享阵容到公会
    optional start_battle                _start_fight        = 14;  // 切磋功能
    repeated query_summary               _query_summary      = 15;  // 查询战斗简报
    optional sweep_reward                _sweep_reward       = 16;  // 扫荡奖励
    optional arena_use_background_reply  _use_background     = 17;  // 返回选择使用竞技场背景图

    optional string             _error_code         = 21;  // 错误代码
}

// 返回选择使用竞技场背景图
message arena_use_background_reply {
    optional uint32 _background_id     = 1;  // 背景id
}

message sweep_reward {
    repeated reward   _rewards        = 1; // 奖励
    optional uint32   _left_challenge = 2; // 剩余挑战次数
}

message query_summary{
    repeated arena_pvp_hero _hero_data = 1;
}

message open_panel{
    optional uint32 _rank               = 1;        //排名
    optional uint32 _left_count         = 2;        //剩余战斗限次
    optional uint32 _last_bt_time       = 3;        //上次战斗时间
    optional uint32 _buy_times          = 4;        //今日购买次数
    repeated hero   _lineup             = 5;        //阵容
    optional uint32 _gs                 = 6;        //阵容gs
    repeated ladder_opponent _oppos     = 7;        //对手列表
    optional uint32 _highestrank        = 8;        //历史最高排名
    optional bool   _is_foothold        = 10;       //是否是据点
    optional uint32 _left_share_count   = 11;        //剩余分享限次
    optional uint32 _ban_hero           = 12;       //禁用英雄
    optional bool   _is_ban_hero_open   = 13;       //是否开启禁用英雄
    optional ladder_buff_desc _ladder_buf = 14;     //是否开启竞技场buff
    optional uint32 _background_id      = 15;       // 正在使用中的背景id
}

message ladder_buff_desc {
    optional uint32  _buff_id             = 1;  // 0表示没开启
    optional string  _title               = 2;
    optional string  _content             = 3;
}

message apply_opponent{
    repeated ladder_opponent _oppos   = 1;        //对手列表
    optional uint32          _rank    = 2;        //自身排名
}

message start_battle{
    optional result           _result                 = 1;
    optional uint32           _rseed                  = 2;
    repeated hero             _self_heroes            = 3;        //自己英雄详细信息
    repeated hero             _heroes                 = 4;        //对手英雄详细信息
    optional uint32           _is_robot               = 5;        //对手是否为机器人
    repeated warschool_book   _self_warschool_books   = 6;
    repeated warschool_book   _oppo_warschool_books   = 7;
    optional uint32           _self_bookreading_level = 8;
    optional uint32           _oppo_bookreading_level = 9;
    optional uint32           _ladder_buff_id         = 10;       //竞技场buff id, 0表示没开启
    optional uint32           _bt_st                  = 11;
    optional battle_bonus     _self_bonus             = 12; // 己方战斗加成
    optional battle_bonus     _oppo_bonus             = 13; // 对手战斗加成
    optional uint32           _background_id          = 14; // 正在使用中的背景id
    optional uint32           _home_ground            = 15; // 0代表自己为主场；1代表对手为主场
}

message end_battle{
    enum achievement_type{
        foothold        = 1; //据点信息：排名多少
        top_1           = 2; //全服第一：_
        win_10          = 3; //连胜十次及以上：连胜次数
        best            = 4; //历史最佳：排名多少
        win_3           = 5; //连胜三次：_
    }
    optional battle_result      _result             = 1;
    optional best_rank_reward   _best_rank_reward   = 2;     // 最高排名奖励
    optional uint32             _best_rank          = 3;     // 最高排名
    optional uint32             _cur_rank           = 4;     // 当前排名
    optional achievement_type   _achievement_type   = 5;     // 成就类型，用于生成文字分享信息
    optional uint32             _achievement_info   = 6;     // 成就具体信息
    repeated reward             _rewards            = 7;     // 获得的奖励
}

message best_rank_reward {
    optional uint32  _dimond = 1; // 钻石
    repeated uint32  _items  = 2; // 限时掉落道具
}

message set_lineup{
    optional result _result         = 1;
    repeated hero   _lineup         = 2;     // 阵容信息，hero数组
    optional uint32 _gs             = 3;     // 阵容gs
    optional uint32 _ban_hero       = 4;     // 禁用英雄信息
}

message query_records{
    repeated ladder_record _arena_records   = 1;
    repeated ladder_record _fight_records   = 2;
}

message query_replay{
    optional battle_record _record   = 1;
}

message battle_record{
    optional uint32 _checkid       = 1;
    optional uint32 _userid        = 2;
    optional string _username      = 3;
    optional uint32 _level         = 4;
    optional uint32 _avatar        = 5;
    optional uint32 _vip           = 6;
    optional uint32 _oppo_userid   = 7;
    optional string _oppo_name     = 8;
    optional uint32 _oppo_level    = 9;
    optional uint32 _oppo_avatar   = 10;
    optional uint32 _oppo_vip      = 11;
    optional uint32 _oppo_robot    = 12;
    optional battle_result _result = 13;
    repeated hero   _self_heroes   = 14;
    repeated hero_dyna _self_dynas = 15;
    repeated hero   _oppo_heroes   = 16;
    repeated hero_dyna _oppo_dynas = 17;
    optional uint32 _rseed         = 18;
    optional uint32 _self_robot    = 19;
    optional uint32 _param1        = 20;
    repeated operation _operations     = 21;
    repeated operation _oppo_operations    = 22;
    optional uint32 _args          = 23;  //战斗分享的字段，1 代表远征，2代表宝藏分享
    repeated warschool_book    _self_warschool_books  = 24;
    repeated warschool_book    _oppo_warschool_books  = 25;
    optional uint32 _self_bookreading_level = 26;
    optional uint32 _oppo_bookreading_level = 27;
    optional uint32 _ladder_buff_id         = 28;  //竞技场buff活动的buff id
    optional uint32      _bt_st             = 29;
    optional battle_bonus _self_bonus       = 30; // 己方战斗加成
    optional battle_bonus _oppo_bonus       = 31; // 对手战斗加成
    optional medal_item   _self_medal       = 32; // 我方徽章
    optional medal_item   _oppo_medal       = 33; // 敌方徽章
    optional uint32       _oppo_svr_id      = 34; // 对手服务器ID
    optional uint32       _background_id    = 35; // 正在使用中的背景id
    optional uint32       _home_ground      = 36; // 0代表自己为主场；1代表对手为主场；2 代表无主场
}

message query_guild_members{
    optional uint32         _uid           = 1;
    optional user_summary   _user_summary  = 2;
    optional uint32         _is_online     = 3; // 玩家在线状态，0离线，1在线
}

message query_rankboard{
    repeated rankboard_data _rank_list   = 1;
    optional rankboard_data _self_rank   = 2;  // 自己的排行榜信息
    optional uint32         _pos         = 3;  // 自己的排名
    optional uint32         _prev_pos    = 4;  // 自己之前的排名
}

message query_oppo_info{
    optional ladder_opponent _user    = 1;
}

message clear_battle_cd{
    optional result _result         = 1;
}

message rankboard_data{
    optional uint32 _user_id        = 1;
    optional user_summary _summary  = 2;
}

message ladder_record{
    optional uint32 _user_id            = 1;
    optional user_summary _summary      = 2;        //简要信息
    optional uint32 _deta_rank          = 3;        //玩家等级
    optional uint32 _bt_time            = 4;        //战斗时间
    optional battle_result  _bt_result  = 5;        //战斗结果
    optional uint32 _replay_id          = 6;        //战斗录像ID
    optional uint32 _active             = 7;        //是否主动方
    repeated hero   _oppo_heroes        = 8;        //敌方英雄
    optional battle_bonus       _bonus  = 9;        //战斗加成
}

message ladder_opponent{
    optional uint32 _user_id        = 1;
    optional user_summary _summary  = 2;        //简要信息
    optional uint32 _rank           = 3;        //排名
    optional uint32 _win_cnt        = 4;        //胜场数
    optional uint32 _gs             = 5;        //战力
    optional uint32 _is_robot       = 6;        //是否机器人
    repeated hero   _heros          = 7;
    optional relation _relation     = 8;
    optional bool   _is_foothold    = 9;
    optional uint32 _ban_hero       = 10;
    optional uint32 _guild_id       = 11;
}

message ladder_rank_reward{
    enum reward_type{
        gold        = 1;
        diamond     = 2;
        item        = 3;
        arenapoint  = 4; // 普通竞技场币
    }
    optional reward_type _type      = 1;        // 奖励类型
    optional uint32 _param1         = 2;        // 奖励参数1
    optional uint32 _param2         = 3;        // 奖励参数2
}

message draw_rank_reward{
    repeated ladder_rank_reward _rewards = 1;   // 奖励组
}

message buy_battle_chance{
    optional result _result         = 1 [default = success];
    optional uint32 _buy_times      = 2;        // 已购买次数
}

message share_fight{
    optional chat_broad_say _chat_broad_say = 1;
}
// 设置名字
message set_name_reply {
    enum set_name_result {
        success     = 0;
        exists      = 1;
        dirty_word  = 2;
    }
    optional set_name_result  _result = 1 [default = success];
}

// 设置头像
message set_avatar_reply {
    optional result      _result  = 1;
}

// 打包的钻石数据
message packed_diamond {
    optional uint32     _free_diamond   = 1; // 免费钻石
    optional uint32     _pay_diamond    = 2; // 付费钻石
    optional uint32     _debt_diamond   = 3; // 欠费钻石
}


// 充值轮询
message recharge_polling_reply {
    optional packed_diamond     _diamond    = 1; // 钻石
    optional uint32     _vip_exp            = 2; // vip经验
    repeated hero       _heroes             = 3; // 英雄
    repeated item       _recharge_limits    = 4; // 充值限制
    repeated monthcard  _monthcards         = 5; // 月卡
    repeated item       _items              = 6; // 查询道具数量
    optional bool       _to_gift_ticket     = 7; // 是否订单被转换成代金券
}

// 礼包券同步
message gift_ticket_sync {
    repeated item       _gift_tickets       = 1; // 礼包券数量，[{money1,cnt1},{money2,cnt2}]
    repeated item       _gift_ticket_items  = 2; // 礼包券道具
    optional sint32     _bbp                = 3; // 冰冰点
}

// 充值通知
message recharge_notify {
    optional bool _is_role_first = 1; // 是否是角色首充
    optional bool _is_acc_first = 2; // 是否账号首充
}


// 点金手，戳一下
message midas_acquire {
    optional uint32 _type   = 1;
    optional uint32 _money  = 2;
}

message midas_reply {
    repeated midas_acquire _acquire = 1;
    optional uint32 _cur_free_times = 2; // 新已使用免费次数
}

// 打开神秘商店的返回
message open_shop_reply {
    optional result      _result  = 1;
    optional user_shop   _shop    = 2;
}

// 服务器通知
message notify_msg {
    optional ladder_notify _ladder_notify                = 1;  // 普通竞技场通知
    optional uint32        _new_mail                     = 2;  // 新的邮件
    optional uint32        _guild_chat                   = 3;  // 公会聊天
    optional uint32        _activity_notify              = 4;  // 活动变动通知，需要拉取活动信息
    repeated uint32        _activity_reward_ids          = 5;  // 可奖励的活动cfg id列表，需要显示红点
    repeated uint32        _release_heroes               = 6;  // 回到自由状态的英雄们
    optional personal_chat _personal_chat                = 9;  // 1表示有新的私聊，2表示有新的工会英雄任务
    repeated user_point    _points_sync                  = 10; // 点数同步

    optional chat_msg_notify _chat_msg_notify            = 15;  // 聊天消息通知
    optional uint32        _has_unread_activies          = 16;  // 有未读的活动信息

    optional uint32        _bd_version                   = 23;  // backdoor版本号
    optional uint32        _is_open_debug                = 24;  // 是否开启debug，0表示开启，其他表示关闭
    repeated item_expiry   _item_expiry                  = 26;  // 时效道具显示日期刷新

    optional uint32        _vitality                     = 31;  // 通知当前的体力值
    optional bool          _is_open_arena_foothold       = 32;  // 是否开启竞技场据点战

    repeated uint32        _anti_guilds                  = 39;  // 敌对公会

    optional chat_contact_user _new_apply                = 41;  // 新的好友申请
    optional chat_contact_user _new_friend               = 42;  // 对方同意了你的好友请求 成为了你的好友
    optional chat_target   _del_friend                   = 43;  // 对方从好友列表里面吧你删除了

    optional chat_group_leave_info   _exit_member_info   = 45;  // 有人从聊天室退出了

    optional multi_pvp_notify   _multi_pvp_notify        = 47;  // 多人联机玩法（诸王争霸，诸神对决）
    optional weeklyjob_notify   _weeklyjob_notify        = 54;  // 是否有完成的周常活动或没开的周常箱子
    optional bool          _guild_worship                = 55;  // 公会膜拜红点
    optional dreamland_summary  _dreamland_summary       = 56;  // 永生梦境状态
    optional uint32        _dreamland_scene_buff         = 61;  // 梦境场景BUFF
    optional bool          _world_cup                    = 62;  // 世界杯红点
    optional bool          _force_battle_report          = 67;  // 强制战斗校验报告
    optional bool          _goback_notify                = 68;  // 重返战场奖励
    optional bool          _chess_act_open               = 69;  // 自走棋活动开启标志
    optional impulse_gift_notify  _impulse_gift                 = 71;  // 冲动礼包
    optional cup_arena_notify   _cup_arena               = 73;  // 杯赛
    optional uint32        _myth_open_time               = 74;  // 时空秘境开启时间
    optional bool          _myth                         = 75;  // 时空秘境红点
    optional bool          _mall_gift                    = 76;  // 商城礼包红点f
    optional bool          _activity_hint                = 78;  // 是否有新的活动提示
    optional guild_mount_notify     _guild_mount         = 80;  // 公会山

    optional bool          _newplayer_notify             = 83;  // 萌新助力
    optional daily_pass_notify     _daily_pass_notify    = 84;  // 日常通行证
    optional simple_shop_notify     _simple_shop_notify  = 91;  // 简单商店提示
    optional uint32        _fancy_candle_count           = 99;  // 玩家幻生烛数量
    optional bool          _fancy_tower                  = 100; // 幻境塔红点
    optional bool          _achievement                  = 101; // 成就未领取奖励
    optional bool          _expire_mail                  = 102; // 过期邮件通知
    repeated monthcard     _new_monthcards               = 103; // 获得了新的月卡
    optional gift_ticket_sync   _gift_ticket_sync        = 104; // 礼包券同步
    optional recharge_notify    _recharge_notify         = 105; // 充值同步
    optional bool               _bag_guard_notify        = 106; // 是否背包溢出
    optional simple_pass_notify _simple_pass_notify      = 107; // 通用通行证通知
    optional string             _ip_location             = 108; // IP位置
    optional bool               _charge_vault_notify     = 109; // 充值宝匣通知
    optional bool               _sevenday_assist_notify  = 110; // 七日助力通知
    optional act_adventure_notify   _act_adventure_notify    = 111; // 活动关卡
    optional bool               _server_maintain_notify  = 112; // 服务器维护通知
    optional peak_arena_notify  _peak_arena_notify       = 113; // 巅峰竞技场通知
    optional bool               _fancy_abyss_notify      = 114; // 幻境深处新赛季通知
    optional awake_dungeon_notify   _awake_dungeon_notify   = 115; // 地底历险
    optional heat_notify        _heat_notify             = 116; // 热力挑战
    repeated chat_spell_notify  _chat_spell_notify       = 117; // 聊天发奖
    optional nian_monster_notify    _nian_monster_notify    = 118; // 年兽活动
    optional uint32             _guild_enlist            = 119; // 公会招募大厅，未开放=0，开放=1，公会红点=2
    optional guild_clash_notify     _guild_clash_notify     = 120; // 公会战
    optional uint32               _retrieval_reward_notify  = 121; // 奖励找回通知 无奖励=0，无红点=1，显示红点=2
    optional bool                 _summon_circle_notify     = 122; // 法阵 新手奖励红点
    optional bool                 _force_quit_notify        = 123; // 强制客户端退出
    repeated uint32               _cosmetic_shop_notify     = 124; // 皮肤商店红点
    optional bool                 _guild_join_req_notify    = 125; // 公会申请列表红点
    optional rogue_notify         _rogue_notify             = 126; // rogue通知
    optional bool                 _has_hatched_egg          = 127; // 是否有孵出的蛋
    optional bool                 _new_hero_astrolabe       = 128; // 有新的星盘上线
    optional uint32               _all_star_season          = 129; // 送花赛季
    optional sweet_party_notify   _sweet_party_notify       = 130; // 甜心派对通知
    optional chat_blocking_notify _chat_blocking_notify     = 131; // 聊天屏蔽类型
    optional time_corridor_notify _time_corridor_notify     = 132; // 时空回廊
    optional real_arena_notify    _real_arena_notify        = 133; // 诸王红点
    optional legend_equip_notify  _legend_equip_notify      = 134; // 传奇装备
    optional bool                 _pirate_shop_notify       = 135; // 可领取藏宝图红点
    optional simple_assist_notify _simple_assist_notify     = 136; // 简单助力
    optional dragon_boat_notify   _dragon_boat_notify       = 137; // 划龙舟
    optional crevice_defend_notify     _crevice_defend_notify       = 138; // 多队梦境
    optional hero_haggle_notify   _hero_haggle_notify       = 139; // 英雄砍一刀
    optional feature_preview_notify _feature_preview_notify = 140; // 功能预览
    // notify_msg_end 跳转
}

message personal_chat {
    repeated person_chat_info _person_chat_info = 1;
}

message person_chat_info {
    optional string _role_id = 1;
    optional uint32 _chat_count = 2;
}

// 天梯通知
message ladder_notify {
    optional uint32 _is_attacked = 1;   // 1被攻击，0没有被攻击
}



message chat_msg_notify {
    optional chat_channel _channel  = 1;
    optional chat_content _contents = 2;
}


message multi_pvp_notify {
    optional bool   _is_open_real_arena_double_points    = 1;  // 是否开启双倍积分
    optional bool   _is_open_rt2v2_double_point          = 2;  // 是否开启诸神双倍积分
    optional bool   _is_open_real_arena_arena_model      = 3;  // 是否开启诸王竞技模式
    optional bool   _is_open_rt2v2_arena_model           = 4;  // 是否开启诸神竞技模式
}

message weeklyjob_notify {
    repeated dailyjob_module   _weekly_job_module      = 1;
}

// 燃烧的远征
message tbc_reply {
    optional tbc_open_panel     _open_panel     = 1;
    optional tbc_query_oppo     _query_oppo     = 2;
    optional tbc_start_battle   _start_bat      = 3;
    optional tbc_end_battle     _end_bat        = 4;
    optional tbc_reset          _reset          = 5;
    optional tbc_draw_reward    _draw_reward    = 6;
    optional tbc_sweep          _tbc_sweep      = 7;
    optional tbc_change_mode    _change_mode    = 8;
    optional tbc_rush           _tbc_rush       = 9;
    optional tbc_weekly_reward  _weekly_reward  = 10;
    optional tbc_draw_hell_box  _draw_hell_box  = 11;
    optional tbc_battle_record  _battle_record  = 12;
    optional query_replay       _query_replay   = 13;
    repeated query_summary      _query_summary  = 14;
    optional result             _revive_hero    = 15;
    optional tbc_line_reward    _line_reward    = 16;
}

message tbc_change_mode {
    optional result         _result     = 1[default = success];
}

message tbc_self_hero {
    optional uint32     _tid        = 1;
    optional hero_dyna  _dyna       = 2;
}

message tbc_oppo_hero {
    optional hero        _base      = 1;
    optional hero_dyna   _dyna      = 2;
}

message tbc_stage {
    enum status {
        unpassed    = 0;        //未通过
        passed      = 1;        //已通过
        rewarded    = 2;        //已领奖
    }
    optional status _status      = 1 [default = unpassed];
    repeated reward _rewards     = 2;
}

enum tbc_mode {
    normal = 1;       // 正常模式
    hell  = 2;        // 地狱模式
}

message tbc_info {
    optional uint32         _cur_stage   = 1;         // 当前关卡下标，下标从1开始，0表示通关
    optional uint32         _reset_times = 2;         // 今天已用次数
    repeated tbc_self_hero  _heroes      = 3;         // 英雄数据
    repeated tbc_stage      _stages      = 4;         // 关卡数据
    optional hire_data      _hire_hero   = 5;         // 雇佣英雄
    optional uint32         _best_stage  = 6;         // 本日最佳成绩
    optional uint32         _history_best_stage = 7;  // 历史最佳成绩
    optional tbc_mode       _mode = 8;                // 当前远征模式
    optional uint32         _energy_bean = 9;         // 能量豆剩余数量
    optional bool           _bean_add    = 10;        // 能量豆加成
    optional uint32         _line_point  = 11;        // 阶段点数
    repeated uint32         _line_flags  = 12;        // 阶段奖励领取标志
}

message tbc_open_panel {
    optional tbc_info  _info                            = 1;
    repeated uint32 _heroes                             = 2; // 每日特殊扫荡英雄
    optional tbc_weekly_reward_info _weekly_reward_info = 3;
    optional tbc_hell_box  _hell_box                    = 4; // 特殊情况下触发获得的箱子
}

message tbc_query_oppo {
    optional user_summary   _summary    = 1;
    repeated tbc_oppo_hero  _oppos      = 2;
    optional uint32         _is_robot   = 3;        //对手是否为机器人
}

message tbc_start_battle {
    optional result         _result                 = 1[default = success];
    optional uint32         _rseed                  = 2;
    repeated warschool_book _oppo_warschool_books   = 3;
    optional uint32         _oppo_bookreading_level = 4;
    optional uint32         _energy_bean            = 5; //能量豆
    optional battle_bonus   _self_bonus             = 6; // 玩家自己的战斗加成
    optional battle_bonus   _oppo_bonus             = 7; // 战斗加成
}

message tbc_end_battle {
    optional battle_result  _result     = 1[default = victory];  //把客户端上传的结果返回，方便客户端处理
    optional tbc_weekly_reward_info _weekly_reward = 2; // 宝箱信息
}

message tbc_reset {
    optional result    _result          = 1[default = success];
    optional tbc_info  _info            = 2;
    repeated uint32    _heroes          = 3; //每日特殊扫荡英雄
    optional tbc_weekly_reward_info _weekly_reward_info = 4; // 周奖励信息
}

message tbc_draw_reward {
    optional result     _result         = 1[default = success];
    optional uint32     _stage_id       = 2;
    repeated reward     _rewards        = 3;
    optional uint32     _beans          = 4; // 能量豆
}

message tbc_sweep{
    repeated tbc_sweep_stage _tbc_sweep_stage = 1;
}
message tbc_rush{
    repeated tbc_rush_stage _tbc_rush_stage = 1;
    optional uint32         _extra_bean     = 2; //额外的能量豆
}

message tbc_rush_stage{
    optional uint32     _stage_id       = 1;
    repeated reward     _rewards        = 2;
    optional uint32     _energy_bean    = 3; //能量豆
}

message tbc_sweep_stage{
    optional uint32     _stage_id       = 1;
    repeated reward     _rewards        = 2;
}

message tbc_weekly_reward_info {
    optional uint32     _cur_progress   = 1; // 当前进度
    optional uint32     _max_progress   = 2; // 最大进度
    optional bool       _reward_flag    = 3; // 奖励标志，true=已领取
    repeated reward     _rewards        = 4; // 奖励列表
}

message tbc_weekly_reward {
    repeated reward     _rewards        = 1;
    optional tbc_weekly_reward_info _weekly_reward_info = 2; // 周奖励信息
}

message tbc_hell_box {
    optional uint32     _money             = 1;
    repeated uint32     _items             = 2;
    optional uint32     _diamond_cost      = 3;
}

message tbc_draw_hell_box {
    repeated reward     _rewards        = 1;
}

message tbc_battle_record {
    repeated tbc_record _records = 1;
}

message tbc_record {
    optional tbc_mode       _mode       = 1; // 难度模式
    optional uint32         _stage_id   = 2; // 据点编号
    optional user_summary   _summary    = 3; // 目标信息
    repeated tbc_oppo_hero  _heroes     = 4; // 英雄信息
    optional uint32         _bt_time    = 5; // 战斗时间
    optional battle_result  _bt_result  = 6; // 战斗结果
    optional uint32         _replay_id  = 7; // 战斗录像ID
}

// 远征阶段奖励
message tbc_line_reward {
    repeated reward _rewards = 1; // 奖励数组
}

// 获取所有邮件的返回
message get_maillist_reply {
    repeated sys_mail _sys_mail_list  = 1;
}

message sys_mail {
    enum status {
        unread  = 0;
        read    = 1;
    }
    optional uint32 _id             = 1;
    optional status _status         = 2;
    optional uint32 _mail_time      = 3;
    optional uint32 _expire_time    = 4;
    optional mail_content _content  = 5;
    optional double _money          = 6;
    optional uint32 _diamonds       = 7;
    optional uint32 _bbp    	    = 8;
    repeated item _items            = 9;    // 道具列表
    repeated user_point _points     = 10;   // 玩家消耗点数，新型货币集合
    optional uint32 _type           = 11;   // 1 是系统邮件，2是公会邮件, 166是问卷
    repeated mail_acc _mail_acc     = 12;   // 邮件附件
    optional string _url            = 13;   //邮件内打开web连接
}

message mail_acc {
    enum type {
        selfmonthcard   = 1;      // 月卡
        hero            = 2;      // 英雄
        magic_soul      = 3;      // 魂石
        medal           = 6;      // 勋章
        legend_equip    = 7;      // 传奇装备
    }
    optional type   _type          = 1; // 附件类型
    optional uint32 _amount        = 2; // 附件数量,如果是徽章的话,也是时间
    optional uint32 _id            = 3; // ID
    repeated mail_acc_extra _extra = 4; // 附件中其他一些可扩展字段
}

// 附件参数
// key="trading_action", value="buy"表示交易行买入邮件
message mail_acc_extra {
    optional string _key    = 1;
    optional string _value  = 2;
}

message mail_content {
    optional plain_mail     _plain_mail     = 1;
    optional format_mail    _format_mail    = 2;
}

message plain_mail {
    optional string _from         = 1;
    optional string _title        = 2;
    optional string _content      = 3;
}

message format_mail {
    optional uint32 _mail_cfg_id  = 1;
    repeated mail_param _params   = 2;
}

message mail_param {
    enum mail_param_type {
        value               = 1;     // 纯值类型，数字、字符串
        money               = 2;     // 货币
        item                = 3;     // 物品
        self_hero           = 5;     // 自己的英雄
        hero_name           = 7;     // 英雄名
        todo_task           = 8;     // 每日任务
        guild_avatar        = 9;     // 公会头像框
        scientific_counting = 10;    // 科学计数显示
    }

    optional uint32             _idx    = 1;
    optional mail_param_type    _type   = 2;
    optional string             _value  = 3;
}

message user_point {
    enum user_point_type {
        arenapoint      = 1;        // pvp点数
        crusadepoint    = 2;        // 远征点数
        pay_diamond     = 3;        // 付费钻石
        vip_exp         = 4;        // vip经验
        dreampoint      = 7;        // 永生梦境币
        raid_point      = 20;       // 团本币
        shard_point     = 21;       // 觉醒币
        purple_pet_point = 22;      // 信使紫币
        blue_pet_point   = 23;      // 信使蓝币

        shard_point_daily = 121;    // 每日觉醒币
        peak_arena_point  = 122;    // 巅峰币
        guild_mount_point = 123;    // 讨伐勋章
        tavern_point     = 124;     // 酒馆币
        tavern_point_weekly = 125;  // 每周酒馆币
    }
    optional user_point_type     _type   = 1[default = arenapoint];
    optional uint32              _value  = 2;
}

message read_mail_reply {
    optional result     _result         = 1;
    optional double     _money          = 2;
    optional uint32     _diamonds       = 3;
    optional uint32     _bbp            = 4;   // 冰冰点
    repeated item       _items          = 5;   // 道具列表
    repeated user_point _points         = 6;   // 玩家消耗点数，新型货币集合
    repeated mail_acc   _mail_acc       = 7;   // 邮件附件
    optional monthcard  _monthcard      = 8;   // 个人月卡
    optional uint32     _pay_diamond    = 9;   // 付费钻石
}

message mail_reward {
    enum type {
        money = 1;
        diamond = 2;
        skill_point = 3;
        item = 4;
        pay_diamond = 5;
        hero = 6;
    }
    optional type _type = 1;
    optional uint32 _amount = 2;
    optional uint32 _param1 = 3;
}

message get_vip_gift_reply {
    optional result  _result  = 1;
}

// 聊天回复
message chat_reply {
    optional chat_say            _say                   = 1;
    optional chat_fresh          _fresh                 = 2;
    optional chat_fetch          _fetch                 = 3;
    optional chat_add_bl         _chat_add_bl           = 4;  //拉黑名单
    optional chat_del_bl         _chat_del_bl           = 5;  //解除黑名单
    optional chat_blacklist      _chat_blacklist        = 6;
    optional chat_broad_say      _chat_broad_say        = 7;
    repeated chat_fresh          _multi_fresh           = 8;  // 一次性返回多个频道数据
    optional chat_set_bubble_id  _chat_set_bubble_id    = 9;  // 聊天设置
    optional chat_contact        _chat_contact          = 10; // 联系人
    optional chat_apply_friend   _chat_apply_friend     = 11; // 申请好友
    optional chat_reject_friend  _chat_reject_friend    = 12; // 拒绝好友申请
    optional chat_add_friend     _chat_add_friend       = 13; // 添加好友
    optional chat_del_friend     _chat_del_friend       = 14; // 删除好友
    optional chat_get_friends    _chat_get_friends      = 15; // 获得所有好有
    optional chat_group_leave    _chat_group_leave      = 16; // 聊天室退出
    optional chat_search_user    _chat_search_user      = 17;
    optional chat_delete_recent  _chat_delete_recent    = 18;
    optional chat_get_unread_msg _get_unread_msg        = 19;
    optional hero                _chat_query_hero       = 20; // 查看分享英雄
    optional result              _set_gender            = 21;
    optional chat_recommend_friends  _chat_recommend_friends  = 22; // 推荐好友
    optional chat_set_blocking  _set_blocking           = 23; // 设置聊天屏蔽
    optional chat_translate      _chat_translate        = 24; // 聊天翻译
}

message chat_get_unread_msg {
    optional personal_chat _personal_chat = 1;
}

message chat_delete_recent {
    repeated chat_contact_user _chat_contact_user = 1;
}

message chat_search_user {
    optional chat_contact_user _chat_contact_user = 1;
}

enum chat_group_type {
    multi_stage_talk = 1;     // 勇者之书
    dreamland        = 2;   //梦境
    multi_arena      = 3;   //诸神
}

message chat_group_leave {
    optional result _result   = 1[default = success];
}


message chat_group_leave_info {
    optional chat_group_type _chat_group_type = 1;
    optional uint32          _chat_group_id   = 2;
    repeated chat_target     _group_user      = 3;
}


message chat_group_info {
    optional chat_group_type   _chat_group_type = 1;
    optional uint32            _chat_group_id   = 2;
    repeated chat_contact_user _group_user      = 3;
}

message chat_get_friends {
    optional result            _ret     = 1;
    repeated chat_contact_user _friends = 2;
}

message chat_recommend_friends {
  repeated chat_contact_user _recommend_friend     = 1;
}

message chat_set_blocking {

}

message chat_set_bubble_id {
    optional uint32 _result    = 1; // 设置聊天气泡结果 1、成功，0失败
    optional uint32 _bubble_id = 2;
}
message chat_contact {
    optional uint32            _version           = 1; // 版本号
    repeated chat_contact_user _chat_contact_user = 2; // 最近聊天
    repeated chat_contact_user _chat_friend       = 3; // 好友
    repeated chat_contact_user _friend_apply      = 4; // 好友申请

    optional uint32            _world_chat_times  = 5; // 世界聊天次数
    repeated chat_group_info   _chat_group_info   = 6; // 聊天室信息
    optional uint32            _group_version     = 7; // 聊天室的版本号
}

message chat_contact_user {
    optional string       _role_id            = 1; // 角色ID
    optional user_summary _user_summary       = 2; // 摘要信息
    optional uint32       _is_online          = 3; // 是否在线
    optional string       _server_name        = 4; // 服务器名字
    optional uint32       _recent_online_time = 5; // 最近上线时间
    optional uint32       _svr_id             = 6; // 服务器ID
}

message chat_blacklist_user {
    optional string       _role_id          = 1; // 角色ID
    optional user_summary _user_summary     = 2; // 摘要信息
    optional uint32       _status           = 3; //0 玩家没有被禁言, 1 玩家被禁言
    optional uint32       _svr_id           = 4; // 服务器ID
}

message chat_blacklist {
    repeated chat_blacklist_user _chat_blacklist_user = 1;
}

message chat_broad_say {
    optional result       _result   = 1;
    optional chat_channel _channel  = 2;
    repeated chat_content _contents = 3;
    optional string       _error_code = 4; // 错误码
}

message chat_say {
    optional result       _result   = 1[default = success];
    optional chat_channel _channel  = 2[default = world_channel];
    repeated chat_content _contents = 3;
    optional string       _error_code = 4; // 错误码
}

message chat_fresh {
    optional chat_channel _channel  = 1[default = world_channel];
    repeated chat_content _contents = 2;
}

message chat_acc_summary {
    optional ladder_fight_reply    _ladder_fight             = 1; // ladder切磋阵容
}

message chat_fetch {
    optional chat_channel       _channel  = 1[default = world_channel];
    optional uint32             _chat_id  = 2;
    optional chat_acc_reply     _accessory= 3;
}

message chat_acc_reply {
    enum chat_acc_t {
        binary                = 1;      // 客户端自定义数据
        pvp_replay            = 2;      // pvp比赛录像
        binary_replay         = 3;      // pve,tbc等比赛录像
        real_pvp_replay       = 5;      // 真实（蓝牙）对战录像
        real_arena_replay     = 7;      // 诸王争霸录像
        ladder_fight          = 8;      // 竞技场公会切磋
        babel_replay          = 9;      // 通天塔
        multiplayer_invite    = 10;     // 多人联机
        multi_arena_invite    = 12;     // 诸神邀请
        multi_arena_replay    = 13;     // 诸神录像
        multi_stage_invite    = 14;     // 勇者之书多人副本
        add_friend_asst       = 15;     // 请求加好友
        tbc_replay            = 16;     // 远征录像
        heroes_link           = 17;     // 英雄数据分享链接
        team_invite           = 18;     // 组队邀请
        lantern_msg           = 19;     // 走马灯消息
        dreamland_replay      = 20;     // 梦境录像
        real_arena_invite     = 21;     // 诸王邀请
    }
    optional chat_acc_t             _type                           = 1[default = binary];
    optional bytes                  _binary                         = 2; // 二进制数据，客户端发送
    optional battle_record          _replay                         = 3; // 通用战斗录像
    repeated battle_record          _real_pvp_replay                = 5;  // 真实蓝牙对战的rep
    repeated battle_record          _real_arena_replay              = 7;  // 诸王争霸replay
    optional ladder_fight_reply     _ladder_fight                   = 8;  // ladder切磋阵容
    optional battle_record          _babel_replay                   = 9;  // 通天塔replay
    repeated query_summary          _query_summary                  = 10; // 战斗结算的统计数据
    optional multiplayer_invite     _multiplayer_invite             = 11;
    optional multi_arena_battle_record  _multi_arena_battle_record  = 13; // 诸神对决的录像
    optional multi_arena_invite     _multi_arena_invite             = 14; // 诸神对决邀请
    optional multi_stage_invite     _multi_stage_invite             = 15; // 勇者之书多人副本
    optional uint32                 _tbc_stage                      = 16; // 远征关卡ID
    optional chat_hero_link         _chat_hero_link                 = 17; // 聊天分享英雄信息的链接
    optional team_invite            _team_invite                    = 18; // 组队邀请
    optional lantern_msg            _lantern_msg                    = 19; // 走马灯消息
    optional uint32                 _dreamland_stage                = 20; // 梦境Stage
}

message team_invite {
    optional team_target    _target     = 1; // 目标
    optional uint32         _team_id    = 2; // 队伍ID
}

message chat_hero_link {
    optional string _role_id      = 1 ; // 分享玩家的svrid
    repeated uint32 _heroids      = 2 ; // 分享的英雄id
}

message chat_translate {
    optional string _content  = 1;
}

message multiplayer_invite {
    optional uint32          _room_id                      = 1;    // 参数1 roomid
    optional uint32          _stage_id                     = 2;    // 参数2 stageid
    optional string          _module_type                  = 3;    // 参数3 type
}

message multi_arena_invite {
    enum invite_type {
        team = 1; //组队邀请
        room = 2; //房间邀请
    }
    optional invite_type    _invite_type    = 1;    // 参数1
    optional uint32         _id             = 2;    // 参数1
    optional uint32         _stage_id       = 3;    // 参数2
}

message multi_stage_invite {
    optional uint32          _room_id         = 1;    // 参数1
    optional uint32          _stage_id        = 2;    // 参数2
}

message ladder_fight_reply {
    optional uint32        _oppo_uid      = 1;
    repeated hero_summary  _heroes        = 2; // 英雄列表
}

message chat_content {
    optional uint32             _chat_id                = 1;
    optional string             _speaker_role_id        = 2;
    optional user_summary       _speaker_summary        = 4;
    optional string             _target_role_id         = 5;
    optional user_summary       _target_summary         = 7;
    optional uint32             _speaker_post           = 8;  //职位
    optional uint32             _speak_time             = 9;
    optional uint32             _content_type           = 10;
    optional string             _content                = 11;
    optional chat_acc_reply     _summary                = 12;
    optional uint32             _speaker_bubble_id      = 13;
    optional string             _speaker_server_name    = 14; // 服务器名字
    optional string             _target_server_name     = 15; // 服务器名字
    optional chat_group_type    _chat_group_type        = 16; // 聊天室类型
    optional uint32             _chat_group_id          = 17; // 聊天室ID
    optional gender             _speaker_gender         = 19; // 性别
}

message chat_add_bl {
    optional result       _ret  = 1;
}

message chat_del_bl {
    optional result       _ret  = 1;
}

message chat_apply_friend {
    optional result       _ret  = 1;
}

message chat_reject_friend {
    optional result       _ret  = 1;
}

message chat_add_friend {
    optional result       _ret  = 1;
    optional chat_contact_user _add_friend = 2;
}

message chat_del_friend {
    optional result       _ret  = 1;
}

// 用户聊天数据
message chat {
    optional uint32 _world_chat_times           = 1; // 本日世界聊天次数
    optional uint32 _last_reset_world_chat_time = 2; // 上次重置世界聊天时间
    repeated chat_target _black_list            = 3; // 黑名单
    repeated chat_target _friend_list           = 4; // 好友名单
    repeated chat_target _apply_list            = 5; // 申请列表
    optional uint32 _bubble_id                  = 6; // 玩家的气泡ID
}

message chat_target {
    optional string       _role_id = 1;     // 目标
}

// 公会
message user_guild {
    optional uint32         _id             = 1;
    optional string         _name           = 2;
    optional guild_job_t    _job            = 3[default = member];
    optional uint32         _req_guild_id   = 4;
    repeated uint32         _hire_hero      = 5;        //雇佣出去的英雄列表
}

message guild_reply {
    optional guild_create           _create             = 1;        // 创建公会
    optional guild_dismiss          _dismiss            = 2;        // 解散公会
    optional guild_list             _list               = 3;        // 获取公会列表
    optional guild_search           _search             = 4;        // 按条件查询公会
    optional guild_join             _join               = 5;        // 加入公会
    optional guild_join_confirm     _join_confirm       = 6;        // 加入公会确认
    optional guild_leave            _leave              = 7;        // 离开公会
    optional guild_kick             _kick               = 8;        // 踢出公会
    optional guild_set              _set                = 9;        // 设置公会信息
    optional guild_query            _query              = 10;       // 查询本公会信息
    optional guild_set_job          _set_job            = 11;       // 修改成员权限
    optional guild_add_hire         _add_hire           = 12;       // 上架雇佣英雄
    optional guild_del_hire         _del_hire           = 13;       // 下架雇佣英雄
    optional guild_query_hires      _query_hires        = 14;       // 查询公会用的雇佣英雄
    optional guild_hire_hero        _hire_hero          = 15;       // 雇佣别人的英雄
    optional guild_worship_req      _worship_req        = 16;       // 膜拜英雄
    optional guild_worship_withdraw _worship_withdraw   = 17;       // 领膜拜奖励
    optional guild_qurey_hh_detail  _query_hh_detail    = 18;       // 雇佣英雄详情查询
    optional guild_members          _guild_members      = 33; // 公会成员列表
    optional result                 _guild_send_mail_reply = 36;    // 发送公会邮件
    optional guild_query_single     _guild_query_single = 37;       // 查询单个成员信息
    optional guild_query_chair_info _guild_query_chair_info = 39;   // 查询会长信息
    optional guild_brief_list       _guild_relation_list= 42;       // 工会关系列表
    optional result                 _guild_set_relation = 43;       // 设置工会关系
    optional guild_brief_list       _guild_list_query   = 44;       // 查询工会列表
    optional result                 _set_recruit_del    = 45;       // 设置公会招募宣言
    optional guild_member_rank      _guild_member_rank  = 46;       // 成员玩法排行
}

// 公会成员玩法排行
message guild_member_rank {
    repeated ranklist_item  _ranklist_item  = 1;
}

enum relation {
    friendship = 1;
    hostility  = 2;
    colleague  = 3;
    default    = 4;
}

message guild_brief {
    optional uint32 _avatar_id  = 1;
    optional uint32 _guild_id   = 2;
    optional string _guild_name = 3;
    optional relation _relation = 4;
}

message guild_brief_list {
    repeated guild_brief _guild_brief = 1;
    optional uint32      _guild_cnt   = 2;

}

message guild_query_chair_info {
    optional uint32         _id         = 1;    //会长id
    optional string         _name       = 2;    //会长信息
}

message guild_set_tactics {
    optional result _result = 1;
}

message guild_query_tactics {
    optional string _name   = 1;
}

message guild_query_single {
    optional monthcard _monthcard = 1;
}

message guild_members {
    repeated guild_member _guild_member = 1;
}
message guild_create {
    optional result     _result     = 1;
    optional guild_info _guild_info = 2;
    repeated uint32     _frames     = 3;
    repeated uint32     _avatars    = 4;
}

message guild_dismiss {
    optional result     _result     = 1;
}

message guild_info {
    optional guild_summary  _summary    = 1;
    repeated guild_member   _members    = 2;
    repeated guild_applier  _appliers   = 3;
    optional uint32         _liveness = 4;
    optional uint32         _self_liveness = 5;
}

message guild_summary {
    optional uint32         _id         = 1;
    optional string         _name       = 2;
    optional uint32         _avatar     = 3;
    optional string         _slogan     = 4;
    optional guild_join_t   _join_type  = 5;
    optional uint32         _join_limit = 6;
    optional uint32         _member_cnt = 7;
    optional user_summary   _president  = 8;
    optional uint32         _liveness   = 9;
    optional guild_recruit_item _recruit_item = 11;
}

message guild_member {
    optional uint32         _uid                = 1;
    optional user_summary   _summary            = 2;  //简要信息
    optional guild_job_t    _job                = 3;
    optional uint32         _last_login         = 4;  //最后登入时间戳
    optional uint32         _active             = 5;  //七日贡献活跃
    optional uint32         _join_instance_time = 6;  //参加团本挑战次数
    optional uint32         _full_gs            = 8;  //总战力
    optional uint32         _is_online          = 9;  //玩家在线状态，0离线，1在线
}

message guild_applier {
    optional uint32         _uid    = 1;
    optional user_summary   _user_summary = 2;
}

message guild_list {
    repeated guild_summary  _guilds = 1;
    optional uint32         _create_cost = 2;
    optional bool           _is_in_guild = 3; // 是否在工会中
}

message guild_search {
    optional guild_summary  _guilds = 1;
}

message guild_join {
    enum join_result {
        join_enter  = 1;        //进入公会
        join_wait   = 2;        //等待批准
        join_fail   = 3;        //加入失败
    }
    optional join_result    _result         = 1;
    optional uint32         _join_guild_id  = 2;
    optional guild_info     _guild_info     = 3;
    optional uint32         _cd_time        = 4;
    optional string         _fail_reason    = 5;
}

message guild_join_confirm {
    optional result         _result     = 1;
    optional guild_member   _new_man    = 2;
}

message guild_leave {
    optional result     _result     = 1;
}

message guild_kick {
    optional result     _result     = 1;
}

message guild_set {
    optional result     _result     = 1;
    optional uint32     _diamond_cost = 2;
}

message guild_query {
    optional guild_info             _info      = 1;
    optional guild_worship          _worship   = 2;
    optional uint32                 _to_chairman = 4; //变为会长
    repeated uint32                 _frames    = 5;
    repeated uint32                 _avatars   = 6;
    optional uint32                 _last_set_name_time = 7; // 公会改名cd
}

message guild_worship {
    optional uint32             _use_times      = 1;        //今天已使用次数
    repeated worship_reward     _rewards        = 2;        //已经得到的奖励
    optional uint32             _times          = 3;        //被膜拜次数
}

message guild_set_job {
    optional result     _result     = 1;
}

message guild_add_hire {
    optional result     _result     = 1;
    optional uint32     _income     = 2;
}

message guild_del_hire {
    optional result     _result         = 1;
    optional uint32     _hire_reward    = 2;        //雇佣的奖励
    optional uint32     _stay_reward    = 3;        //守护的奖励
    optional uint32     _heroid         = 4;        //英雄ID
}

message guild_query_hires {
    repeated guild_hire_user    _users      = 1;
    repeated uint32             _hire_uids  = 2;        //已经被自己雇佣过英雄的玩家列表
    optional hire_from          _from       = 3;
}

message guild_hero_hire {
    optional string             _name       = 1;
    optional uint32             _hire_times = 2;        //工会英雄当前雇佣次数
    repeated hire_hero_summary  _heroes     = 3;        //工会英雄出租的工会英雄列表
}

message guild_hire_user {
    optional uint32             _uid          = 1;
    optional user_summary       _user_summary = 2;
    repeated hire_hero_summary  _heroes       = 3;        //玩家出租的英雄列表
}

message hire_hero_summary {
    optional hero_summary   _hero       = 1;
    optional uint32         _cost       = 2;
    optional uint32         _income     = 3;
    optional uint32         _hire_ts    = 4;
}

message guild_hire_hero {
    optional hire_result     _result     = 1;
    optional hire_from  _from       = 2;
    optional uint32     _uid        = 3;        //雇佣英雄的属主id
    optional hero       _hero       = 4;        //雇佣到英雄的数据
}

message guild_worship_req {
    optional result     _result     = 1;
}

message guild_worship_withdraw {
    optional result             _result     = 1;
    repeated reward             _rewards    = 2;        //已经得到的奖励
}

message guild_qurey_hh_detail {
    optional hero   _hero             = 1;
}

message guild_recruit_item {
    optional string  _recruit_declare = 1; // 招募宣言
    repeated uint32  _guild_tag       = 2;  // 公会tag
}


message worship_reward {
    enum type {
        gold        = 1;
        diamond     = 2;
    }
    optional type   _type   = 1;
    optional uint32 _param1 = 2;
    optional uint32 _param2 = 3;
}

enum guild_join_t {
    no_verify   = 1;        //不需要验证
    verify      = 2;        //需要验证才能加入
    closed      = 3;        //不允许加入
}

enum guild_job_t {
    chairman    = 1;
    member      = 2;
    elder       = 3;

}

// 聊天频道
enum chat_channel {
    world_channel       = 1;              // 世界频道
    guild_channel       = 2;              // 公会频道
    personal_channel    = 3;              // 私聊频道
    chatroom_channel    = 4;              // 聊天室频道
}


message cdkey_gift_reply {
    enum cdkey_result {
        success       = 0;  // 成功
        already_used  = 1;  // 已经被使用
        not_exists    = 2;  // 不存在
        once_only     = 3;  // 仅能使用一次
        invitation_code_used_success = 4; //成功输入邀请码
        input_phone_success     = 5; //输入手机成功
        bind_phone_success      = 6; //绑定手机成功
        join_bind_actvity_success = 7 ; //参加绑定手机活动成功
        bind_wechat_success = 8 ; //参加绑定手机活动成功
    }
    required cdkey_result _result   = 1;
    optional res_pack     _pack     = 2;
}

message res_pack {
    optional uint32 _money   = 1;
    optional uint32 _diamond = 2;
    repeated item   _items   = 3;
    repeated hero   _heroes  = 4;
    optional monthcard _month_card = 5;
}
// 用于客户端和服务器之间重要数据的md5校验
message important_data {
    optional double             _money                = 1;
    optional double             _rmb                  = 2;
    repeated hero               _heroes               = 3; // 排序的玩家列表
}

// 月卡
message monthcard {
    optional monthcard_type _type             = 1; // 月卡的类型
    optional uint32         _expire_time      = 2; // 此月卡的截止日期
    optional uint32         _left_days        = 3; // 冻结后的剩余时间
    optional uint32         _last_reward_time = 4; // 上次领奖时间
}


// 系统功能开关
message system_setting_reply{
    optional system_setting_change   _change = 1;

}

message system_setting_change{
    optional result _result = 1;
}

message system_setting_item{
    enum setting_status {
        on    = 1;
        off   = 2;
    }
    optional string  key = 1;
    optional setting_status value = 2;
}



message battle_check_fail {
    optional uint32 _checkid = 1;    //战斗流水号
}

message super_link {
    optional string _info = 2 ;
    optional string _addr = 1 ;
}

message ranklist_item {
    optional user_summary  _user_summary  = 1;
    optional guild_summary _guild_summary = 2;
    optional double        _param1        = 3;
    optional uint32        _param2        = 4;
    optional uint32        _param3        = 5;
    optional string        _param4        = 6;
    optional uint32        _param5        = 7;
    optional string        _param6        = 8;
}

message query_ranklist_reply {
    optional rank_type      _rank_type      = 1;
    repeated ranklist_item  _ranklist_item  = 2;
    optional uint32         _self_ranking   = 3;
    optional ranklist_item  _self_item      = 4;
    optional uint32         _self_prev_pos  = 5;
}


message request_guild_log_reply{
    repeated guild_log _guild_log = 1;
}

message guild_log{
    optional uint32 _id = 1;
    repeated string _params = 2;
    optional uint32  _time = 3;
}

message client_update_version{
    optional uint32     _version = 1;
}

message query_act_stage_reply{
    repeated uint32     _opened_act_stage = 1;      // 开启的活动关卡列表
    optional uint32     _user_left_time   = 2;      // 玩家剩余次数
}

// 实时对战 begin
enum pvp_rule {
    bo1 = 1;
    bo3 = 2;
    bo5 = 3;
}

enum pvp_errorcode {
    success = 0; // 默认成功
    rival_not_exists = 1; // 对手不存在
    choose_hero_deny = 2; // 当前不可以选择英雄
    deselect_hero_deny = 3; // 当前不可以取消选择英雄
    choose_hero_num_limit = 4; // 选择英雄个数超出上限
    hero_already_used = 5; // 英雄已经被使用过
    rival_conn_closed = 6; // 对手连接断开
    rival_in_challenge = 7; // 对手正在挑战中
    req_timeout = 8; // 请求超时
    rival_not_ready_select = 9; // 对手未准备好选择英雄
    hero_invalid = 10;
    bp_operate_deny = 11; // 当前不可以bp
    hero_already_banned = 12; // 英雄已经被禁用
    hero_already_picked = 13; // 英雄已经被选择
    hero_bp_invalid     = 14; // 英雄bp错误
}

// 若拒绝， 仅通知挑战者
// 若接受， 双方都会收到 包含对手信息的
message pvp_match_result {
    optional uint32            _is_accepted        = 1; // 对方是否接受 1 接受/ 0 拒绝
    optional string            _rt_room_addr       = 2; // 实时对战房间服务器地址 ip:port
}

message pvp_enter_room_reply{
    optional result                     _result             = 1;
    optional uint32                     _is_host            = 4; //是否为主机  1 是 / 0 不是
    optional pvp_rule                   _rule               = 5; // 赛制
    optional uint32                     _udp_port           = 6; // 服务器的udp端口号
    optional real_arena_room_user_info  _host_info          = 7; // 诸王争霸主场玩家信息
    optional real_arena_room_user_info  _guest_info         = 8; // 诸王争霸客场玩家信息
}

message hero_select_begin_reply{
    optional uint32             _turn                     = 1; // 是否轮到当前玩家选择，1是，0不是
    optional uint32             _time_first_round         = 2; // 首轮选择英雄的时间
    optional uint32             _select_count             = 3; // 首轮选择英雄的个数
}

message hero_select_opponent {
    optional hero           _hero_selected            = 1; // 对手选择的英雄
}

message hero_deselect_opponent {
    optional uint32         _hero_deselected         = 1; // 对手取消选择的英雄
}

message hero_select_round_end_reply {
    optional uint32             _turn                      = 1; // 是否轮到当前玩家选择，1是，0不是
    optional uint32             _step                      = 2; // 下一轮当前局第几次选择
    optional uint32             _time_round                = 3; // 下一轮剩余选择时间
    optional uint32             _select_count              = 4; // 下一轮选择英雄的个数
    optional uint32             _cur_select_count          = 5; // 断线重连时,服务器告知客户端这轮已经选了几个英雄
    repeated hero               _heroes_host               = 6; // 主机当前已选择的英雄完整列表
    repeated hero               _heroes_slave              = 7; // 挑战者当前已选择的英雄完整列表
}

message battle_start_countdown {
    optional uint32             _time_countdown          = 1; // 战斗开始倒数时间
    repeated hero               _heroes_host             = 2; // 主机英雄完整列表
    repeated hero               _heroes_slave            = 3; // 挑战者英雄完整列表
    optional int32              _round                   = 4; // 1, 2, 3
    optional uint32             _rseed                   = 5; // 随机种子
    optional battle_bonus       _host_bonus              = 6; // 主机战斗加成
    optional battle_bonus       _slave_bonus             = 7; // 挑战者战斗加成
}


message pvp_ban_notify{
    repeated uint32         _banned_hero_id          = 1; //对手禁用的英雄
}

message pvp_pick_notify{
    repeated hero           _picked_hero_id          = 1; //对手选择的英雄
}

enum pvp_bp_operate_type {
    ban         = 0;
    pick        = 1;
}

message pvp_bp_begin_notify{
    enum role {
        host = 1;
        guest = 2;
    }
    optional role                       _turn                     = 1; // 轮到当前操作的玩家
    optional uint32                     _bp_round                 = 2; // 当前bp轮次
    optional bool                       _is_host                  = 3; // 是否是主机
    optional uint32                     _operate_time             = 4; // 操作时间
    optional uint32                     _select_count             = 5; // 选择英雄的个数
    optional pvp_bp_operate_type        _operate_type             = 6; // 操作类型
    repeated real_arena_hero_info       _host_picked              = 7; // 主机当前选择英雄
    repeated real_arena_hero_info       _guest_picked             = 8; // 挑战者当前选择英雄
    repeated real_arena_hero_info       _host_banned              = 9; // 主机当前禁用英雄
    repeated real_arena_hero_info       _guest_banned             = 10; // 挑战者当前禁用英雄
    optional uint32                     _backup_time              = 11; // bp备用时间
    repeated uint32                     _used_heroes              = 12; // 已经上场过的英雄id
    optional uint32                     _host_win_cnt             = 13; // 主场胜场数
    optional uint32                     _guest_win_cnt            = 14; // 客场胜场数
}

message pvp_bp_end_notify{
    optional uint32                     _count_down_time          = 1; // 操作时间
    repeated real_arena_hero_info       _host_picked              = 2; // 主机当前选择英雄
    repeated real_arena_hero_info       _guest_picked             = 3; // 挑战者当前选择英雄
    repeated real_arena_hero_info       _host_banned              = 4; // 主机当前禁用英雄
    repeated real_arena_hero_info       _guest_banned             = 5; // 挑战者当前禁用英雄
}

message pvp_heart_resp{
    optional uint32 _server_time = 1;
    optional uint32 _oppo_lag    = 2; // 对手的延迟
}

message sync_operation{
    optional uint32 _tick     = 1;
    repeated uint32 _self_ops = 2;        // 自己操作
    repeated uint32 _oppo_ops = 3;        // 对方操作
}

message sync_operations{
    optional uint32 _cur_tick     = 1;     // 服务器的最新一帧
    repeated sync_operation _ops  = 2;     // 有操作的帧
}

message sync_acks{
    repeated uint32 _ticks = 1;
}

message pvp_device_info {
    optional uint32     _user_id          = 1; // 玩家id
    optional string     _device_id        = 2; // 玩家设备信息
    optional user_summary   _summary          = 3; // 玩家简要信息，
}

message pvp_challenge_notify {
    optional pvp_device_info  _challenger_info    = 1;  // 挑战者名字
    optional pvp_rule         _pvp_rule           = 2; // 挑战类型
}

message pvp_new_round_start {
  optional uint32           _new_round_id     = 1; // 新一轮id
}

message pvp_round_end_reply {
    optional battle_result  _result           = 1 [default = victory];
    optional int32          _next_round       = 2; // 0表示已经没有下一轮了
    optional int32          _win_times        = 3;  // 总胜利次数
    optional int32          _is_final_winner  = 4; // 是否是整场比赛的胜利者
    optional uint32         _check_id         = 5;    //战斗流水号
    optional uint32         _svr_id           = 6;    //战斗服务器id
}

message register_device_reply {
    repeated pvp_device_info  _near_list = 1; // 附近的玩家列表
}

message pvp_round_reset{
}

message pvp_select_ready_reply {
    enum role {
        host = 1;
        guest = 2;
    }
    optional role                       _turn                     = 1; // 轮到当前操作的玩家
    optional bool                       _is_host                  = 2; // 是否是主机
    optional uint32                     _select_time              = 3; // 选择英雄的时间
    optional uint32                     _select_count             = 4; // 选择英雄的个数
    optional pvp_bp_operate_type        _operate_type             = 5; // 操作类型
    optional uint32                     _backup_time              = 6; // bp备用时间
    repeated uint32                     _used_heroes              = 7; // 已经上场过的英雄id
    optional uint32                     _host_win_cnt             = 8; // 主场胜场数
    optional uint32                     _guest_win_cnt            = 9; // 客场胜场数
}

message pvp_chat_msg_reply {
    enum chat_result {
        success         = 0;
        frequency_limit = 1;
    }
    optional chat_result _result  = 1;
    optional string _device_id    = 2;
    optional string _role_id      = 3; // 角色码
    optional string _chat_data    = 4; // 聊天内容
}

message reconnect_msg_reply{
    enum rtpvp_status {
        wait_enter              = 1;
        wait_select_ready       = 2;
        wait_hero_bp            = 3;
        wait_hero_bp_end        = 4;
        wait_count_down         = 5;
        battle                  = 6;
        wait_round_reset        = 7;
    }
    optional rtpvp_status                _status            = 1;
    optional pvp_bp_begin_notify         _bp_info           = 2;
}

message real_pvp {
    optional pvp_errorcode                     _err_code                      = 1;
    optional register_device_reply             _reg_device_reply              = 2; // 服务器返回可以匹配的附近玩家
    optional pvp_challenge_notify              _pvp_challenge_notify          = 3; // 通知xx向你发起挑战，是否接受
    optional pvp_match_result                  _pvp_match_result              = 4; // 挑战匹配结果
    optional pvp_enter_room_reply              _pvp_enter_room_reply          = 5; // 进入对战房间回复
    optional pvp_select_ready_reply            _pvp_select_ready_reply        = 6; // 准备选择英雄回复
    optional hero_select_opponent              _hero_select_opponent          = 7; // 通知对手选了某个英雄
    optional hero_deselect_opponent            _hero_deselect_opponent        = 8; // 通知对手取消选择某个英雄
    optional hero_select_round_end_reply       _hero_select_round_end_reply   = 9; // 本轮英雄确认回复
    optional battle_start_countdown            _battle_start_countdown        = 10; // 战斗倒计时开始
    optional pvp_new_round_start               _pvp_new_round_start           = 11; // 每轮开始的提示
    optional sync_operations                   _sync_operations               = 12; // 战斗同步
    optional sync_acks                         _sync_acks                     = 13; // 战斗同步回复
    optional pvp_round_end_reply               _round_end_reply               = 14; // 回合结束，战斗校验结果
    optional pvp_heart_resp                    _pvp_heart_resp                = 15; // 心跳报文
    optional pvp_round_reset                   _pvp_round_reset               = 16; // 重置
    optional pvp_chat_msg_reply                _pvp_chat_msg_reply            = 17; // 聊天的协议
    optional reconnect_msg_reply               _reconnect_msg_reply           = 18; // 重新连接后，获取房间最新消息(目前适用于选英雄)
    optional pvp_ban_notify                    _pvp_ban_notify                = 19; // 通知对手禁用的英雄
    optional pvp_pick_notify                   _pvp_pick_notify               = 20; // 通知对手选择的英雄
    optional pvp_bp_begin_notify               _pvp_bp_begin_notify           = 21; // 通知bp阶段开始
    optional pvp_bp_end_notify                 _pvp_bp_end_notify             = 22; // 通知bp阶段结束
}
// 实时对战 end


message ask_pred_stage_reply {
    repeated uint32 stage_id = 1;  // 预言之池ID
}

message realtime_notify_reply {
    optional result                 _rtnotify_register_result   = 1;
    optional rtnotify_keepalive     _rtnotify_keepalive_reply   = 2;  // 心跳包回应
}

message rtnotify_keepalive {
    optional uint32     _time = 1; // 心跳发送时间
}

// 永生梦境
message dreamland_reply {
    optional dreamland_open_panel                _open_panel        = 1;
    optional dreamland_start_battle              _start_battle      = 2;
    optional dreamland_end_battle                _end_battle        = 3;
    optional dreamland_buy_chance                _buy_chance        = 4;
    optional dreamland_summary                   _summary           = 5;
    optional dreamland_error_code                _err_code          = 6;
    optional result                              _set_video_status  = 7;
    optional dreamland_battle_record             _battle_record     = 8;
    optional query_replay                        _query_replay      = 9;
    repeated query_summary                       _query_summary     = 10;
    optional dreamland_calendar                  _calendar          = 11;
}

message dreamland_open_panel {
    optional dreamland_summary _summary          = 1; // 简要信息
    optional uint32            _left_chance      = 2; // 剩余挑战次数，关卡未开启时undefine
    optional uint32            _top_damage       = 3; // 玩家当前最高伤害
    optional uint32            _current_rank     = 4; // 玩家当前排名
    optional uint32            _times            = 5; // 已购买的次数
    optional bool              _rank_act_open    = 6; // 排名活动是否开启
    repeated uint32            _available_heroes = 7; // 可以使用的英雄ID
}

message dreamland_start_battle {
    optional result     _result     = 1[default = success];
    optional uint32     _rseed      = 2;
    optional uint32     _bt_st      = 3;
}

message dreamland_end_battle {
    optional battle_result _result           = 1;
    optional uint32        _current_rank     = 2;     // 玩家当前排名
    optional uint32        _previous_rank    = 3;     // 这次战斗前的排名
    optional uint32        _current_damage   = 4;     // 当前的最高伤害
    optional user_summary  _milestone_player = 5;     // 获得更高等级奖励需要超越的玩家数据
    optional uint32        _milestone_rank   = 6;     // 获得更高等级奖励需要超越的玩家排名
    optional uint32        _milestone_damage = 7;     // 获得更高等级奖励需要超越的玩家伤害
    optional uint32        _global_rank      = 8;     // 全服排行
}

message dreamland_buy_chance {
    optional result _result         = 1 [default = success];
    optional uint32 _times          = 2;        // 已购买的次数
}

enum dreamland_error_code {
    success = 1;
    no_stage_info = 2;
    not_in_battle_period = 3;
    no_stage_count = 4;
    lineup_hero_duplicate = 5;
    lineup_hero_toomany = 6;
    not_in_rank_period = 7;
    update_rank_error = 8;
    lineup_hero_invalid = 9;
    battle_check_fail = 10;
    money_not_enough = 11;
    buy_limit_error = 12;
    limit_by_level = 13;
}

message dreamland_summary {
    optional uint32         _current_stage       = 1; // 当前boss关卡ID
    optional uint32         _start_time      = 2; // 关卡开启时间
    optional uint32         _end_time            = 3; // 关卡结束时间
    optional uint32         _disappear_time      = 4; // 活动关闭时间
}

message dreamland_battle_record {
    repeated dreamland_record _records = 1;
}

message dreamland_record {
    optional uint32         _stage_id   = 1; // 编号
    optional user_summary   _summary    = 2; // 目标信息
    optional uint32         _bt_time    = 3; // 战斗时间
    optional battle_result  _bt_result  = 4; // 战斗结果
    optional uint32         _damage     = 5; // 伤害
    optional uint32         _replay_id  = 6; // 战斗录像ID
    repeated hero           _heroes     = 7; // 英雄信息
}

message dreamland_calendar {
    repeated dreamland_calendar_summary _summary = 1; // 梦境关卡信息
}

message dreamland_calendar_summary {
    optional uint32         _stage_id    = 1; // boss关卡ID
    optional uint32         _start_time  = 2; // 关卡开启时间
}

//商店切换
message shop_switch_reply{
    optional uint32 _shop_id = 1;//商店切换后的商店Id
}

// 诸王争霸
message real_arena_reply {
    optional real_arena_open_panel             _open_panel                      = 1; // 打开面板
    optional real_arena_match_reply            _match_reply                     = 2; // 匹配对手回应
    optional real_arena_match_result           _match_result                    = 3; // 匹配对手结果
    optional real_arena_cancel_match_result    _cancel_match_result             = 4; // 取消匹配对手回复
    optional real_arena_achievement            _achievement                     = 5; // 竞技模式数据
    optional real_arena_hero_info_list         _hero_info_list                  = 6; // 英雄信息
    optional real_arena_record_info            _record_info                     = 7; // 记录信息
    optional real_arena_replay_info            _replay_info                     = 8; // 录像信息
    optional real_arena_check_network          _check_network                   = 9; // 网络测速
    optional real_arena_battle_result          _battle_result                   = 10; // 一场比赛的结果
    optional real_arena_error_code             _err_code                        = 11; // 错误码
    optional real_arena_guild_info             _guild_info                      = 12; // 公会成员信息
    optional real_arena_challenge_reply        _challenge_reply                 = 13; // 挑战回应
    optional real_arena_challenge_cancel       _cancel_result                   = 14; // 挑战取消结果通知
    optional real_arena_challenge_notify       _challenge_notify                = 15; // 挑战请求通知
    optional real_arena_challenge_result       _challenge_result                = 16; // 挑战请求结果
    optional real_arena_open_task_panel        _open_task_panel                 = 17; // 任务面板请求结果
    optional real_arena_job_rewards            _job_rewards                     = 18; // 诸王任务领取奖励
    optional real_arena_open_shop_panel        _open_shop_panel                 = 19; // 打开诸王商店面板
    optional real_arena_buy_goods              _buy_goods                       = 20; // 购买商品

    optional real_arena_room                   _room                            = 22; // 房间匹配
    optional real_arena_team_start_reply       _team_reply                      = 23; // 队伍匹配回复
    optional real_arena_team_start_notify      _team_notify                     = 24; // 队伍匹配通知
    optional uint32                            _query_local_rank                = 25; // 查询本地排名
    optional real_arena_grade_rewards          _grade_rewards                   = 26; // 诸王段位领取奖励
}

enum real_arena_type {
    athletics     = 1;    // 竞技模式
    casual        = 2;    // 休闲模式
}

message real_arena_open_panel {
    optional real_arena_season_info          _season_info                = 1; // 赛季信息
    optional real_arena_rank_info            _my_rank_info               = 2; // 竞技模式排名信息
    optional real_arena_public_hero          _public_hero                = 3; // 公共英雄信息
    optional real_arena_level_rank           _level_rank                 = 4; // 英雄等级和品阶
    optional uint32                          _points                     = 5; // 诸王币
    repeated real_arena_buy_history          _buy_history                = 6; // 玩家购买的道具列表
    repeated real_arena_task                 _tasks                      = 7; // 诸王任务
    repeated real_arena_grade                _grade_reward_flags         = 8; // 段位奖励领取标志
    optional uint32                          _max_score                  = 9; // 最高积分
    optional uint32                          _block_time                 = 10; // 天梯匹配屏蔽时间戳
}

message real_arena_season_info {
    optional uint32                         _index                  = 1; // 赛季序号
    optional uint32                         _time_start             = 2; // 开始时间
    optional uint32                         _time_end               = 3; // 结束时间
    optional uint32                         _casual_mode            = 4; // 是否开放休闲模式，0不开放，1开放
    optional uint32                         _athletics_mode         = 5; // 是否开放竞技模式，0不开放，1开放
    optional string                         _name                   = 6; // 赛季名称
}

message real_arena_season_reward_info {
    optional uint32                         _level_id_limit       = 1; // 排名等级ID限制
    repeated real_arena_season_reward       _rewards              = 2; // 奖励
}

message real_arena_season_reward {
    enum reward_type{
        gold        = 1;
        diamond     = 2;
        item        = 3;
    }
    optional uint32             _id                     = 1; // 奖励ID
    optional reward_type        _type                   = 2; // 类型
    optional uint32             _amount                 = 3; // 数量
}

message real_arena_rank_info {
    optional uint32             _level_id                      = 1; // 排名等级ID
    optional uint32             _score                         = 2; // 积分
    optional uint32             _casual_victory_count          = 3; // 休闲模式胜场数
    optional uint32             _point                         = 4; // 积分赛积分
}

message real_arena_public_hero {
    optional uint32             _start_time            = 1;
    optional uint32             _end_time              = 2;
    repeated uint32             _heroes                = 3;
    repeated uint32             _legend_equips         = 4;
}

message real_arena_level_rank {
    optional uint32             _level            = 1; // 等级
    optional uint32             _rank             = 2; // 品阶
}

message real_arena_match_reply {
    optional result                            _result         = 1; // 是否可以进入匹配流程
    optional real_arena_error_code             _err_code       = 2; // 错误码
}

message real_arena_match_result {
    optional result                 _result         = 1; // 匹配结果
    optional string                 _room_addr      = 2; // 实时对战房间服务器地址 svr#ip:port
    optional uint32                 _room_id        = 3; // 房间序号
    optional string                 _device_id      = 4; // 用户唯一标识
}

message real_arena_room_user_info {
    optional uint32                     _id                    = 1;
    optional user_summary               _summary               = 2;
    optional string                     _server_name           = 3; // 所在服务器名称
    optional real_arena_rank_info       _rank_info             = 4; // 排名信息
    repeated real_arena_hero_info       _heroes                = 5; // 英雄简介
}

message real_arena_cancel_match_result {
    optional result              _result                     = 1; // 取消匹配结果
}

enum real_arena_victory_type {
    full     = 1; // 完胜
    quick    = 2; // 速胜
    straight = 3; // 全胜
}

message real_arena_achievement {
    optional uint32                 _arena_score            = 1; // 王者积分
    optional uint32                 _match_time             = 2; // 匹配次数
    optional uint32                 _victory_time           = 3; // 胜利次数
    optional real_arena_hero        _mvp_hero               = 4; // MVP英雄
    repeated real_arena_hero        _frequently_used_hero   = 5; // 常用英雄
}

message real_arena_hero {
    optional uint32     _id               = 1;
    optional uint32     _match_time         = 2; // 出场次数
    optional uint32     _victory_time       = 3; // 胜利次数
    optional uint32     _damage             = 4; // 场均伤害
    optional uint32     _kill               = 5;  //场均击杀
}

message real_arena_hero_info_list {
    repeated real_arena_hero_info   _hero_infos = 1;
}
message real_arena_hero_info {
    optional uint32         _id            = 1;
    optional uint32         _gs            = 2; // 战斗力
    optional uint32         _star          = 3;
    optional uint32         _fashion       = 4; // 皮肤ID
    optional hero_legend_equip   _legend_equip  = 5; // 传奇装备
}

message real_arena_record_info {
    repeated real_arena_record  _records = 1;
}

message real_arena_record{
    optional uint32 _user_id            = 1;
    optional user_summary _summary      = 2;        //简要信息
    optional string     _svr_name       = 3;
    optional uint32 _deta_rank          = 4;        //玩家等级
    optional uint32 _bt_time            = 5;        //战斗时间
    optional battle_result  _bt_result  = 6;        //战斗结果
    optional uint32 _record_index       = 7;        //战斗记录ID
    optional uint32 _active             = 8;        //是否主动方
    optional bool   _is_audience        = 9;        //是否观众
    optional uint32 _score              = 10;       // 旧积分
    optional uint32 _new_score          = 11;       // 新积分
}

message real_arena_check_network {
    optional uint32 _time_ping = 1;
}

enum real_arena_error_code {
    success =  1;
    pvp_room_undefined =      2; // 对战服务器未配置
    match_process_confilict = 3; // 已存在一个匹配进程了
    pvp_rule_invalid        = 4; // 不合法的匹配模式
    heroes_not_enough       = 5; // 英雄数量不足
    season_not_found        = 6; //  赛季没有开发
    athletics_not_open      = 7; // 竞技模式在指定时间开放
    level_not_reach         = 8; // 未达到指定等级
    user_not_in_guild       = 9; // 玩家未加入公会
    oppo_in_battle          = 10; // 对手正在对战流程中
    oppo_heroes_not_enough  = 11; // 对手英雄数量不足
    self_be_challenged      = 12; // 自己处于被挑战状态
    expire_challenge        = 13; // 过期的挑战
    in_oppo_blacklist       = 14; // 你已被对方屏蔽
    result_unknow           = 15; // 结果未出来
    battle_past             = 16; // 战斗已过时
    oppo_offline            = 17; // 对手不在线
    in_challenged_status    = 18; // 处于挑战状态，无法发起匹配
    self_poor_network       = 19; // 你的网络不佳，无法发起匹配
    oppo_poor_network       = 20; // 对手的网络不佳，取消本次匹配
    match_process_already   = 21; // 已经开始匹配了
    matched_in_battle       = 22; // 正在战斗中，请稍后再匹配
    act_as_brush            = 23; // 连续三次断线或退出游戏，请过稍后重试
    task_not_found          = 24; // 没有找到这个任务
    point_not_enough        = 25; // 领奖条件不满足
    hero_already_five_star  = 26; // 英雄已经五星
    hero_already_awake      = 27; // 英雄已经觉醒
    hero_already_have       = 28; // 已经拥有该英雄
    level_not_reached       = 29; // 等级未达到
    not_apply_period        = 30; // 非报名时间
    room_not_exsits         = 31; // 房间不存在
    already_in_room         = 32; // 已经在房间里面了,不能创建或进入房间
    expire_realaren_room    = 33; // 房间已过期
    not_enough_room         = 34; // 房间拥挤, 请稍后再试
    version_not_match       = 35; // 你和房主版本号不对应
    room_in_battle          = 36; // 房间已经对战中
    reach_max_point_match_count = 37; // 积分赛匹配达到20次
    not_illegal_playoffs_stage = 38; //当前非积分赛匹配阶段
    grade_already_rewarded  = 39; // 段位奖励已领取
    grade_not_reach         = 40; // 还没达到该段位
}

enum real_arena_result_reason {
    normal            = 1;
    opponent_off_line = 2;
    opponent_quit     = 3;
    opponent_cheat    = 4;
}

message real_arena_battle_result {
    optional battle_result              _result             = 1;
    optional real_arena_rank_info       _rank_before        = 2; // 战斗之前的排名信息
    optional real_arena_rank_info       _rank_after         = 3; // 战斗之后的排名信息
    optional uint32                     _winning_streak     = 4; // 连胜场数，1表示胜利一场，2表示胜利两场，依次类推
    optional real_arena_result_reason   _reason             = 5; // 战斗结果原因
    optional uint32                     _oppo_score_before  = 6; // 战斗之前对手积分
    optional uint32                     _oppo_score_after   = 7; // 战斗之后对手积分
}

message real_arena_replay_info {
    repeated battle_record      _record             = 1;
    optional pvp_rule           _rule               = 2;
    optional battle_result      _result             = 3;
    repeated query_summary      _summary            = 4; // 战斗简报
    repeated real_arena_ban_list    _self_ban       = 5;
    repeated real_arena_ban_list    _oppo_ban       = 6;
    optional string             _host_role_id       = 7; // 主场的role id
    optional bool               _is_audience        = 8; // 是否是观众
}

message real_arena_ban_list{
    repeated uint32         _hero_id        = 1;
}

message real_arena_guild_info {
    repeated real_arena_challenge_user       _guild_members = 1;
}

message real_arena_challenge_reply {
    optional result                          _result    = 1;
    optional real_arena_error_code           _err_code  = 2;
    optional uint32                          _valid_time = 3; // 挑战有效期限

}

message real_arena_challenge_cancel {
    optional result                    _result     = 1;
}

message real_arena_challenge_user {
    optional uint32                 _id                    = 1;
    optional user_summary           _summary               = 2;
    optional string                 _server_id             = 3;
    optional string                 _server_name           = 4; // 所在服务器名称
    optional uint32                 _connection_status     = 5; // 玩家在线状态，0离线，1在线
}

enum real_arena_challenge_type {
    guild            = 1; // 公会挑战
    lbs              = 2; // 附近挑战
    playoffs         = 3; // 季后赛
}

message real_arena_challenge_notify {
    optional real_arena_challenge_user  _challenger         = 1; // 挑战者信息
    optional pvp_rule                   _pvp_rule           = 2; // 挑战赛制
    optional real_arena_challenge_type  _type               = 3; // 挑战类型
    optional uint32                     _valid_time         = 4; // 挑战有效期限
}

message real_arena_challenge_result {
    optional result                    _result     = 1;
    optional real_arena_challenge_user _oppo       = 2;
    optional string                    _room_addr  = 3; // 实时对战房间服务器地址 ip:port
    optional uint32                    _room_id    = 4; // 房间序号
    optional string                    _device_id  = 5; // 用户唯一标识
}

message real_arena_open_task_panel {
    repeated real_arena_task    _tasks  = 1; // 诸王任务
}

message real_arena_task {
    optional uint32         _job_id     = 1; // 任务ID
    optional uint32         _cfg_id     = 2; // 任务配置ID
    optional uint32         _task_target= 3; // 任务进度
}

message real_arena_job_rewards {
    optional result                          _result    = 1;
    optional real_arena_error_code           _err_code  = 2;
}

message real_arena_grade_rewards {
    repeated reward                          _rewards   = 1;
    optional real_arena_grade                _grade     = 2;
    optional result                          _result    = 3;
    optional real_arena_error_code           _err_code  = 4;
}

enum real_arena_goods_type{
    star    = 1;
    awake   = 2;
    hire    = 3;
}

message real_arena_open_shop_panel {
    optional uint32                            _points        = 1; // 玩家代币总量
    repeated real_arena_goods                  _goods         = 2; // 商品
    repeated real_arena_buy_history            _buy_history   = 3; // 购买历史
}

message real_arena_goods {
    optional real_arena_goods_type  _type  = 1; // 商品ID
    optional uint32                 _price = 2; // 商品价格
}

message real_arena_buy_goods {
    optional result                          _result     = 1;
    optional real_arena_error_code           _err_code   = 2;
    optional uint32                          _next_price = 3;
}

message real_arena_buy_history {
    optional real_arena_goods_type  _type    = 1;
    optional uint32                 _hero_id = 2;
    optional uint32                 _amount  = 3;
}

message real_arena_room {
    optional real_arena_room_create _create_room = 1; // 开房
    optional real_arena_room_enter  _enter_room  = 2; // 进入房间
    optional real_arena_room_ready  _ready       = 3; // 准备
    optional real_arena_room_cancel _cancel      = 4; // 取消
    optional real_arena_room_reconnect   _reconnect   = 5; // 重连
}

message real_arena_room_create {
    optional uint32             _room_id        = 1;
    optional uint32             _expire_time    = 2;
    optional pvp_rule           _pvp_rule       = 3; // 赛制选择
}

message real_arena_room_enter {
    optional real_arena_room_info _room_info      = 1;
}

message real_arena_room_ready {
    optional real_arena_room_info      _room_info  = 1;
    optional string                    _room_addr  = 2; // 实时对战房间服务器地址 svrid#ip:port
    optional uint32                    _room_id    = 3; // 房间序号
    optional string                    _device_id  = 4; // 用户唯一标识
}
message real_arena_room_cancel {
    optional result                    _result     = 1;
}

message real_arena_room_info {
    enum room_status {
        wait_guest   = 1;
        wait_confirm = 2;
        onbattle     = 3;
    }
    optional uint32                    _room_id      = 1;
    optional room_status               _status       = 2;
    optional pvp_rule                  _pvp_rule     = 3;
    optional real_arena_room_user      _host         = 4;
    optional real_arena_room_user      _guest        = 5;
    optional uint32                    _host_ready   = 6;
    optional uint32                    _guest_ready  = 7;
    optional uint32                    _expire_time  = 8; // 房间当前状态有效期限
}

message real_arena_room_user {
    optional uint32                 _server_id             = 1;
    optional uint32                 _user_id               = 2;
    optional user_summary           _summary               = 3;
    optional string                 _server_name           = 4; // 所在服务器名称
    optional uint32                 _score                 = 5; // 积分
}

message real_arena_room_reconnect {
    optional real_arena_room_info      _room_info  = 1;
    optional string                    _room_addr  = 2; // 实时对战房间服务器地址 svrid#ip:port
    optional uint32                    _room_id    = 3; // 房间序号
    optional string                    _device_id  = 4; // 用户唯一标识
}

message real_arena_team_start_reply {
    optional result     _result     = 1;
}

message real_arena_team_start_notify {
    optional string                    _room_addr  = 1; // 实时对战房间服务器地址 svrid#ip:port
    optional uint32                    _room_id    = 2; // 房间序号
    optional string                    _device_id  = 3;
    optional pvp_rule                  _pvp_rule   = 4;
}

///////////////////////////////////////////

message update_backdoor_reply {
    optional uint32       _version  = 1;
    optional bytes        _data     = 2; // 二进制数据
}

//////////////////////////////////////////////////////////////////////
message test_battle_check_reply {
    optional battle_result _result = 1 [default = victory];
}

message migrate_reply {
    optional migrate_open_panel_reply           _migrate_open_panel_reply  =   1; // 打开转服界面 获取服务器列表
    optional migrate_check_reply                _migrate_check_reply       =   2;
    optional migrate_opration_reply             _migrate_opration_reply    =   3; // 转服
}

message migrate_open_panel_reply {
    optional uint32      _self_svrid  = 1;
    repeated server_info _server_list = 2;
    optional uint32      _left_time   = 3;
    optional uint32      _open_wait_time = 4; // 开启等待时间（秒）

}

message migrate_check_reply {
    enum check_result {
        success        = 0;
        need_privilege = 1;
    }
    optional check_result _result = 1;
}
message migrate_opration_reply {
    enum type {
        normal                  = 0;    // 转服操作
        privilege               = 1;    // 使用特权转服
        normal_kick_exsits      = 2;    // 不论目标服有没有用户, 强制转服
        privilege_kick_exsits   = 3;
    }

    enum mresult {
        success        = 0;
        fail           = 1;
        user_exists    = 2;    // 失败 因为玩家存在 此处是为了给用户提示 玩家可选择 ignore_exists 来屏蔽这种结果
    }

    optional type    _type  = 1;
    optional mresult _mresult = 2;
}


enum server_status {
    idle    = 0;    // 可转
    full    = 1;    // 爆满
}

message server_info {
    optional uint32        _server_display_id = 1;
    optional uint32        _server_id         = 2;
    optional string        _server_name       = 3;
    optional string        _server_ip         = 4;
    optional server_status _server_status     = 5;
}

message migrate_info {
    optional uint32        _server_display_id = 1;
    optional string        _user_name         = 2;

}

message consume_exp_items_reply {
    optional result     _result = 1 [default = fail];
    optional hero       _hero   = 2;        // 成功则返回完整信息，失败则无效
}

message medal_reply {
    optional medal_open_panel_reply  _open_panel = 1; // 打开徽章界面
    optional medal_set_medal_reply   _set_medal  = 2; // 设置徽章
}

message medal_task_info {
    optional uint32        _medal_id = 1; // 徽章ID
    optional uint32        _progress = 2; // 当前进度
    optional uint32        _target   = 3; // 目标
}

message medal_open_panel_reply {
    repeated medal_item _medal_item         = 1; // 徽章
    repeated medal_task_info _task_list          = 2; // 进度
}

message medal_set_medal_reply {
    optional  result    _result = 1; // 结果
}

message remote_setting_reply {
    optional get_remote_items _get_remote_items = 1; // 获取远程的头像和徽章
    optional result           _set_remote_item  = 2; // 设置远程的头像和徽章
}

message get_remote_items {
    repeated uint32 _avatar_ids       = 1;
    repeated uint32 _avatar_frame_ids = 2;
    repeated medal_item _medal_item   = 3;
}

message multiplayer_battle_reply {
    optional string                      _error_code      = 1;    // 错误码
    optional multiplayer_roominfo        _roominfo        = 2;    // 创建房间
    optional result                      _register        = 3;    // 注册玩家
    optional multiplayer_enterroom       _enterroom       = 4;    // 进入房间
    optional multiplayer_exitroom        _exitroom        = 5;    // 退出房间
    optional multiplayer_playerinfos     _roomchange      = 6;    // 状态变换
    optional uint32                      _heart           = 7;    // 心跳发送的时间
    optional multiplayer_hero_select     _hero_select     = 8;    // 选择英雄
    optional multiplayer_enterbattle     _enterbattle     = 9;    // 进入战斗
    optional multiplayer_synchronization _synchronization = 10;   // 同步帧
    optional multiplayer_sync_acks       _sync_acks       = 11;   // 确认帧
    optional multiplayer_end_battle      _end_battle      = 12;   // 结束战斗
    optional result                      _start_match     = 13;   // 多人对战匹配
    optional result                      _cancel_match    = 14;   // 取消匹配
    optional multiplayer_prepare         _prepare         = 15;   // 功能准备检查
    optional bool                        _open_check      = 16;   // 是否开启检查
    optional multiplayer_chat            _chat            = 17;   // 聊天
    optional multiplayer_matchchange     _matchchange     = 18;   // 匹配模式改变
    optional multiplayer_playagain       _playagain       = 19;   // 再来一局
}

message multiplayer_roominfo {
    optional string      _room_addr   = 1; // 房间地址
    optional uint32      _room_id     = 2; // 房间ID
}


message multiplayer_playerinfo {
    enum role{
        host        = 1; //房主
        invitee     = 2; //被邀请的人
        matched     = 3; //匹配的人
    }
    optional user_key               _deviceid           = 1;
    optional user_summary           _user_summary       = 2;
    optional uint32                 _top_arena_gs       = 3;
    optional string                 _server_name        = 4; // 所在服务器名称
    optional role                   _role               = 5; // 角色,host是房主
    optional bool                   _is_ready           = 6; // 是否准备
    repeated hero                   _heroes             = 7; // 参加战斗的英雄
    repeated warschool_book         _warschool_books    = 8;  // 对手的战争学院技能信息
    optional uint32                 _bookreading_level  = 9;
    optional battle_bonus           _bonus              = 10; // 战斗加成
}

message multiplayer_enterroom {
    enum room_status {
        wait_player      = 1;  // 等待玩家进入
        wait_select_hero = 2;  // 等待玩家选择英雄
        start_battle     = 3;  // 开始战斗
    }
    repeated multiplayer_playerinfo _playerinfo     = 1;    // 当前房间玩家的信息
    optional room_status            _room_status    = 2;    // 房间状态
    optional uint32                 _left_time      = 3;    // 剩余时间（秒）
    optional bool                   _match_stranger = 4;    // 是否允许匹配路人
}

message multiplayer_playerinfos {
    repeated multiplayer_playerinfo _playerinfo   = 1;    // 当前房间玩家的信息
}

message multiplayer_exitroom {
    optional result     _result                 = 1;    // 结果
    optional string     _reason                 = 2;    // 退出原因
}

message multiplayer_hero_select {
    enum select_operartion {
        addhero  = 1;
        delhero  = 2;
        ready    = 3;
        unready  = 4;
    }
    optional select_operartion     _state        = 1;    // 操作码
    optional user_key              _deviceid     = 2;
    optional uint32                _index        = 3;    // 槽号
    optional hero                  _hero         = 4;    // 英雄
}

message multiplayer_enterbattle {
    optional uint32                     _stage          = 1;    // 关卡ID
    optional uint32                     _rseed          = 2;    // 随机数
    optional multiplayer_roominfo       _roominfo       = 3;    // UDP房间信息
    optional multiplayer_playerinfos    _playerinfos    = 4;    // 玩家信息
    optional uint32                     _bt_st          = 5;    // 战斗开始时间
}

message multiplayer_synchronization {
    optional uint32                  _cur_tick   = 1;     // 服务器的最新一帧
    repeated battle_operations       _operations = 2;
}

message multiplayer_sync_acks {
    repeated uint32     _ticks  = 1;
}

message multiplayer_end_battle {
    optional battle_result _result = 1[default = victory];
    optional uint32        _damage = 2;
    optional uint32        _check_id         = 3;    //战斗流水号
    optional uint32        _svr_id           = 4;    //战斗服务器id
}

message multiplayer_prepare {
    optional result  _result   = 1;
    optional uint32  _stage_id = 2;
    optional string  _module_type = 3;
    optional uint32  _unlock_left_time = 4;
}

message multiplayer_chat {
    optional user_key             _deviceid = 1;
    optional string               _content  = 2;
}

message multiplayer_matchchange {
    optional bool   _match_stranger    = 1; // 是否能匹配路人
}

message multiplayer_playagain {
    optional uint32      _stage_id      = 1; //
    optional string      _module_type   = 2; //
    optional uint32      _room_id       = 3; // 房间ID
    optional string      _room_addr     = 4; // 房间地址
    optional bool        _is_create     = 5; // 是否是创建者
    optional uint32      _chat_groupid  = 6; // 聊天室ID
}


message monster_reply {
    optional monster_open_panel_reply         _monster_open_panel            = 1;
    optional monster_node_info                _monster_scan_node_reply       = 2;
    optional monster_start_battle_reply       _monster_start_battle_reply    = 3;
    optional monster_damage_info              _monster_end_battle_reply      = 4;
    optional monster_chance_info              _monster_buy_chance_reply      = 5;
    repeated monster_draw_rewards_info        _monster_draw_rewards_reply    = 6;
    repeated monster_rankboard_info           _monster_rankboard_reply       = 7;
    optional monster_error_code               _monster_error_code            = 8;
}

enum monster_error_code {
    success                = 1;
    refresh_lunar_beast    = 2;  // 刷新面板
    battle_not_found       = 3;  // 战斗未开始
    battle_chance_out      = 4;  // 战斗次数用尽
    monster_node_not_found = 5;  // 年兽点未扫描
    battle_check_fail      = 6;  // 战斗校验失败
    lunar_beast_not_open   = 7;  // 年兽未开启
    lineup_hero_duplicate  = 8;  // 阵容重复英雄
    lineup_hero_invalid    = 9;  // 英雄不存在
    lineup_hero_toomany    = 10; // 英雄太多
    scan_not_cooldown      = 11; // 冷却中
    node_not_found         = 12; // 节点不存在
    user_not_join_guild    = 13; // user not join guild
    rmb_not_enough         = 14; // 钻石不足
    buy_limit_reach        = 15; // 购买到达上限
    chance_left            = 16; // 还有未用次数
    could_not_draw         = 17; // 不能领奖
}

message monster_rankboard_info {
    optional user_summary _user_summary = 1;
    optional uint32       _damage       = 2;
}

message monster_open_panel_reply {
    repeated monster_node_info   _nodes   = 1;
    optional monster_damage_info _last_damage  = 2;
    optional uint32              _last_op = 3;
    optional monster_chance_info _chance  = 4;
    optional monster_damage_info _cur_damage  = 5;
    optional uint32              _end_time = 6;
    optional uint32              _monster_node = 7;
}

message monster_damage_info {
    optional uint32 _damage = 1;
    optional uint32 _id     = 2;
}

message monster_chance_info {
    optional uint32 _used  = 1;
    optional uint32 _limit = 2;
    optional uint32 _buy   = 3;
}

message monster_node_info {
    optional uint32 _node_id    = 1;
    optional uint32 _tip_id     = 2;
    repeated string _tip_args   = 3;
    optional uint32 _is_monster = 4; //0 false; 1 true
}

message monster_start_battle_reply {
    optional uint32 _rseed = 1;
}


message monster_draw_rewards_info {
    optional uint32 _itemid = 1;
    optional uint32 _count  = 2;
}

message lantern_reply {
    repeated lantern_msg _msg = 1;
}

message lantern_msg {
    optional uint32       _msg_id  = 1;  // 消息ID
    optional lantern_user _user_a  = 2;  // 消息结构体主体
    repeated string       _params  = 3;  // 消息填充字段
    optional uint32       _time    = 4;  // 消息产生时间
}

message lantern_user {
    optional uint32    _guild_id   = 1;  // 公会ID
    optional string    _guild_name = 2;  // 公会名称
    optional uint32    _user_id    = 3;  // 玩家ID
    optional string    _user_name  = 4;  // 玩家名称
    optional medal_item _medal     = 5;  // 徽章
}


//诸神对决
message multi_arena_reply {
    optional string                                 _error_code       = 1;    // 错误码
    optional multi_arena_open_panel_reply           _open_panel       = 2;    // 诸王2v2
    optional multi_arena_create_team_reply          _create_team      = 3;    // 创建队伍
    optional multi_arena_enter_team_reply           _enter_team       = 4;    // 加入队伍
    optional multi_arena_team_info                  _team_info        = 5;    // 队伍信息（含玩家信息）
    optional multi_arena_room_info_notice           _room_notice      = 6;    // 房间信息（含玩家信息）
    optional multi_arena_create_room_reply          _create_room      = 7;    // 创建房间
    optional multi_arena_query_room_reply           _query_room       = 8;    // 查询房间地址
    optional multi_arena_enter_room_reply           _enter_room       = 9;    // 加入房间
    optional multi_arena_match_reply                _match            = 10;   // 匹配
    optional multi_arena_cancel_match_reply         _cancel_match     = 11;   // 取消匹配
    optional multi_arena_heart_reply                _heart            = 12;   // 心跳发送的时间
    optional multi_arena_enter_battle_reply         _enter_battle     = 13;   // 进入战斗
    optional multi_arena_synchronization_reply      _synchronization  = 14;   // 同步帧
    optional multi_arena_sync_acks_reply            _sync_acks        = 15;   // 确认帧
    optional multi_arena_end_battle_reply           _end_battle       = 16;   // 结束战斗
    optional multi_arena_set_hero_cards_reply       _set_hero_cards   = 17;   // 队伍预设
    optional multi_arena_set_magic_cards_reply      _set_magic_cards  = 18;   // 法术预设
    optional multi_arena_chat_reply                 _chat             = 19;   // 聊天
    optional multi_arena_achievement_reply          _achievement      = 20;   // 查询战绩
    optional multi_arena_record_reply               _record           = 21;   // 查询记录
    optional multi_arena_replay                     _replay           = 22;   // 查询录像
    optional multi_arena_ask_heroes_reply           _ask_heroes_reply = 23;   // 英雄数据
    optional multi_arena_fetch_result_reply         _fetch_result     = 24;   // 拉取结果
    optional multi_arena_ask_books_reply            _ask_books_reply  = 25;   // 拉取学院技能
    optional multi_arena_match_succeed_reply        _match_succeed    = 26;   // 匹配成功
    optional multi_arena_be_kicked_reply            _be_kicked        = 27;   // 被踢出房间
    optional multi_arena_exit_reply                 _exit             = 28;   // 离开房间
    optional multi_arena_ask_lords_reply            _ask_lords        = 29;   // 获取领主信息
    optional multi_arena_buy_goods                  _buy_goods        = 30;   // 购买物品
}

message multi_arena_deviceid {
    optional uint32 _svr_id = 1; // 服务器ID
    optional uint32 _uid    = 2; // 玩家ID
    optional uint32 _key    = 3; // ID标识
}

message multi_arena_open_panel_reply {
    repeated uint32                     _heroes                 = 1; // 预设队伍
    repeated uint32                     _magics                 = 2; // 预设法术
    optional multi_arena_season_info    _season_info            = 3; // 赛季信息
    optional uint32                     _rank                   = 4; // 排名
    optional uint32                     _score                  = 5; // 积分
    optional uint32                     _athletics_win_count    = 6; // 竞技胜场
    optional uint32                     _casual_win_count       = 7; // 休闲胜场
    optional uint32                     _mt_point               = 8; // 诸神荣耀代币
    repeated multi_arena_buy_history    _buy_history            = 9; // 荣耀代币购买商品列表
}

message multi_arena_season_info {
    optional uint32   _index                  = 1; // 赛季序号
    optional uint32   _time_start             = 2; // 开始时间
    optional uint32   _time_end               = 3; // 结束时间
    optional uint32   _athletics_mode         = 4; // 是否开放竞技模式，0不开放，1开放
    optional uint32   _daily_start            = 5; // 开始的时间，秒数
    optional uint32   _daily_end              = 6; // 结束的时间，秒数
}

message multi_arena_create_team_reply {
    optional uint32 _team_id = 1; // 队伍ID
}

enum multi_arena_mode {
    athletics = 1; // 竞技
    casual    = 2; // 休闲
    test      = 3; // 内部用
}

message multi_arena_enter_team_reply {
    optional multi_arena_mode _arena_mode = 1; // 竞技类型
    optional uint32 _team_id = 2; // 队伍ID
    optional multi_arena_team_info _team_info = 3; // 队伍信息
}

message multi_arena_team_info {
    enum multi_arena_team_state {
        normal = 1; // 正常
        closed = 2; // 解散
        matching = 3; // 匹配中
    }

    optional multi_arena_team_state  _team_state = 1; // 队伍状态
    repeated multi_arena_memberinfo _memberinfo  = 2; // 当前队伍玩家的信息
}

message multi_arena_memberinfo {
    optional multi_arena_deviceid  _key            = 1;
    optional user_summary   _user_summary   = 2;
    optional uint32         _top_arena_gs   = 3;
    optional bool           _is_ready       = 4; // 是否准备
    optional bool           _is_leader      = 5; // 是否队长
    optional uint32         _elo            = 6; // elo
}

message multi_arena_room_info_notice {
    optional multi_arena_room_info  _room_info  = 1; // 房间消息
}

message multi_arena_ask_heroes_reply {
    optional multi_arena_device_heroes   _device_heroes   = 1;
}

message multi_arena_device_heroes {
    optional multi_arena_deviceid   _deviceid             = 1;
    repeated hero                   _heroes               = 2;
}

message multi_arena_room_info {
    enum multi_arena_room_step {
        wait_player     = 1; // 准备阶段
        wait_req_data   = 2; // 拉取资源
        wait_lord       = 3; // 选首领
        countdown       = 4; // 倒计时
        battle          = 5; // 战斗中
        closed          = 6; // 房间关闭
        battle_end      = 7; // 等待结果
    }

    optional uint32                 _seq        = 1; // 有效操作序号：维护最新的，小于当前的值则舍弃
    optional multi_arena_room_step  _room_step  = 2; // 房间状态
    repeated multi_arena_playerinfo _playerinfo = 3; // 当前房间玩家的信息
    optional multi_arena_room_camp  _host       = 4; // 主机阵营
    optional multi_arena_room_camp  _guest      = 5; // 客机阵营
    repeated uint32                 _host_ops   = 6; // 自己操作
    repeated uint32                 _guest_ops  = 7; // 自己操作
    optional uint32                 _left_time  = 8; // 基地选择倒计时
    optional uint32                 _rseed      = 9; // 对战随机种子
}

message multi_arena_room_camp {
    repeated uint32                 _lord_ids      = 1;
    optional uint32                 _cfm_lord_id   = 2;
    optional uint32                 _lord_index    = 3;
}

message multi_arena_playerinfo {
    optional multi_arena_deviceid   _deviceid           = 1;
    optional multi_arena_index      _player_index       = 2; // 玩家在房间的位置
    optional user_summary           _user_summary       = 3;
    optional string                 _server_name        = 4; // 所在服务器名称
    optional uint32                 _top_arena_gs       = 5;
    optional uint32                 _point              = 6;
    optional uint32                 _victory_count      = 7;
    optional bool                   _is_ready           = 8; // 是否准备
    optional bool                   _is_ok              = 9; // 是否资源获取完成
    repeated uint32                 _magics             = 10; // 使用的法术
    repeated uint32                 _hero_ids           = 11;
    optional uint32                 _bookreading_level  = 12;
    optional uint32                 _defense_id         = 13; // 基地id
    optional bool                   _is_confirm         = 14; // 是否确认基地选择
    optional bool                   _is_init_over       = 15; // 是否进入场景
    optional uint32                 _network_lag        = 16; // 玩家网络延时
    optional uint32                 _fca_load_progress  = 17; // 资源将在进度
    optional string                 _plat               = 18; //平台名称
    optional uint32                 _show_server_id     = 19;   //显示的服务器id
}

message multi_arena_index {
    enum role {
        host = 1;
        guest = 2;
    }
    enum pos {
        first   = 1;
        second  = 2;
    }
    optional role   _role  = 1;
    optional pos    _pos   = 2;
}

message multi_arena_create_room_reply {
    optional uint32                 _key        = 1; // 玩家ID标识
    optional string                 _room_addr  = 2; // 房间地址
    optional uint32                 _room_id    = 3; // 房间ID
}

enum multi_arena_room_mode {
    match_mode  = 1; // 组队匹配
    custom_mode = 2; // 自定义
}

message multi_arena_enter_room_reply {
    optional multi_arena_mode             _arena_mode = 1; // 竞技类型
    optional multi_arena_room_mode              _room_mode  = 2; // 房间类型
    optional multi_arena_room_info  _room_info  = 3; // 房间消息
}

message multi_arena_match_reply {
    optional result _result = 1; // 0 failure , 1 success
}

message multi_arena_cancel_match_reply {
    optional result _result = 1; // 0 failure , 1 success
}

message multi_arena_heart_reply {
    optional uint32                     _heart          = 1;    // 心跳
}

message multi_arena_enter_battle_reply {
    optional uint32                     _stage          = 1;    // 关卡ID
    optional uint32                     _rseed          = 2;    // 随机数
    optional multi_arena_room_info      _room_info      = 3;    // UDP房间信息
    optional uint32                     _bt_st          = 4;    // 战斗开始时间
}

message ops {
    optional uint32                 _ops        = 1; //操作信息
    optional uint32                 _ops_extra  = 2; //操作扩展信息
}

message multi_arena_synchronization_reply {
    optional uint32                  _cur_tick   = 1;     // 服务器的最新一帧
    repeated sync_operation          _operations = 2;     // 有操作的帧
}

message multi_arena_sync_acks_reply {
    repeated uint32 _ticks  = 1;
}

message multi_arena_end_battle_reply {
    optional battle_result          _result        = 1[default = victory];
    optional uint32                 _check_id      = 2;    //战斗流水号
    optional uint32                 _svr_id        = 3;    //战斗服务器id
    optional uint32                 _point_before  = 4;
    optional uint32                 _point_after   = 5;
    optional uint32                 _combo_victory = 6;
    optional uint32                 _combo_count   = 7;
    repeated multi_arena_task       _tasks         = 8;
}
message multi_arena_task {
    optional uint32                        _task_id       = 1;
    optional uint32                        _task_target   = 2;
}

message multi_arena_set_hero_cards_reply {
    optional result _result = 1; // 0 failure , 1 success
}

message multi_arena_set_magic_cards_reply {
    optional result _result = 1; // 0 failure , 1 success
}

message multi_arena_chat_reply {
    optional multi_arena_deviceid _deviceid = 1;
    optional string               _content  = 2;
}

message multi_arena_hero {
    optional uint32     _id                 = 1;
    optional uint32     _match_time         = 2; // 出场次数
    optional uint32     _victory_time       = 3; // 胜利次数
    optional uint32     _damage             = 4; // 场均伤害
    optional uint32     _kill               = 5;  //场均击杀
}

message multi_arena_achievement_reply {
    optional uint32                 _arena_score            = 1; // 王者积分
    optional uint32                 _match_time             = 2; // 匹配次数
    optional uint32                 _victory_time           = 3; // 胜利次数
    repeated multi_arena_hero       _frequently_used_hero   = 4; // 常用英雄
}

message multi_arena_record{
    optional multi_arena_mode                _arena_mode = 1; // 竞技类型
    optional multi_arena_room_mode                 _room_mode  = 2; // 房间类型
    optional uint32                    _bt_time    = 3;  //战斗时间
    repeated multi_arena_record_player _players    = 4;
    optional multi_arena_index         _self_index = 5;
    optional uint32                    _bt_svr_id  = 6;
    optional uint32                    _battle_id  = 7;
    optional battle_result             _result      = 8 [default = victory];
}
message multi_arena_record_player {
    optional multi_arena_index         _self_index      = 1;
    optional string                    _plat            = 2;        //平台名称
    optional uint32                    _show_server_id  = 3;        //显示的服务器id
    optional string                    _svr_name        = 4;
    optional user_summary              _user_summary    = 5;
}

message multi_arena_record_reply {
    repeated multi_arena_record  _records = 1;
}

message multi_arena_replay {
    optional multi_arena_battle_record      _record     = 1;
    optional multi_arena_index              _self_index  = 2;
}

message multi_arena_query_room_reply {
    optional uint32                 _key        = 1; // 玩家ID标识
    optional string                 _room_addr  = 2; // 房间地址
    optional uint32                 _room_id    = 3; // 房间ID
}

message multi_arena_battle_record{
    optional uint32 _checkid       = 1;
    optional uint32 _userid        = 2;
    optional multi_arena_battle_record_team   _host_team         = 3;
    optional multi_arena_battle_record_team   _guest_team        = 4;
    optional uint32                   _rseed             = 5;
    optional battle_result                   _result            = 6 [default = victory];
}
message multi_arena_battle_record_team {
    repeated multi_arena_battle_record_player _players    = 1;
    optional uint32                   _lord_index = 2;
    optional hero                     _lord       = 3;
    repeated tick_ops                 _ops        = 4;
}
message tick_ops {
    optional uint32                     _tick       = 1;
    repeated uint32                     _ops        = 2;
}
message multi_arena_battle_record_player {
    optional uint32              _team_index         = 1;
    optional user_summary        _user_summary       = 2;
    optional string              _svr_name           = 3;
    repeated warschool_book      _warschool_books    = 4;
    optional uint32              _bookreading_level  = 5;
    repeated hero                _heroes             = 6;
    repeated uint32              _magics             = 7;
    optional battle_bonus        _bonus              = 8; // 战斗加成
}

message multi_arena_fetch_result_reply {
    optional battle_result _result       = 1;
    optional uint32        _point_before = 2;
    optional uint32        _point_after  = 3;
}

message multi_arena_ask_books_reply {
    optional multi_arena_device_books   _device_books   = 1;
}

message multi_arena_device_books {
    optional multi_arena_deviceid   _deviceid             = 1;
    repeated warschool_book         _books                = 2;  // 对手的战争学院技能信息
    optional battle_bonus           _bonus                = 3; // 战斗加成
}

message multi_arena_ask_lords_reply {
    optional multi_arena_role_lords _lords  = 1;
}

message multi_arena_role_lords {
    enum role {
        host = 1;
        guest = 2;
    }
    optional role   _role    = 1;
    repeated hero   _heroes  = 2;
}

message multi_arena_match_succeed_reply {
    optional uint32                 _key        = 1; // 玩家ID标识
    optional string                 _room_addr  = 2; // 房间地址
    optional uint32                 _room_id    = 3; // 房间ID
}
message multi_arena_be_kicked_reply {
    optional result _result = 1; // 0 failure , 1 success
}

message multi_arena_exit_reply {
    optional result _result = 1; // 0 failure , 1 success
}

message multi_arena_buy_goods {
    optional result                          _result     = 1;
}

enum multi_arena_goods_type{
    star_3_to_5  = 1;
    star_4_to_5  = 2;
    enhance      = 3;
    hire         = 4;
}

message multi_arena_buy_history {
    optional multi_arena_goods_type                 _goods_type    = 1;
    optional uint32                                 _hero_id     = 2;
}

message query_guild_members_reply {
    repeated query_guild_members _members = 1;
}

//英雄培养引导
message herohot_reply {
    optional hh_open_panel_reply        _open_panel         = 1;  // 打开面板
    optional hh_hot_hero_reply          _hot_hero           = 2;  // 查看热点英雄
    optional hh_top_hero_reply          _top_hero           = 3;  // 查看最强英雄
    optional hh_fav_add_reply           _fav_add            = 4;  // 添加到收藏夹
    optional hh_fav_del_reply           _fav_del            = 5;  // 清理收藏夹
    optional hh_query_exceed_reply      _query_exceed       = 6;  // 查询超越千分比
    optional hh_stage_recommend_reply   _stage_recommend    = 7;  // 关卡推荐
    optional hh_team_recommend_reply    _team_recommend     = 8;  // 队伍推荐
    optional hh_latest_recommend_reply  _latest_recommend   = 9;  // 最近通关（如种族塔推荐阵容）
    optional hh_hot_recommend_reply     _hot_recommend      = 10; // 热门阵容推荐
    optional hh_lineup_recommend_reply  _lineup_recommend   = 11; // 阵容推荐
}

//热点英雄
message hh_hero {
    optional uint32     _heroid     = 1; // 英雄ID
    optional uint32     _hot        = 2; // 热度
    optional uint32     _flag       = 3; // =1表示新英雄
}

//玩法推荐
message hh_recommend {
    optional uint32     _gameplay   = 1; // 玩法
    repeated uint32     _heroids    = 2; // 英雄ID列表
}

//大神阵容
message hh_lineup {
    optional uint32         _gameplay   = 1; // 玩法
    optional uint32         _stageid    = 2; // 团本或者梦境的stage
    optional uint32         _rank       = 3; // 玩法的排名
    optional uint32         _score      = 4; // 玩法的分数
    optional user_summary   _user       = 5; // 玩家摘要
    repeated hero_summary   _heros      = 6; // 英雄摘要
}

//通关阵容
message clearance_lineup {
    optional uint32         _gameplay       = 1; // 玩法
    optional uint32         _stageid        = 2; // 关卡
    optional user_summary   _user           = 3; // 玩家摘要
    repeated hero_summary   _heros          = 4; // 英雄摘要
    optional uint32         _svrid          = 5; // 服务器id
    optional uint32         _replay_id      = 6; // 录像ID（0=不显示录像）
    optional string         _plat           = 7; // 平台名称
    optional uint32         _show_server_id = 8; // 显示的服务器id
}

message hh_open_panel_reply {
    repeated hh_hero        _heros      = 1; // 英雄列表
    repeated hh_recommend   _recommends = 2; // 推荐列表
}

message hh_hot_hero_reply {
    optional hh_hero        _hero       = 1; // 热点英雄
    optional uint32         _self_gs    = 2; // 我的战力
    optional uint32         _exceed     = 3; // 超过千分比
    optional bool           _in_fav     = 4; // 是否已经收藏
    repeated uint32         _tags       = 5; // 标签【数组】
    repeated hh_lineup      _lineups    = 6; // 大神阵容【数组】
}

message hh_top_hero_reply {
    optional uint32         _heroid         = 1; // 热点英雄
    optional uint32         _self_gs        = 2; // 我的战力
    optional uint32         _top_gs         = 3; // 最强战力
    optional user_summary   _top_user       = 4; // 最强玩家
    optional uint32         _top_rank       = 5; // 最强玩家竞技场排名
}

message hh_fav_add_reply {
    repeated uint32 _heroids = 1; //加入的英雄的ID数组
}

message hh_fav_del_reply {
    repeated uint32 _heroids = 1; //删除的英雄的ID数组
}

message hh_query_exceed_reply {
    optional uint32 _exceed = 1; //超过千分比
    optional uint32 _gs     = 2; //战斗力
}

message hh_stage_recommend_reply {
    optional uint32       _gameplay   = 1; // 玩法
    optional uint32       _stageid    = 2; // 关卡
    repeated uint32       _heroids    = 3; // 英雄ID列表
}

message hh_team_recommend_reply {
    repeated hh_lineup      _lineups    = 1; // 大神阵容【数组】
}

message hh_latest_recommend_reply {
    repeated clearance_lineup     _clearance_lineup    = 1; //通关阵容
}

message hh_hot_recommend_reply {
    optional uint32     _gameplay   = 1; // 玩法
    optional uint32     _stageid    = 2; // 关卡
    repeated lineup     _lineups    = 3; // 阵容
}

message hh_lineup_recommend_reply  {
    optional uint32             _gameplay       = 1; // 玩法
    optional uint32             _stageid        = 2; // 关卡
    repeated hh_stage_lineup    _stage_lineups   = 3; // 关卡阵容
}

message hh_stage_lineup {
    optional uint32         _stars      = 1; // 通关星数
    optional uint32         _gs         = 2; // 战力
    repeated herohot_lineup_hero   _heros  = 3; // 英雄摘要
}

message herohot_lineup_hero{
    optional uint32               _tid         = 1;
    optional uint32               _rank        = 2; // 英雄阶级
    optional uint32               _level       = 3; // 英雄等级
    optional uint32               _stars       = 4; // 进化等级
}

// 个人主页
message personal_home_page_reply {
    optional personal_home_page _personal_home_page = 1;
    optional result             _set_signature      = 2;
    optional result             _set_honor_wall     = 3;
    optional personal_home_page _req_home_page      = 4;
    optional hero               _req_hero           = 5;
    optional string             _error_code         = 6;
}

message personal_home_page {
    optional uint32          _uid               = 1;
    optional user_summary    _user_summary      = 2;
    optional uint32          _hero_cnt          = 3;
    optional uint32          _total_hero_gs     = 4;
    optional string          _guild_name        = 5;
    optional uint32          _svr_id            = 6;
    optional string          _region            = 7;
    optional uint32          _region_id         = 8;
    optional string          _svr_name          = 9;
    optional string          _signature         = 10;
    repeated honor_wall_item _honor_wall        = 11;
    repeated uint32          _achievement_cup   = 12; // 成就杯
    optional uint32          _fashoins          = 13; // 皮肤数量
}

message video_reply {
    optional video_data    _video_data    = 1;
    optional barrage_data  _barrage_data  = 2;
    optional result        _send_barrage  = 3;
    optional video_summary _video_summary = 4;
}

enum battle_type {
    single_pve = 1;
    single_pvp = 2;
    multi_pve  = 3;
    multi_pvp  = 4;
}

enum battle_module {
    dreamland = 1;
}

message video_data {
    optional uint32            _id               = 1;
    optional battle_type       _battle_type      = 2;
    optional battle_module     _battle_module    = 3;
    optional uint32            _rseed            = 4;
    repeated hero              _heroes           = 5;
    repeated video_user        _video_user       = 6;
    repeated battle_user       _battle_user      = 7;
    repeated battle_operations _multi_ops        = 8;
    repeated operation         _single_ops       = 9;
    optional uint32            _stage_id         = 10;
    repeated hero              _oppo_heroes      = 11;
    repeated video_user        _oppo_video_user  = 12;
    repeated battle_user       _oppo_battle_user = 13;
    optional uint32            _timestamp        = 14;
    optional string            _version          = 15;
    optional uint32            _scene_buff       = 16; // 场景BUFF

}

message barrage_data {
    optional uint32   _id          = 1;
    optional uint32   _barrage_cnt = 2;
    repeated barrage  _content     = 3;
    repeated barrage_user_info   _user_map = 4;
}

message barrage_user_info {
    optional user_key   _user_key   = 1;
    optional user_summary   _user_summary   = 2;
    optional uint32     _barrage_count  = 3;
}

message video_summary {
    optional uint32         _id              = 1;
    optional battle_type    _battle_type     = 2;
    optional battle_module  _battle_module   = 3;
    repeated video_user     _video_user      = 4;
    repeated hero_summary   _heroes          = 5;
    repeated video_user     _oppo_video_user = 6;
    repeated hero_summary   _oppo_heroes     = 7;
    optional uint32         _play_cnt        = 8;
    optional uint32         _barrage_cnt     = 9;
    optional uint32         _scene_buff       = 10; // 场景BUFF
}

message video_user {
    optional user_key     _user_key     = 1;
    optional user_summary _user_summary = 2;
}

message onekey_sweep_loot {
    optional uint32     _stage_id = 1; // 关卡ID
    optional uint32     _times    = 2; // 扫荡次数
    repeated sweeploot  _loots    = 3; // 掉落
}

message onekey_sweep_stage_reply {
    enum result_type {
        success          = 0;   // 成功
        task_limit       = 1;   // 二觉任务限制
        lack_of_vitality = 2;   // 体力不足
        lack_of_ticket   = 3;   // 扫荡券不足
        no_stage         = 4;   // 没有可扫荡关卡
    }
    optional result_type        _result     = 1;
    repeated onekey_sweep_loot  _loots      = 2; // 掉落
    repeated item               _items      = 3; // 额外掉落道具
}

// achievement start

message achievement_reply {
    optional achievement_open_panel_reply             _open_panel       = 1;    //打开成就面板
    optional achievement_require_rewards_reply        _require_rewards  = 2;    //请求成就奖励
    optional achievement_point_rewards_reply          _point_rewards    = 3;    //请求成就点奖励
}
message achievement_task {
    enum achievement_type {
        Player      = 0;                   //个人成就
        Hero        = 1;                   //英雄成就
        Guild       = 2;                   //工会成就
        Festival    = 3;                   //活动成就
        Dungeon     = 4;                   //副本成就
        Event       = 5;
    }
    optional uint32             _line_id        = 1;      //成就链id
    optional achievement_type   _type           = 2;      //成就类型
    optional uint32             _id             = 3;      //成就id
    optional uint32             _progress       = 4;      //每个小成就的进度
    optional uint32             _reward_time    = 5;      //领奖的时间
    optional uint32            _done_time      = 6;      //完成时间
}


message achievement_open_panel_reply {
    optional uint32             _point          = 1;      //成就点数
    optional uint32             _total          = 2;      //成就总数
    optional uint32             _progress       = 3;      //总的成就进度
    repeated achievement_task   _tasks          = 4;      //多个成就任务
    repeated uint32             _take_point_reward = 5;   // 已获取的成就点奖励
    repeated uint32             _cups           = 6;      // 杯数
}

message achievement_require_rewards_reply {
    repeated reward _rewards =1;
}

message achievement_point_rewards_reply {
    repeated reward _rewards = 1;
}
// achievement end

message binding_reply {
    optional binding_code_reply       _code       = 1; // 验证码
    optional binding_submit_reply     _submit     = 2; // 提交绑定
}

message binding_code_reply {
    optional result _result = 1;
}

message binding_submit_reply {
    optional result     _result     = 1;
    repeated reward     _rewards    = 2; // 奖励
}

message user_binding {
    optional bool   _has_bound      = 1; // 是否已经绑定
}


// 世界杯（新）
message world_cup_reply {
    optional wc_open_panel_reply      _open_panel   = 1; // 打开面板
    optional wc_bet_team_reply        _bet_team     = 2; // 押注队伍

    optional string                   _error_code   = 9; // 错误代码
}

message wc_user_team {
    optional uint32     _id             = 1; // 队伍ID
    optional bool       _win            = 2; // 是否胜利
    optional uint32     _odds_rate      = 3; // 赔率,乘100之后的值
    optional uint32     _support_rate   = 4; // 支持率,乘100之后的值
    optional uint32     _bet_counter    = 5; // 下注筹码
}

message wc_user_match {
    enum status {
        wait        = 1; // 等待中，可以投注
        matching    = 2; // 比赛中
        matched     = 3; // 已经比完了
    }
    optional string         _id             = 1; // 比赛ID
    optional status         _status         = 2; // 状态
    optional uint32         _start_time     = 3; // 开始时间戳
    repeated wc_user_team   _team_list      = 4; // 队伍列表
}

message wc_open_panel_reply {
    repeated wc_user_match  _match_list     = 1; // 比赛列表
    optional uint32         _own_counter    = 2; // 拥有的筹码
}

message wc_bet_team_reply {
    optional string         _match_id       = 1; // 队伍ID
    optional uint32         _team_id        = 2; // 队伍ID
    optional uint32         _counter        = 3; // 下注筹码
    optional uint32         _remain_counter = 4; // 剩余筹码
}


// 重返战场,全新回归系统
message goback_reply {
    optional goback_open_panel_reply        _open_panel         = 1; // 打开面板
    optional goback_once_reward_reply       _once_reward        = 2; // 领取一次性奖励
    optional goback_login_reward_reply      _login_reward       = 3; // 登录阶段奖励
    optional goback_buy_goods_reply         _buy_goods          = 4; // 购买商品
    optional goback_task_line_reward_reply  _task_line_reward   = 5; // 任务阶段奖励

    optional string                     _error_code     = 21; // 错误码
}


// 重返战场福利
message goback_bonus {
    optional uint32     _id      = 1; // ID
    optional int32      _used    = 2; // 已经使用的次数
}

message goback_goods {
    optional   uint32  _goods_id = 1; // 商品ID
    optional   uint32  _buy_time = 2; // 购买时间
}

// 玩家的goback信息
message user_goback {
    optional uint32         _act_id             = 1; // 活动ID，0=不再活动中
    optional uint32         _active_time        = 2; // 参与活动的开始时间
    optional bool           _once_reward_flag   = 3; // 一次性奖励领取标记,true=已领取
    repeated uint32         _login_reward_flags = 4; // 登录阶段性奖励领取标记，[true,false,false,...]，true=已领取
    optional uint32         _login_day_acc      = 5; // 累计登录天数
    repeated goback_goods   _goods_buy_flags    = 6; // 商品购买标记
    repeated goback_bonus   _bonus_list         = 7; // 福利数据列表
    optional uint32         _task_line_progress = 8; // 任务阶段进度
    repeated uint32         _task_line_reward_flags     = 9; // 任务阶段奖励标志
    optional bool           _view_flag          = 10; // 首次信封展示
    optional uint32         _left_days          = 11; // 离开天数
}

message goback_open_panel_reply {
    optional user_goback    _goback             = 1; // 活动数据
}

message goback_once_reward_reply {
    repeated reward     _rewards    = 1; // 奖励
}

message goback_login_reward_reply {
    optional uint32     _index      = 1; // 奖励索引
    repeated reward     _rewards    = 2; // 奖励
}

message goback_buy_goods_reply {
    optional uint32     _goods_id   = 1; // 商品ID
    repeated reward     _rewards    = 2; // 奖励
    optional uint32     _cost       = 3; // 消耗
}

message goback_task_line_reward_reply {
    optional uint32     _index      = 1; // 奖励索引
    repeated reward     _rewards    = 2; // 奖励
}

// 自走棋
message chess_reply {
    optional chess_open_panel_reply       _open_panel     = 1; // 打开面板
    optional chess_match_start_reply      _match_start    = 2; // 开始匹配
    optional chess_match_cancel_reply     _match_cancel   = 3; // 取消匹配
    optional chess_resolve_rookie_reply   _resolve_rookie = 4; // 跳过引导
    optional chess_rookie_start_reply     _rookie_start   = 5; // 开始新手引导
    optional chess_rookie_finish_reply    _rookie_finish  = 6; // 完成新手引导
    optional chess_weekly_reward_reply    _weekly_reward  = 7; // 周常奖励
    optional chess_grade_reward_reply     _grade_reward   = 8; // 段位奖励

    optional string                       _error_code     = 21; // 错误码
}

// 自走棋游戏状态
enum chess_game_status {
    free            = 0; // 空闲
    matching        = 1; // 匹配中
    gaming          = 2; // 游戏中
    game_over       = 3; // 游戏结束
}


// 打开面板
message chess_open_panel_reply {
    optional bool                       _is_rookie          = 1; // 是否是新手
    optional uint32                     _score              = 2; // 积分
    optional chess_game_status          _game_status        = 3; // 游戏状态
    optional uint32                     _cur_game_id        = 4; // 当前游戏ID，不为0表示正在游戏中
    optional string                     _cur_game_addr      = 5; // 当前游戏地址，ip:port
    optional chess_game_type            _cur_game_type      = 6; // 当前游戏类型，游戏中或匹配中的
    optional chess_game_over_notify     _game_over_notify   = 7; // 游戏结束通知
    optional uint32                     _match_start_time   = 8; // 匹配开始时间
    repeated chess_game_type            _open_types         = 9; // 已开放的模式
    optional uint32                     _weekly_task_progress   = 10; // 周常进度
    optional uint32                     _weekly_task_target     = 11; // 周常目标
    optional bool                       _weekly_reward_flag     = 12; // 周常是否领取
    repeated uint32                     _grade_reward_flags     = 13; // 段位奖励领取标志
}

// 开始匹配
message chess_match_start_reply {
    optional uint32     _expect_wait_time   = 1; // 预计等待时间（秒）
}

// 取消匹配
message chess_match_cancel_reply {

}

// 跳过引导
message chess_resolve_rookie_reply {
    optional result     _result     = 1;
}

// 开始新手引导
message chess_rookie_start_reply {
    optional chess_game_summary     _summary    = 1; // 摘要信息
}

// 完成新手引导
message chess_rookie_finish_reply {
    optional chess_game_start_notify    _notify  = 1; // 游戏开始通知
}

// 周常奖励
message chess_weekly_reward_reply {
    repeated reward     _rewards    = 1; // 奖励
}

// 获取段位奖励
message chess_grade_reward_reply {
    optional uint32     _grade      = 1; // 段位
    repeated reward     _rewards    = 2; // 奖励
}


// 自走棋游戏中请求(长连接)
message chess_game_reply {
    optional chess_join_reply             _join           = 1;  // 加入游戏
    optional chess_loading_reply          _loading        = 2;  // 加载同步
    optional chess_buy_hero_reply         _buy_hero       = 3;  // 购买英雄
    optional chess_sell_hero_reply        _sell_hero      = 4;  // 出售英雄
    optional chess_shop_refresh_reply     _shop_refresh   = 5;  // 商店刷新
    optional chess_shop_lock_reply        _shop_lock      = 6;  // 商店锁定
    optional chess_set_lineup_reply       _set_lineup     = 7;  // 设置阵容
    optional chess_equip_pet_reply        _equip_pet      = 8;  // 装备信使
    optional chess_replace_pet_reply      _replace_pet    = 9;  // 替换信使
    optional chess_buy_exp_reply          _buy_exp        = 10; // 购买经验
    optional chess_quit_reply             _quit           = 11; // 退出游戏
    optional chess_battle_confirm_reply   _battle_confirm = 13; // 战斗确认
    optional chess_heartbeat_reply        _heartbeat      = 14; // 心跳
    optional chess_switch_pet_reply       _switch_pet     = 15; // 交换宠物
    optional chess_choose_hero_power_reply _choose_hero_power    = 16; // 选择英雄能力
    optional chess_emoji_reply            _emoji          = 17; // 表情返回

    optional string                       _error_code     = 21; // 错误码
}

// 自走棋摘要信息
message chess_game_summary {
    optional uint32                 _id         = 1; // 游戏ID
    optional chess_game_type        _game_type  = 2; // 游戏类型
    optional uint32                 _server_id  = 3; // 游戏所在svrID
    repeated chess_user_summary     _users      = 4; // 玩家信息
    optional uint32                 _max_hp     = 5; // 最大血量
}

// 英雄合成记录
message chess_hero_compose_record {
    repeated uint32         _hero_insids    = 1; // 消耗的英雄
    optional chess_hero     _hero           = 2; // 合成的新英雄
    repeated chess_pet      _pets           = 3; // 返还信使数组
}


// 加入游戏
message chess_join_reply {
    optional chess_game_summary     _summary    = 1; // 摘要信息
}

// 加载
message chess_loading_reply {

}

// 重新连接
message chess_reconnect_reply {

}

// 购买英雄
message chess_buy_hero_reply {
    optional chess_hero                 _hero           = 1; // 买到的英雄
    optional uint32                     _gold           = 2; // 剩余金币同步
    repeated chess_hero_compose_record  _compose_rcds   = 3; // 合成记录
}

// 出售英雄
message chess_sell_hero_reply {
    optional uint32     _hero_insid     = 1; // 买到的英雄
    optional uint32     _gold           = 2; // 剩余金币同步
    optional chess_pet  _pet            = 3; // 返还信使
}

// 刷新商店
message chess_shop_refresh_reply {
    optional chess_hero_shop    _shop   = 1; // 商店信息
    optional uint32             _gold   = 2; // 剩余金币同步
}

// 锁定商店
message chess_shop_lock_reply {
    optional result     _result     = 1;
    optional bool       _is_locked  = 2; // 是否被锁定
}

// 设置阵容
message chess_set_lineup_reply {
    optional result     _result  = 1;
}

// 装备信使
message chess_equip_pet_reply {
    optional chess_hero     _hero   = 1; // 装备信使的英雄
}

// 替换信使
message chess_replace_pet_reply {
    optional chess_hero     _hero   = 1; // 装备信使的英雄
    optional chess_pet      _pet    = 2; // 返还信使
}

// 购买经验
message chess_buy_exp_reply {
    optional uint32 _level          = 1; // 等级同步
    optional uint32 _exp            = 2; // 经验同步
    optional uint32 _gold           = 3; // 金币同步
}

// 退出游戏
message chess_quit_reply {
    optional result     _result  = 1;
}

// 战斗确认
message chess_battle_confirm_reply {
    enum confirm_result {
        ok          = 0; // 确认结果OK
        conflict    = 1; // 战斗结果冲突
    }
    optional confirm_result     _confirm_result = 1; // 确认结果
    optional battle_result      _battle_result  = 2; // 战斗结果
    optional uint32             _hp             = 3; // hp
    optional uint32             _gain_gold      = 4; // 战斗获得的金币
    repeated chess_pet          _loot_pets      = 5; // 掉落的信使
}

// 心跳
message chess_heartbeat_reply {

}

// 交换宠物
message chess_switch_pet_reply {
    optional chess_hero     _from_hero  = 1; // 从哪个英雄
    optional chess_hero     _to_hero    = 2; // 到哪个英雄
    optional chess_pet      _pet        = 3; // 返还信使
}

// 选择英雄能力
message chess_choose_hero_power_reply {
    optional uint32             _power_pos      = 1; // 第几个能力
    optional uint32             _option_index   = 2; // 选项索引
    optional bool               _is_auto        = 3; // 是否自动选取
    optional chess_hero_power   _hero_power     = 4; // 英雄能力
    repeated chess_game_effect  _effects        = 5; // 游戏效果
}

message chess_emoji_reply {
    optional result    _result = 1; // 结果
}

// 自走棋游戏效果
message chess_game_effect {
    optional chess_effect_modify_hp     _mod_hp        = 1; // 修改血量
    optional chess_effect_gain_heroes   _gain_heroes   = 2; // 获得英雄
    optional chess_effect_gain_gold     _gain_gold     = 3; // 获得金币
}

// 自走棋游戏效果，修改血量
message chess_effect_modify_hp {
    optional uint32             _max_hp         = 1; // 最大HP
    optional sint32             _mod_hp         = 2; // 当前HP变化量
}

// 自走棋游戏效果，获得英雄
message chess_effect_gain_heroes {
    repeated chess_hero         _heroes         = 1; // 获得英雄列表
}

// 自走棋游戏效果，获得金币
message chess_effect_gain_gold {
    optional uint32     _gold   = 1; // 获得金币
}


// 自走棋游戏中的通知
message chess_game_notify {
    optional chess_match_timeout_notify  _match_timeout  = 1; // 匹配超时
    optional chess_game_start_notify     _game_start     = 2; // 游戏开始
    optional chess_join_timeout_notify   _join_timeout   = 3; // 加入超时
    optional chess_loading_sync_notify   _loading_sync   = 4; // 加载同步
    optional chess_round_sync_notify     _round_sync     = 5; // 回合同步
    optional chess_game_over_notify      _game_over      = 6; // 游戏结束通知
    optional chess_user_status_notify    _user_status    = 7; // 玩家状态同步
    optional chess_compose_hero_notify   _compose_hero   = 8; // 合成英雄
    optional chess_level_up_notify       _level_up       = 9; // 玩家升级
    optional chess_game_event_notify     _event          = 10; // 事件通知
    optional chess_game_action_notify    _action         = 11; // 动作通知
    optional chess_game_effect_notify    _effect         = 12; // 效果通知
}

// 匹配超时
message chess_match_timeout_notify {

}

// 游戏开始通知
message chess_game_start_notify {
    optional uint32     _game_id    = 1; // 游戏ID
    optional string     _game_addr  = 2; // 游戏地址，ip:port
}

// 游戏加入超时
message chess_join_timeout_notify {

}

// 加载同步通知
message chess_loading_user {
    optional chess_user_key     _user_key   = 1; // 玩家key
    optional uint32             _progress   = 2; // 进度
    optional bool               _is_finish  = 3; // 是否完成
}

// 加载同步通知
message chess_loading_sync_notify {
    repeated chess_loading_user     _users = 1; // 玩家
}

// 合成英雄通知
message chess_compose_hero_notify {
    optional chess_user_key     _user_key   = 1; // 玩家key
    optional uint32             _hid        = 2; // 英雄ID
}

// 玩家升级同步
message chess_level_up_notify {
    optional chess_user_key     _user_key   = 1; // 玩家key
    optional uint32             _level      = 2; // 等级
}

// 回合同步通知
message chess_round_sync_notify {
    optional uint32                 _round_num      = 1; // 当前回合数
    optional chess_round_start      _round_start    = 2; // 回合开始
    optional chess_round_prepare    _round_prepare  = 3; // 回合准备
    optional chess_round_lock       _round_lock     = 4; // 回合锁定
    optional chess_round_battle     _round_battle   = 5; // 回合战斗
    optional chess_round_over       _round_over     = 6; // 回合结束
}

// 玩家状态
enum chess_user_status {
    online  = 0; // 在线
    offline = 1; // 离线
    quit    = 2; // 退出
}

// 玩家状态同步通知
message chess_user_status_notify {
    optional chess_user_key     _user_key   = 1; // 玩家key
    optional chess_user_status  _status     = 2; // 玩家状态
}

// 商品英雄
message chess_goods_hero {
    optional uint32     _insid  = 1; // 商品实例ID
    optional uint32     _hid    = 2; // 英雄ID
    optional bool       _sold   = 3; // 是否已经出售了
}

// 英雄商店
message chess_hero_shop {
    repeated chess_goods_hero   _heroes     = 1; // 所有英雄
    optional bool               _is_locked  = 2; // 商店是否锁定
}

// 对手信息同步
message chess_oppo_user {
    optional chess_user_key     _user_key   = 1; // 玩家key
    optional chess_user_status  _status     = 2; // 玩家状态
    optional uint32             _max_hp     = 3; // 最大血量
    optional uint32             _hp         = 4; // 当前血量
    optional uint32             _level      = 5; // 等级
    repeated chess_hero_power   _hero_powers = 6; // 英雄能力列表
}


// 回合开始
message chess_round_start {
    optional uint32             _max_hp         = 1; // 最大血量
    optional uint32             _hp             = 2; // 当前血量
    optional bool               _is_dead        = 3; // 是否已死亡
    optional uint32             _gold           = 4; // 金币同步
    optional uint32             _gain_base      = 5; // 获得的基本工资（显示用）
    optional uint32             _gain_inst      = 6; // 获得的利息（显示用）
    optional uint32             _gain_combo_v   = 7; // 获得的连胜奖励（显示用）
    optional uint32             _gain_combo_d   = 8; // 获得的连败奖励（显示用）
    optional uint32             _level          = 9; // 等级
    optional uint32             _exp            = 10; // 经验
    optional chess_battle_team  _team           = 11; // 出战的英雄
    repeated chess_hero         _heroes         = 12; // 仓库中英雄
    repeated chess_pet          _pets           = 13; // 宠物
    repeated chess_oppo_user    _oppos          = 14; // 对手信息同步
    optional sint32              _combo         = 15; // >0 = 连胜, <0 = 连败
    repeated chess_hero_power   _hero_powers    = 16; // 英雄能力列表
    repeated sint32             _hero_power_cds = 17; // 下个英雄能力开放倒数回合数，0表示当前回合, < 0表示已过了
}

// 准备阶段
message chess_round_prepare {
    enum battle_oppo_type {
        nobody  = 0;    // 没有对手，你已经挂了
        monster = 1;    // 怪物
        player  = 2;    // 玩家
    }
    optional battle_oppo_type   _oppo_type  = 1; // 对手类型
    optional chess_hero_shop    _hero_shop  = 2; // 商店信息
    optional uint32             _end_time   = 3; // 结束时间戳
}

// 锁定阶段
message chess_round_lock {
    optional chess_battle_team      _team   = 1; // 出战队伍
}

// 战斗掉落
message chess_battle_loot {
    optional uint32     _hero_insid     = 1; // 英雄实例ID
    optional chess_pet  _pet            = 2; // 战斗获得信使
}

// 战斗阶段
message chess_round_battle {
    optional chess_battle_record    _record     = 1; // 战斗录像
    repeated chess_battle_event     _events     = 2; // 事件数组
    optional uint32                 _end_time   = 3; // 结束时间戳
    repeated chess_battle_loot      _loots      = 4; // 战斗最大掉落
    repeated chess_oppo_user        _oppos      = 5; // 对手信息同步
}

// 回合结束
message chess_round_over {
    optional uint32                     _max_hp         = 1; // 最大血量同步
    optional uint32                     _hp             = 2; // 血量同步
    optional uint32                     _gold           = 3; // 金币同步
    optional uint32                     _end_time       = 4; // 结束时间戳
    repeated chess_hero_compose_record  _compose_rcds   = 5; // 合成记录
}

// 战斗记录
message chess_battle_record {
    optional uint32             _checkid        = 1;  // 战斗校验ID
    optional uint32             _gameid         = 2;  // 游戏ID
    optional uint32             _round          = 3;  // 第几回合
    optional chess_battle       _battle         = 4;  // 战斗信息
    optional battle_result      _result         = 5;  // 胜负结果
    optional uint32             _time           = 6;  // 战斗时长
}

// 自走棋游戏内战斗事件
message chess_battle_event {
    optional uint32                     _time  = 1; // 事件发生时间
    optional chess_event_battle_start   _start = 2; // 战斗开始事件
    optional chess_event_battle_over    _over  = 3; // 战斗结束事件
    optional chess_event_combo_victory  _combo = 4; // 连胜事件
    optional chess_event_block_victory  _block = 5; // 终结连胜
}

/// 自走棋游戏动作事件
message chess_action_event {
    optional chess_event_choose_hero_power  _choose_hero_power = 1; // 选择英雄能力
    optional chess_event_emoji              _emoji             = 2; // 发表情
}

// 战斗开始事件
message chess_event_battle_start {
    optional chess_user_key     _user_key   = 1; // 玩家Key
    optional chess_battle_team  _team       = 2; // 队伍
    optional uint32             _hp         = 3; // 战斗开始时血量
    optional uint32             _level      = 4; // 等级
}

message chess_event_emoji {
    optional chess_user_key     _user_key   = 1; // 玩家Key
    optional string             _content    = 2; // 队伍
}

// 战斗结束事件
message chess_event_battle_over {
    enum oppo_type {
        monster = 1;    // 怪物
        player  = 2;    // 玩家
    }
    optional chess_user_key     _user_key       = 1; // 玩家Key
    optional oppo_type          _oppo_type      = 2; // 对手类型
    optional chess_user_key     _oppo_key       = 3; // 战斗对手Key,对手类型=player时有值
    optional battle_result      _battle_result  = 4; // 战斗结果
    optional uint32             _hp             = 5; // 战斗结束时血量
    optional uint32             _level          = 6; // 等级
}

// 连胜事件
message chess_event_combo_victory {
    optional chess_user_key     _user_key       = 1; // 玩家Key
    optional uint32             _combo          = 2; // 连胜次数
}

// 连胜终结事件
message chess_event_block_victory {
    optional chess_user_key     _user_key       = 1; // 被终结的玩家Key
    optional chess_user_key     _oppo_key       = 2; // 终结者玩家Key
    optional uint32             _combo          = 3; // 被终结的连胜次数
}

// 选择英雄能力事件
message chess_event_choose_hero_power {
    optional chess_user_key     _user_key       = 1; // 选择的玩家Key
    optional chess_hero_power   _hero_power     = 2; // 英雄能力
    repeated chess_game_effect  _effects        = 3; // 效果同步
}

// 游戏事件通知
message chess_game_event_notify {
    repeated chess_battle_event   _events      = 1; // 战斗事件数组
    repeated chess_action_event   _actions     = 2; // 动作事件数组
}

// 游戏结束结算时的玩家统计信息
message chess_game_user_stat {
    optional chess_user_summary     _user_summary       = 1; // 玩家信息
    optional uint32                 _rank               = 2; // 排名
    optional bool                   _is_win             = 3; // 是否胜利
    optional int32                  _base_score         = 4; // 获取的基础分数, 失去时为负
    optional int32                  _extra_score        = 5; // 获取的额外分数, 失去时为负
    optional uint32                 _victory_cnt        = 6; // 胜利场数
    optional uint32                 _defeat_cnt         = 7; // 失败场数
    optional chess_battle_team      _team               = 8; // 阵容
    repeated chess_hero_power       _hero_powers        = 9; // 英雄能力列表
}

// 游戏结束通知
message chess_game_over_notify {
    repeated chess_game_user_stat   _stats      = 1; // 玩家统计数组
}

// 游戏动作通知，需要客户端操作
message chess_game_action_notify {
    repeated chess_game_action      _actions    = 1; // 动作数组
}

// 游戏效果通知，需要客户端做表现同步
message chess_game_effect_notify {
    repeated chess_game_effect      _effects    = 1; // 效果数组
}


// 游戏动作
message chess_game_action {
    optional chess_action_choose_hero_power     _choose_hero_power  = 1; // 选择英雄能力
}

// 选择英雄能力
message chess_action_choose_hero_power {
    optional uint32     _power_pos      = 1; // 第几个能力
    repeated uint32     _power_ids      = 2; // 英雄能力ID列表
}

// 队员概要信息
message team_member_summary {
    optional team_member_key     _user_key           = 1; // 队员key
    optional user_summary        _user_summary       = 2; // 玩家概要信息
    optional string              _plat               = 3; // 平台名称
    optional uint32              _show_server_id     = 4; // 显示的服务器id
    optional uint32              _score              = 5; // 通用积分
    optional string              _status             = 6; // 通用状态
    optional team_room_status    _room_status        = 7; // 房间状态
}

// 队伍概要信息
message team_summary {
    optional uint32                 _id         = 1; // 队伍ID
    optional team_target            _target     = 2; // 目标
    repeated team_member_summary    _members    = 3; // 队员信息
    optional team_member_key        _leader     = 4; // 队长的Key
}

// 队伍回复
message team_reply {
    optional team_open_panel_reply          _open_panel     = 1; // 打开面板
    optional team_create_reply              _create         = 2; // 创建队伍
    optional team_query_reply               _query          = 3; // 查询队伍
    optional team_apply_reply               _apply          = 4; // 申请入队
    optional team_join_reply                _join           = 5; // 加入队伍
    optional team_quit_reply                _quit           = 6; // 离开队伍
    optional team_kick_reply                _kick           = 7; // 踢出队伍
    optional team_heartbeat_reply           _heartbeat      = 8; // 心跳
    optional team_set_room_status_reply     _room_status    = 9; // 设置房间状态

    optional string _error_code = 99; // 错误代码
}

// 打开队伍界面
message team_open_panel_reply {
  optional bool           _is_in_team     = 1; // 是否在队伍中
  optional team_summary   _team_summary   = 2; // 队伍ID
  optional string         _team_addr      = 3; // 队伍地址，svrid#ip:port
}


// 创建队伍
message team_create_reply {
    optional uint32     _team_id    = 1; // 队伍ID
    optional string     _team_addr  = 2; // 队伍地址，svrid#ip:port
}

// 查看队伍信息
message team_query_reply {
    optional team_summary        _team_summary   = 1; // 队伍信息
    optional team_target         _team_target    = 2;
}

// 申请加入队伍
message team_apply_reply {
    optional uint32             _team_id        = 1; // 队伍ID
    optional string             _team_addr      = 2; // 队伍地址，svrid#ip:port
    optional team_target        _team_target    = 3;
}

// 加入队伍
message team_join_reply {
    optional team_summary    _team_summary   = 1; // 队伍信息
}

// 离开队伍
message team_quit_reply {

}

// 踢出队伍
message team_kick_reply {
    optional result         _result         = 1; // 处理结果
}

// 队伍心跳
message team_heartbeat_reply {

}

// 设置房间状态
message team_set_room_status_reply {
    optional result     _result     = 1;
}

// 队伍通知
message team_notify {
    optional uint32                     _team_id        = 1; // 队伍ID确认，不是自己的队伍ID就忽略
    optional team_join_notify           _join           = 2; // 加入队伍通知
    optional team_quit_notify           _quit           = 3; // 离开队伍通知
    optional team_leader_change_notify  _leader_change  = 4; // 队长改变
    optional team_member_status_notify  _member_status  = 5; // 队员状态
    optional team_room_status_notify    _room_status    = 6; // 房间状态
    optional string     _error_code     = 99; // 错误信息
}

// 加入队伍通知
message team_join_notify {
    optional team_member_summary    _member     = 1; // 队员信息
}


// 离开队伍通知
message team_quit_notify {
    enum reason {
        self    = 0; // 主动退出
        kick    = 1; // 被人踢出
        dismiss = 2; // 解散了
    }
    optional team_member_key        _member_key     = 1; // 队员key
    optional reason                 _reason         = 2; // 原因
    optional team_member_key        _op_key         = 3; // 操作者key
}

// 队长改变通知
message team_leader_change_notify {
    optional team_member_key        _new_leader     = 1; // 新的队长
}

// 队员状态通知
message team_member_status_notify {
    repeated team_member_key        _member_keys    = 1; // 队员Key列表
    optional string                 _status         = 2; // 状态
}

// 房间状态通知
message team_room_status_notify {
    repeated team_member_key        _member_key     = 1; // 队员Key
    repeated team_room_status       _room_status    = 2; // 房间状态
}

// 心动礼包
message impulse_gift {
    optional uint32         _gift_id        = 1; // 礼包ID
    repeated reward         _rewards        = 2; // 实际奖励列表
    optional uint32         _cfg_gift_id    = 3; // 配置礼包ID
    optional bool           _has_buy        = 4; // 是否购买
    optional uint32         _dead_line      = 5; // 截止时间戳
    optional uint32         _create_time    = 6; // 创建时间
    optional uint32         _start_time     = 7; // 开始倒计时时间
    optional uint32         _discount       = 8; // 折扣指数
    optional uint32         _bunch_group    = 9; // 堆叠组
    optional bool           _view_flag      = 10; // 查看标志
}

message impulse_gift_notify {
    repeated uint32   _nearest_end_time = 1; // 最近消失时间
    repeated uint32   _dreamland_end_time = 2; // 梦境礼包结束时间

    repeated impulse_gift_type  _new_gift_flag  = 3; // 新礼包
}

// 心动礼包回复
message impulse_gift_reply {
    optional impulse_gift_open_reply     _open   = 1; // 打开
    optional impulse_gift_buy_reply      _buy    = 2; // 购买
    optional impulse_gift_view_reply     _view   = 3; //  查看礼包

    optional string     _error_code     = 99; // 错误信息
}


// 打开礼包
message impulse_gift_open_reply {
    optional impulse_gift_type  _gift_type = 1; // 礼包类型
    repeated impulse_gift       _gifts     = 2; // 礼包列表
    repeated uint32             _new_gifts = 3; // 需要弹脸的礼包ID
}

// 购买礼包
message impulse_gift_buy_reply {
    optional result             _result     = 1; // 购买结果
    optional uint32             _gift_id    = 2; // 礼包ID
    repeated reward             _rewards    = 3; // 奖励
    optional bool               _is_mail    = 4; // 是否使用了邮件
    optional packed_diamond     _diamond    = 5; // 剩余钻石
}

message impulse_gift_view_reply {
    optional result                   _result    = 1; // 结果
}



// 杯赛（金苹果，女神之战）
message cup_arena_reply {
    optional cup_arena_not_entry_reply              _not_entry          = 1;  // 未报名
    optional cup_arena_entry_reply                  _entry              = 2;  // 报名
    optional cup_arena_audition_reply               _audition           = 3;  // 海选
    optional cup_arena_match_prepare_reply          _match_prepare      = 4;  // 比赛准备
    optional cup_arena_match_out_reply              _match_out          = 5;  // 比赛被淘汰
    optional cup_arena_open_challenge_reply         _open_challenge     = 6;  // 打开挑战面板
    optional cup_arena_get_lineup_reply             _get_lineup         = 7;  // 获取阵容
    optional cup_arena_set_lineup_reply             _set_lineup         = 8;  // 设置阵容
    optional cup_arena_refresh_oppo_reply           _refresh_oppo       = 9;  // 刷新对手
    optional cup_arena_oppo_teams_reply             _oppo_teams         = 10; // 获取对手队伍
    optional cup_arena_challenge_reply				_challenge			= 11; // 挑战对手
    optional cup_arena_clear_cd_reply				_clear_cd			= 12; // 清除挑战CD
    optional cup_arena_buy_count_reply				_buy_count			= 13; // 购买挑战次数
    optional cup_arena_challenge_record_reply		_challenge_record	= 14; // 挑战记录
    optional cup_arena_get_replay_reply				_get_replay			= 15; // 战斗录像
    optional cup_arena_query_summary_reply			_query_summary		= 16; // 战斗录像摘要信息
    optional cup_arena_medal_reward_reply			_medal_reward		= 17; // 战斗记录
    optional cup_arena_history_reply				_history			= 18; // 历史赛季
    optional cup_arena_top_rankboard_reply			_top_rankboard		= 19; // 排行榜-名人堂
    optional cup_arena_user_rankboard_reply			_user_rankboard		= 20; // 排行榜-个人
    optional cup_arena_camp_rankboard_reply			_camp_rankboard		= 21; // 排行榜-阵营
    optional cup_arena_match_rankboard_reply        _match_rankboard    = 22; // 排行榜-比赛
    optional cup_arena_time_schedule_reply			_time_schedule		= 23; // 时间表
    optional cup_arena_match_schedule_reply			_match_schedule		= 24; // 赛程表
    optional cup_arena_match_group_reply			_match_group		= 25; // 查看比赛分组信息
    optional cup_arena_match_record_reply			_match_record		= 26; // 赛事对战记录
    optional cup_arena_set_match_lineup_reply		_set_match_lineup	= 27; // 查看玩家信息
    optional cup_arena_view_user_reply				_view_user			= 28; // 查看玩家信息
    optional cup_arena_open_bet_reply				_open_bet			= 29; // 打开竞猜面板
    optional cup_arena_bet_match_reply				_bet_match			= 30; // 竞猜比赛
    optional cup_arena_bet_record_reply				_bet_record			= 31; // 竞猜记录
    optional cup_arena_open_reward_reply			_open_reward		= 32; // 打开奖励面板
    optional cup_arena_open_task_reply              _open_task          = 33; // 打开任务界面
    optional cup_arena_audition_achievement_reply   _audition_achievement = 34; // 打开海选赛果界面
    optional cup_arena_open_camp_reward_reply       _open_camp_reward = 35; // 打开阵营奖励界面
    optional cup_arena_paint_trigger_reply          _paint_trigger = 36; // 图鉴触发

    optional uint32     _season         = 98; // 当前赛季
    optional string     _error_code     = 99; // 错误码
}

// 杯赛对手
message cup_arena_oppo {
    optional string             _role_id            = 1; // 角色ID
    optional user_summary       _summary            = 2; // 简要信息
    optional uint32             _camp_id            = 3; // 阵营ID
    optional uint32             _score              = 4; // 积分
    optional string             _plat               = 5; // 平台名称
    optional string             _server_name        = 6; // 显示的服务器名称
    optional uint32             _gs                 = 7; // 战力
    optional battle_result      _result             = 8; // 结果
}

// 杯赛挑战对手记录
message cup_arena_challenge_oppo_record {
    optional string             _role_id            = 1; // 角色ID
    optional battle_result      _result             = 2;  // 胜负结果
}

// 杯赛挑战第几场的战斗录像
message cup_arena_round_battle_record {
    optional uint32             _checkid        = 1;  // 战斗校验ID
    optional uint32             _round          = 2;  // 第几场
    optional battle_result      _result         = 3;  // 胜负结果
    optional uint32             _rseed          = 4;  // 战斗种子
    optional uint32             _match_id       = 5;  // 比赛ID
    optional string             _self_key       = 6;  // 自己的key
    optional string             _oppo_key       = 7;  // 自己的key
    optional user_summary       _self_user      = 8;  // 自己信息
    optional user_summary       _oppo_user      = 9; // 对手信息
    optional uint32             _self_camp_id   = 10; // 自己队伍ID
    optional uint32             _oppo_camp_id   = 11; // 对手队伍ID
    optional arena_team         _self_heroes    = 12; // 自己英雄
    optional arena_team         _oppo_heroes    = 14; // 对手英雄

    repeated operation          _operations     = 20; // 操作
    repeated warschool_book     _self_warschool_books   = 21; // 自己战斗学院信息
    repeated warschool_book     _oppo_warschool_books   = 22; // 对手战斗学院信息
    optional uint32             _self_bookreading_level = 23; // 自己博学院等级
    optional uint32             _oppo_bookreading_level = 24; // 对手博学院等级
    optional battle_bonus       _self_bonus             = 25; // 己方战斗加成
    optional battle_bonus       _oppo_bonus             = 26; // 对手战斗加成
}

// 杯赛战斗录像
message cup_arena_battle_replay {
    repeated cup_arena_round_battle_record   _records  = 1; // 每个回合战斗记录
}

// 杯赛挑战记录
message cup_arena_challenge_record {
    optional uint32             _replay_id       = 1;  // 战斗录像ID
    optional cup_arena_oppo     _oppo            = 2;  // 对手信息
    optional uint32             _bt_time         = 3;  // 战斗时间
    optional battle_result      _bt_result       = 4;  // 战斗结果
    optional bool               _active          = 5;  // 是否主动方
    optional uint32             _self_old_score  = 6;  // 自己历史积分
    optional uint32             _self_new_score  = 7;  // 自己最新积分
    optional uint32             _oppo_old_score  = 8;  // 对手历史积分
    optional uint32             _oppo_new_score  = 9;  // 对手最新积分
}

// 杯赛排行榜玩家数据
message cup_arena_user_rankitem {
    optional uint32         _rank           = 1; // 排名
    optional user_summary   _user_summary   = 2; // 玩家信息
    optional uint32         _score          = 3; // 积分
    optional uint32         _camp_id        = 4; // 阵营ID
    optional string         _role_id        = 5; // 角色ID
    optional string         _plat           = 6; // 平台名称
    optional string         _server_name    = 7; // 显示的服务器名称

}

// 杯赛s排行榜阵营数据
message cup_arena_camp_rankitem {
    optional uint32         _rank           = 1; // 排名
    optional uint32         _camp_id        = 2; // 阵营编号
    optional uint32         _medal          = 3; // 勋章
}

// 杯赛参赛记录
message cup_arena_entry_record {
    optional uint32         _season         = 1; // 赛季
    optional uint32         _camp_id        = 2; // 阵营ID
    optional uint32         _grade          = 3; // 段位
    optional uint32         _score          = 4; // 积分
    optional uint32         _medal          = 5; // 勋章
    optional uint32         _audition_rank  = 6; // 海选名次
    optional uint32         _final_rank     = 7; // 最终名次
    optional uint32         _zone_id        = 8; // 赛区
}

// 杯赛比赛
message cup_arena_match {
    enum match_status {
        wait        = 0; // 等待
        matching    = 1; // 比赛中
        matched     = 2; // 比赛完成
    }
    optional uint32             _match_id   = 1; // 比赛ID
    optional cup_arena_oppo     _host       = 2; // 主队
    optional cup_arena_oppo     _guest      = 3; // 客队
    optional match_status       _status     = 4; // 比赛状态
    optional uint32             _winner     = 5; // 比赛胜利者 1=host,2=guest
    optional uint32             _replay_id  = 6; // 录像ID
    optional uint32             _start_time = 7; // 赛程开始时间
}

// 杯赛比赛记录
message cup_arena_match_record {
    optional uint32             _match_id   = 1; // 比赛ID
    optional cup_arena_oppo     _oppo       = 2; // 对手信息
    optional bool               _is_win     = 3; // 是否胜利
    optional uint32             _start_time = 4; // 赛程开始时间
}

// 杯赛竞猜选项
message cup_arena_bet_option {
    optional uint32             _match_id           = 1; // 比赛ID
    optional cup_arena_oppo     _host               = 2; // 主队（左）
    optional cup_arena_oppo     _guest              = 3; // 客队（右）
    optional uint32             _winner             = 4; // 胜利者，0=未开始,1=host,2=guest
    optional uint32             _host_pick_rate     = 5; // 主队支持率, 千分比
    optional uint32             _guest_pick_rate    = 6; // 客队支持率, 千分比
    optional uint32             _pick_side          = 7; // pick状态，0=未选择，1=host,2=guest
    optional double             _counter            = 8; // 下注筹码
    optional uint32             _host_odds_rate     = 9; // 主队回报率, 放大1000倍
    optional uint32             _guest_odds_rate    = 10; // 客队回报率, 放大1000倍
}

// 杯赛竞猜记录
message cup_arena_bet_record {
    optional uint32             _match_id   = 1; // 比赛ID
    optional cup_arena_oppo    _host       = 2; // 主队
    optional cup_arena_oppo     _guest      = 3; // 客队
    optional uint32             _winner     = 4; // 胜利者，1=host,2=guest
    optional uint32             _bet_result = 5; // 1=竞猜成功
    optional double             _counter    = 6; // 押注筹码
}


// 未报名
message cup_arena_not_entry_reply {

}

// 报名
message cup_arena_entry_reply {
    optional uint32     _camp_id = 1;  // 阵营ID
}

// 海选
message cup_arena_audition_reply {
    optional uint32             _camp_id    = 1; // 阵营ID
    optional uint32             _score      = 2; // 积分
    optional uint32             _rank       = 3; // 阵营内积分排名
    optional uint32             _medal      = 4; // 勋章
    optional uint32             _camp_rank  = 5; // 阵营勋章排名
    optional uint32             _camp_medal = 6; // 阵营总勋章数
    repeated uint32             _medal_reward_flags = 7; // 勋章宝箱领取记录
    optional uint32             _schedule_id        = 8; // 赛程状态
    optional uint32             _end_time           = 9; // 状态结束时间
    optional uint32             _zone_id            = 10;// 赛区
    optional uint32             _zone_score_rank    = 11;// 赛区积分排名
    optional uint32             _change_lineup_time = 12;// 变更阵容时间
}

// 比赛准备
message cup_arena_match_prepare_reply {
    optional uint32             _match_id       = 1; // 比赛ID
    optional uint32             _match_time     = 2; // 比赛时间
    optional cup_arena_oppo     _oppo           = 3; // 对手信息
    repeated cup_arena_team     _lineups        = 4; // 我的阵容
    optional uint32             _set_deadline   = 5; // 阵容设置截止时间
    optional uint32             _schedule_id    = 6; // 赛程状态
    optional uint32             _end_time       = 7; // 状态结束时间
    optional uint32             _camp_id        = 8; // 阵营ID
    optional uint32             _zone_id        = 9; // 赛区
}

// 比赛被淘汰了
message cup_arena_match_out_reply {
    optional uint32             _final_rank     = 1; // 比赛ID
    repeated cup_arena_team     _lineups        = 2; // 我的阵容
    optional uint32             _schedule_id    = 3; // 赛程状态
    optional uint32             _end_time       = 4; // 状态结束时间
    optional uint32             _camp_id        = 5; // 阵营ID
    optional uint32             _zone_id        = 6; // 赛区
}

// 打开挑战界面
message cup_arena_open_challenge_reply {
    optional uint32             _challenge_count    = 1; // 可挑战次数
    optional uint32             _buy_count          = 2; // 已经购买的次数
    optional uint32             _last_time          = 3; // 挑战cd
    repeated cup_arena_oppo     _oppos              = 4; // 对手列表
    repeated lineup             _lineups            = 5; // 我的防守阵容
    optional uint32             _last_refresh_time  = 6; // 上次刷新时间
    optional uint32             _cur_refresh_times  = 7; // 当前剩余刷新对手次数
    optional uint32             _refresh_times_update_time = 8; // 刷新对手次数更新时间
}

// 获取防守阵容
message cup_arena_get_lineup_reply {
    repeated cup_arena_lineup     _lineups = 1;
}

// 设置防守阵容
message cup_arena_set_lineup_reply {
    optional result     _result = 1; // 结果
}

// 刷新对手
message cup_arena_refresh_oppo_reply {
    repeated cup_arena_oppo     _oppos              = 1; // 对手列表
    optional uint32             _cur_refresh_times  = 2; // 当前剩余刷新对手次数
    optional uint32             _refresh_times_update_time = 3; // 刷新对手次数更新时间
}

// 获取对手阵容
message cup_arena_oppo_teams_reply {
    repeated arena_team     _teams = 1; // 队伍列表
}

// 挑战对手
message cup_arena_challenge_reply {
    optional battle_result                  _result         = 1; // 结果 0 victory , 1 defeat
    optional uint32                         _rank           = 2; // 我的排名信息
    optional cup_arena_battle_replay        _battle_replay  = 3; // 对战信息
    repeated query_summary                  _battle_summary = 4; // 战斗简介
    optional double                         _rank_change    = 5; // 玩家排名变化
    optional double                         _medal_change   = 6; // 徽章变化
    optional uint32                         _camp_medal     = 7; // 阵营勋章
    optional uint32                         _camp_rank      = 8; // 阵营勋章排名
    optional uint32                         _self_old_score = 9; // 自己历史积分
    optional uint32                         _self_new_score = 10;// 自己最新积分
    optional uint32                         _new_rank       = 11;// 新的排名
    optional uint32                         _oppo_old_score = 12;// 对手历史积分
    optional uint32                         _oppo_new_score = 13;// 对手最新积分
    optional uint32                         _zone_score_rank = 14;// 赛区积分排名
    optional uint32                         _self_extra_medal = 15;// 获得额外勋章数量
}

// 清除挑战CD
message cup_arena_clear_cd_reply {
    optional result     _result = 1; // 结果
}

// 购买挑战次数
message cup_arena_buy_count_reply {
    optional result     _result = 1; // 结果
}


// 挑战记录
message cup_arena_challenge_record_reply {
    repeated cup_arena_challenge_record     _records = 1; // 记录列表
}

// 战斗录像
message cup_arena_get_replay_reply {
    optional cup_arena_battle_replay     _replay = 1; // 录像列表
}

// 战斗录像摘要信息
message cup_arena_query_summary_reply {
    optional query_summary      _summary = 1; // 战斗简报
}

// 战斗记录
message cup_arena_medal_reward_reply {
    optional uint32     _reward_id  = 1; // 奖励ID
    repeated reward     _rewards    = 2; // 奖励列表
}


// 历史赛季
message cup_arena_history_reply {
    repeated cup_arena_entry_record     _records    = 1; // 报名记录
}

// 杯赛排行榜-名人堂
message cup_arena_top_rankboard_reply {
    optional uint32                     _season     = 1; // 赛季
    repeated cup_arena_user_rankitem    _rank_list  = 2; // 排行列表
    repeated uint32                     _zone_list  = 3; // 赛区列表
    optional uint32                     _zone_id    = 4; // 玩家赛区
}


// 杯赛排行榜-个人
message cup_arena_user_rankboard_reply {
    optional uint32                     _camp_id    = 1; // 阵营ID
    repeated cup_arena_user_rankitem    _rank_list  = 2; // 排行列表
    optional cup_arena_user_rankitem    _self_rank  = 3; // 自己的排行榜信息
    optional uint32                     _self_pos   = 4; // 自己的排名
}

// 杯赛排行榜-阵营
message cup_arena_camp_rankboard_reply {
    repeated cup_arena_camp_rankitem    _rank_list      = 1; // 排行列表
    optional uint32                     _self_camp_id   = 2; // 自己的阵营ID
    optional uint32                     _self_camp_rank = 3; // 自己阵营的排行
}

// 杯赛排行榜-比赛
message cup_arena_match_rankboard_reply {
    repeated cup_arena_user_rankitem    _rank_list  = 1; // 排行列表
    optional cup_arena_user_rankitem    _self_rank  = 2; // 自己的排行榜信息
    optional uint32                     _self_pos   = 3; // 自己的排名
}

// 杯赛时间表
message cup_arena_time_schedule_reply {
    repeated uint32     _timestamps     = 1; // 时间戳列表
}


// 赛程表
message cup_arena_match_schedule_reply {
    optional uint32             _schedule_id    = 1; // 赛程ID
    optional uint32             _end_time       = 2; // 赛程结束时间
    repeated cup_arena_match    _matches        = 3; // 比赛列表
    optional bool               _is_auto        = 4; // 是否自动弹出
    optional uint32             _my_group_id    = 5; // 我的组别
    optional uint32             _zone_id        = 6; // 赛区
}

// 查看比赛分组信息
message cup_arena_match_group_reply {
    optional uint32             _group_id       = 1; // 小组ID
    optional uint32             _schedule_id    = 2; // 赛程ID
    optional uint32             _end_time       = 3; // 赛程结束时间
    repeated cup_arena_match    _matches        = 4; // 比赛列表
}

// 赛事对战记录
message cup_arena_match_record_reply {
    repeated cup_arena_match_record     _records = 1; // 比赛记录
}

// 设置比赛阵容
message cup_arena_set_match_lineup_reply {
    optional result     _result = 1; // 结果
}

// 查看玩家信息
message cup_arena_view_user_reply {
    optional string             _role_id            = 1; // 角色ID
    optional uint32             _camp_id            = 2; // 阵营ID
    optional user_summary       _summary            = 3; // 简要信息
    optional uint32             _audition_rank      = 4; // 排名
    optional uint32             _score              = 5; // 积分
    optional string             _plat               = 6; // 平台名称
    optional string             _server_name        = 7; // 显示的服务器名称
    repeated arena_team         _teams              = 8; // 队伍列表
    optional uint32             _gs                 = 9; // 战斗力
}

// 打开竞猜面板
message cup_arena_open_bet_reply {
    optional uint32                 _left_bet_time      = 1; // 剩余下注时间(秒)
    optional double                 _left_bet_counter   = 2; // 剩余可以下注额度
    repeated cup_arena_bet_option   _options            = 3; // 竞猜选项
}

// 竞猜比赛
message cup_arena_bet_match_reply {
    optional uint32     _match_id           = 1; // 比赛ID
    optional bool       _pick_host          = 2; // 选择host(左边)
    optional double     _counter            = 3; // 设置总下注筹码
    optional double     _left_bet_counter   = 4; // 剩余可以下注额度
    optional cup_arena_bet_option _option   = 5; // 竞猜选项
}

// 竞猜记录
message cup_arena_bet_record_reply {
    repeated cup_arena_bet_record   _records    = 1; // 记录列表
}

// 打开奖励面板
message cup_arena_open_reward_reply {
    optional uint32     _camp_rank          = 1; // 阵营勋章排名
    optional uint32     _score_max          = 2; // 个人最高积分
    optional uint32     _medal              = 3; // 当前勋章数
    repeated uint32     _medal_reward_flags = 4; // 勋章宝箱领取标志
}

// 杯赛任务
message cup_arena_task {
    optional uint32     _id             = 1; // 任务id
    optional uint32     _progress       = 2; // 任务进度
    optional bool       _has_completed  = 3; // 是否已完成
}

// 打开任务界面
message cup_arena_open_task_reply {
    optional uint32             _start_time     = 1; // 任务开始时间
    optional uint32             _end_time       = 2; // 任务终止时间
    repeated cup_arena_task     _task_list      = 3; // 任务列表
    optional uint32             _daily_medal    = 4; // 每日累计奖励
    optional uint32             _total_medal    = 5; // 总奖励
    optional uint32             _medal_amount   = 6; // 玩家勋章数量
    optional uint32             _camp_medal     = 7; // 阵营勋章
}

// 打开海选赛果
message cup_arena_audition_achievement_reply {
    optional uint32             _camp_id                = 1; // 阵营
    optional uint32             _camp_rank              = 2; // 阵营排名
    optional uint32             _camp_medal             = 3; // 阵营勋章
    optional uint32             _self_score             = 4; // 自己积分
    optional uint32             _self_medal             = 5; // 自己勋章
    optional uint32             _audition_camp_rank     = 6; // 海选阵营排名
    optional uint32             _audition_rank          = 7; // 海选总排名
    optional bool               _can_match              = 8; // 是否出线
}

// 打开阵营奖励界面
message cup_arena_open_camp_reward_reply {
    repeated cup_arena_camp_rankitem    _rank_list      = 1; // 排行列表
}

// 杯赛通知
message cup_arena_notify {
    optional bool   _can_entry          = 1; // 是否可以报名
    optional bool   _challenge_record   = 2; // 战斗记录
    optional bool   _bet_record         = 3; // 竞猜记录
    optional bool   _match_record       = 4; // 比赛记录
    optional bool   _bet_batch          = 5; // 新的下注批次
    optional bool   _task               = 6; // 任务红点,新的任务或者已完成
    optional bool   _refresh_challenge  = 7; // 每天海选赛刷新红点
    optional bool   _first_challenge    = 8; // 首次打开挑战界面红点
    optional bool   _medal_reward       = 9; // 勋章奖励
}

message cup_arena_paint_trigger_reply {
    optional uint32             _acc_times  = 1; // 累计触发次数
    repeated reward             _rewards    = 2; // 奖励，为空本次登录不再触发
}

// 杯赛比赛阵容
message cup_arena_team {
    repeated arena_team _heroes  = 1; // 英雄ID列表
    repeated bool       _hidden  = 2; // 是否隐藏
}

// 时空秘境
message myth_reply {
    optional myth_open_panel_reply          _open_panel           = 1; // 打开面板
    optional myth_boss_start_battle_reply   _boss_start_battle    = 2; // BOSS战斗开始
    optional myth_boss_end_battle_reply     _boss_end_battle      = 3; // BOSS战斗结束
    optional myth_shop_consume_reply        _shop_consume         = 4; // 商店购买
    optional myth_view_team_reply           _view_team            = 5; // 玩家阵容
    optional myth_boss_sweep_reply          _boss_sweep           = 6; // BOSS扫荡
    optional myth_multi_shop_consume_reply  _multi_consume        = 7; // 商店多次购买

    optional string     _error_code     = 99; // 错误码
}


// 时空秘境小关卡信息
message myth_stage {
    optional uint32     _stage_id   = 1; // 小关卡ID
    optional uint32     _best_stars = 2; // 最高星级
}

// 时空秘境商品
message myth_goods {
    optional uint32     _goods_id       = 1; // 商品ID
    optional uint32     _buy_times      = 2; // 当前购买次数
}

// 时空秘境打开面板
message myth_open_panel_reply {
    optional uint32         _act_id         = 1;  // 活动ID
    optional uint32         _act_start_time = 2;  // 活动开始时间
    optional uint32         _act_end_time   = 3;  // 活动结束时间
    optional uint32         _act_shop_time  = 4;  // 商店结束时间
    optional uint32         _boss_id        = 5;  // BOSSID
    repeated myth_stage     _stage_list     = 6;  // 小关卡列表
    repeated myth_goods     _goods_list     = 7;  // 商品列表
    optional uint32         _coin_amount    = 8;  // 代币数量
    optional uint32         _coin_acc       = 9;  // 代码累计数
    optional uint32         _ticket_id      = 10; // 门票物品ID
    optional uint32         _ticket_amount  = 11; // 门票单次消耗数量
    optional uint32         _reward_line_id = 12; // 奖励ID
    optional uint32         _boss_retry_left  = 13; // 剩余BOSS重试次数
    optional uint32         _ticket_left      = 14; // 剩余门票数量
    optional uint32         _today_top_damage = 15; // 今日最高伤害
}

// 时空秘境BOSS战斗开始
message myth_boss_start_battle_reply {
    optional uint32                     _rseed      = 1; // 战斗种子
}

// 时空秘境BOSS战斗结束
message myth_boss_end_battle_reply {
    optional battle_result      _result                 = 1; // 战斗结果
    optional bool               _is_retry               = 2; // 是否尝试重新战斗，返还战斗消耗
    optional uint32             _coin_amount            = 3; // 奖励代币数
    optional uint32             _coin_acc               = 4; // 累计代币数
    optional uint32             _checkid                = 5; // 战斗校验ID，战斗校验出错时返回
    optional uint32             _retry_left             = 6; // 剩余BOSS重试次数
    optional uint32             _ticket_left            = 7; // 剩余门票数量
    optional uint32             _today_top_damage       = 8; // 本日最高伤害
}

// 时空秘境商店购买
message myth_shop_consume_reply {
    optional result     _result = 1; // 结果
}

message myth_view_team_reply {
    optional user_summary      _user_summary    = 1;  // 玩家信息
    repeated hero              _heroes          = 2;  // 玩家英雄信息
}

message myth_boss_sweep_reply{
    optional uint32             _add_coins              = 1; // 增加的代币数
    optional uint32             _coin_amount            = 2; // 当前代币数
    optional uint32             _coin_acc               = 3; // 累计代币数
    optional uint32             _ticket_left            = 4; // 剩余门票数量
    optional uint32             _today_top_damage       = 5; // 本日最高伤害
}

message myth_multi_shop_consume_reply {
    optional result     _result  = 1; // 结果
    optional uint32     _goodsid = 2; // 购买的商品id
    optional uint32     _times   = 3; // 购买次数
}

// 商城礼包
message mall_gift_reply {
    optional mall_gift_open_panel_reply   _open_panel     = 1; // 打开面板
    optional mall_gift_free_reward_reply  _free_reward    = 2; // 免费奖励
    optional mall_gift_buy_daily_reply    _buy_daily      = 3; // 购买日礼包
    optional mall_gift_buy_weekly_reply   _buy_weekly     = 4; // 购买周礼包
    optional mall_gift_buy_once_reply     _buy_once       = 5; // 购买一次性礼包
    optional mall_gift_view_timely_reply  _view_timely    = 6; // 查看限时礼包
    optional mall_gift_buy_timely_reply   _buy_timely     = 7; // 购买限时礼包

    optional string     _error_code     = 99; // 错误码
}

// 商城礼包商品
message mall_gift_goods {
    optional uint32     _gift_id        = 1; // 礼包ID
    optional uint32     _cur_buy_times  = 2; // 当前购买次数
    optional uint32     _max_buy_times  = 3; // 最大购买次数
    optional uint32     _deadline       = 4; // 下架时间
    optional bool       _view_flag      = 5; // 查看标志
}

// 打开面板
message mall_gift_open_panel_reply {
    optional uint32             _day_acc            = 1; // 累计天数
    optional uint32             _free_group         = 2; // 免费奖励分组
    optional bool               _free_reward_flag   = 3; // 免费奖励标志
    repeated mall_gift_goods    _daily_gifts        = 4; // 每日礼包数组
    repeated mall_gift_goods    _weekly_gifts       = 5; // 每周礼包数组
    repeated mall_gift_goods    _once_gifts         = 6; // 一次性礼包数组
    repeated mall_gift_goods    _timely_gifts       = 7; // 限时礼包数组
}

// 免费奖励
message mall_gift_free_reward_reply {
    repeated reward     _rewards = 1; // 奖励
}

// 购买日礼包
message mall_gift_buy_daily_reply {
    optional result     _result     = 1; // 购买结果
    repeated reward     _rewards    = 2; // 获得奖励
}

// 购买周礼包
message mall_gift_buy_weekly_reply {
    optional result     _result     = 1; // 购买结果
    repeated reward     _rewards    = 2; // 获得奖励
}

// 购买一次性礼包
message mall_gift_buy_once_reply {
    optional result     _result     = 1; // 购买结果
    repeated reward     _rewards    = 2; // 获得奖励
}

// 查看限时礼包
message mall_gift_view_timely_reply {
    optional mall_gift_goods     _goods = 1; // 礼包信息
}

// 购买限时礼包
message mall_gift_buy_timely_reply {
    optional result     _result     = 1; // 购买结果
    repeated reward     _rewards    = 2; // 获得奖励
}

// 活动红点提示
message activity_hint_reply {
    optional activity_hint_pull_reply         _pull       = 1; // 拉取提示信息
    optional activity_hint_resolve_reply      _resolve    = 2; // 消除提示信息
}

// 活动提示记录
// 提示KEY格式为 "HintType-ActID-ActType", HintType = Once | Daily
message activity_hint_record {
    optional uint32     _act_id                = 1; // 提示KEY
    optional uint32     _last_resolve_time  = 2; // 上次消除提示时间
}

// 拉取活动提示信息
message activity_hint_pull_reply {
    repeated activity_hint_record  _records = 1; // 提示数组
}

// 消除活动提示信息
message activity_hint_resolve_reply {
    optional result     _result = 1; // 结果
}


// 公会山
message guild_mount_reply {
    optional guild_mount_open_panel_reply       _open_panel     = 1; // 打开面板
    optional guild_mount_open_boss_reply        _open_boss      = 2; // 打开BOSS
    optional guild_mount_query_damage_reply     _query_damage   = 3; // 查询伤害排行
    optional guild_mount_start_battle_reply     _start_battle   = 4; // 开始战斗
    optional guild_mount_end_battle_reply       _end_battle     = 5; // 结束战斗
    optional guild_mount_gain_reward_reply      _gain_reward    = 6; // 领取奖励
    optional guild_mount_pull_event_reply       _pull_event     = 7; // 拉取事件
    optional guild_mount_score_rankboard_reply  _score_rank     = 8; // 查询积分排行
    optional guild_mount_guild_rankboard_reply  _guild_rank     = 9; // 查询公会排行
    optional guild_mount_query_goods_reply      _query_goods    = 10; // 查询商品
    optional guild_mount_buy_goods_reply        _buy_goods      = 11; // 购买商品
    optional result                             _change_display = 12; // 更换形象
    optional guild_mount_guild_member_rb_reply  _guild_member_rb    = 13; // 公会个人今日排行榜
    optional guild_mount_practice_reply         _practice       = 14; // 练习模式
    optional string _error_code = 99; //  错误码
}

// 公会山状态
enum guild_mount_state {
    wait = 0; // 等待，未开始
    preview = 1; // 预告
    open = 2; // 开启，活动已开始
    show = 3; // 展示，活动已结束
}

// 公会山BOSS
message guild_mount_boss_info {
    optional uint32     _id = 1; // BOSSID
}

// 伤害记录
message guild_mount_damage_record {
    optional double                 _damage = 1; // 伤害值
    optional double                 _uuid = 2; // 玩家的UUID
    optional user_summary           _user_summary = 3; // 玩家摘要
    repeated hero_summary           _heroes = 4; // 英雄列表
}


// 打开界面
message guild_mount_open_panel_reply {
    optional uint32                 _season = 1; // 赛季
    optional guild_mount_state      _state = 2; // 当前活动状态
    optional uint32                 _end_time = 3; // 状态结束时间
    optional uint32                 _left_battle_times = 4; // 剩余战斗次数
    optional uint32                 _acc_battle_times = 5; // 累计挑战次数
    repeated uint32                 _reward_flags = 6; // 奖励领取标志
    optional guild_mount_boss_info  _boss = 7; // 当前BOSS信息
    optional uint32                 _player_rank = 8; // 个人排名
    optional uint32                 _guild_rank = 9; // 公会排名
    repeated uint32                 _used_hero_list = 10; // 已经使用的英雄列表
    optional uint32                 _left_exit_times = 11; // 剩余退出战斗次数
    optional uint32                 _zone_id = 12; // 赛区ID
    optional uint32                 _coins = 13; // 异界币
    repeated uint32                 _boss_list = 14; // BOSS前瞻
}


// 打开BOSS页面
message guild_mount_open_boss_reply {
    optional guild_mount_boss_info      _boss = 1; // BOSS信息
    optional user_summary               _battling_user = 2; // 玩家摘要
    optional uint32                     _battling_count = 3; // 战斗中的玩家数量
    optional guild_mount_damage_record  _top_damage = 4; // 最高伤害
    optional hire_data                  _hire_hero = 5; // 佣兵信息
}

// 查询伤害
message guild_mount_query_damage_reply {
    repeated guild_mount_damage_record  _damages = 1; // 伤害列表
}


// 开始战斗
message guild_mount_start_battle_reply {
    optional guild_mount_boss_info      _boss = 1; // BOSS信息同步
    optional uint32                     _rseed = 2; // 战斗种子
}

// 结束战斗
message guild_mount_end_battle_reply {
    optional battle_result              _result = 1; // 战斗结果
    optional uint32                     _checkid = 2; // 战斗校验ID，战斗校验出错时返回
    optional double                     _damage = 3; // 伤害值
    optional uint32                     _add_score = 4; // 获得积分
    optional uint32                     _total_score = 5; // 总积分
    repeated reward                     _rewards = 6; // 奖励列表
    optional uint32                     _acc_battle_times = 7; // 总战斗次数
    optional guild_mount_damage_record  _top_damage = 8; // 最高伤害记录
    optional uint32                     _add_coins = 9; // 获得异界币
    optional bool                       _is_new_record = 10; // 是否新的最大伤害纪录
}

// 获取奖励
message guild_mount_gain_reward_reply {
    optional uint32     _index      = 1; // 奖励的位置
    optional uint32     _add_coins  = 2; // 获得异界币
}

// 伤害事件
message guild_mount_damage_event {
    optional uint32         _time           = 1; // 时间戳
    optional uint32         _boss_id        = 2; // BOSS名称
    optional uint32         _user_id        = 3; // 玩家ID
    optional string         _nick_name      = 4; // 玩家昵称
    optional double         _damage         = 5; // 伤害值
    optional uint32         _from_health    = 6; // BOSS开始血量
    optional uint32         _to_health      = 7; // BOSS结束血量
    optional hero_summary   _hero_summary   = 8; // 展示的英雄形象
}

// 进入玩法事件
message guild_mount_enter_event {
    optional uint32         _time           = 1; // 时间戳
    optional user_summary   _user_summary   = 2;
    optional hero_summary   _hero_summary   = 3; // 展示的英雄形象
    optional bool           _is_in_battle   = 4; // 是否正在战斗中
}

// 拉取事件
message guild_mount_pull_event_reply {
    repeated guild_mount_damage_event   _damage_events = 1; // 造成伤害事件列表
    repeated guild_mount_enter_event    _enter_events  = 2; // 进入玩法事件列表
}

// 查询积分排行榜
message guild_mount_score_rankboard_reply {
    repeated ranklist_item                  _rank_list     = 1; // 排名列表
    optional ranklist_item                  _self_rank     = 2; // 自己排名
    optional uint32                         _self_pos      = 3; // 自己名次
}


// 公会排行
message guild_mount_guild_rankitem {
    optional guild_summary  _guild_summary  = 1; // 公会排行
    optional uint32         _boss_id        = 2; // BOSSID
    optional uint32         _boss_hp        = 3; // BOSS血量
    optional uint32         _score          = 4; // 积分
    optional string         _plat           = 5; // 平台名称
    optional uint32         _show_server_id = 6; // 显示的服务器ID
}

// 查询公会排行榜
message guild_mount_guild_rankboard_reply {
    repeated ranklist_item                  _rank_list      = 1; // 排名列表
    optional ranklist_item                  _self_rank      = 2; // 自己排名
    optional uint32                         _self_pos       = 3; // 自己名次
    optional guild_summary                  _self_guild     = 4; // 公会摘要
}

// 通知
message guild_mount_notify {
    optional uint32             _season         = 1; // 当前赛季
    optional guild_mount_state  _state          = 2; // 当前状态
    optional bool               _battle_hint    = 3; // 可挑战提示
    optional bool               _rewards_hint   = 4; // 总挑战次数领奖提示
}

message guild_mount_goods {
    optional uint32     _group_id       = 1; // 兑换ID
    optional uint32     _index          = 2; // 商品ID
    optional uint32     _cur_buy_times  = 3; // 当前购买次数
    optional uint32     _max_buy_times  = 4; // 最大购买次数
}

// 查询商品
message guild_mount_query_goods_reply {
    repeated guild_mount_goods _goods = 1; // 商品
}

// 购买商品
message guild_mount_buy_goods_reply {
    optional uint32 _group_id      = 1; // 商品组
    optional uint32 _goods_index   = 2; // 商品下表
    optional uint32 _cur_buy_times = 3; // 数量
    optional uint32 _left_coin     = 4; // 剩余数量
    repeated reward _rewards       = 5; // 奖励
}

// 公会个人今日排行榜
message guild_mount_guild_member_rb_reply {
    repeated guild_mount_guild_member_rb_item   _rank_list      = 1; // 排名列表
}

message guild_mount_guild_member_rb_item{
    optional user_summary                   _user_summary   = 1;
    optional uint32                         _score          = 2; // 当日积分
    repeated guild_mount_rb_battle_record   _battle_record  = 3; // 挑战记录
}

message guild_mount_rb_battle_record {
    optional uint32         _boss_id    = 1;
    optional bool           _is_extra   = 2; // 是否是补时战斗
}

// 魔界讨伐 练习模式
message guild_mount_practice_reply {
    optional uint32     _add_score  = 1; // 增加积分
}

//萌新助力模块
message newplayer_reply {
    optional newplayer_open_panel_reply        _open_panel         = 1; // 打开面板
    optional newplayer_once_reward_reply       _once_reward        = 2; // 领取一次性奖励
    optional newplayer_line_reward_reply       _line_reward  = 3; // 阶段奖励
    optional newplayer_buy_goods_reply         _buy_goods          = 4; // 购买商品
    optional newplayer_task_reward_reply       _task_reward        = 5; // 任务奖励
    optional newplayer_task_line_reward_reply  _task_line_reward   = 6; // 任务阶段奖励

    optional string                     _error_code                = 21; // 错误码
}

message newplayer_bonus {
    optional uint32     _id      = 1; // ID
    optional uint32     _used    = 2;  //次数
}

message newplayer_task {
    enum status {
        lock = 0;
        doing = 1;
        reward = 2;
        complete = 3;
    }
    optional uint32     _id                 = 1; // 任务ID
    optional status     _status             = 2; // 任务状态
    optional uint32     _task_target        = 3; // 当前进度
    optional uint32     _task_day           = 4; // 任务天数
}

message user_newplayer {
    optional uint32         _act_id                    = 1; // 活动ID，0=不再活动中
    optional uint32         _active_time               = 2; // 参与活动的开始时间
    optional uint32         _cur_task_day              = 3; // 参与活动的第几天
    optional bool           _once_reward_flag          = 4; // 一次性奖励领取标记,true=已领取
    repeated bool           _line_reward_flags         = 5; // 登录阶段性奖励领取标记，[true,false,false,...]，true=已领取
    optional uint32         _login_day_acc             = 6; // 累计登录天数
    repeated uint32         _goods_buy_flags           = 7; // 商品购买标记，[Time,0,0,...]，Time>0 表示购买时间
    repeated newplayer_bonus   _bonus_list             = 8; // 福利数据列表
    repeated newplayer_task    _task_list              = 9; // 任务列表
    optional uint32         _task_line_progress        = 10; // 任务阶段进度
    repeated bool           _task_line_reward_flags    = 11; // 任务阶段奖励标志
}

message newplayer_open_panel_reply {
    optional user_newplayer    _newplayer         = 1; // 活动数据
}

message newplayer_once_reward_reply {
    repeated reward     _rewards    = 1; // 奖励
}

message newplayer_line_reward_reply {
    optional uint32     _index      = 1; // 奖励索引
    repeated reward     _rewards    = 2; // 奖励
}

message newplayer_buy_goods_reply {
    optional uint32     _index      = 1; // 商品索引
    repeated reward     _rewards    = 2; // 奖励
    optional uint32     _cost       = 3; // 消耗
}

message newplayer_task_reward_reply {
    optional uint32     _task_id        = 1; // 任务ID
    repeated reward     _rewards        = 2; // 奖励
    optional uint32     _line_progress  = 3; // 阶段奖励进度同步
}

message newplayer_task_line_reward_reply {
    optional uint32     _index      = 1; // 奖励索引
    repeated reward     _rewards    = 2; // 奖励
}

message daily_pass_reply {
    optional daily_pass_open_panel_reply   _open_panel        = 1; // 返回daily_pass信息
    optional daily_pass_level_reward_reply _level_reward      = 2;// 普通通行证等级奖励
    optional daily_pass_sweep_reward_reply _sweep_reward      = 3; // 一键领取
    optional daily_pass_buy_level_reply    _buy_level         = 4; // 购买等级
    optional string                       _error_code        = 21; // 错误码
}

message daily_pass_reward_index {
    optional uint32   _index      =  1; // Pass等级对应
    repeated uint32   _reward_idx =  2; // 多个奖励下表
}

message user_daily_pass {
    optional uint32    _act_id                       = 1;    //活动id
    optional bool      _is_advanced                  = 2;    //通行证类型；
    optional uint32    _pass_id                      = 3;    //pass id
    optional uint32    _level                        = 4;    //通行证等级
    optional uint32    _total_exp                    = 5;    //通行证经验
    optional uint32    _today_exp                    = 6;    //今日经验获取
    repeated daily_pass_reward_index    _free_pass_flags         = 7;    // 普通通行证奖励领取标记
    repeated daily_pass_reward_index    _advanced_pass_flags     = 8;    // 高级通行证奖励领取标记
}

message daily_pass_open_panel_reply {
    optional user_daily_pass      _daily_pass        = 1; //通行证数据
    optional uint32               _exp_end_time      = 2; //获取经验结束时间
    optional uint32               _reward_end_time   = 3; //获取奖励结束时间
    optional uint32               _reward_count      = 4; //待领取奖励数量
    optional double               _bonus             = 5; //加成倍率
}

message daily_pass_level_reward_reply {
    optional uint32     _index        = 1; // 索引
    optional uint32     _reward_index = 2; // 奖励索引
    optional bool       _is_advanced  = 3; // 是否是高级通行证
    repeated reward     _rewards      = 4; // 奖励
    optional uint32     _reward_count = 5; // 未领取奖励个数
}

message daily_pass_sweep_reward_reply {
    repeated daily_pass_reward_index    _free_pass_flags         = 1;    // 普通通行证奖励领取标记
    repeated daily_pass_reward_index    _advanced_pass_flags     = 2;    // 高级通行证奖励领取标记
    optional uint32                     _reward_count            = 3;    // 未领取奖励个数
}

message daily_pass_buy_level_reply {
    optional uint32    _level                        = 1;    //通行证等级
    optional uint32    _total_exp                    = 2;    //通行证经验
    optional uint32    _today_exp                    = 3;    //今日经验获取
    optional packed_diamond    _diamond              = 4;    //钻石数量
}

message daily_pass_daily {
    optional bool   _is_advanced   = 1; // 是否是高级通行证;
    optional uint32 _level         = 2; // 通行证等级
    optional uint32 _reward_count  = 3; // 未领取个数
}

message daily_pass_notify {
    optional uint32 _actid           = 1; // 通行证存在提示
    optional bool   _reward_hint     = 2; // 可领取奖励提示
    optional bool   _newpass_hint    = 3; // 新通行证提示
}

// 英雄小人
message hero_man_reply {
    optional hero_man_trigger_reply   _trigger     = 1; // 触发英雄
    optional string                   _error_code  = 9; // 错误代码
}

message hero_man_trigger_reply {
    optional uint32             _acc_times  = 1; // 累计触发次数
    repeated reward             _rewards    = 2; // 奖励，为空本次登录不再触发
}

// 战斗校验控制通知信息
message btc_ctrl_notify {
    optional string         _battle_type    = 1; // 战斗类型
    optional bool           _open_btlog     = 2; // 是否打开战斗日志
    optional uint32         _btlog_id       = 3; // 校验日志ID
}



// 简单商店
message simple_goods {
    optional uint32         _id               = 1; // 商品ID
    optional uint32         _item_id          = 2; // 物品ID （商品内容）
    optional uint32         _item_amount      = 3; // 物品数量
    optional goods.price_type   _price_type   = 4; // 价格类型
    optional uint32         _price_value      = 5; // 商品价格
    optional uint32         _cur_buy_times    = 6; // 当前购买次数
    optional uint32         _max_buy_times    = 7; // 最大购买次数
    optional uint32         _deadline         = 8; // 截止时间
}

// 简单商店回复
message simple_shop_reply {
    optional simple_shop_buy_reply      _buy = 1; // 购买

    optional string                 _error_code = 21; // 错误码
}
// 购买
message simple_shop_buy_reply {
    optional uint32     _goods_id       = 1; // 商品ID
    repeated reward     _rewards        = 2; // 奖励
}

// 新增商品
message simple_shop_newly {
    optional uint32     _shop_id    = 1; // 商店
    repeated uint32     _goods_ids  = 2; // 新增商品ID列表
}
// 简单商店的红点提示
message simple_shop_notify {
    repeated simple_shop_newly  _newlys = 1; // 新增商品提示
}
//=========================================================
//  快速装备选择箱 fast_equip_chest_use
//=========================================================
message fast_equip_chest_use_reply {
    optional result   _result       = 1;  // 是否使用成功

    optional string   _error_code   = 99; // 错误码
}

//=========================================================
// 新信使兑换活动 new_compose
//=========================================================
message new_compose_reply {
    optional new_compose_open_panel_reply    _open_panel   = 1; // 打开面板
    optional new_compose_exchange_reply      _exchange     = 2; // 道具兑换
    optional string                          _error_code   = 99; // 错误码
}
message new_compose_open_panel_reply {
    repeated new_compose_item   _compose   =1; // 信使兑换
}

message new_compose_item {
    optional uint32         _id     = 1; // 兑换id
    repeated compose_item   _item   = 2; // 兑换道具
    repeated compose_item   _reward = 3; // 兑换奖励
    optional uint32         _total_exchange_times  = 4; // 总的兑换次数
    optional uint32         _remain_exchange_times = 5; // 剩余兑换次数
}

message compose_item {
    optional string     _type    = 1; // 物品类型
    optional uint32     _id      = 2; // 物品id
    optional uint32     _amount  = 3; // 物品数量

}

message new_compose_exchange_reply {
    optional result   _result                = 1; // 是否兑换成功
    optional uint32   _remain_exchange_times = 2; // 剩余兑换次数
}

//=========================================================
// 召唤法阵 summon_circle (全新抽卡)
//=========================================================
message summon_circle_reply {
    optional summon_circle_open_panel_reply   _open_panel  = 1; // 打开界面
    optional summon_circle_summon_reply       _summon      = 2; // 抽卡
    optional summon_circle_switch_wish_reply  _switch_wish = 3; // 切换愿望单
    optional summon_circle_buy_ticket_reply   _buy_ticket  = 4; // 购买抽奖券
    optional summon_circle_query_records_reply _query_records = 5; // 查询召唤记录
    optional summon_circle_take_rewards_reply  _take_rewards  = 6; // 领取新手卡池奖励

    optional string                         _error_code     = 99; // 错误码
}

message beginner_hot_hero {
    optional uint32    _hero_id        = 1; // 热门英雄ID
    optional double    _hot_value      = 2; // 热度值
}

message extra_summon_info {
    optional summon_type   _type               = 1; // 类型
    optional uint32        _hero_id            = 2; // 许愿英雄ID
    optional uint32        _total_count        = 3; // 总次数
    optional bool          _reward_flag        = 4; // 奖励领取标记
    optional uint32        _end_time           = 5; // 结束时间
    repeated beginner_hot_hero   _hot_heroes   = 6; // 热门英雄
}

message summon_circle_open_panel_reply {
    repeated summon_circle_hero_wish   _wish_list    = 1; // 愿望单
    optional uint32                    _lucky_point  = 2; // 保底
    optional uint32                    _total_summon_count = 3; // 普通召唤总次数
    optional uint32                    _hero_id            = 4; // 命定召唤许愿英雄ID
    optional uint32                    _destiny_lucky_point        = 5; // 保底
    optional uint32                    _destiny_total_summon_count = 6; // 召唤总次数
    optional uint32                    _timely_total_summon_count  = 7; // 限时召唤总次数
    optional uint32                    _beginner_hero_id             = 8; // 新手召唤许愿英雄ID
    optional uint32                    _beginner_total_summon_count  = 9; // 新手召唤总次数
    optional bool                      _beginner_reward_flag         = 10; // 新手召唤奖励领取
    optional uint32                    _beginner_end_time            = 11; // 新手召唤结束时间
    repeated beginner_hot_hero         _beginner_hot_heroes          = 12; // 新手召唤热门英雄
    repeated extra_summon_info         _extra_summon_info            = 13; // 其他召唤信息
}

message summon_circle_summon_reply {
    repeated  reward     _reward    = 1; // 奖励
    repeated  uint32     _smash_idx = 2; // 英雄转换成灵魂石的位置
    repeated  hero       _heroes    = 3; // 英雄结构
    optional  uint32     _lucky_point = 4; // 保底次数
    optional  uint32     _item_count  = 5; // 剩余道具数量
    optional  summon_type _type       = 6; // 类型
}

message summon_circle_switch_wish_reply {
    optional result    _result  = 1; // 是否成功
}

message summon_circle_buy_ticket_reply {
    optional result    _result     = 1; // 是否成功
    optional uint32    _item_count = 2; // 剩余道具数量
    optional summon_type _type     = 3; // 类型
}

message summon_circle_record {
    optional  uint32     _time   = 1; // 抽奖时间
    optional  reward     _reward = 2; // 奖励
}

message summon_circle_query_records_reply {
    optional  summon_type           _type   = 1; // 类型
    repeated  summon_circle_record  _records = 2; // 记录
}

message summon_circle_take_rewards_reply {
    optional  summon_type   _type   = 1; // 类型
    repeated  reward        _reward = 2; // 奖励
}


message cut_read_mail_reply {
    optional  result   _result = 1; // 是否成功
}

// 同步限时道具通知
message timely_item_notify {
    repeated timely_item  _new_timely_item    = 1; // 新增限时道具
}

message achievement_notify {
    optional  uint32   _line_id = 1;
    optional  uint32   _id      = 2;
}

//=========================================================
// 新版签到 new_daily_login
//=========================================================
//签到信息
message daily_login {
    optional uint32      _last_login_time   = 1; // 玩家上次领取登陆奖励的时间
    optional bool        _reward_status     = 2; // 玩家最近一次签到的奖励领取状态
    repeated uint32      _logined_days      = 3; // 已签到过的自然天
    optional uint32      _frequent          = 4; // 累计签到天数
    repeated uint32      _make_up_days      = 5; // 可补签的自然天
}

// 签到奖励
message daily_login_reward_reply {
    repeated reward        _login_rewards     = 1; // 当天签到的奖励
    repeated reward        _line_rewards      = 2; // 累计签到的奖励

    optional string        _error_code        = 99; // 错误码
}

//=========================================================
//  幻境探险 fancy_tower
//=========================================================
// 幻境塔回复
message fancy_tower_reply {
    optional fancy_tower_open_panel_reply       _open_panel     = 1; // 打开面板
    optional fancy_tower_start_battle_reply     _start_battle   = 2; // 开始战斗
    optional fancy_tower_end_battle_reply       _end_battle     = 3; // 结束战斗
    optional fancy_tower_sweep_reply            _sweep          = 4; // 关卡扫荡
    optional fancy_tower_star_reward_reply      _star_reward    = 5; // 星星奖励
    optional fancy_tower_candle_buy_reply       _candle_buy     = 6; // 购买幻生烛

    optional string     _error_code     = 99; // 错误码
}

// 打开面板
message fancy_tower_open_panel_reply {
    repeated fancy_tower_record _records                    = 1; // 通关塔记录
    optional uint32             _candle_count               = 2; // 玩家幻生烛数量
    optional uint32             _daily_candle_cur_buy_times = 3; // 幻生烛今日已购买次数
    optional uint32             _daily_candle_max_buy_times = 4; // 幻生烛每日最大购买次数
    optional uint32             _candle_last_recover_time   = 5; // 幻生烛最近一次的恢复时间
    optional uint32             _stars                      = 6; // 玩家收集的总星星数量
    repeated uint32             _star_ids                   = 7; // 已领取的星星奖励ids
    repeated uint32             _open_towers                = 8; // 开启的塔ID数组
    optional packed_fancy_abyss _fancy_abyss                = 9; // 幻境深渊数据
}

// 塔记录
message fancy_tower_record {
    optional uint32             _id          = 1; // 塔ID
    optional uint32             _cur_floor   = 2; // 目前挑战过的最高层数
    optional uint32             _tower_stars = 3; // 塔星星数量
    repeated fancy_stage_record _stage       = 4;
}

message fancy_stage_record {
    optional uint32   _floor       = 1; // 层数
    optional uint32   _stage_star  = 2; // 关卡星星获取数量
}

// 开始战斗
message fancy_tower_start_battle_reply {
    optional uint32                     _rseed      = 1; // 战斗种子
}

// 结束战斗
message fancy_tower_end_battle_reply {
    optional battle_result    _result             = 1; // 战斗结果
    repeated reward           _first_rewards      = 2; // 首次奖励列表
    repeated reward           _rewards            = 3; // 普通奖励列表
    optional uint32           _candle_count       = 4; // 玩家幻生烛数量
    optional uint32           _checkid            = 5; // 战斗校验ID，战斗校验出错时返回
}

// 星星奖励
message fancy_tower_star_reward_reply {
    optional result      _result       = 1; // 是否领取成功
    repeated reward      _rewards      = 2; // 奖励
}

// 关卡扫荡的返回
message fancy_tower_sweep_reply {
    repeated reward           _rewards        = 1; // 奖励列表
    optional uint32           _candle_count   = 2; // 玩家幻生烛数量
}

// 购买幻生烛
message fancy_tower_candle_buy_reply {
    optional result     _result                 = 1; // 是否购买成功
    optional uint32     _candle_count           = 2; // 玩家幻生烛数量
    optional uint32     _daily_candle_buy_times = 3; // 幻生烛每日剩余购买次数
}

//=========================================================
//  战役章节星星宝箱奖励 stage
//=========================================================
message stage_star_reward_reply {
    optional result      _result       = 1; // 是否领取成功
    repeated reward      _rewards      = 2; // 奖励
}


//=========================================================
//  新团本 guild_raid
//=========================================================
message guild_raid_reply {
    optional guild_raid_open_panel_reply      _open_panel     = 1; // 打开面板
    optional guild_raid_open_instance_reply   _open_instance  = 2; // 开启团本实例
    optional guild_raid_reset_instance_reply  _reset_instance = 3; // 重置团本实例
    optional guild_raid_query_instance_reply  _query_instance = 4; // 查询团本实例
    optional guild_raid_query_stage_reply     _query_stage    = 5; // 查询关卡
    optional guild_raid_prepare_battle_reply  _prepare_battle = 6; // 准备战斗
    optional guild_raid_start_battle_reply    _start_battle   = 7; // 开始战斗
    optional guild_raid_end_battle_reply      _end_battle     = 8; // 结束战斗
    optional guild_raid_view_members_reply    _view_members   = 9; // 查看成员列表
    optional guild_raid_member_rank_reply     _member_rank    = 10; // 成员单次伤害排行榜
    optional guild_raid_stage_rank_reply      _stage_rank     = 11; // 关卡伤害排行榜
    optional guild_raid_query_user_reply      _query_user     = 12; // 查询玩家数据

    optional string      _error_code     = 99; // 错误码
}


// 团本实例摘要数据
message guild_raid_instance_summary {
    optional uint32     _raid_id            = 1; // 团本ID
    optional uint32     _progress           = 2; // 团本进度
    optional uint32     _fast_deadline      = 3; // 快速奖励截至时间
    optional uint32     _fast_raid_point    = 4; // 快速奖励团本币
    optional uint32     _cur_battle_times   = 5; // 当前挑战次数
    optional uint32     _max_battle_times   = 6; // 最大挑战次数
}

// 团本挑战者信息
message guild_raid_challenger {
    enum challenge_status {
        prepare   = 1; // 准备中
        fighting  = 2; // 挑战中
        tally_up  = 3; // 结算中
    }
    optional challenge_status       _status         = 1; // 挑战状态
    optional uint32                 _end_time       = 2; // 状态结束时间
    optional user_summary           _user_summary   = 3; // 玩家摘要信息
}

// 团本实例关卡信息
message guild_raid_instance_stage {
    optional uint32                     _stage_id           = 1; // 关卡ID
    optional uint32                     _progress           = 2; // 关卡进度
    optional uint32                     _wave               = 3; // 当前波数
    repeated uint32                     _hp_list            = 4; // 血量列表
    optional guild_raid_challenger      _challenger         = 5; // 当前挑战者
}

// 打开面板
message guild_raid_open_panel_reply {
    repeated guild_raid_instance_summary    _open_instances         = 1; // 已开启团本
    optional uint32                         _cur_discount_times     = 2; // 当前使用优惠次数
    optional uint32                         _max_discount_times     = 3; // 最大使用优惠次数
    optional uint32                         _cur_weekly_liveness    = 4; // 当前每周活跃度
    optional uint32                         _max_weekly_liveness    = 5; // 最大每周活跃度
    repeated uint32                         _passed_raid_ids        = 6; // 已通关的团本ID列表
}

// 开启团本实例
message guild_raid_open_instance_reply {
    optional result                         _result         = 1; // 操作结果
    optional guild_raid_instance_summary    _instance       = 2; // 是否有折扣, 校验
    optional uint32                         _left_liveness  = 3; // 剩余的活跃度
}

// 重置团本实例
message guild_raid_reset_instance_reply {
    optional result                         _result         = 1; // 操作结果
    optional guild_raid_instance_summary    _instance       = 2; // 是否有折扣, 校验
    optional uint32                         _left_liveness  = 3; // 剩余的活跃度
}

// 查询团本实例
message guild_raid_query_instance_reply {
    optional guild_raid_instance_summary    _instance           = 1; // 团本实例摘要信息
    repeated guild_raid_instance_stage      _stages             = 2; // 关卡列表
    optional sint32                         _top_damage_bonus   = 3; // 最高伤害加成百分比，50=50%
    optional sint32                         _gs_level_bonus     = 4; // 战力等级加成百分比，50=50%，可能为负
    optional uint32                         _raid_point         = 5; // 预计团本币
    optional uint32                         _join_process       = 6; // 加入时团本进度，万分比
}

// 查询团本关卡
message guild_raid_query_stage_reply {
    optional guild_raid_instance_stage  _stage              = 1; // 关卡ID
    optional uint32                     _cur_battle_times   = 2; // 当前挑战次数
    optional uint32                     _max_battle_times   = 3; // 最大挑战次数
}

// 团本准备战斗
message guild_raid_prepare_battle_reply {
    enum prepare_result {
        success             = 0; // 成功
        progress_updated    = 1; // 挑战进度有更新
        challenger_updated  = 2; // 挑战者有更新
        prepare_cd          = 3; // 准备CD，下次可准备时间
    }
    optional prepare_result             _result             = 1; // 是否准备成功，不成功就刷新一下关卡
    optional guild_raid_instance_stage  _stage              = 2; // 关卡信息，result不为success时返回
    optional uint32                     _next_prepare_time  = 3; // 下次可准备时间
    optional uint32                     _left_time          = 4; // 本次准备剩余时间
    optional uint32                     _cur_battle_times   = 5; // 当前挑战次数
    optional uint32                     _max_battle_times   = 6; // 最大挑战次数
}

// 团本开始战斗
message guild_raid_start_battle_reply {
    optional guild_raid_instance_stage  _stage          = 1; // 关卡信息
    optional uint32                     _rseed          = 2; // 战斗种子
    repeated uint32                     _loots          = 3; // 掉落道具
    optional uint32                     _start_time     = 4; // 战斗开始时间
    optional uint32                     _retry_left     = 5; // 剩余重试次数
}

// 团本破纪录
message guild_raid_break_history {
    optional uint32         _stage_id           = 1; // 关卡ID
    optional double         _damage             = 2; // 新伤害
    optional double         _old_damage         = 3; // 老的伤害
    optional user_summary   _old_summary        = 4; // 老的玩家
}

// 团本结束战斗
message guild_raid_end_battle_reply {
    optional battle_result                  _result             = 1; // 战斗结果
    optional guild_raid_instance_summary    _instance           = 2; // 团本实例摘要信息
    repeated guild_raid_instance_stage      _stages             = 3; // 关卡列表
    optional uint32                         _stage_old_progress = 4; // 关卡旧的进度
    repeated reward                         _rewards            = 5; // 奖励
    optional guild_raid_break_history       _break_history      = 6; // 破纪录

}

// 团本实例成员
message guild_raid_member {
    optional user_summary       _user_summary       = 1; // 玩家信息
    optional uint32             _cur_battle_times   = 2; // 当前挑战次数
    optional uint32             _max_battle_times   = 3; // 最大挑战次数
    optional uint32             _join_process       = 4; // 加入时团本进度，万分比
}

// 团本成员
message guild_raid_member_damage {
    optional uint32             _rank               = 1; // 排名
    optional double             _damage             = 2; // 最高伤害
    optional user_summary       _user_summary       = 3; // 玩家信息
    optional sint32             _damage_bonus       = 4; // 伤害奖励加成
}

// 查看团本成员列表
message guild_raid_view_members_reply {
    repeated guild_raid_member     _members         = 1; // 成员列表
}

// 团本成员单次伤害排行榜
message guild_raid_member_rank_reply {
    repeated guild_raid_member_damage   _damages        = 1; // 伤害排名
    optional guild_raid_member_damage   _self_damage    = 2; // 当前排行
}

// 团本关卡本服排行
message guild_raid_stage_rank_reply {
    optional uint32             _stage_id       = 1; // 关卡ID
    repeated dps_rank           _dps_rank       = 2; // 伤害排行
    optional guild_first_pass   _first_pass     = 3; // 关卡首杀记录
    optional guild_fast_pass    _fast_pass      = 4; // 团本快速通关记录
}

// 团本查询玩家数据
message guild_raid_query_user_reply {
    optional uint32   _user_id      = 1; // 玩家ID
    optional uint32   _acc_liveness = 2; // 累计活跃值，离开公会时会带走
}

// dps排名
message dps_rank{
    optional double          _dps      = 1;
    optional uint32          _uid      = 2;
    optional user_summary    _dps_user = 3;
    repeated hero_summary    _heroes   = 4;
    optional uint32          _time     = 5;
}

// 公会首通
message guild_first_pass {
    optional user_summary  _summary = 1;
    optional uint32        _pass_time = 2;
}

// 公会快速过关
message guild_fast_pass {
    optional uint32       _id = 1;
    optional uint32       _icon = 2;
    optional uint32       _time = 3;
    optional string       _name = 4;
}


// 月卡协议
message monthcard_reply {
    optional monthcard_daily_reward_reply     _daily_reward = 1; // 月卡每日领奖
}

// 月卡每日奖励
message monthcard_daily_reward_reply {
    repeated reward     _rewards    = 1; // 奖励
    repeated monthcard  _monthcards  = 2; // 月卡
}

// 处理过期道具
message resolve_expired_item_reply {
    optional result         _result = 1; // 结果
}


// 活动请求
message activity_reply {
    optional activity_pull_reply            _pull           = 1; // 拉取活动信息
    optional activity_task_submit_reply     _task_submit    = 2; // 任务提交
    optional activity_calendar_reply        _calendar       = 3; // 活动日历
    optional activity_choose_reward_reply   _choose_reward  = 4; // 选择奖励
    optional activity_hero_recycle_reply    _hero_recycle   = 5; // 英雄重生
    optional activity_assist_reply          _assist         = 6; // 活动助力
}

// 活动头部信息
message activity_head {
    optional string           _title      = 1;  // 活动名称
    optional string           _desc       = 2;  // 活动描述
    optional string           _rules      = 3;  // 活动规则
    optional uint32           _icon       = 4;  // 活动图标
    optional uint32           _banner     = 5;  // 活动banner
}

// 活动扩展信息，针对部分活动的定制信息
message activity_extend {
    optional string                         _tag                = 1; // 标签
    optional activity_extend_fancy_abyss    _fancy_abyss        = 2; // 幻境深渊扩展信息
}

message activity_extend_fancy_abyss {
    optional uint32 _season_id      = 1; // 赛季id
    optional uint32 _cur_max_floor  = 2; // 当前层数
    optional uint32 _total_time     = 3; // 通关时间
}

// 活动任务
message activity_task {
    optional uint32     _id                     = 1; // 任务ID
    optional string     _cond_type              = 2; // 条件类型
    optional uint32     _cond_id                = 3; // 任务达成条件目标
    optional uint32     _cond_target            = 4; // 任务达成条件目标
    optional uint32     _progress               = 5; // 当前任务进度
    optional uint32     _progress_update_time   = 6; // 任务进度更新时间
    optional uint32     _task_start_time        = 7; // 任务开始时间
    optional uint32     _task_end_time          = 8; // 任务结束时间
    optional uint32     _last_rewards_time      = 9; // 奖励领取时间
    optional uint32     _cur_reward_times       = 10; // 当前奖励次数
    optional uint32     _max_reward_times       = 11; // 最大奖励次数
    repeated reward     _rewards                = 12; // 活动任务奖励
    optional activity_task_extend   _extend     = 13; // 活动任务扩展
}

// 活动任务扩展
message activity_task_extend {
    enum refresh_type{
        never     = 0;
        daily     = 1;
        weekly    = 2;
    }
    optional refresh_type _refresh_type = 1;
    repeated string       _extra_string = 2; // 任务额外填入字符
    repeated reward       _choose_rewards = 3; // 选择的奖励
    optional uint32       _recycle_hero_id = 4; // 重置英雄ID
}


// 活动
message packed_activity {
    optional uint32           _id         = 1;  // 活动序号
    optional uint32           _cfg_id     = 2;  // 活动配置ID
    optional string           _type       = 3;  // 活动类型
    optional uint32           _start_time = 4;  // 开始时间
    optional uint32           _end_time   = 5;  // 结束时间
    optional uint32           _expire_time = 6;  // 过期时间
    optional bool             _is_show    = 7;  // 是否展示活动
    optional uint32           _priority   = 8;  // 活动展示优先级
    optional bool             _is_hot     = 9;  // 是否是精彩活动
    optional string           _hint_key   = 10;  // 提示的key
    repeated activity_task    _tasks      = 21; // 活动奖励
    optional activity_head    _head       = 22; // 头部信息
    optional activity_extend  _extend     = 23; // 扩展信息
}


// 拉取活动信息
message activity_pull_reply {
    repeated packed_activity    _activity_list = 1; // 活动列表
}

// 拉取活动信息
message activity_task_submit_reply {
    optional uint32             _act_id     = 1; // 活动ID
    optional activity_task      _task       = 2; // 任务同步
    repeated reward             _rewards    = 3; // 获得的奖励
}

message act_calendar {
    optional uint32        _day_timestamp    = 1;  // 某天的时间戳
    repeated uint32        _act_ids          = 2; // 活动ID
}

message activity_calendar_reply {
    repeated act_calendar  _acts   = 1; // 某天开启的活动ID
}

// 选择奖励
message activity_choose_reward_reply {
    optional uint32             _act_id     = 1; // 活动ID
    optional activity_task      _task       = 2; // 任务同步
}

// 英雄重生
message activity_hero_recycle_reply {
    optional uint32             _act_id     = 1; // 活动ID
    optional activity_task      _task       = 2; // 任务同步
    repeated reward             _rewards    = 3; // 获得的奖励
    optional hero               _hero       = 4; // 英雄信息
}

// 活动助力
message activity_assist_reply {
    optional uint32            _act_id     = 1; // 活动ID
}

message daily_vitality {
    optional bool _lunch_received       = 1; // 午餐是否领取
    optional bool _dinner_received      = 2; // 晚餐是否领取
    optional uint32 _next_refresh_time  = 3; // 下次刷新时间
}

message daily_vitality_reply {
    optional bool _lunch_received = 1; // 午餐是否领取
    optional bool _dinner_received = 2; // 晚餐是否领取
    optional uint32 _current_vitality = 3; // 当前体力
}

// 简单pass
message simple_pass_reply {
    optional simple_pass_open_panel_reply     _open_panel     = 1; // 打开通行证面板
    optional simple_pass_level_reward_reply   _level_reward   = 2; // 通行证等级奖励
    optional simple_pass_buy_rank_reply       _buy_rank       = 3; // 购买品阶
    optional simple_pass_buy_level_reply      _buy_level      = 4; // 购买等级

}

// 简单pass简历标记
message simple_pass_reward_flag {
    optional uint32     _pos            = 1; // 奖励所属位置, 奖励索引偏移=品级*10000
    repeated uint32     _index_list     = 2; // 该位置奖励索引列表 1=1号索引奖励已领取
}

// 简单pass扩展
message simple_pass_extend {
    optional  uint32   _pass_exp = 1; //经验
}

// 简单pass结构
message packed_simple_pass {
    optional uint32                     _id                 = 1; // 通行证ID
    optional uint32                     _rank               = 2; // 通行证品级，奖励索引偏移=品级*10000
    optional uint32                     _level              = 3; // 通行证等级
    optional uint32                     _end_time           = 4; // 截至时间，0=不过期
    optional uint32                     _expire_time        = 5; // 过期时间，0=不过期
    repeated simple_pass_reward_flag    _reward_flags       = 6; // 奖励领取标记
    optional simple_pass_extend         _extend             = 7; // 扩展信息
}

// 简单pass打开面板
message simple_pass_open_panel_reply {
    optional packed_simple_pass  _pass  = 1; // 通行证类型
}

// 简单pass的等级奖励
message simple_pass_level_reward_reply {
    repeated reward                     _rewards    = 1; // 奖励
    optional packed_simple_pass         _pass       = 2; // 通行证
}

// 简单pass购买品阶
message simple_pass_buy_rank_reply {
    optional packed_simple_pass         _pass       = 1; // 通行证
}

message  simple_pass_buy_level_reply {
    optional packed_simple_pass         _pass       = 1; // 通行证
}

// 简单pass奖励提示
message simple_pass_reward_hint {
    optional uint32   _pass_id        = 1; // 通行证ID
    optional uint32   _reward_count   = 2; // 可领取奖励数量
}

// 简单pass通知
message simple_pass_notify {
    repeated packed_simple_pass         _new_pass_list  = 1; // 新增的pass列表
    repeated simple_pass_reward_hint    _reward_hints   = 2; // 奖励提示列表
}

// 拉取自己的英雄数据
message pull_hero_info_reply {
    repeated hero   _heroes = 1; // 英雄数据
}

message fashion_reply {
    optional fashion_set_reply    _set_fashion   = 1; // 设置皮肤
}

message fashion_set_reply {
    optional result    _result = 1; // 是否成功
    optional uint32    _gs     = 2; // 英雄战力
    optional uint32    _hero   = 3; // 英雄
    optional uint32    _fashion = 4; // 皮肤ID
}

// 充值宝库，神秘宝匣
message charge_vault_reply {
    optional charge_vault_open_panel_reply        _open_panel       = 1; // 打开面板
    optional charge_vault_gain_reward_reply       _gain_reward      = 2; // 领取奖励
    optional charge_vault_infinite_reward_reply   _infinite_reward  = 3; // 无限奖励
}

message charge_vault_open_panel_reply {
    optional uint32     _vault_id       = 1; // 宝库ID,0=不在活动里
    optional uint32     _score          = 2; // 当前奖励
    repeated uint32     _reward_flags   = 3; // 奖励领取标志, 10000+N 表示领取第N个无限奖励
    optional uint32     _end_time       = 4; // 结束时间
}

message charge_vault_gain_reward_reply {
    optional uint32     _index      = 1; // 位置
    repeated reward     _rewards    = 2; // 奖励列表
}

message charge_vault_infinite_reward_reply {
  repeated uint32     _indexes      = 1; // 位置列表, 10000+N 表示领取第N个无限奖励
  repeated reward     _rewards      = 2; // 奖励列表
}

// 活动关卡
message act_adventure_reply {
    optional act_adventure_open_panel_reply      _open_panel     = 1; // 打开面板
    optional act_adventure_enter_stage_reply     _enter_stage    = 2; // 进入关卡
    optional act_adventure_exit_stage_reply      _exit_stage     = 3; // 退出关卡
    optional act_adventure_get_rewards_reply     _get_rewards    = 4; // 获得奖励
    optional act_adventure_sweep_reply           _sweep          = 5; // 关卡扫荡
    optional act_adventure_buy_vitality_reply    _buy_vitality   = 6; // 购买体力
}

message act_adventure_open_panel_reply {
    repeated act_adventure_single_info _single_infos    = 1; // 单个冒险信息
}

message act_adventure_single_info {
    optional uint32                         _act_id                = 1; // 活动id
    optional uint32                         _act_vitality          = 2; // 活动体力
    optional uint32                         _vitality_update_time  = 3; // 体力更新时间
    optional uint32                         _token_amount          = 4; // 活动代币
    optional uint32                         _vitality_buy          = 5; // 活动代币
    repeated act_adventure_stage_info       _stage_infos           = 6; // 关卡信息
    repeated uint32                         _rewards_infos         = 7; // 已领取奖励列表
    optional uint32                         _challenge_level       = 8; // 挑战等级
}

// 活动关卡任务
message act_adventure_task {
    optional uint32     _id                     = 1; // 任务ID
    optional string     _cond_type              = 2; // 条件类型
    optional uint32     _cond_id                = 3; // 任务达成条件目标
    optional uint32     _cond_target            = 4; // 任务达成条件目标
    optional uint32     _task_progress          = 5; // 当前任务进度
    optional uint32     _progress_update_time   = 6; // 任务更新时间
    optional uint32     _day_num                = 7; // 任务天数
    optional uint32     _accept_time            = 8; // 任务开始时间
    optional uint32     _expire_time            = 9; // 任务结束时间
    optional bool       _is_rewarded            = 10; // 是否已领取
}

message act_adventure_stage_info {
    optional uint32  _stage_id          = 1; // 关卡id
    optional uint32  _max_addition      = 2; // 历史最高加成
    optional bool    _is_passed         = 3; // 是否通关
}

message act_adventure_enter_stage_reply {
    optional uint32                     _rseed      = 1; // 战斗种子
}

message act_adventure_exit_stage_reply {
    optional battle_result      _result                 = 1; // 战斗结果
    optional bool               _is_retry               = 2; // 是否尝试重新战斗，返还战斗消耗
    optional uint32             _checkid                = 3; // 战斗校验ID，战斗校验出错时返回
    optional uint32             _coin_amount            = 4; // 代币数
    repeated reward             _rewards                = 5; // 奖励
    optional uint32             _act_id                 = 6; // 活动id
}

message act_adventure_get_rewards_reply {
    repeated reward     _rewards    = 1; // 奖励列表
}

message act_adventure_sweep_reply {
    optional uint32             _act_id                    = 1;
    optional uint32             _token_amount              = 2; // 代币数
}

message act_adventure_buy_vitality_reply {
    optional uint32     _act_id           = 1;
    optional uint32     _cur_vitality     = 2; // 当前活动体力
}

message act_adventure_notify {
    repeated act_adventure_notify_act   _act_info     = 1; // 活动时间
    optional bool                       _has_reward   = 2; // 是否有未领取奖励
}

message act_adventure_notify_act {
    optional uint32                     _act_id         = 1; // 活动id
    optional uint32                     _start_time     = 2; // 活动开启时间
    optional uint32                     _end_time       = 3; // 活动关闭时间
    optional uint32                     _medal_end_time = 4; // 奖励领取关闭时间
    repeated act_adventure_notify_stage _stage_info     = 5; // 关卡时间
}

message act_adventure_notify_stage {
    optional uint32 _stage_id     = 1; // 关卡id
    optional uint32 _open_time    = 2; // 关卡开启时间
}

message dap_report_notify {
  optional string _event  = 1; // 事件名
  optional string _param1 = 2; // 第一个参数
}

// 七日助力
message sevenday_assist_reply {
    optional sevenday_assist_open_panel_reply           _open_panel           = 1; // 打开面板
    optional sevenday_assist_get_task_rewards_reply     _get_task_rewards     = 2; // 获得任务奖励
    optional sevenday_assist_get_line_rewards_reply     _get_line_rewards     = 3; // 获得进度奖励
}

message sevenday_assist_open_panel_reply {
    repeated sevenday_assist_task     _task_lists    = 1; // 任务列表
    repeated sevenday_assist_task     _line_lists    = 2; // 进度任务列表
    optional uint32                   _cur_day       = 3; // 当前天数
    optional uint32                   _active_time   = 4; // 助力开启时间
}

// 七日助力任务
message sevenday_assist_task {
    optional uint32     _id                     = 1; // 任务ID
    optional string     _cond_type              = 2; // 条件类型
    optional uint32     _cond_id                = 3; // 任务达成条件目标
    optional uint32     _cond_target            = 4; // 任务达成条件目标
    optional uint32     _task_progress          = 5; // 当前任务进度
    optional uint32     _progress_update_time   = 6; // 任务更新时间
    optional uint32     _day_num                = 7; // 任务天数
    optional uint32     _accept_time            = 8; // 任务开始时间
    optional uint32     _expire_time            = 9; // 任务结束时间
    optional bool       _is_rewarded            = 10; // 是否已领取
}


message sevenday_assist_get_task_rewards_reply {
    optional uint32     _task_id            = 1; // 任务id
    optional uint32     _cur_line_progress  = 2; // 当前总进度
    repeated reward     _rewards            = 3; // 奖励列表
}

message sevenday_assist_get_line_rewards_reply {
    repeated reward     _rewards    = 1; // 奖励列表
}

message packed_sevenday_assist{
    optional bool       _is_open  = 1; // 是否开启
}

// 幻境深渊
message fancy_abyss_reply {
    optional fancy_abyss_open_panel_reply      _open_panel     = 1; // 打开面板
    optional fancy_abyss_enter_floor_reply     _enter_floor    = 2; // 进入关卡
    optional fancy_abyss_exit_floor_reply      _exit_floor     = 3; // 退出关卡
    optional fancy_abyss_rankboard_reply       _rank           = 4; // 排行榜查询
    optional fancy_abyss_pass_records_reply    _pass_records   = 5; // 最快通关时间记录
}

message packed_fancy_abyss {
    optional uint32                         _season_id                  = 1; // 赛季id
    optional uint32                         _personal_min_total_time    = 2; // 个人最短通关时间
    optional uint32                         _season_start_time          = 3; // 赛季开始时间
    optional uint32                         _season_end_time            = 4; // 赛季结束时间
    optional uint32                         _cur_floor_id               = 5; // 当前层数
}

message packed_fancy_abyss_floor {
    optional uint32                         _floor_id                          = 1; // 关卡id
    optional uint32                         _personal_min_pass_time            = 2; // 个人本层最短通关时间
    optional fancy_abyss_score_rankitem     _server_min_pass_info              = 3; // 本服本层最短通关信息
}

message fancy_abyss_open_panel_reply {
    repeated packed_fancy_abyss_floor       _floor_infos                = 1; // 关卡信息
    optional uint32                         _remain_enter_floor_time    = 2; // 剩余当天进入关卡次数
}

message fancy_abyss_enter_floor_reply {
    optional uint32                     _rseed      = 1; // 战斗种子
    optional uint32                     _remain_enter_floor_time         = 2; // 剩余当天进入关卡次数
}

message fancy_abyss_exit_floor_reply {
    optional battle_result              _result                         = 1; // 战斗结果
    optional uint32                     _checkid                        = 2; // 战斗校验ID，战斗校验出错时返回
    repeated reward                     _rewards                        = 3; // 奖励
    optional fancy_abyss_score_rankitem _server_min_pass_info           = 4; // 本服本层最短通关信息
    optional bool                       _is_break_record                = 5; // 是否破记录
    optional uint32                     _personal_min_total_time        = 6; // 个人最短通关时间
}

// 耗时排行
message fancy_abyss_score_rankitem {
    optional uint32                 _min_time           = 1; // 最短通关时间
    optional user_summary           _user_summary       = 2; // 玩家摘要
    optional string                 _svr_name           = 3; // 显示的服务器ID
}

// 查询总耗时排行榜
message fancy_abyss_rankboard_reply {
    enum rb_type {
        local       = 0; // 本服
        global      = 1; // 全服
    }
    repeated fancy_abyss_score_rankitem   _rank_list     = 1; // 排名列表
    optional fancy_abyss_score_rankitem   _self_rank     = 2; // 自己排名
    optional uint32                       _self_pos      = 3; // 自己名次
    optional rb_type                      _type          = 4;
}

// 幻境深渊 最快通关记录
message fancy_abyss_pass_records_reply {
    enum query_type {
        self = 0; // 自己
        friends_and_guild = 1; //好友及公会
    }
    optional query_type                 _type       = 1;
    optional uint32                     _floor_id   = 2;
    repeated fancy_abyss_pass_record    _records    = 3;
}

message fancy_abyss_pass_record {
    optional user_summary   _user_summary     = 1;
    repeated hero_summary   _heroes           = 2; // 通关英雄
    optional uint32         _time             = 3; // 通关时间
}

message lottery_reply {
    optional    lottery_open_panel_reply    _open_panel   = 1; // 打开界面
    optional    lottery_enter_tray_reply    _enter_tray   = 2; // 进入下一层
    optional    lottery_open_card_reply     _open_card    = 3; // 翻牌
    optional    lottery_line_reward_reply   _line_reward  = 4; // 领取阶段奖励
    optional    lottery_open_tray_reply     _open_tray    = 5; // 开始翻牌
}

message lottery_tray_reward {
    optional uint32    _pos    = 1; //  位置
    repeated reward    _reward = 2; //奖励
    optional bool      _is_big = 3; // 是否是大奖
}

message lottery_open_panel_reply {
    optional  uint32                _coins    = 1; // 代币数量
    optional  uint32                _progress = 2; // 点了多少次了
    optional  uint32                _tray     = 3; // 当前是第几层
    repeated  lottery_tray_reward   _rewards  = 4; // 奖励 未翻牌时返回全部奖励,翻牌是会返回已开启的对应位置的奖励
    repeated  uint32                _line_reward = 5; // 已领取的阶段奖励
    optional  bool                  _state    = 6; //  false代表未翻牌，true代表翻牌
}

message lottery_enter_tray_reply {
    repeated  lottery_tray_reward   _rewards = 1; // 奖励
}

message lottery_open_card_reply {
    repeated  reward   _rewards   = 1; // 奖励
    optional  uint32   _left_coin = 2; // 剩余代币数量
    optional  bool     _is_lucky  = 3; // 是否是大奖
    optional  bool     _is_crit   = 4; // 是否暴击
}

message lottery_line_reward_reply {
    optional uint32     _index   = 1; // 奖励索引
    repeated reward     _rewards = 2; // 奖励
}

message lottery_open_tray_reply {
    optional   result     _result = 1; // 结果
}

//=========================================================
//  赛季竞技场 peak_arena
//=========================================================
// 赛季竞技场回复
message peak_arena_reply {
    optional peak_arena_open_panel_reply        _open_panel     = 1;  // 打开面板
    optional peak_arena_refresh_oppo_reply      _refresh_oppo   = 2;  // 刷新对手
    optional peak_arena_get_lineup_reply        _get_lineup     = 3;  // 获取防守阵容
    optional peak_arena_set_lineup_reply        _set_lineup     = 4;  // 设置防守阵容
    optional peak_arena_query_oppo_reply        _query_oppo     = 5;  // 查询对手信息
    optional peak_arena_query_player_reply      _query_player   = 6;  // 查询玩家信息
    optional peak_arena_challenge_reply         _challenge      = 7;  // 挑战对手
    optional peak_arena_get_records_reply       _get_records    = 8;  // 获取挑战记录
    optional peak_arena_add_count_reply         _add_count      = 9;  // 增加挑战次数
    optional peak_arena_get_replay_reply        _get_replay     = 10; // 获取战斗录像
    optional peak_arena_query_summary_reply     _query_summary  = 11; // 获取战斗录像摘要
    optional peak_arena_history_reply           _history        = 12; // 赛季历史
    optional peak_arena_medal_reward_reply      _medal_reward   = 13; // 赛季勋章奖励
    optional peak_arena_score_rankboard_reply   _score_rank     = 14; // 积分排行榜
    optional peak_arena_check_evolve_reply      _check_evolve   = 15; // 晋级赛确认
    optional peak_arena_challenge_evolve_reply  _challenge_evolve = 16; // 挑战晋级赛
    optional peak_arena_query_goods_reply  _query_goods = 17; // 查询商品
    optional peak_arena_buy_goods_reply    _buy_goods   = 18; // 购买商品
    optional peak_arena_query_ban_list_reply     _query_ban_list      = 19; // 当前英雄得票率
    optional peak_arena_vote_heroes_reply        _vote_heroes         = 20; // BP投票
    optional string _error_code = 99; // 错误码
}

// 巅峰竞技场通知
message peak_arena_notify {
    optional uint32               _season       = 1; // 当前赛季
    optional peak_arena_state   _state        = 2; // 赛季状态
    optional uint32               _end_time     = 3; // 当前赛季状态结束时间
    optional bool                 _new_season   = 4; // 是否是新赛季
    optional bool                 _medal_reward     = 5; // 勋章奖励红点
    optional bool                 _challenge_record = 6; // 被挑战的红点
    optional bool                 _tally_record     = 7; // 结算结束红点
}

// 对手信息
message peak_arena_oppo {
    optional string             _role_id            = 1; // key
    optional user_summary       _summary            = 2; // 简要信息
    optional uint32             _grade              = 3; // 段位
    optional uint32             _score              = 4; // 积分
    optional string             _server_name        = 5; // 显示的服务器名称
    optional string             _plat               = 6; // 平台名称
    optional uint32             _score_rank         = 7; // 全服积分排名
    optional sint32             _zone               = 8; // 赛区
    optional battle_result      _result             = 9; // 结果
    repeated hero               _heroes             = 10; // 队伍列表
    optional uint32             _lineup_gs          = 11; // 阵容战力
    optional battle_bonus       _oppo_bonus         = 12; // 对手战斗加成
}

// 赛季挑战第几场的战斗录像
message peak_arena_round_battle_record {
    optional uint32             _checkid        = 1;  // 战斗校验ID
    optional uint32             _round          = 2;  // 第几场
    optional battle_result      _result         = 3;  // 胜负结果
    optional uint32             _rseed          = 4;  // 战斗种子

    optional string             _self_role_id       = 6;  // 自己的key
    optional string             _oppo_role_id       = 7;  // 自己的key
    optional user_summary       _self_user      = 8;  // 自己信息
    optional user_summary       _oppo_user      = 9; // 对手信息
    optional arena_team         _self_heroes    = 10; // 自己英雄
    optional arena_team         _oppo_heroes    = 11; // 对手英雄

    optional bool               _trigger_buff   = 12; // 是否触发buff
    optional string             _extra          = 13; // 额外信息

    repeated operation          _operations     = 14; // 操作
    optional battle_bonus       _self_bonus     = 15; // 己方战斗加成
    optional battle_bonus       _oppo_bonus     = 16; // 对手战斗加成
    optional uint32             _season_buff_key  = 17; // 赛季Buff
}

// 赛季战斗录像
message peak_arena_battle_replay {
    repeated peak_arena_round_battle_record   _records  = 1; // 每个回合战斗记录
}

// 赛季挑战记录
message peak_arena_challenge_record {
    optional uint32             _replay_id              = 1;  // 战斗录像ID
    optional peak_arena_oppo  _oppo                     = 2;  // 对手信息
    required uint32             _bt_time                = 3;  // 战斗时间
    required battle_result      _bt_result              = 4;  // 战斗结果
    optional bool               _active                 = 5;  // 是否主动方
    optional uint32             _self_score             = 6;  // 玩家原有积分
    optional sint32             _self_score_change      = 7;  // 玩家积分变化, -表示扣除
    optional uint32             _oppo_score             = 8;  // 对手原有积分
    optional sint32             _oppo_score_change      = 9;  // 对手积分变化, -表示扣除
    optional bool               _is_evolve              = 10; // 是否是晋级赛
    optional bool               _is_lose_protect        = 11; // 是否触发失败保护
}

// 赛季历史记录
message peak_arena_history_record {
    optional uint32             _season         = 1; // 赛季
    optional uint32             _final_score    = 2; // 最终积分
    optional uint32             _final_grade    = 3; // 最终段位
    optional peak_arena_step    _final_step     = 4; // 最终竞技场
    optional uint32             _zone_rank      = 5; // 赛区排名
    optional uint32             _score_rank     = 6; // 全服排名
    optional uint32             _zone           = 7; // 赛区
}

// 排行榜玩家数据
message peak_arena_rankitem {
    optional uint32             _rank           = 1; // 排名
    optional string             _role_id        = 2; // 玩家Key
    optional user_summary       _user_summary   = 3; // 玩家信息
    optional uint32             _score          = 4; // 积分/赛季勋章
    optional uint32             _grade          = 5; // 段位
    optional peak_arena_step    _step           = 6; // 竞技场级别
    optional string             _svr_name       = 7; // 显示的服务器ID
    optional string             _plat           = 8; // 平台
}


// 赛季状态
enum peak_arena_state {
    preparing   = 1; // 准备中
    fighting    = 2; // 比赛中
    playoffs    = 3; // 季后赛
    off_season  = 4; // 休赛中
}

// 赛季汇总
message peak_arena_summary {
    optional uint32   _total_challenge_count    = 1; // 总挑战次数
    optional uint32   _challenge_victory_count  = 2; // 挑战胜场数
    optional double   _challenge_victory_over   = 3; // 挑战胜场数超过
    optional uint32   _total_defend_count       = 4; // 防守次数
    optional uint32   _defend_victory_count     = 5; // 防守胜场数
    optional double   _defend_victory_over      = 6; // 防守胜场数超过
    repeated peak_arena_challenge_record  _challenges = 7; // 挑战记录,可能为空[1]=最难缠的战斗
    repeated uint32   _hero_used                = 8; // 最多英雄使用,可能为空 [1]=heroid, [2]=times
    optional uint32   _top_grade                = 9; // 最高段位
    optional uint32   _top_medal                = 10; // 最高积分
    optional uint32   _medal_rank                 = 11; // 最高排名
}

message peak_arena_buff {
    optional  uint32   _key      = 1; // buff key
    optional  uint32   _start_time = 2; // 开始时间
    optional  uint32   _end_time   = 3; // 结束时间
}

// 打开面板
message peak_arena_open_panel_reply {
    optional uint32                     _season                     = 1;  // 当前赛季
    optional peak_arena_state           _state                      = 2;  // 赛季状态
    optional uint32                     _zone                       = 3;  // 赛区
    optional uint32                     _end_time                   = 4;  // 当前赛季状态结束时间
    optional uint32                     _open_time                  = 5;  // 竞技场开放时间
    optional peak_arena_step            _step                       = 6;  // 当前竞技场级别
    optional uint32                     _grade                      = 7;  // 当前段位
    optional uint32                     _score                      = 8;  // 当前积分
    optional uint32                     _lineup_gs                  = 9;  // 当前防守阵容战力
    optional uint32                     _medal                      = 10;  // 赛季勋章
    optional uint32                     _left_times                 = 11; // 剩余挑战次数
    optional uint32                     _max_times                  = 12; // 最大挑战次数
    optional uint32                     _left_refresh_times         = 13; // 剩余刷新次数
    optional uint32                     _refresh_max_times          = 14; // 刷新最大次数
    optional uint32                     _refresh_last_recover_time  = 15; // 刷新最近一次的恢复时间
    repeated uint32                     _grade_reward_flags         = 16; // 段位奖励领取标志,[grade]
    repeated uint32                     _medal_reward_flags         = 17; // 赛季勋章奖励领取标志,[index]
    optional peak_arena_summary         _summary                    = 18; // 赛季汇总
    optional uint32                     _ticket_use_count           = 19; // 赛季竞技场票已用次数
    optional uint32                     _ticket_max_use_count       = 20; // 竞技场入场券最大使用次数
    optional uint32                     _key_use_count              = 21; // 巅峰竞技场钥匙已用次数
    optional uint32                     _key_max_use_count          = 22; // 竞技场入场钥匙最大使用次数
    optional peak_arena_evolve_info     _evolve_info                = 23; // 晋级赛信息
    optional peak_arena_grade_state     _grade_state                = 24; // 掉落标识
    optional bool                       _score_punish               = 25; // 积分惩罚
    optional bool                       _can_challenge              = 26; // 是否可以挑战
    optional uint32                     _score_rank                 = 27; // 全服排名
    optional uint32                     _set_lineup_cd_time         = 28; // 设置阵容冷却结束时间
    optional peak_arena_tally_result    _tally_result               = 29; // 上次结算结果
    optional uint32                     _zone_rank                  = 30; // 赛区排名
    optional uint32                     _coins                      = 31; // 巅峰币
    repeated uint32                     _ban_selected               = 32; // 选择的BP英雄
    repeated uint32                     _baned_heroes               = 33; // Ban掉的英雄
    repeated peak_arena_buff            _season_buff                = 34; // 赛季Buff
    optional uint32                     _day_change_lineup_times    = 35; // 每日挑战阵容次数
}

// 赛季结算结果
message peak_arena_tally_result {
    optional uint32             _tally_num      = 1; // 第几次结算
    optional uint32             _grade          = 2; // 结算段位
    optional uint32             _score          = 3; // 结算积分
    optional uint32             _medal          = 4; // 结算赛季勋章
    optional uint32             _rank           = 5; // 结算排名
    optional uint32             _zone_rank      = 6; // 赛区排名
    optional uint32             _coin           = 7; // 巅峰币
}

// 刷新对手
message peak_arena_refresh_oppo_reply {
    repeated peak_arena_oppo     _oppos   = 1; // 对手列表
    optional uint32              _left_refresh_times      = 2; // 剩余刷新次数
    optional uint32              _refresh_max_times       = 3; // 刷新最大次数
    optional uint32              _refresh_last_recover_time   = 4; // 刷新最近一次的恢复时间
}

// 查看防守阵容
message peak_arena_get_lineup_reply {
    repeated peak_arena_lineup    _lineups = 1; // 阵容列表
}

// 设置防守阵容
message peak_arena_set_lineup_reply {
    optional result     _result     = 1; // 结果
    optional uint32     _lineup_gs  = 2; // 阵容战力
}

// 查询对手信息
message peak_arena_query_oppo_reply {
    repeated arena_team    _teams = 1; // 队伍列表
}

// 查询玩家信息
message peak_arena_query_player_reply {
    optional string             _role_id            = 1; // key
    optional user_summary       _summary            = 2; // 简要信息
    optional uint32             _grade              = 3; // 段位
    optional uint32             _score              = 4; // 积分
    optional string             _plat               = 5; // 平台
    optional string             _svr_name           = 6; // 显示的服务器名称
    optional peak_arena_step    _step               = 7; // 竞技场级别
    optional uint32             _score_rank         = 8; // 积分排行
    optional uint32             _medal              = 9; // 赛季勋章
    repeated arena_team         _teams              = 10; // 队伍列表
    optional sint32             _zone               = 11; // 赛区
    optional uint32             _gs                 = 12; // 战斗力
    optional uint32             _zone_rank          = 13; // 赛区排名
}

// 挑战对手
message peak_arena_challenge_reply {
    optional battle_result                  _result                 = 1; // 结果 0 victory , 1 defeat
    optional peak_arena_battle_replay       _battle_replay          = 2; // 对战信息
    repeated query_summary                  _battle_summary         = 3; // 战斗简介
    optional sint32                         _self_score_change      = 4; // 自身积分变化
    optional uint32                         _self_before_score      = 5; // 自身之前的积分
    optional uint32                         _self_new_score         = 6; // 自身新的积分
    optional sint32                         _oppo_score_change      = 7; // 对手积分变化
    optional uint32                         _oppo_before_score      = 8; // 对手之前的积分
    optional uint32                         _oppo_new_score         = 9; // 对手新的积分
    optional uint32                         _before_grade           = 10; // 之前的段位
    optional uint32                         _new_grade              = 11; // 新的段位
    optional peak_arena_evolve_info         _evolve_info            = 12; // 晋级赛信息
    optional uint32                         _medal                  = 13; // 获得的勋章
    optional uint32                         _self_rank              = 14; // 排名
    optional bool                           _score_punish           = 15; // 积分惩罚
    optional uint32                         _zone_rank              = 16; // 赛区排名
    optional uint32                         _coins                  = 17; // 巅峰币
    optional bool                           _is_lose_protect        = 18; // 是否触发失败保护
}

// 增加挑战次数
message peak_arena_add_count_reply {
    optional uint32   _left_times               = 1; // 剩余挑战次数
    optional uint32   _max_times                = 2; // 最大挑战次数
    optional uint32   _ticket_use_count         = 3; // 入场券已使用次数
    optional uint32   _ticket_max_use_count     = 4; // 入场卷最大使用次数
    optional uint32   _key_use_count            = 5; // 入场钥匙已使用次数
    optional uint32   _key_max_use_count        = 6; // 入场钥匙最大使用次数
}

message peak_arena_challenge_stat {
    optional uint32                          _attack_cnt       = 1; // 进攻场数
    optional uint32                          _attack_win       = 2; // 进攻胜利场数
    optional uint32                          _defend_cnt       = 3; // 防守场数
    optional uint32                          _defend_win       = 4; // 防守胜利场数
    optional uint32                          _day_attack_cnt       = 5;  // 每日进攻场数
    optional uint32                          _day_attack_win       = 6;  // 每日进攻胜利场数
    optional uint32                          _day_defend_cnt       = 7;  // 每日防守场数
    optional uint32                          _day_defend_win       = 8; // 每日防守胜利场数
}

// 挑战记录
message peak_arena_get_records_reply {
    repeated peak_arena_challenge_record     _records          = 1; // 记录列表
    repeated peak_arena_challenge_record     _playoffs_records = 2; // 季后赛记录列表
    optional peak_arena_challenge_stat       _stat             = 3; // 挑战统计
}

// 获取战斗录像
message peak_arena_get_replay_reply {
    optional peak_arena_battle_replay     _replay          = 1; // 录像
    optional bool                         _is_lose_protect = 2; // 是否触发失败保护
}

// 获取战斗录像摘要
message peak_arena_query_summary_reply {
    optional query_summary      _summary = 1; // 战斗简报
}

// 赛季历史
message peak_arena_history_reply {
    repeated peak_arena_history_record    _records     = 1; // 记录列表
}

// 巅峰勋章奖励
message peak_arena_medal_reward_reply {
    optional uint32 _reward_idx = 1; // 奖励索引
    repeated reward _rewards    = 2; // 奖励
}

// 积分排行榜
message peak_arena_score_rankboard_reply {
    repeated peak_arena_rankitem      _rank_list  = 1; // 排行列表
    optional peak_arena_rankitem      _self_rank  = 2; // 自己的排行榜信息
    optional uint32                   _self_pos   = 3; // 自己的排名
}

message peak_arena_check_evolve_reply {
    optional peak_arena_evolve_info   _evolve_info = 1; // 晋级赛状态
}

message peak_arena_challenge_evolve_reply {
    optional battle_result                  _result                 = 1; // 结果 0 victory , 1 defeat
    optional peak_arena_battle_replay       _battle_replay          = 2; // 对战信息
    repeated query_summary                  _battle_summary         = 3; // 战斗简介
    optional peak_arena_step                _step                   = 4; // 竞技场级别
    optional uint32                         _self_before_score      = 5; // 自身老积分
    optional uint32                         _self_new_score         = 6; // 自身新的积分
    optional uint32                         _before_grade           = 7; // 之前的段位
    optional uint32                         _new_grade              = 8; // 新的段位
    optional peak_arena_evolve_info         _evolve_info            = 9; // 晋级赛信息
    optional uint32                         _oppo_score             = 10; // 对手积分
    optional uint32                         _self_rank              = 11; // 排名
}

message peak_arena_goods {
    optional uint32     _group_id      = 1; // 兑换ID
    optional uint32     _index         = 2; // 商品ID
    optional uint32     _cur_buy_times  = 3; // 当前购买次数
    optional uint32     _max_buy_times  = 4; // 最大购买次数
}

message peak_arena_query_goods_reply {
    repeated  peak_arena_goods    _goods = 1; // 商品
}

message peak_arena_buy_goods_reply {
    optional   uint32     _group_id     = 1; // 商品组
    optional   uint32     _goods_index  = 2; // 商品下表
    optional   uint32     _cur_buy_times = 3; // 数量
    optional   uint32     _left_coin     = 4; // 剩余数量
    repeated   reward     _rewards       = 5; // 奖励
}

message peak_arena_ban_hero {
    optional uint32   _hero_id   = 1; // 英雄ID
    optional uint32   _voted_num = 2; // 得票数
}

message peak_arena_query_ban_list_reply {
    repeated peak_arena_ban_hero _ban_heroes = 1; //  BP英雄数据
}

message peak_arena_vote_heroes_reply {
    optional result              _result     = 1; // 结果
    repeated peak_arena_ban_hero _ban_heroes = 2; //  BP英雄数据
    repeated uint32              _ban_selected   = 3; // 选择的BP英雄
}

// 灵魂石回收
message soul_exchange_reply{
    optional soul_exchange_item_convert_reply    _item_convert  = 1; // 兑换物品
}

message soul_exchange_item_convert_reply {
    repeated item   _exchange_items = 1; // 兑换获得物品
    repeated item   _extra_items    = 2; // 兑换额外获得物品
}

//=========================================================
//  预设阵容 preset_lineup
//=========================================================
// 预设阵容
message preset_lineup_reply {
    optional preset_lineup_set_lineup_reply    _set_lineup     = 1; // 预设阵容设置
    optional preset_lineup_delete_lineup_reply _delete_lineup  = 2; // 删除阵容
    optional preset_lineup_switch_lineup_reply _switch_lineup  = 3; // 切换阵容
}

message preset_lineup {
    optional uint32    _id        = 1; // ID
    optional string    _name      = 2; // 阵容名字
    repeated uint32    _hero_ids  = 3; // 英雄
}

message preset_lineup_set_lineup_reply {
    optional  result    _result  = 1; // 结果
}

message preset_lineup_delete_lineup_reply {
    optional  result    _result  = 1; // 结果
}

message preset_lineup_switch_lineup_reply {
    optional  result    _result  = 1; // 结果
}

// 英雄觉醒
message shard_reply {
    optional shard_unlock_reply     _unlock     = 1; // 解锁觉醒装备，如果没有装备会自动装上
    optional shard_level_up_reply   _level_up   = 2; // 等级提升
    optional shard_wear_reply       _wear       = 3; // 穿戴另外一件觉醒装备
}

// 觉醒装备解锁
message shard_unlock_reply {
    optional hero   _hero = 1;  // 英雄同步
}

// 觉醒装备升级
message shard_level_up_reply {
    optional hero   _hero = 1;  // 英雄同步
}

// 觉醒装备穿戴
message shard_wear_reply {
    optional hero   _hero = 1;  // 英雄同步
}
// 地底历险
message awake_dungeon_reply {
    optional    awake_dungeon_open_panel_reply    _open_panel       = 1; // 打开界面
    optional    awake_dungeon_enter_stage_reply   _enter_stage      = 2; // 进入关卡
    optional    awake_dungeon_exit_stage_reply    _exit_stage       = 3; // 进入关卡
    optional    awake_dungeon_sweep_reply         _sweep            = 4; // 扫荡关卡
    optional    awake_dungeon_buy_vitality_reply  _buy_vitality     = 5; // 购买补给
    optional    awake_dungeon_level_rewards_reply       _level_rewards    = 6; // 等级奖励
    optional    awake_dungeon_stage_record_reply        _stage_record     = 7; // 首通记录
    optional    awake_dungeon_take_block_rewards_reply  _take_block_rewards = 8; // 领取宝箱格子奖励
    optional    awake_dungeon_enter_next_chapter_reply  _enter_next_chapter = 9; // 进入下一章
    optional    awake_dungeon_enter_block_reply         _enter_block        = 10; // 走到某个格子
    optional    awake_dungeon_chapter_reward_reply      _chapter_reward     = 11; // 章节奖励
    optional    awake_dungeon_prepare_battle_reply      _prepare_battle     = 12; // 准备战斗
    optional    awake_dungeon_chapter_info_reply        _chapter_info       = 13; // 章节信息
}

message awake_dungeon_open_panel_reply {
    optional uint32                         _season_id             = 1; // 赛季ID
    optional uint32                         _cur_chapter_id        = 2; // 当前章节ID
    optional uint32                         _paragon_level         = 3; // 巅峰等级
    optional uint32                         _paragon_exp           = 4; // 巅峰等级经验值
    optional uint32                         _cur_vitality          = 5; // 当前体力
    optional uint32                         _vitality_update_time  = 6; // 体力更新时间
    optional uint32                         _vitality_buy_time     = 7; // 体力购买次数
    repeated awake_dungeon_chapter_info     _chapter_infos         = 8; // 关卡信息
    repeated uint32                         _level_rewards_flags   = 9; // 等级奖励领取标识
    optional uint32                         _sweep_reward       = 10; // 扫荡获得的道具数量
    repeated uint32                         _light_chapters     = 11; // 点亮过的章节
    repeated uint32                         _reward_chapters    = 12; // 领取过奖励的章节
}

message awake_dungeon_chapter_info {
    optional uint32  _chapter_id       = 1; // 章节ID
    repeated coordinate  _light_blocks = 2; // 点亮的格子
}

message awake_dungeon_stage_info {
    optional coordinate _coordinate     = 1;  // 坐标
    optional uint32     _cur_progress   = 2; // 当前进度
}

message awake_dungeon_enter_stage_reply {
    optional uint32                  _rseed          = 1; // 战斗种子
    optional coordinate              _coordinate     = 2; // 坐标
    optional uint32                  _stage_id       = 3; // 关卡id
    repeated hero                    _free_heroes    = 4; // 免费英雄
}

message awake_dungeon_exit_stage_reply {
    optional battle_result      _result                 = 1; // 战斗结果
    optional uint32             _checkid                = 2; // 战斗校验ID，战斗校验出错时返回
    repeated reward             _normal_rewards         = 3; // 奖励
    repeated reward             _fd_rewards             = 4; // boss关进度奖励或普通关首次奖励
    optional uint32             _stage_id               = 5; // 关卡id
    optional uint32             _cur_progress           = 6; // 本次进度
    optional uint32             _old_progress           = 7; // 之前最高进度
    optional uint32             _max_progress           = 8; // 当前最高进度
    optional coordinate         _coordinate             = 9; // 坐标
    optional uint32             _cur_vitality           = 10; // 当前体力
    optional uint32             _paragon_level          = 11; // 巅峰等级
    optional uint32             _paragon_exp            = 12; // 巅峰等级经验值
    optional uint32             _sweep_reward           = 13; // 扫荡获得的道具数量
    optional awake_dungeon_stage_record _stage_record   = 14; // 首通记录
}

message awake_dungeon_sweep_reply {
    repeated reward             _rewards                = 1; // 奖励
    optional uint32             _left_vit               = 2; // 剩余体力
    optional uint32             _paragon_level          = 11; // 巅峰等级
    optional uint32             _paragon_exp            = 12; // 巅峰等级经验值
}

message awake_dungeon_buy_vitality_reply {
    optional uint32     _cur_vitality     = 1; // 当前体力
    optional uint32     _buy_time         = 2; // 购买次数
}

message awake_dungeon_level_rewards_reply {
    repeated reward             _rewards                = 1; // 奖励
    repeated uint32             _level_rewards_flags    = 2; // 等级奖励领取标识
}

message awake_dungeon_stage_record_reply {
    optional uint32                 _stage_id           = 1;
    optional uint32                 _break_time         = 2; // 达成首通的时间
    optional user_summary           _user_summary       = 3; // 玩家摘要
    repeated hero_summary           _heroes             = 4; // 英雄列表
}

message awake_dungeon_take_block_rewards_reply {
    optional awake_dungeon_stage_info   _info                   = 1; // 坐标
    repeated reward                     _rewards                = 2; // 奖励
}

message awake_dungeon_stage_record {
    optional coordinate   _coordinate             = 1; // 坐标
    optional uint32       _stage_id               = 2; // 关卡id
    optional user_summary _user_summary           = 3; // 玩家摘要
}

message awake_dungeon_enter_next_chapter_reply {
    optional coordinate   _coordinate             = 1; // 坐标
    repeated awake_dungeon_stage_info   _stage_infos = 2; // 点亮信息
    repeated awake_dungeon_stage_record _stage_records = 3; // 关卡首通信息
}

message awake_dungeon_enter_block_reply {
    optional result   _success = 1; // 成功
}

message awake_dungeon_chapter_reward_reply {
    optional result   _result                  = 1; // 结果
    repeated reward   _rewards                 = 2; // 奖励
}

message awake_dungeon_prepare_battle_reply {
    repeated  hero           _heroes = 1; // 免费英雄信息
}

message awake_dungeon_chapter_record {
    optional user_summary           _user_summary           = 1; // 首通玩家摘要
    optional uint32                 _time                   = 2; // 时间
}

message awake_dungeon_chapter_info_reply {
    optional awake_dungeon_chapter_record      _chapter_record     = 1; // 首通玩家摘要
}

message awake_dungeon_notify {
    optional uint32     _paragon_level      = 1; // 巅峰等级
    optional bool       _is_vitality_full   = 2; // 体力是否满
    optional bool       _has_reward         = 3; // 是否有未领取奖励
}

// 热力挑战
message heat_reply {
    optional    heat_open_panel_reply           _open_panel         = 1; // 打开界面
    optional    heat_enter_stage_reply          _enter_stage        = 2; // 进入关卡
    optional    heat_exit_stage_reply           _exit_stage         = 3; // 进入关卡
    optional    heat_rankboard_reply            _rankboard          = 4; // 排行榜
    optional    heat_get_task_rewards_reply     _get_task_rewards   = 5; // 领取任务奖励
}


message heat_open_panel_reply {
    optional uint32             _group_id           = 1; // 热力组ID
    optional uint32             _max_heat           = 2; // 最高热力
    optional uint32             _min_pass_time      = 3; // 最小通关时间
    repeated heat_task          _task_list          = 4; // 任务列表
    repeated choose_heat        _last_choose_heat   = 5; // 热力选择记录
    optional uint32             _challenge_level    = 6; // 挑战等级 = 活动开启时间与开服天数差
}

message heat_enter_stage_reply {
    optional uint32         _rseed = 1; // 战斗种子
}

message heat_exit_stage_reply {
    optional battle_result      _result             = 1; // 战斗结果
    optional uint32             _checkid            = 2; // 战斗校验ID，战斗校验出错时返回
    optional bool               _is_break_record    = 3; // 是否破记录
    optional uint32             _max_heat           = 4; // 最高热力
    optional uint32             _min_time           = 5; // 个人最短通关时间
    optional uint32             _cur_heat           = 6; // 本次挑战热力值
    repeated choose_heat        _cur_choose_heat    = 7; // 本次挑战热力选择
    optional uint32             _cur_battle_time    = 8; // 本次挑战时间
    optional uint32             _group_id           = 9; // 组ID
}

// 热力值排行
message heat_score_rankitem {
    optional uint32                 _heat_value     = 1; // 热力值
    optional uint32                 _pass_time      = 2; // 通关时间
    optional user_summary           _user_summary   = 3; // 玩家摘要
    optional uint32                 _rank           = 4; // 排名
}

// 查询热力值排行榜
message heat_rankboard_reply {
    repeated heat_score_rankitem   _rank_list = 1; // 排名列表
    optional heat_score_rankitem   _self_rank = 2; // 自己排名
}

message heat_get_task_rewards_reply {
    repeated reward             _rewards            = 1; // 奖励列表
}

// 热度任务
message heat_task {
    optional uint32     _task_id              = 1; // 任务ID
    optional uint32     _task_line_id         = 2; // 任务线id
    optional string     _cond_type            = 3; // 条件类型
    repeated uint32     _cond_id              = 4; // 任务达成条件目标
    optional uint32     _cond_target          = 5; // 任务达成条件目标
    optional uint32     _task_progress        = 6; // 当前任务进度
    optional uint32     _progress_update_time = 7; // 任务更新时间
    optional uint32     _start_time           = 8; // 任务开始时间
    optional uint32     _expire_time          = 9; // 任务结束时间
    optional bool       _is_rewarded          = 10; // 是否已领取
}

message heat_notify {
    repeated heat_single_notify   _single_notifies     = 1; // 每组信息
}

message heat_single_notify {
    optional uint32 _group_id               = 1;
    optional uint32 _start_time             = 2; // 开始时间
    optional uint32 _challenge_end_time     = 3; // 挑战结束时间
    optional uint32 _reward_end_time        = 4; // 领奖结束时间
    optional bool   _has_unrewarded_task    = 5; // 有可领取的任务奖励
    optional bool   _has_new_task           = 6; // 有新发布任务
    optional string _module_name            = 7; // 模块名
}

// 服务器时间戳
message server_timestamp {
    optional uint32     _next_day_ts = 1; // 到达明天的时间戳
    optional uint32     _next_week_ts = 2; // 到达下个星期的时间戳
    optional uint32     _next_month_ts = 3; // 到达下个月的时间戳
}

// 同步服务器时间戳
message sync_timestamps_reply {
    repeated server_timestamp   _timestamps = 1; // 服务器时间
}

// 聊天发奖通知
message chat_spell_notify{
    optional uint32 spell_id    = 1; // 触发文字id
    repeated reward rewards     = 2; // 奖励
}

// 年兽活动
message nian_monster_reply {
    optional    nian_monster_open_panel_reply           _open_panel         = 1; // 打开界面
    optional    nian_monster_buy_item_reply             _buy_item           = 2; // 道具购买
}

message nian_monster_open_panel_reply {
    repeated    nian_monster_item_info   _item_infos         = 1; // 道具信息
}

message nian_monster_buy_item_reply {
    repeated    reward                     _bought_item       = 1; // 本次购买的道具
}

message nian_monster_item_info {
    optional    uint32      _item_id        = 1;
    optional    uint32      _buy_time       = 2; // 购买次数
    optional    uint32      _launch_time    = 3; // 可购买时间
}

message nian_monster_notify {
    optional    uint32      _cur_season_id  = 1;
    optional    bool        _has_new_goods  = 2; // 有商品上新
}

// 公会招募
message guild_enlist_reply {
    optional guild_enlist_open_panel_reply  _open_panel = 1; // 打开面板
    optional guild_enlist_entry_reply       _entry      = 2; // 登记
    optional guild_enlist_quit_reply        _quit       = 3; // 退出
    optional guild_enlist_subscribe_reply   _sub        = 4; // 订阅
    optional guild_enlist_query_reply       _query      = 5; // 查询
}

// 公会招募成员
message guild_enlist_member {
    optional user_summary   _user_summary   = 1; // 玩家摘要信息
    optional bool           _is_online      = 2; // 是否在线
    optional uint32         _liveness       = 3; // 7日活跃
}

// 打开面板
message guild_enlist_open_panel_reply {
    optional bool       _has_entry          = 1; // 是否已报名
    optional bool       _has_sub            = 2; // 是否已订阅
    optional uint32     _sub_expire_time    = 3; // 订阅过期时间
    optional uint32     _guild_liveness     = 4; // 公会7日活跃

    optional uint32     _total_member       = 11; // 总成员数量
    repeated guild_enlist_member   _members = 12; // 成员列表
    optional uint32     _version            = 13; // 成员数据版本号
}

// 报名
message guild_enlist_entry_reply {
    optional result     _result     = 1; // 结果
}

// 退出
message guild_enlist_quit_reply {
    optional result     _result     = 1; // 结果
}

// 订阅服务
message guild_enlist_subscribe_reply {
    optional result     _result     = 1; // 结果
}

// 查询
message guild_enlist_query_reply {
    optional uint32     _start          = 1; // 开始数量
    optional uint32     _total_member   = 2; // 总数量
    repeated guild_enlist_member    _members    = 3; // 成员列表
    optional uint32     _version        = 4; // 成员数据版本号
}


//=========================================================
//  公会战 guild_clash
//=========================================================

// 公会战
message guild_clash_reply {
    optional guild_clash_open_panel_reply           _open_panel             = 1; // 打开面板
    optional guild_clash_user_team_info_reply       _user_team              = 2; // 请求队伍信息
    optional guild_clash_guild_team_info_reply      _guild_team             = 3; // 请求公会队伍信息
    optional guild_clash_add_team_reply             _add_team               = 4; // 增加队伍
    optional result                                 _del_team               = 5; // 删除队伍
    optional result                                 _edit_team              = 6; // 保存队伍设置信息
    optional result                                 _change_line            = 7; // 更换本队线路
    optional result                                 _chair_change_line      = 8; // 会长调整队伍
    optional result                                 _switch_line            = 9; // 交换两个线路的队伍
    optional guild_clash_summary_info_reply         _summary_info           = 10; // 玩家概况信息
    optional guild_clash_query_line_reply           _query_line             = 11; // 上中下线战斗信息
    optional guild_clash_sync_events_reply          _sync_events            = 12; // 拉取战况增量更新
    optional guild_clash_query_replay_reply         _query_replay           = 13; // 查看录像
    optional guild_clash_query_battle_summary_reply _query_battle_summary   = 14; // 比赛战报
    optional guild_clash_query_rank_reply     	    _query_rank             = 15; // 排行榜
    optional guild_clash_query_rune_summary_reply   _query_rune_summary     = 16; // 神符战报
    optional guild_clash_query_battle_teams_reply   _query_battle_teams     = 17; // 请求战斗队伍
    optional result                                 _set_declare            = 18; // 设置战场宣言
    optional guild_clash_guild_liveness_reply       _guild_liveness         = 19; // 查询公会成员活跃度
    optional guild_clash_query_history_reply        _query_history          = 20; // 查询本赛季历史
    optional guild_clash_query_battle_info_reply    _query_battle_info      = 21; // 同步线路队伍信息
    optional guild_clash_query_goods_reply          _query_goods            = 22; // 查询商品
    optional guild_clash_buy_goods_reply            _buy_goods              = 23; // 购买商品
    optional guild_clash_query_last_summarys_reply  _query_last_summarys    = 24; // 请求上一轮的工会玩家数据
    optional result                                 _start_chair_operate    = 25; // 开始会长调整
    optional result                                 _end_chair_operate      = 26; // 停止会长调整
}

// 公会战赛季状态
enum guild_clash_state {
    closed              = 1; // 未开启
    preview             = 2; // 预告阶段
    grading             = 3; // 定级中
    grading_count       = 4; // 定级计算中
    grade_show          = 5; // 定级结果展示
    match_guilds        = 10; // 公会匹配中
    match_prepare       = 11; // 赛前准备阶段
    rune_refresh        = 12; // 神符刷新
    rune_head_modify    = 13; // 神符会长调整
    rune_gank           = 14; // 神符抢夺
    rune_disappear      = 15; // 神符消失(成员调整期)
    head_modify         = 100; // 会长调整
    march               = 101; // 行军期
    clash_show          = 102; // 比赛表演中
    clash_end           = 103; // 比赛结束
}

message guild_clash_rate_info {
    optional uint32                     _guild_liveness             = 1; // 公会活跃度
    optional uint32                     _user_liveness              = 2; // 个人活跃度
    optional uint32                     _user_today_liveness        = 3; // 个人当天活跃
    optional uint32                     _user_today_liveness_max    = 4; // 个人当天活跃度上限
    optional uint32                     _zone_id                    = 5; // 战区id
    optional uint32                     _grade                      = 6; // 定级等级
}

// 打开面板
message guild_clash_open_panel_reply {
    optional uint32                         _season_id          = 1; // 赛季ID
    optional uint32                         _schedule_id        = 2; // 赛程ID
    optional guild_clash_state              _cur_state          = 3; // 当前赛季状态
    optional uint32                         _state_start_time   = 4; // 当前阶段开始时间
    optional uint32                         _state_end_time     = 5; // 当前阶段结束时间
    optional uint32                         _round_id           = 6; // 当前轮次
    repeated uint32                         _rune_id            = 7; // 神符ID
    optional guild_clash_rate_info          _rate_info          = 8; // 定级信息
    optional guild_clash_guild_summary      _self_guild_summary = 9; // 我方信息
    optional guild_clash_guild_summary      _oppo_guild_summary = 10; // 对手信息
    repeated guild_clash_battle_info        _battle_info        = 11; // 战斗中线路信息
    optional uint32                         _camp_id            = 12; // 阵营
    optional string                         _match_declare      = 13; // 战场宣言
}

message guild_clash_guild_summary {
    optional guild_summary                  _guild_summary          = 1; // 公会信息
    optional uint32                         _svr_id                 = 2; // 公会服务器ID
    optional string                         _svr_name               = 3; // 服务器名称
    optional uint32                         _win_cnt                = 4; // 胜场数
    optional uint32                         _lose_cnt               = 5; // 负场数
}

message guild_clash_user_team_info_reply {
    repeated guild_clash_user_team         _user_teams                      = 1; // 队伍列表 所有分路
    repeated guild_clash_user_team_count   _guild_user_team_counts          = 2; // 公会其他人队伍及英雄数量
}

message guild_clash_guild_team_info_reply {
    repeated guild_clash_user_team         _user_teams                   = 1; // 队伍列表
    optional uint32                        _start_operate_time           = 2; // 开始调整时间
    optional user_summary                  _start_operate_user_summary   = 3; // 开始调整玩家概要
}

message guild_clash_user_team{
    optional uint32                  _id                   = 1; // 队伍ID
    optional uint32                  _user_id              = 2; // 玩家ID
    repeated guild_clash_hero        _heroes               = 3; // 队伍英雄列表
    optional uint32                  _line_id              = 4; // 线路id
}

message guild_clash_user_team_count{
    optional uint32             _uid                = 1;
    optional uint32             _team_count         = 2;
    optional uint32             _hero_count         = 3;
    optional uint32             _line_id            = 4; // 分路
}

message guild_clash_hero {
    optional uint32              _hero_id      = 1; // 英雄id
    optional hero_summary        _hero_summary = 2; // 英雄简介
}

message guild_clash_summary_info_reply{
    repeated   guild_clash_user_summary        _self_guild_clash_summary    = 1;
    repeated   guild_clash_user_summary        _oppo_guild_clash_summary    = 2;
}

message guild_clash_user_summary{
    optional    uint32                        _id             = 1; // 玩家id
    optional    user_summary                  _user_summary   = 2;
}

message guild_clash_battle_info {
    optional    uint32     _line            = 1;  // 上中下路
    optional    uint32     _camp1_team_count = 2; // 我方队伍数
    optional    uint32     _camp2_team_count = 3; // 对方队伍数
    optional    uint32     _camp1_team_sum   = 4; // 我方队伍数总数
    optional    uint32     _camp2_team_sum   = 5; // 对方队伍数总数
    optional    uint32     _summary_time     = 6; // 线路结束时间偏移
}

message guild_clash_event {
    enum event_type {
        battle   = 1; // 战斗
        summary  = 2; // 总结
        result   = 3; // 最终结果
    }
    optional   uint32    _id            = 1; // 事件ID
    optional   uint32    _time          = 2; // 事件时间
    optional   event_type _type         = 3; // 类型
    optional   guild_clash_battle        _battle_data  = 4; // 战斗数据
    optional   guild_clash_event_summary _summary_data = 5; // 总结数据
    optional   uint32    _win_camp      = 6; // 最终结果
    optional   uint32    _param         = 7; // 额外参数
}

message guild_clash_event_summary {
    optional  guild_clash_battle_info_summary   _battle_summarys  = 1; // 战斗战报
    optional  guild_clash_rune_info_summary     _rune_summarys    = 2; // 神符战报
}

message guild_clash_sync_events_reply {
    repeated guild_clash_event  _events          = 1; // 战斗中线路信息
}

message  guild_clash_battle {
    enum result_type {
        victory  = 1; // 胜利
        narrow_victory = 2; // 险胜
        kill     = 3;  //  秒杀
        triple_kill = 4; // 三杀
        ultra_kill = 5; // 四杀
        rampage     = 6; // 暴走
    }
    optional     uint32               _replay_id              = 1; // 回放ID
    optional     uint32               _line_id                = 2; // 路
    optional     guild_clash_user_team_summary _team1         = 3; // 上阵队伍
    optional     guild_clash_user_team_summary _team2         = 4; // 上阵队伍
    optional     uint32               _camp1_hero               = 5; // 进攻方战力最高的英雄
    optional     uint32               _camp2_hero               = 6; // 防守方战力最高的英雄
    optional     uint32               _start_time             = 7; // 开始时间
    optional     uint32               _end_time               = 8; // 结束时间
    optional     uint32               _win_camp               = 9; // 1 team1 胜利； 2 team2 胜利
    optional     uint32               _team1_win              = 10; // 队伍1胜利次数
    optional     uint32               _team2_win              = 11; // 队伍2胜利次数
    optional     result_type          _type                   = 12; // 战斗结果类型
}

message guild_clash_line_battle {
    optional    uint32                       _line_id              = 1;// 路
    optional    uint32                       _team1_count          = 2;// 左边出战队伍数量
    optional    uint32                       _team2_count          = 3;// 右边出战队伍数量
    optional    uint32                       _team1_left           = 4;// 左边出战队伍剩余
    optional    uint32                       _team2_left           = 5;// 右边出战队伍剩余
    repeated    guild_clash_battle           _battle               = 6; // 记录
}

message guild_clash_query_line_reply {
    optional   guild_clash_line_battle   _line_battle   = 1; // 线路战斗信息
}

message guild_clash_notify {
    optional    uint32                      _season_id      = 1; // 赛季ID
    optional    guild_clash_state           _cur_state      = 2; // 当前状态
    optional    uint32                      _schedule_id    = 3; // 赛程ID
    optional    uint32                      _round_id       = 4; // 轮次ID
    optional    bool                        _has_oppo       = 5; // 是否有对手
    optional    bool                        _is_during_season   = 6; //是否在赛季中
}

message guild_clash_add_team_reply {
    optional uint32     _team_id    = 1;  // 队伍id
}

message guild_clash_query_replay_reply {
    required uint32 _checkid                        = 1; // 校验ID
    optional uint32 _userid                         = 2; // 左方UID
    optional uint32 _oppo_userid                    = 3; // 右方UID
    optional user_summary _camp1_summary            = 4; // 我方头像信息
    optional user_summary _camp2_summary            = 5; // 敌方头像信息
    repeated hero   _camp1_heroes                   = 6; // 我方英雄
    repeated hero   _camp2_heroes                   = 7; // 敌方英雄
    required uint32 _rseed                          = 8; // 种子
    optional uint32 _start_time                     = 9; // 战斗开始时间
    optional uint32 _battle_time                    = 10; // 战斗时间
    optional uint32 _win_team                       = 11; // 胜利队伍
    repeated hero_dyna   _camp1_hero_dynas          = 12; // 我方血量
    repeated hero_dyna   _camp2_hero_dynas          = 13; // 对方血量
    repeated uint32       _end_hp_list              = 14; // 结束时我方血量
    repeated uint32       _end_mp_list              = 15; // 结束时对方血量
    repeated uint32       _camp1_runes              = 16; // 我方神符加成
    repeated uint32       _camp2_runes              = 17; // 对方神符加成
    optional battle_bonus _camp1_bonus              = 18; // 己方战斗加成
    optional battle_bonus _camp2_bonus              = 19; // 对手战斗加成
    optional uint32       _camp1_win_times          = 20; // 进攻方胜场次数
    optional uint32       _camp2_win_times          = 21; // 防守方胜场次数
}


message guild_clash_battle_info_summary {
    optional   uint32    _line_id = 1; // 线路
    optional   uint32    _win_camp = 2; // 获胜阵营
    repeated   ranklist_item  _rank_list = 3; // 击杀详情
    optional   guild_clash_user_team_summary _team         = 4; // 上阵队伍
    optional   uint32                        _hero_id      = 5; // 英雄
    optional   uint32    _camp1_team                       = 6; // 阵营1队伍
    optional   uint32    _camp2_team                       = 7; // 阵营2队伍
    optional   uint32    _camp1_random                     = 8; // 平局时随机骰子
    optional   uint32    _camp2_random                     = 9; // 平局时随机骰子
}

message guild_clash_query_battle_summary_reply {
    optional  uint32                            _camp_id   = 1; // 我方阵营
    optional  uint32                            _win_camp  = 2; // 获胜阵营
    repeated  guild_clash_battle_info_summary   _summarys  = 3;
}

message guild_clash_query_rank_reply {
    repeated ranklist_item      _rank_list  = 1; // 排行列表
    optional ranklist_item      _self_rank  = 2; // 自己的排行榜信息
    optional uint32             _self_pos   = 3; // 自己的排名
}

message guild_clash_rune_info_summary {
    optional   uint32    _rune_id = 1; // 线路
    optional   uint32    _win_guild = 2; // 胜利的公会
}

message guild_clash_query_rune_summary_reply {
    repeated guild_clash_rune_info_summary  _summarys = 1; // 神符战报
}

message guild_clash_user_team_summary {
    optional uint32    _camp_id = 1; // 阵营
    optional uint32    _uid     = 2; // UID
    optional uint32    _team_id = 3; // team_id
}

message guild_clash_query_battle_teams_reply {
    optional uint32                        _line_id = 1; // 线路
    repeated guild_clash_user_team_summary _team1   = 2; // 队伍
    repeated guild_clash_user_team_summary _team2   = 3; // 队伍
}

message guild_clash_guild_liveness_reply {
    repeated guild_clash_member_liveness _member_liveness = 1; // 成员活跃度
}

message guild_clash_member_liveness {
    optional guild_member _member_summary   = 1;
    optional uint32       _guild_liveness   = 2; // 公会贡献活跃度
    optional uint32       _today_liveness   = 3; // 今日活跃度
}

message guild_clash_query_history_reply {
    repeated guild_clash_battle_history  _battle_history   = 1;
}

message guild_clash_battle_history {
    optional uint32         _round_id           = 1;
    optional bool           _is_win             = 2;
    optional guild_summary  _oppo_guild         = 3;
}

message guild_clash_query_battle_info_reply {
    repeated guild_clash_battle_info        _battle_info        = 1; // 战斗中线路信息
}

message guild_clash_query_goods_reply {
    repeated  guild_clash_goods    _goods = 1; // 商品
}

message guild_clash_goods {
    optional uint32     _group_id           = 1; // 兑换ID
    optional uint32     _index              = 2; // 商品ID
    optional uint32     _cur_buy_times      = 3; // 当前购买次数
    optional uint32     _max_buy_times      = 4; // 最大购买次数
}

message guild_clash_buy_goods_reply {
    optional   uint32     _group_id         = 1; // 商品组
    optional   uint32     _goods_index      = 2; // 商品下表
    optional   uint32     _cur_buy_times    = 3; // 数量
    optional   uint32     _left_coin        = 4; // 剩余数量
    repeated   reward     _rewards          = 5; // 奖励
}

message guild_clash_query_last_summarys_reply {
    optional uint32                         _camp_id        = 1; // 阵营ID
    optional guild_clash_guild_summary      _guild_summary  = 2; // 对手公会信息
    repeated guild_clash_user_summary       _camp1_summarys       = 3; // CAMP1工会玩家信息
    repeated guild_clash_user_summary       _camp2_summarys       = 4; // CAMP2工会玩家信息
}

// 奖励找回
message retrieval_reward_reply {
    optional retrieval_reward_open_panel_reply     _open_panel     = 1; // 打开界面
    optional retrieval_reward_take_reward_reply    _take_reward    = 2; // 领取奖励
}

message retrieval_reward_detail {
    optional retrieval_reward_type      _type     = 1; // 奖励
    repeated reward                     _rewards  = 2; // 奖励
    optional uint32                     _diamond  = 3; // 消耗的钻石
}

// 奖励找回打开
message retrieval_reward_open_panel_reply {
    optional uint32                   _act_id  = 1; // ID
    repeated retrieval_reward_detail  _details = 2; //奖励信息
}

// 奖励找回奖励
message retrieval_reward_take_reward_reply {
    repeated  retrieval_reward_type  _type         = 1; // 领取类型
    repeated  reward                 _rewards      = 2; // 奖励
    optional  uint32                 _diamond      = 3; // 消耗的钻石
}

// 手动触发
message manual_trigger_reply {
    optional string     _type       = 1; // 触发类型
    optional string     _param      = 2; // 参数
    repeated reward     _rewards    = 3; // 奖励
}

//=========================================================
// 外观商店 cosmetic_shop_reply
//=========================================================
message cosmetic_shop_reply {
    optional cosmetic_shop_open_panel_reply    _open_panel   = 1; // 打开商店
    optional cosmetic_shop_exchange_reply      _exchange     = 2; // 兑换
    optional cosmetic_shop_view_flag_reply     _view_flag    = 3; // 查看页签
    optional string                            _error_code   = 99; // 错误码
}

message cosmetic_shop_open_panel_reply {
    repeated uint32   _bough_goods_id   = 1; // 已购买商品ID
    repeated uint32   _show_goods_id    = 2; // 上架的商品ID
}

message cosmetic_shop_exchange_reply {
    optional result   _result                = 1; // 是否兑换成功
    optional uint32   _goods_id              = 2; // 购买的商品ID
    repeated reward   _cut_items             = 3; // 扣除的道具ID
    repeated reward   _rewards               = 4; // 获得的奖励
}

message cosmetic_shop_view_flag_reply {
    optional result   _result                = 1; // 是否兑换成功
}

//=========================================================
// 关卡自选奖励 select_stage_reward_reply
//=========================================================
message select_stage_reward_reply {
    optional uint32 _stage_id                = 1; // 关卡id
    optional result _result                  = 2; // 选择结果
    optional uint32 _reward_id               = 3; // 奖励id
}

//=========================================================
// 魔力豫州 rogue_reply
//=========================================================
message rogue_reply {
    optional rogue_open_panel_reply    _open_panel    = 1; // 打开面板
    optional rogue_enter_chapter_reply _enter_chapter = 2; // 进入副本
    optional rogue_enter_room_reply    _enter_room    = 3; // 进入房间
    optional rogue_start_battle_reply    _start_battle    = 4; // 进入战斗
    optional rogue_end_battle_reply    _end_battle    = 5; // 进入战斗
    optional rogue_choose_reward_reply _choose_reward = 6; // 选择奖励
    optional rogue_choose_choice_reply _choose_choice = 7; // 进行选择
    optional rogue_shop_buy_bless_reply _shop_buy_bless = 8; // 商店格购买
    optional rogue_refresh_bless_reply  _refresh_bless  = 9; // 刷新祝福
    optional rogue_enter_next_round_reply _enter_next_round = 10; // 进入下一张图
    optional rogue_skip_battle_reply   _skip_battle   = 11; // 跳过战斗
    optional rogue_end_chapter_reply   _end_chapter   = 12; // 退出副本：可以领蛋，无法战斗
    optional rogue_view_result_reply   _view_result   = 13; // 已看过的结果
    optional rogue_exit_chapter_reply  _exit_chapter  = 14; // 结算副本
    optional rogue_open_tech_reply     _open_tech     = 15; // 打开天赋树
    optional rogue_buy_tech_reply      _buy_tech      = 16; // 加天赋
    optional rogue_golden_reward_reply  _golden_reward  = 17; // 打开周积分奖励
    optional rogue_view_bless_reward_reply  _view_bless_reward  = 18; // 祝福奖励
    optional rogue_view_event_reward_reply  _view_event_reward  = 19; // 事件奖励
    optional rogue_query_rankboard_reply    _query_rankboard    = 21; // 排行榜
    optional rogue_open_script_reply        _open_script        = 22; // 演绎法
    optional rogue_script_reward_reply      _script_reward      = 23; // 演绎法奖励
    optional rogue_query_charm_reply        _query_charm        = 24; // 护符信息
    optional rogue_refresh_room_reply       _refresh_room       = 25; // 刷新房间
    optional rogue_sync_hero_infos_reply    _sync_hero_infos    = 26; // 同步英雄信息
}

message rogue_pass_chapter {
    optional  uint32  _chapter_id  = 1; // 章节ID
    repeated  uint32  _difficulty  = 2; // 难度
}

message rogue_view_event {
    optional  uint32   _id  = 1; // ID
    optional  bool     _flag = 2; // 是否领取过
}

message user_rogue {
    optional  rogue_chapter_info _cur_chapter  = 1; // 当前进行的章节
    repeated  rogue_pass_chapter _pass_chapter = 2; // 通关的章节信息
    repeated  uint32             _view_bless   = 3; // 祝福奖励信息
    repeated  uint32             _view_revelation     = 4; // 启示
    repeated  uint32             _bless_reward_flag   = 5; // 祝福奖励信息
    repeated  rogue_view_event   _view_event   = 6; // 事件奖励信息
    optional  uint32             _weekly_point = 7; // 周积分
    optional  uint32             _golden_point = 8; // 黄金屋积分
    repeated  uint32             _golden_reward_flag  = 9; // 黄金屋奖励
}

enum rogue_room_type {
    normal_battle  = 1;     // 战斗格
    elite_battle   = 2; // 精英战斗
    boss_battle    = 3;  // Boss战斗
    airdrop        = 4; // 获取英雄格
    event   = 5;     // 事件格
    buy_shop    = 6; // 购买商店
    enhance_shop = 7; // 强化商店
    hot_spring  = 8;  // 回血
    all_shop     = 9; // 购买商店&&强化商店
    round_start  = 10; // 地图起始点
    ex_elite_battle = 11; // ex精英战斗
}

message rogue_choice {
    optional  uint32   _index  = 1; // choice唯一标识
    optional  uint32   _choice = 2; // 选择Group
    optional  uint32   _choose = 3; // 选择
    optional  uint32   _result_group = 4; // 结果GroupID
    optional  uint32   _result_id    = 5; // 结果ID
}

message rogue_event {
    optional  uint32   _event_id  = 1; // 时间ID
    repeated  rogue_choice _choices = 2; // 选择
}

message rogue_result {
    enum result_type {
        stage                    = 0; // 关卡
        team_mp_cut_point        = 1; // 队伍MP扣除点数
        team_mp_cut_percent      = 2; // 队伍MP扣除百分比
        team_mp_add_percent      = 3; // 队伍MP增加百分比
        team_mp_add_point        = 4; // 队伍MP增加点数
        team_hp_cut_percent      = 5; // 队伍HP扣除百分比
        team_hp_add_percent      = 6; // 队伍HP增加百分比
        pearl_add                = 7; // 珍珠增加
        random_destiny_all_bless = 8; // 获取某个命途下所有祝福
        enhance_all_bless        = 9; // 强化所有祝福
        pearl_store              = 10; // 珍珠储存
        pearl_bonus              = 11; // 珍珠获取倍数
        appoint_bless            = 12; // 指定祝福获取
        retry_times_add          = 13; // 重试次数增加
        retry_times_cut          = 14; // 重试次数扣除
        normal_bless             = 15; // 普通祝福获取
        pearl_cut                = 16; // 珍珠扣除
        pearl_cut_all            = 17; // 扣除所有珍珠
        reinforced_bless_add     = 18; // 新增强化祝福
        bless_enhance            = 19; // 强化祝福
        low_bless_cut            = 20; // 祝福扣除
        total_bless_cut          = 21; // 祝福扣除
        weakest_hero_cure        = 22; // 最虚弱英雄治愈
        hero_reborn              = 23; // 英雄重生
        kill_hero                = 24; // 随机杀死某个英雄
        bought_bless             = 25; // 购买祝福
        hero_add                 = 26; // 英雄将领
        battle_end               = 27; // 战斗结束
        revelation_pick          = 28; // 深度启示选择
        normal_sheep_reward      = 29; // 普通羊奖励
        gold_sheep_reward        = 30; // 金羊奖励
        random_bless_range       = 31; // 随机获取N个祝福
        pearl_random_calculate   = 32; // 四则运算
        get_current_bless        = 33; // 获得自己命运的祝福
        enhanced_bless           = 34; // 强化祝福
        core_bless               = 35; // 核心祝福随机
        hero_reborn_add          = 36; // 英雄复活次数加减
        roll_add                 = 37; // 房间刷新次数增加
        refresh_add              = 38; // 刷新祝福
        des_energy_add_percent   = 39; // 命途能量加减百分比
        shop_rebate              = 40; // 商店折扣
        pearl_add_percent        = 41; // 珍珠增加百分比
    }
    enum from {
        normal = 1; // 普通奖励
        charm  = 2; // 护符
    }
    optional  uint32       _index  = 1; // result唯一标识
    optional  result_type  _type   = 2; // 类型
    repeated  uint32       _params = 3; // 奖励参数
    optional  uint32       _need_choose = 4; // 玩家选择个数
    repeated  uint32       _pos    = 5; // 玩家选择
    optional  uint32       _refresh_time = 6; // 刷新次数
    optional  uint32       _refresh_max  = 7; // 刷新上限
    optional  from         _from         = 8; // 奖励来自
}

message rogue_goods {
    optional  uint32  _bless_id   = 1; // 祝福ID
    optional  uint32  _price      = 2; // 价格
}

message rogue_wave_info {
    optional  uint32   _round_id  = 1; // 第几张图
    optional  uint32   _room_id   = 2; // 房间ID
    optional  uint32   _wave_id   = 3; // 波次ID
    optional  rogue_room_type   _type  = 4; // 房间类型
    optional  uint32   _stage_id       = 5; // 关卡ID
    optional  rogue_event _event       = 6; // 事件信息
    repeated  rogue_goods  _goods_list = 7; // 商店格商品
    repeated  rogue_result _results    = 8; // 房间结果
    optional  bool         _passed     = 9; // 玩家 是否经过
}

message rogue_bless {
    optional   uint32  _bless = 1; // 祝福ID
    optional   uint32  _level = 2; // 祝福等级
}

message rogue_vitality_reward_flag {
    optional  uint32   _wave       = 1; // 波次
    optional  uint32   _take_times = 2; // 奖励领取次数
}

enum rogue_battle_status {
    battle = 1; // 战斗中
    defeat = 2; // 失败
    canceled = 3; // 取消
    finish   = 4; // 退出
}

message rogue_view_result {
    optional uint32   _round_id = 1; // 第几张图
    optional uint32   _room_id  = 2; // 房间ID
    repeated uint32   _result_index    = 3; // result_index
}

message rogue_refresh_bless_param {
    optional uint32   _times  = 1; // 次数
    optional uint32   _price  = 2; // 价格
}

message rogue_chapter_info {
    optional  uint32   _chapter_id  = 1; // 章节ID
    optional  uint32   _end_time    = 2; // 结束时间
    optional  uint32   _difficulty  = 3; // 难度
    optional  uint32   _crisis      = 4; // 危机
    optional  uint32   _destiny     = 5; // 选择的命途
    optional  uint32   _des_energy  = 6; // 启示能量
    optional  uint32   _cur_round_id = 7; // 当前在第几张图
    optional  uint32   _cur_wave    = 8; // 波次
    optional  uint32   _cur_room_id = 9; // 当前房间
    optional  uint32   _pearl       = 10; // 当前珍珠数量
    repeated  rogue_bless _bless_list   = 11; // 祝福
    repeated  uint32   _tech_list       = 12; // 科技
    repeated  uint32   _equip           = 13; // 奇物
    optional  uint32   _retry_times     = 14; // 重试次数
    optional  bool   _can_battle_status = 15; // 最大重试次数
    optional  rogue_battle_status _battle_status = 16; // 是否可以战斗
    repeated  rogue_hero_info  _heroes      = 17; // 英雄信息
    repeated  rogue_wave_info  _waves       = 18; // 波次信息
    optional  uint32  _shop_discount        = 19; // 商店折扣
    repeated  rogue_view_result _view_results     = 20; // 已看过的结果
    repeated  rogue_charm_battle      _charm_list = 21; // 带入副本的护符
    optional  uint32  _refresh_room_times   = 22; // 刷新房间次数
    optional  uint32  _hero_reborn_times    = 23; // 英雄复活次数
    repeated  rogue_refresh_bless_param _refresh_bless_param = 24; // 刷新祝福参数
    optional uint32             _max_weight = 25; // 皮带负重上限
}

message rogue_open_panel_reply {
    optional user_rogue  _user_rogue = 1; // 信息
}

message rogue_enter_chapter_reply {
    optional  rogue_chapter_info  _cur_chapter = 1; // 章节信息
}

message rogue_enter_room_reply {
    optional uint32    _room_id   = 1; // 房间ID
    optional  rogue_room_type   _type  = 2; // 房间类型
    optional  uint32   _wave_id        = 3; // 波次ID
    optional  uint32   _stage_id       = 4; // 关卡ID
    optional  rogue_event _event       = 5; // 事件信息
    repeated  rogue_goods _goods       = 6; // 商店中可购买|可强化的祝福
    repeated  rogue_result _results    = 7; // 结果
    repeated  rogue_hero_info  _hero_infos  = 8; // 英雄信息
    optional  uint32       _pearl      = 9; // 珍珠
    optional  uint32       _des_energy = 10; // 命途能量
}

message rogue_start_battle_reply {
    optional uint32           _rseed      = 1; // 战斗种子
    optional uint32           _cur_wave   = 2; // 波次
    optional uint32           _retry_times               = 3; // 重试次数
    optional bool             _can_battle_status         = 4; // 是否可以战斗
}

message rogue_end_battle_reply {
    optional battle_result    _battle_result             = 1; // 战斗结果
    optional  uint32          _cur_room_id               = 2; // 当前房间
    repeated rogue_result     _result                    = 3; // 结果
    repeated rogue_hero_info  _hero_infos                = 4; // 英雄信息
    optional uint32           _des_energy                = 5; // 启示能量
    optional uint32           _retry_times               = 6; // 重试次数
    optional bool             _can_battle_status         = 7; // 是否可以战斗
    optional rogue_battle_status    _battle_status       = 8; // 战斗状态
    optional uint32           _pearl                     = 9; // 珍珠
    optional uint32           _hero_reborn_times         = 10; // 英雄复活次数
}

message rogue_choose_reward_reply {
    optional  result   _result  = 1; // 选择的奖励槽位
    optional  uint32        _cur_room_id    = 2; // 当前房间
    repeated  rogue_bless   _bless = 3; // 获得的buff
    repeated  rogue_hero_info _heroes  = 4; // 获得的英雄
    repeated  rogue_result    _results = 5; // results
    optional  bool            _is_delete = 6; // 是否是删除
    optional  uint32          _pearl     = 7; // 珍珠
    optional  uint32          _des_energy = 8; // 启示能量
}

message rogue_choose_choice_reply {
    optional result           _result        = 1; // 操作是否成功
    optional uint32           _cur_room_id   = 2; // 当前房间
    optional rogue_event      _event         = 3; // 事件
    repeated rogue_result     _rogue_result  = 4; // 结果
    repeated rogue_hero_info  _hero_infos    = 5; // 同步英雄信息
    optional uint32           _pearl         = 6; // 珍珠
    optional uint32           _des_energy    = 7; // 启示能量
    optional uint32           _retry_times   = 8; // 补给
}

message rogue_shop_buy_bless_reply {
    optional result           _result        = 1; // 操作是否成功
    optional uint32         _cur_room_id     = 2; // 当前房间
    optional rogue_bless      _bless         = 3; // 祝福
    repeated rogue_result     _rogue_result  = 4; // 结果
    optional uint32           _left_pearl    = 5; // 剩余珍珠
    optional uint32           _des_energy    = 6; // 启示能量
}

message rogue_refresh_bless_reply {
    optional uint32           _result_index  = 1; // 下标
    optional uint32           _room_id       = 2; // RoomId
    repeated rogue_result     _rogue_result  = 3; // 结果
    optional uint32           _left_pearl    = 4; // 剩余珍珠
}

message rogue_enter_next_round_reply {
    optional result _result   = 1; // 成功
    optional uint32 _round_id = 2; // 第几张图
    optional uint32 _room_id  = 3; // 新的room_id
    repeated rogue_result     _rogue_results  = 4; // 结果
    optional uint32           _pearl          = 5; // 珍珠
}

message rogue_skip_battle_reply {
    optional uint32           _cur_room_id               = 1; // 当前房间
    repeated rogue_result     _result                    = 2; // 结果
    optional uint32           _pearl                     = 3; // 珍珠
}

message rogue_end_chapter_reply {
    optional bool  _can_battle_status = 1; // 战斗状态
    optional rogue_battle_status _battle_status = 2; // 退出
}

message rogue_view_result_reply {
    optional result   _result = 1; // 结果
}

message rogue_exit_chapter_reply {
    optional uint32           _chapter_id          = 1; // 章节ID
    optional uint32           _weekly_point        = 2; // 积分
    optional uint32           _tech                = 3; // 天赋点数
    optional uint32           _total_pearl         = 4; // 最终获取的珍珠数量
    optional uint32           _max_boss_damage     = 5; // 最大boss伤害
    optional uint32           _damage_hero         = 6; // 造成伤害的英雄
    repeated reward           _rewards             = 7; // 首通奖励
    repeated rogue_charm_record _new_charm_list    = 8; // 护符
}

message rogue_open_tech_reply {
    optional uint32   _chapter_id   = 1; // 章节ID
    optional uint32   _tech_point   = 2; // 点数
    repeated uint32   _light_tech_list   = 3; // 已点亮的天赋
}

message rogue_buy_tech_reply {
    optional uint32   _chapter_id   = 1; // 章节ID
    optional uint32   _tech_id      = 2; // 天赋ID
    optional uint32   _tech_point   = 3; // 点数
}

message rogue_golden_reward_reply {
    optional   uint32    _level    = 1; // 等级
    repeated   reward    _rewards  = 2;// 奖励
}

message rogue_view_bless_reward_reply {
    optional   uint32    _index    = 1; // 奖励下表
    repeated   reward    _rewards  = 2;// 奖励
}

message rogue_view_event_reward_reply {
    optional   uint32    _event_id    = 1; // 事件ID
    repeated   reward    _rewards     = 2; // 奖励
}

message rogue_notify {
    repeated uint32   _new_chapter  = 1; // 是否有新章节
    optional bool     _script_reward = 2; // 演绎法可领取
    optional bool     _golden_reward = 3; // 黄金屋红点
}

message rogue_query_rankboard_reply {
    repeated ranklist_item  _rank_list = 1; // 排行榜
    optional ranklist_item  _self_rank = 2; // 自身排行榜
    optional uint32         _self_pos  = 3; // 自身排名
}

message rogue_script {
    optional uint32     _script_id = 1; // 剧本ID
    optional uint32     _progress  = 2; // 当前进度
    repeated uint32     _param     = 3; // 额外参数
    optional uint32     _complete_time = 4; // 完成时间
    optional uint32     _reward_time   = 5; // 领奖时间
}

message rogue_open_script_reply {
    repeated rogue_script  _scripts = 1; // 剧本
}

message rogue_script_reward_reply {
    optional rogue_script  _script = 1; // ID
    repeated reward    _rewards    = 2; // 奖励
}

message rogue_charm_record {
    optional uint32   _charm_id   = 1; // 护符ID
    optional uint32   _exp        = 2; // 经验
    optional uint32   _progress   = 3; // 进度
}

message rogue_query_charm_reply {
    repeated rogue_charm_record _charm_list = 1; // 护符信息
    optional uint32             _weight     = 2; // 皮带负重
}

message rogue_refresh_room_reply {
    optional  rogue_room_type   _type  = 1; // 房间类型
    optional uint32             _round_id  = 2; // 第几张图（回合
    optional uint32             _room_id   = 3; // 房间ID
}

message rogue_sync_hero_infos_reply {
    repeated rogue_hero_info  _hero_infos    = 1; // 同步英雄信息
}


message pet_reply {
    optional pet_open_panel_reply             _open_panel             = 1;
    optional pet_hatch_egg_reply              _hatch_egg              = 2;
    optional pet_accelerate_hatch_reply       _accelerate_hatch       = 3;
    optional pet_open_egg_reply               _open_egg               = 4;
    optional pet_result                       _equip_pet              = 5;
    optional pet_result                       _unequip_pet            = 6;
    optional pet_result                       _levelup_skill          = 7;
    optional pet_result                       _levelup                = 8;
    optional pet_decompose_reply              _decompose              = 9; //分解宠物
}

message pet_open_panel_reply {
    repeated packed_hatching_egg           _hatching_egg       = 1;
    optional bool                          _is_decompose_open  = 2; // 是否可以分解
}

message pet_hatch_egg_reply {
    optional result        _result        = 1;
    optional packed_hatching_egg  _hatching_egg  = 2;
}

message packed_hatching_egg {
    optional uint32 _index              = 1;
    optional uint32 _egg_id             = 2;
    optional uint32 _start_time         = 3;
    optional uint32 _end_time           = 4;
}

message pet_accelerate_hatch_reply{
    optional result     _result         = 1;
    optional uint32     _cur_diamond    = 2; // 当前钻石
}

message pet_open_egg_reply {
    optional uint32 _index      = 1;
    optional pet    _pet        = 2;
    optional bool   _is_record  = 3; // 是否刷新体型记录
}

message pet_result {
    optional result  _result        = 1;
    optional uint32  _hero_id       = 2;
    optional uint32  _hero_gs       = 3;
    optional pet     _pet           = 4;
    repeated item    _return_item   = 5;
}

message pet_decompose_reply {
    repeated reward _rewards = 1;
}

//=========================================================
// 星盘 astrolabe_reply
//=========================================================
message user_astrolabe_info {
    optional uint32  _hero_id = 1; // 英雄ID
    optional uint32  _left_times    = 2; // 剩余次数
    optional uint32  _buy_times     = 3; // 购买次数
    optional uint32  _pray_times    = 4; // 祈福总次数
    repeated astrolabe_star _replace_stars  = 5; // 星星
    repeated uint32  _lock_index_list       = 6; // 锁定的词条ID
    optional bool    _unlock        = 7; // 是否解锁
    optional uint32  _lock_lucky    = 8; // 四锁保底
    optional uint32  _replace_gs    = 9; // 保存词条后的战力
}

message astrolabe_reply {
    optional  astrolabe_unlock_reply    _unlock  = 1; // 解锁
    optional  astrolabe_pray_reply      _pray    = 2; // 祈福
    optional  astrolabe_confirm_reply   _confirm  = 3; // 保存
    optional  astrolabe_clear_cache_reply   _clear_cache    = 4; // 不保存，清除替换词条
    optional  astrolabe_buy_times_reply     _buy_times      = 5; // 购买次数
    optional  astrolabe_buy_stone_reply     _buy_stone      = 6; // 购买石头
    optional  astrolabe_pull_reply          _pull           = 7; // 拉取星盘信息
    optional  string                        _error_code     = 99; // 错误码
}

message astrolabe_unlock_reply {
    optional user_astrolabe_info  _info = 1; // 信息
    optional hero_astrolabe _hero_astro = 2; // 新的英雄星盘信息
    optional uint32         _gs         = 3; // 战力GS
}

message astrolabe_pray_reply {
    optional user_astrolabe_info _info = 1; // 信息
    optional hero_astrolabe _hero_astro = 2; // 新的英雄星盘信息
    optional uint32         _gs         = 3; // 战力GS
    repeated item           _items      = 4; // 消耗的道具
    optional uint32         _gold       = 5; // 消耗的金币
}

message astrolabe_confirm_reply {
    optional hero    _hero    = 1; // 英雄信息
}

message astrolabe_clear_cache_reply {
    optional user_astrolabe_info _info = 1; // 信息
}

message astrolabe_buy_times_reply {
    optional user_astrolabe_info _info  = 1; // 新的新盘信息
    optional uint32  _max_times    = 2; // 最大淬炼次数
    optional uint32  _left_diamond = 3; // 剩余的钻石数量
}

message astrolabe_buy_stone_reply {
    repeated reward  _rewards      = 1; // 获得的道具
    optional uint32  _left_diamond = 2; // 剩余的钻石数量
}

message astrolabe_pull_reply {
    repeated user_astrolabe_info  _infos = 1; // 信息
}

//=========================================================
// 送花 all_star_reply
//=========================================================
message all_star_reply {
    optional  all_star_query_rankboard_reply  _query_rankboard  = 1; // 全服获赠排行榜
    optional  all_star_give_record_reply      _give_record      = 2; // 赠送记录
    optional  all_star_get_rank_reply         _get_rank         = 3; // 获赠排行榜
    optional  all_star_give_reply             _give         = 4; // 送花
}

message all_star_query_rankboard_reply {
    repeated ranklist_item  _rank_list = 1; // 排行榜
    optional ranklist_item  _self_rank = 2; // 自身排行榜
    optional uint32         _self_pos  = 3; // 自身排名
}

message all_star_give_record {
    optional uint32        _time      = 1; // 时间
    optional user_summary  _user      = 2; // 玩家信息
    optional bool          _is_give   = 3; // true为赠送，false为获赠
    optional uint32        _num       = 4; // 数量
    optional string        _svr_name  = 5; // 服务器名称
}

message all_star_give_record_reply {
    repeated all_star_give_record  _records = 1; // 记录
    optional uint32          _give_num  = 2; // 赠送出去的花
    optional uint32          _get_num   = 3; // 获得的花
}

message all_star_get_rank_reply {
    repeated ranklist_item  _rank_list = 1; // 排行榜
}

message all_star_give_reply {
    optional  result    _result = 1; // 结果
}

message hero_recycle_reply {
    optional hero_recycle_check_reply       _check      = 1; // 检查
    optional hero_recycle_preview_reply     _preview    = 2; // 预览
}

message hero_recycle_check_list {
    enum check_result {
        ok      = 1; // 通过检查
        auto    = 2; // 自动处理，通过检查
        manual  = 3; // 需要手动处理，没有通过检查
    }

    optional check_result   _ladder_lineup          = 1; // 竞技场队列
    optional check_result   _guild_hire             = 2; // 公会雇佣营地
    optional check_result   _peak_arena_lineup      = 3; // 巅峰竞技场队列
    optional check_result   _guild_clash_lineup     = 4; // 公会战队列
    optional check_result   _cup_arena_lineup       = 5; // 女神之战队列
    optional check_result   _legend_equip           = 6; // 传奇装备
}

message hero_recycle_check_reply {
    required hero_recycle_check_list    _check_list = 1; // 检查列表
}

message hero_recycle_preview_reply {
    repeated reward _rewards = 1;    // 奖励
}

// 甜心派对
message sweet_party_reply {
    optional sweet_party_open_panel_reply           _open_panel           = 1; // 打开面板
    optional sweet_party_get_task_rewards_reply     _get_task_rewards     = 2; // 获得任务奖励
    optional sweet_party_get_line_rewards_reply     _get_line_rewards     = 3; // 获得进度奖励
}

message sweet_party_open_panel_reply {
    repeated sweet_party_task         _task_lists           = 1; // 任务列表
    repeated bool                     _line_flags           = 2; // 进度任务列表
    optional uint32                   _active_time          = 3; // 派对开启时间
    optional uint32                   _cur_line_progress    = 4; // 当前进度条进度
}

// 甜心派对任务
message sweet_party_task {
    optional uint32     _id                     = 1; // 任务ID
    optional string     _cond_type              = 2; // 条件类型
    optional uint32     _cond_id                = 3; // 任务达成条件目标
    optional uint32     _cond_target            = 4; // 任务达成条件目标
    optional uint32     _task_progress          = 5; // 当前任务进度
    optional uint32     _progress_update_time   = 6; // 任务更新时间
    optional uint32     _tab                    = 7; // 标签
    optional uint32     _accept_time            = 8; // 任务开始时间
    optional uint32     _expire_time            = 9; // 任务结束时间
    optional bool       _is_rewarded            = 10; // 是否已领取
}

message sweet_party_get_task_rewards_reply {
    optional uint32     _task_id            = 1; // 任务id
    optional uint32     _cur_line_progress  = 2; // 当前总进度
    repeated reward     _rewards            = 3; // 奖励列表
    optional uint32     _add_strawberry     = 4; // 增加奶油草莓数量
}

message sweet_party_get_line_rewards_reply {
    repeated reward     _rewards            = 1; // 奖励列表
}

message sweet_party_notify {
    optional bool       _is_open            = 1; // 是否开启
    optional bool       _task               = 2; // 任务
}

message chat_blocking_notify {
    repeated chat_blocking_type _type       = 1; // 当前生效的屏蔽类型
}

//=========================================================
// 时空回廊 time_corridor_req
//=========================================================
message time_corridor_reply {
    optional  time_corridor_open_panel_reply  _open_panel  = 1; // 打开界面
    optional  time_corridor_summon_reply      _summon      = 2; // 召唤
    optional  time_corridor_buy_goods_reply   _buy_goods   = 3; // 购买商品
    optional  time_corridor_query_records_reply   _query_records        = 4; // 记录
}

message time_corridor_goods {
    optional uint32     _index         = 1; // 商品ID
    optional uint32     _cur_buy_times  = 2; // 当前购买次数
    optional uint32     _max_buy_times  = 3; // 最大购买次数
}

message time_corridor_open_panel_reply {
    optional  uint32    _left_free = 1; // 剩余免费次数
    repeated  time_corridor_goods _goods = 2; // 已购买商品
}

message time_corridor_summon_reply {
    repeated  reward     _rewards    = 1; // 奖励
    repeated  uint32     _smash_idx  = 2; // 英雄转换成灵魂石的位置
    optional  uint32     _item_count    = 3; // 剩余抽道具数量
    optional  uint32     _discount_item = 4; // 剩余折扣道具数量
    optional  uint32     _left_free     = 5; // 剩余免费次数
}

message time_corridor_buy_goods_reply {
    optional   uint32     _goods_index  = 1; // 商品下表
    optional   uint32     _cur_buy_times = 2; // 数量
    optional   uint32     _left_token    = 3; // 剩余数量
    optional   uint32     _left_diamond  = 4; // 剩余钻石数量
    repeated   reward     _rewards       = 5; // 奖励
}

message time_corridor_record {
    optional  uint32     _time   = 1; // 抽奖时间
    optional  reward     _reward = 2; // 奖励
    optional  bool       _is_smash = 3; // 是否粉碎
}

message time_corridor_query_records_reply {
    repeated  time_corridor_record  _records = 1; // 记录
}

message time_corridor_notify {
    optional  uint32    _season    = 1; // 赛季
    optional  bool      _view_flag = 2; // 新手引导
}

message real_arena_notify {
    optional bool       _has_grade_reward   = 1; // 是否有未领取段位奖励
    optional uint32     _season_id          = 2; // 当前赛季id
    optional bool       _legend_equip_open  = 3; // 传奇装备活动是否开启
}

//=========================================================
// 天下角逐 guild_contest_reply
//=========================================================
message guild_contest_reply {
    optional  guild_contest_prepare_panel_reply     _prepare_panel      = 1; // 打开准备界面
    optional  guild_contest_score_rankboard_reply   _score_rankboard    = 2; // 打开积分排名界面
    optional  guild_contest_query_members_reply     _query_members      = 3; // 查询成员列表
}

message guild_contest_prepare_panel_reply {
    optional uint32 _tally_time = 1; // 结算时间
    optional uint32 _rank_time  = 2; // 排名时间
}

message guild_contest_score_rankboard_reply {
    optional uint32                     _tally_time     = 1; // 结算时间
    repeated guild_contest_guild_info   _guild_infos    = 2; // 公会信息
    optional guild_contest_guild_info   _my_guild_info  = 3; // 我的公会信息
    optional bool                       _is_tally_end   = 4; // 结算结束
}

message guild_contest_guild_info {
    optional guild_summary _summary = 1; // 公会摘要
    optional uint32        _score   = 2; // 公会积分
    optional uint32        _rank    = 3; // 排名
}

message guild_contest_query_members_reply {
    repeated guild_contest_user_info _user_infos = 1; // 玩家信息
}

message guild_contest_user_info {
    optional user_summary _summary = 1; // 玩家摘要
    optional uint32       _score   = 2; // 玩家积分
    optional uint32       _change_score = 3; // 昨日获得积分
    optional guild_job_t  _job          = 4; // 公会职务
}

message point_sync_reply{
    repeated user_point     _points  = 1;
}

//=========================================================
// 永生梦境新年活动 dreamland_new_year
//=========================================================
message dreamland_new_year_reply {
    optional dreamland_new_year_query_rankboard_reply  _query_rankboard  = 1; // 全服排行榜
    optional dreamland_new_year_daily_record_reply     _daily_record     = 2; // 每日记录
}

message dreamland_new_year_query_rankboard_reply {
    repeated ranklist_item  _rank_list = 1; // 排行榜
    optional ranklist_item  _self_rank = 2; // 自身排行榜
    optional uint32         _self_pos  = 3; // 自身排名
}

message dreamland_new_year_daily_record_reply {
    repeated dreamland_new_year_daily_record  _records          = 1; // 记录
    optional uint32                           _total_damage     = 2; // 总伤害
}

message dreamland_new_year_daily_record {
    optional uint32        _time      = 1; // 时间
    repeated hero_summary  _heroes    = 2; // 英雄信息
    optional uint32        _damage    = 3; // 伤害
}

message sync_tiger_tool_reply {
    optional   result   _result = 1; // 结果
}

//=========================================================
// 传奇装备
//=========================================================
message legend_equip_reply {
    optional legend_equip_equip_reply           _equip              = 1; // 穿戴装备
    optional legend_equip_unequip_reply         _unequip            = 2; // 卸下装备
    optional legend_equip_starup_reply          _starup             = 3; // 装备升星
    optional legend_equip_rankup_reply          _rankup             = 4; // 装备升阶
    optional legend_equip_recycle_reply         _recycle            = 5; // 分解装备
    optional legend_equip_forge_equip_reply     _forge_equip        = 6; // 锻造装备
    optional legend_equip_unlock_queue_reply    _unlock_queue       = 7; // 解锁锻造队列
    optional legend_equip_unlock_pos_reply      _unlock_pos         = 8; // 解锁锻造队列槽位
    optional legend_equip_forge_panel_reply     _forge_panel        = 9; // 打开锻造界面
    optional legend_equip_lottery_reply         _lottery            = 10; // 开启锻造装备
    optional legend_equip_accelerate_reply      _accelerate         = 11; // 锻造加速
    optional legend_equip_one_key_forge_reply   _one_key_forge      = 12; // 一键锻造
    optional legend_equip_one_key_lottery_reply _one_key_lottery    = 13; // 一键开启
    optional legend_equip_one_key_accelerate_reply _one_key_accelerate    = 14; // 一键加速
    optional legend_equip_discard_reply         _discard            = 15; // 装备丢弃
    optional legend_equip_open_shop_reply       _open_shop          = 16; // 打开商店
    optional legend_equip_buy_goods_reply       _buy_goods          = 17; // 购买商品
    optional legend_equip_synthesize_reply      _synthesize         = 18; // 碎片合成
    optional legend_equip_submit_task_reply     _submit_task        = 19; // 提交任务
    optional legend_equip_set_wish_reply        _set_wish           = 20; // 设定心愿单
    optional legend_equip_sell_fragement_reply  _sell_fragement     = 21; // 出售碎片
    optional legend_equip_query_task_reply      _query_task         = 22; // 查询任务
    optional legend_equip_handbook_reply        _handbook           = 23; // 图鉴
    optional legend_equip_query_record_reply    _query_records      = 24; // 查询抽奖记录
    optional legend_equip_reset_reply           _reset              = 25; // 传奇装备重置
    optional legend_equip_buy_reset_times_reply _buy_reset_times    = 26; // 购买重置次数
}

message legend_equip_equip_reply {
    optional legend_equip               _legend_equip   = 1; // 传奇装备
    optional uint32                     _hero_gs        = 2; // 英雄战力
    repeated legend_equip_task_info     _task           = 3; // 任务信息
}

message legend_equip_unequip_reply {
    optional legend_equip   _legend_equip       = 1; // 传奇装备
    optional uint32         _hero_gs            = 2; // 英雄战力
    optional uint32         _next_unequip_time  = 3; // 最近一次脱下装备时间
    optional uint32         _hero_id            = 4; // 英雄id
}

message legend_equip_starup_reply {
    optional legend_equip   _legend_equip   = 1; // 传奇装备
    optional uint32         _hero_gs        = 2; // 英雄战力
    repeated item           _items          = 3; // 消耗的道具
    optional uint32         _gold           = 4; // 消耗的金币
    repeated legend_equip   _cost_equips    = 5; // 消耗装备
}

message legend_equip_rankup_reply {
    optional legend_equip   _legend_equip   = 1; // 传奇装备
    optional uint32         _hero_gs        = 2; // 英雄战力
    repeated item           _items          = 3; // 消耗的道具
    optional uint32         _gold           = 4; // 消耗的金币
    repeated legend_equip   _cost_equips    = 5; // 消耗装备
}

message legend_equip_recycle_reply {
    repeated uint32         _ids            = 1; // 装备id
    repeated reward         _return_items   = 2; // 返回道具
}

message legend_equip_forge_equip_reply {
    optional uint32                     _queue_id       = 1; // 锻造队列编号
    optional legend_equip_forge_item    _item           = 2; // 锻造物品
    repeated item                       _cost_items     = 3; // 锻造消耗
    repeated legend_equip_task_info     _task           = 4; // 任务信息
}

message legend_equip_unlock_queue_reply {
    optional legend_equip_queue    _queue      = 1; // 锻造队列信息
}

message legend_equip_unlock_pos_reply {
    optional uint32    _queue_id        = 1; // 锻造队列编号
    optional uint32    _pos             = 2; // 槽位
}

message legend_equip_item_notify {
    repeated legend_equip   _legend_equips  = 1; // 传奇装备
}

message legend_equip_forge_panel_reply {
    repeated legend_equip_queue         _queues         = 1; // 锻造队列信息
    repeated legend_equip_task_info     _task           = 2; // 任务信息
    repeated legend_equip_wish          _wishes         = 3; // 心愿单
    repeated reward                     _rewards        = 4; // 奖励
    optional uint32                     _normal_times   = 5; // 下次出现普通装备的次数
    optional uint32                     _first_only_times = 6; // 首次出现唯一装备的次数
    optional uint32                     _left_reset_times = 7; // 每周剩余重置次数
}

message legend_equip_lottery_reply {
    optional uint32                     _queue_id           = 1; // 队列id
    repeated reward                     _rewards            = 2; // 奖励
    repeated legend_equip_wish          _wishes             = 3; // 心愿单
    repeated legend_equip_task_info     _task               = 4; // 任务信息
    optional uint32                     _normal_times       = 5; // 下次出现普通装备的次数
    optional uint32                     _first_only_times   = 6; // 首次出现唯一装备的次数
}

message legend_equip_accelerate_reply {
    optional legend_equip_queue    _queue               = 1; // 锻造队列信息
    optional uint32                _cost_diamond        = 2; // 消耗的钻石
    optional item                  _cost_item           = 3; // 消耗的道具
}

message legend_equip_queue {
    optional uint32                     _queue_id       = 1; // 锻造队列编号
    repeated bool                       _unlock_pos     = 2; // 解锁槽位信息
    repeated legend_equip_forge_item    _forge_list     = 3; // 锻造物品
}

message legend_equip_forge_item {
    optional uint32 _index          = 1; // 索引
    optional uint32 _start_time     = 2; // 开始时间
    optional uint32 _end_time       = 3; // 结束时间
}

message legend_equip_one_key_forge_reply {
    repeated legend_equip_queue          _queues        = 1; // 锻造队列信息
    repeated item                        _cost_items    = 2; // 锻造消耗
    repeated legend_equip_task_info      _task          = 3; // 任务信息
    optional uint32                      _forge_times   = 4; // 锻造次数
}

message legend_equip_one_key_lottery_reply {
    repeated legend_equip_queue         _queues             = 1; // 锻造队列信息
    repeated reward                     _rewards            = 2; // 奖励
    repeated legend_equip_wish          _wishes             = 3; // 心愿单
    repeated legend_equip_task_info     _task               = 4; // 任务信息
    optional uint32                     _normal_times       = 5; // 下次出现普通装备的次数
    optional uint32                     _first_only_times   = 6; // 首次出现唯一装备的次数
}

message legend_equip_one_key_accelerate_reply {
    optional legend_equip_queue     _queue                  = 1; // 锻造队列信息
    optional uint32                 _cost_diamond           = 2; // 消耗的钻石
    optional item                   _cost_item              = 3; // 消耗的道具
}

message legend_equip_discard_reply {
    optional uint32     _id             = 1; // 装备编号
    optional bool       _is_discard     = 2; // 是否丢弃
}

message legend_equip_open_shop_reply {
    repeated legend_equip_good _goods                       = 1; // 商品列表
    optional uint32            _next_auto_refresh_time      = 2; // 下一次自动刷新时间
}

message legend_equip_good {
    optional uint32     _group_id           = 1; // 商品组
    optional uint32     _index              = 2; // 商品索引
    repeated reward     _rewards            = 3; // 商品信息
    optional uint32     _cur_buy_times      = 6; // 当前购买次数
    optional uint32     _max_buy_times      = 7; // 最大购买次数
}

message legend_equip_buy_goods_reply {
    optional legend_equip_good _good    = 1; // 商品信息
    repeated reward            _rewards = 2; // 奖励
}

message legend_equip_synthesize_reply {
    repeated reward                     _rewards    = 1; // 任务奖励
}

message legend_equip_submit_task_reply {
    repeated reward                     _rewards    = 1; // 任务奖励
    optional legend_equip_task_info     _task       = 2; // 任务信息
    repeated legend_equip_queue         _queues     = 3; // 锻造队列信息
}

message legend_equip_task_info {
    optional uint32     _task_id        = 1; // 任务ID
    optional uint32     _progress       = 2; // 当前进度
    optional uint32     _target         = 3; // 目标
    optional bool       _is_rewarded    = 4; // 是否领取
}

message legend_equip_set_wish_reply {
    optional legend_equip_wish          _wish               = 1; // 许愿单
    repeated legend_equip_task_info     _task               = 2; // 任务信息
}

// 传奇装备心愿单
message legend_equip_wish {
    optional legend_equip_wish_type     _wish_type      = 1; // 心愿单类型
    repeated legend_equip_wish_info     _wish_list      = 2;  // 心愿列表
}

message legend_equip_wish_info {
    optional uint32     _index          = 1; // 槽位索引
    optional uint32     _equip_id       = 2; // 装备id
    optional bool       _is_success     = 3; // 是否成功
}

message legend_equip_sell_fragement_reply {
    repeated reward     _rewards    = 1; // 奖励
}

message legend_equip_query_task_reply {
    repeated legend_equip_task_info     _task           = 1; // 任务信息
}

message legend_equip_notify {
    optional bool   _task               = 1; // 任务红点，任务已完成
    optional bool   _forge              = 2; // 锻造红点，有可锻造的装备
    optional bool   _lottery            = 3; // 开启红点，有可开启的装备
    optional bool   _first_open_panel   = 4; // 第一次打开锻造界面
}

message legend_equip_handbook_reply {
    repeated uint32    _equip_ids  = 1; // 已获取装备id
}

message legend_equip_query_record_reply {
    repeated legend_equip_lottery_record  _records = 1; // 记录
}

message legend_equip_lottery_record {
    optional uint32     _time       = 1; // 时间
    optional reward     _reward     = 2; // 奖励
}

message legend_equip_reset_reply {
    optional legend_equip     _equip            = 1; // 装备
    repeated reward           _return_items     = 2; // 返回道具
    optional uint32           _left_reset_times = 3; // 每周剩余重置次数
}

message legend_equip_buy_reset_times_reply {
    optional uint32           _left_reset_times = 1; // 每周剩余重置次数
}

//=========================================================
// 海盗商店 pirate_shop
//=========================================================
message pirate_shop_reply {
    optional  pirate_shop_open_panel_reply  _open_panel = 1; // 打开界面
    optional  pirate_shop_take_map_reply    _take_map   = 2; // 领取藏宝图
    optional  pirate_shop_refresh_shop_reply _refresh_shop = 3; // 刷新商店
    optional  pirate_shop_buy_goods_reply   _buy_goods  = 4; // 购买商品
}

message pirate_shop_good {
    optional  uint32   _index = 1; // 下标
    optional  uint32   _group = 2; // 组别
    optional  uint32   _group_index = 3; // 组别下标
    optional  goods.price_type   _price_type   = 4; // 价格类型
    optional  uint32             _price_value  = 5; // 商品价格
    optional  uint32   _discount = 6; // 折扣
    optional  bool     _status   = 7; // 是否购买
}

message pirate_shop_open_panel_reply {
    optional  uint32            _vit_use  = 1; // 体力累计
    optional  bool              _reward_flag = 2; // 藏宝图领取标志
    repeated  pirate_shop_good  _goods = 3; // 商品
}

message pirate_shop_take_map_reply {
    optional result  _result  = 1; // 结果
    repeated reward  _rewards = 2; // 奖励
}

message pirate_shop_refresh_shop_reply {
    repeated  pirate_shop_good  _goods = 1; // 商品
}

message pirate_shop_buy_goods_reply {
    optional result  _result  = 1; // 结果
    optional uint32  _index   = 2; // 商品下标
    repeated reward  _rewards = 3; // 奖励
}

//=========================================================
// 简单助力 simple_assist_req
//=========================================================
message simple_assist_reply {
    optional simple_assist_open_panel_reply             _open_panel             = 1; // 打开面板
    optional simple_assist_get_task_rewards_reply       _get_task_rewards       = 2; // 领取任务奖励
    optional simple_assist_get_line_rewards_reply       _get_line_rewards       = 3; // 领取进度奖励

    optional simple_assist_query_goods_reply            _query_goods            = 4; // 查询商店
    optional simple_assist_choose_rewards_reply         _choose_rewards         = 5; // 选择奖励
    optional simple_assist_buy_goods_reply              _buy_goods              = 6; // 购买商品
}

// 简单任务
message simple_task {
    optional uint32                 _id                     = 1; // 任务ID
    optional string                 _cond_type              = 2; // 条件类型
    optional uint32                 _cond_id                = 3; // 任务达成条件目标
    optional uint32                 _cond_target            = 4; // 任务达成条件目标
    optional uint32                 _task_progress          = 5; // 当前任务进度
    optional uint32                 _progress_update_time   = 6; // 任务更新时间
    optional uint32                 _tab                    = 7; // 标签
    optional bool                   _is_rewarded            = 8; // 是否已领取
    optional simple_task_extend     _extend                 = 9; // 任务扩展数据
}

// 简单任务扩展
message simple_task_extend {
    optional uint32     _day_num                = 1; // 任务天数
}

// 简单助力结构
message packed_simple_assist {
    optional simple_assist_type         _type               = 1; // 助力类型
    optional uint32                     _id                 = 2; // ID
    repeated simple_task              _task_lists           = 3; // 任务列表
    repeated bool                     _line_flags           = 4; // 进度任务列表
    optional uint32                   _active_time          = 5; // 助力开启时间
    optional uint32                   _cur_line_progress    = 6; // 当前进度条进度
}

message simple_assist_open_panel_reply {
    optional packed_simple_assist  _simple_assist = 1; // 助力类型
}

message simple_assist_get_task_rewards_reply {
    optional simple_assist_type  _type      = 1; // 助力类型
    optional uint32              _task_id   = 2; // 任务ID
    optional uint32     _cur_line_progress  = 3; // 当前总进度
    repeated reward     _rewards            = 4; // 奖励列表
    optional uint32     _add_line     = 5; // 增加任务进度数量
    optional uint32     _add_shop_point     = 6; // 加的商店点数
}

message simple_assist_get_line_rewards_reply {
    optional simple_assist_type  _type      = 1; // 助力类型
    optional uint32              _line_id   = 2; // 任务ID
    repeated reward     _rewards            = 3; // 奖励列表
}

message simple_assist_query_goods_reply {
    optional plain_shop_record  _shop = 1; // 商店
}

message simple_assist_choose_rewards_reply {
    optional result              _result      = 1; // 结果
    optional uint32              _group_id    = 2; // 商品组
    optional uint32              _group_index = 3; // 商品下标
    optional uint32              _choose_group  = 4; // 可选组
    optional uint32              _choose_index  = 5; // 可选下标
}

message simple_assist_buy_goods_reply {
    optional result              _result      = 1; // 结果
    optional simple_assist_type  _type        = 2; // 助力类型
    optional uint32              _group_id    = 3; // 商品组
    optional uint32              _group_index = 4; // 商品下标
    optional uint32              _amount      = 5; // 数量
    repeated reward              _rewards     = 6; // 奖励
}

message simple_assist_reward_hint {
    optional simple_assist_type  _type      = 1; // 助力类型
    optional bool       _is_open            = 2; // 是否开启
    optional bool       _task               = 3; // 任务
}

message simple_assist_notify {
    repeated simple_assist_reward_hint    _reward_hints   = 1; // 奖励提示列表
}

message plain_shop_record {
    optional uint32              _point = 1; // 商店点数
    repeated plain_goods_record  _goods_list = 2; //商品
}

message plain_goods_record {
    optional  uint32   _group = 1; // 组别
    optional  uint32   _group_index = 2; // 组别下标
    optional  goods.price_type   _price_type   = 4; // 价格类型
    optional  uint32             _price_value  = 5; // 商品价格
    repeated  reward             _rewards      = 6; // 奖励
    optional  uint32   _discount = 7; // 折扣
    optional  uint32   _buy_times = 8; // 购买次数
    optional  uint32   _max_buy_times = 9; // 最大购买次数
    optional  uint32   _dead_line     = 10; // 购买期限
    optional  uint32   _order         = 11; // 顺序
}


//=========================================================
// 收藏排行榜 collection_point_reply
//=========================================================
message collection_point_reply {
    optional collection_point_role_reply       _role_info = 1; // 目标角色信息
    optional collection_point_set_show_reply   _set_show  = 2; // 设置展示英雄
}

message collection_point_role_reply {
    optional uint32  _avatar_num = 1;          // 拥有头像数量
    optional uint32  _frame_num = 2;           // 拥有头像框数量
    optional uint32  _fashion_num = 3;         // 拥有皮肤数量
    optional uint32  _sticker_num= 4;          // 拥有表情包数量
    optional uint32  _background_num = 5;      // 拥有竞技场背景数量
    optional user_summary    _user_summary = 6; // 玩家信息
}

message collection_point_set_show_reply {
    optional uint32 _hero_id = 1; // 英雄ID
}



//=========================================================
// 导流功能 player_shift_reply
//=========================================================


// 导流功能回复
message player_shift_reply {
    optional player_shift_open_panel_reply    _open_panel_reply    = 1; // 打开面板
    optional player_shift_server_list_reply   _server_list_reply   = 2; // 查看服务器列表
    optional player_shift_select_server_reply _select_server_reply = 3; // 选择服务器
    optional player_shift_send_code_reply     _send_code_reply     = 4; // 发送验证码
    optional player_shift_auth_code_reply     _auth_code_reply     = 5; // 验证验证码
    optional player_shift_gain_reward_reply   _gain_reward_reply   = 6; // 领取奖励

}

// 导流打开面板
message player_shift_open_panel_reply {
    optional server_info    _selected_server    = 1; // 当前选择的服务器
    optional string         _selected_zone      = 2; // 服务器大区
    optional uint32         _target_user_id     = 3; // 目标玩家ID
    optional bool           _reward_flag        = 4; // 奖励标识
    optional uint32         _next_code_time     = 5; // 下次可发送验证码时间
    optional string         _nickname           = 6; // 已领取目标昵称
    optional uint32         _level              = 7; // 已领取目标等级

}


// 导流服务器列表
message player_shift_server_list_reply {
    repeated server_info    _server_list = 1; // 服务器列表
}

// 导流选择服务器
message player_shift_select_server_reply {
    optional server_info    _server_info  = 1; // 服务器ID
}

// 导流发送验证码
message player_shift_send_code_reply {
    optional result     _result = 1; // 结果
}

// 导流验证验证码
message player_shift_auth_code_reply {
    optional result         _result         = 1; // 结果
    optional string         _server_zone    = 2; // 服务器大区
    optional server_info    _server_info    = 3; // 服务器信息
    optional uint32         _user_id        = 4; // 玩家ID
    optional string         _nickname       = 5; // 昵称
    optional uint32         _level          = 6; // 等级
    optional string         _self_app_uid   = 7; // 自身app_uid
    optional string         _self_role_id   = 8; // 自身角色ID
}

// 导流领取奖励
message player_shift_gain_reward_reply {
    optional result     _result     = 1; // 结果
    repeated reward     _rewards    = 2; // 奖励
}

//=========================================================
// 划龙舟 dragon_boat_reply
//=========================================================
message dragon_boat_reply {
    optional dragon_boat_open_panel_reply             _open_panel       = 1;     // 打开面板
    optional dragon_boat_start_reply                  _start            = 2;     // 开始划龙舟
    optional dragon_boat_buy_skin_reply               _buy_skin         = 3;     // 购买皮肤
    optional dragon_boat_use_reply                    _use              = 4;     // 使用道具加速
    optional dragon_boat_race_reply                   _race             = 5;     // 定时同步玩家比赛信息
    optional dragon_boat_period_reward_reply          _period_reward    = 6;     // 领取阶段奖励
    optional dragon_boat_give_reply                   _give             = 7;     // 赠送
    optional dragon_boat_give_record_reply            _give_record      = 8;     // 赠送记录
    optional dragon_boat_give_record_rank_reply       _give_record_rank = 9;     // 获赠排行榜
    optional dragon_boat_query_rankboard_reply        _query_rankboard  = 10;    // 全服排行榜
    optional dragon_boat_give_status_reply            _give_status      = 11;    // 是否可以赠送道具
    optional dragon_boat_skin_add_feet_reply          _add_feet         = 12;    // 获取升级皮肤后可多划行的距离
}

message dragon_boat_open_panel_reply  {
    optional bool                       _start          = 1;  // 是否开始划龙舟
    optional uint32                     _skin           = 2;  // 皮肤ID
    repeated uint32                     _period_rewards = 3;  // 阶段性奖励已领取列表
    optional dragon_boat_race           _race           = 4;  // 当下比赛信息
    repeated ranklist_item              _rank_list      = 5;  // 排行榜前3名玩家
    optional uint32                     _cur_season     = 6;  // 当前赛季
}

message dragon_boat_race {
    optional dragon_boat_self_race_info      _self     = 1;  // 玩家自己信息
    optional dragon_boat_race_info           _front    = 2;  // 玩家前一名信息
    optional dragon_boat_race_info           _behind   = 3;  // 玩家后一名信息
}

message dragon_boat_self_race_info {
    optional user_summary                _user_summary   = 1;  // 玩家信息
    optional uint32                      _feet           = 2;  // 已划过的尺寸
    optional uint32                      _skin           = 3;  // 皮肤
    repeated dragon_boat_give_user_info  _give_user      = 4;  // 被赠送列表
    optional uint32                      _give_num       = 5;  // 被赠送总数量
    optional uint32                      _forward_feet   = 6;  // 前进的尺寸
    optional uint32                      _rank           = 7;  // 排名
}

message dragon_boat_give_user_info {
    optional string   _name = 1;      // 玩家名
    optional uint32   _give_num = 2;  // 赠送道具数量
}

message dragon_boat_race_info {
    optional user_summary  _user_summary     = 1;       // 玩家信息
    optional uint32        _feet             = 2;       // 已划过的尺寸
    optional uint32        _skin             = 3;       // 皮肤
    optional double        _use_time         = 4;       // 最近一次使用道具时间 毫秒时间戳
}


message dragon_boat_start_reply  {
    optional dragon_boat_race     _race   = 1;  // 当下比赛信息
}

message dragon_boat_buy_skin_reply  {
    optional uint32    _skin       = 1;  // 皮肤ID
    repeated reward    _rewards    = 2;  // 奖励
}

message dragon_boat_use_reply  {
    optional dragon_boat_race_info      _front      = 1;  // 旧场景玩家前一名新信息
    optional dragon_boat_race_info      _behind     = 2;  // 旧场景玩家后一名新信息
    optional dragon_boat_race           _new_race   = 3;  // 新比赛信息
}

message dragon_boat_race_reply  {
    optional dragon_boat_race_info      _front      = 1;  // 旧场景玩家前一名新信息
    optional dragon_boat_race_info      _behind     = 2;  // 旧场景玩家后一名新信息
    optional dragon_boat_race           _new_race   = 3;  // 新比赛信息
}

message dragon_boat_period_reward_reply  {
    repeated uint32     _period_awards = 1;  // 阶段性奖励已领取列表
    repeated reward     _rewards       = 2;  // 奖励
}

message dragon_boat_give_reply  {
    optional  result    _result = 1; // 结果
}

message dragon_boat_give_record_reply  {
    repeated dragon_boat_give_record  _records = 1; // 记录列表
}

message dragon_boat_give_record {
    optional user_summary  _user     = 1;   // 玩家信息
    optional string        _svr_name = 2;   // 服务器名称
    optional bool          _is_give  = 3;   // true为赠送，false为获赠
    optional uint32        _num      = 4;   // 数量
    optional uint32        _time     = 5;   // 时间
}

message dragon_boat_give_record_rank_reply {
    repeated ranklist_item  _rank_list = 1; // 排行榜
}

message dragon_boat_query_rankboard_reply {
    repeated ranklist_item  _rank_list = 1; // 排行榜
    optional ranklist_item  _self_rank = 2; // 自身排行榜
    optional uint32         _self_pos  = 3; // 自身排名
}

message dragon_boat_give_status_reply {
    optional dragon_boat_give_status      _give_status   = 1; // 赠送状态
}

enum dragon_boat_give_status {
    dragon_boat_can_give = 0;   // 可以赠送
    dragon_boat_not_open = 1;    // 不可以赠送，未在活动时间内
    dragon_boat_not_start = 2;   // 不可以赠送，自己未参加活动
    dragon_boat_level_not_enough = 3;  // 不可以赠送，小队等级不足
    dragon_boat_give_num_not_enough = 4;  // 不可以赠送，赠送自己的数量不足
    dragon_boat_item_not_enough = 5;  // 不可以赠送，道具不足
    dragon_boat_oppo_not_start = 6;   // 不可以赠送，对方未参加活动
    dragon_boat_oppo_server_down = 7;   // 不可以赠送，对方服务器宕机
}

message dragon_boat_notify {
    optional bool      _start            = 1;  // 是否开始划龙舟
    optional uint32    _give_num         = 2;  // 划龙舟已赠送给自己数量
    optional bool      _is_reward        = 3;  // 是否可领取阶段奖励
}

message dragon_boat_skin_add_feet_reply {
    optional uint32    _add_feet = 1;  // 可多划行的距离
}


//=========================================================
// 多队梦境 crevice_defend
//=========================================================
message crevice_defend_reply {
    optional crevice_defend_open_panel_reply             _open_panel            = 1;     // 打开面板
    optional crevice_defend_challenge_reply              _challenge             = 2;     // 挑战
    optional crevice_defend_zone_rankboard_reply         _zone_rankboard        = 3;     // 赛区排行榜
    optional crevice_defend_open_recommend_reply         _open_recommend        = 4;     // 打开推荐界面
    optional crevice_defend_recommend_lineup_reply       _recommend_lineup      = 5;     // 推荐阵容
    optional crevice_defend_query_summary_reply          _query_summary         = 6;     // 查询战斗简报
    optional crevice_defend_query_records_reply          _query_records         = 7;     // 查询录像
    optional crevice_defend_buy_challenge_count_reply    _buy_challenge_count   = 8;     // 购买挑战次数
    optional crevice_defend_task_reward_reply            _task_reward           = 9;     // 领取任务奖励
    optional crevice_defend_challenge_record_reply       _challenge_record      = 10;    // 查询挑战记录
}

message crevice_defend_open_panel_reply {
    optional uint32            _season                 = 1;  // 当前赛季id
    optional uint32            _zone                   = 2;  // 当前赛区id
    optional uint32            _day_left_count         = 3;  // 今日剩余挑战次数
    optional uint32            _day_buy_count          = 4;  // 今日已购买次数
    optional uint32            _total_challenge_count  = 5;  // 总共累计挑战次数
    optional uint32            _end_time               = 7;  // 当前赛季结束时间
    repeated double            _boss_damage            = 8;  // 每个boss伤害
    optional uint32            _rank                   = 9;  // 玩家排名
    optional uint32            _target_rank            = 10; // 目标排名
    optional double            _target_damage          = 11; // 目标伤害
    repeated uint32            _reward_task            = 12; // 已领取奖励的任务列表
}

message crevice_defend_challenge_reply {
    optional crevice_defend_battle_replay       _battle_replay      = 1; // 对战信息
    repeated query_summary                      _battle_summary     = 2; // 战斗简介
    optional uint32                             _new_rank           = 3; // 新的排名
    optional uint32                             _last_rank          = 4; // 上次排名
    optional double                             _new_damage         = 5; // 新的累计伤害
    optional double                             _last_damage        = 6; // 上次累计伤害
    optional double                             _target_damage      = 7; // 目标伤害
    optional uint32                             _target_rank        = 8; // 目标排名
    repeated double                             _best_lineup_damage = 9; // 最佳阵容伤害
}

message crevice_defend_battle_replay {
    repeated crevice_defend_round_battle_record _records = 1; // 每回合战斗记录
}

message crevice_defend_zone_rankboard_reply {
    optional uint32                    _zone_id        = 1; // 赛区id
    repeated crevice_defend_zone_rankitem  _rank_list      = 2; // 排行榜
    optional crevice_defend_zone_rankitem  _self_rank      = 3; // 自身排名
}
message crevice_defend_query_summary_reply {
    optional query_summary      _summary = 1; // 战斗简报
}

message crevice_defend_query_records_reply {
    repeated crevice_defend_round_battle_record      _records = 1; // 每回合战斗记录
}

message crevice_defend_round_battle_record {
    optional uint32             _checkid        = 1;   // 战斗校验ID
    optional uint32             _rseed          = 2;   // 战斗种子
    optional string             _self_role_id   = 3;   // 自己的role id
    optional user_summary       _self_user      = 4;   // 自己信息
    optional arena_team         _self_heroes    = 5;   // 自己英雄
    optional battle_bonus       _self_bonus     = 6;   // 己方战斗加成
    optional uint32             _round          = 7;   // 第几场
    optional uint32             _stage_id       = 8;   // 关卡ID
    optional battle_result      _result         = 9;   // 胜负结果
    optional double             _damage         = 10;  // 伤害
}

message crevice_defend_buy_challenge_count_reply {
    optional result  _result                  = 1 [default = success]; // 结果
    optional uint32  _day_left_count          = 2;                     // 今日剩余挑战次数
    optional uint32  _day_buy_count           = 3;                     // 今日已购买次数
}

message crevice_defend_zone_rankitem {
    optional uint32                             _rank           = 1; // 排名
    optional crevice_defend_user_dgame_info         _user_info      = 2; // 玩家信息
    optional string                             _server_name    = 3; // 显示的服务器名称
}

message crevice_defend_open_recommend_reply {
    repeated crevice_defend_user_dgame_info    _user_info      = 1;      // 玩家信息
}

message crevice_defend_recommend_lineup_reply {
    optional crevice_defend_recommoned_lineup _lineup          = 1;      // 推荐阵容
}

message crevice_defend_recommoned_lineup {
    repeated crevice_defend_lineup    _user_info               = 1;      // 队伍信息
}

message crevice_defend_lineup {
    repeated hero_summary      _heroes      = 1; // 英雄
    optional double            _damage      = 2; // 伤害
}

message crevice_defend_task_reward_reply {
    repeated uint32     _reward_task   = 1;  // 已领取奖励的任务列表
    repeated reward     _rewards       = 2;  // 奖励列表
}

message crevice_defend_challenge_record_reply {
    repeated simple_pve_record    _record = 1;          // 挑战记录
}

message crevice_defend_user_dgame_info {
    optional user_summary   _user_summary   = 1; // 玩家信息
    optional uint32         _damage         = 2; // 伤害
}

message crevice_defend_notify {
    optional bool           _is_open           = 1; // 是否开放
    optional bool           _refresh_battle    = 2; // 刷新战斗
    optional bool           _task_rewards      = 3; // 任务红点
}

//=========================================================
// 英雄砍一刀 hero_haggle_reply
//=========================================================
message hero_haggle_reply {
    optional hero_haggle_open_panel_reply             _open_panel = 1;     // 打开面板
    optional hero_haggle_select_hero_reply            _select_hero = 2;    // 选择英雄
    optional hero_haggle_price_reply                  _haggle_price = 3;   // 砍一刀
    optional hero_haggle_buy_hero_reply               _buy_hero = 4;       // 购买英雄
}

message hero_haggle_open_panel_reply  {
    optional uint32      _season_id = 1;  // 赛季ID
    optional uint32      _select_hero = 2;  // 选择的英雄ID
    optional uint32      _haggle_num = 3;  // 砍一刀次数
    optional uint32      _buy_hero = 4;    // 购买的英雄ID
}

message hero_haggle_select_hero_reply  {
    optional result            _result = 1;
}

message hero_haggle_price_reply  {
    optional uint32    haggle_num = 1;  // 砍一刀次数
}

message hero_haggle_buy_hero_reply  {
    repeated  reward           _rewards = 1; // 奖励
    optional  hero             _hero = 2; // 英雄结构
}

message hero_haggle_notify {
    optional bool      _open = 1;        // 活动是否开启
    optional bool      _can_haggle = 2;  // 是否可砍一刀
    optional bool      _is_select = 3;   // 是否已选择英雄
}

message feature_preview_notify {
    optional bool      _is_open = 1; // 是否开启预览
    optional bool      _rewards = 2; // 是否有奖励
}

//=========================================================
// + 选技
//=========================================================

// 选技
message solo_reply {
    optional solo_open_panel_reply       _open_panel     = 1; // 打开面板
    optional solo_match_start_reply      _match_start    = 2; // 开始匹配
    optional solo_match_cancel_reply     _match_cancel   = 3; // 取消匹配
    optional solo_resolve_rookie_reply   _resolve_rookie = 4; // 跳过引导
    optional solo_rookie_start_reply     _rookie_start   = 5; // 开始新手引导
    optional solo_rookie_finish_reply    _rookie_finish  = 6; // 完成新手引导
    optional solo_query_records_reply    _query_records  = 7; // 查询记录
    optional solo_record_detail_reply    _record_detail  = 8; // 查看记录详情
    optional solo_grade_rewards_reply    _grade_rewards  = 9; // 领取段位奖励

    optional string                       _error_code     = 21; // 错误码
}

// 选技游戏状态
enum solo_game_status {
    free            = 0; // 空闲
    matching        = 1; // 匹配中
    gaming          = 2; // 游戏中
    game_over       = 3; // 游戏结束
}


// 打开面板
message solo_open_panel_reply {
    optional bool                       _is_rookie              = 1; // 是否是新手
    optional uint32                     _score                  = 2; // 积分
    optional solo_game_status           _game_status            = 3; // 游戏状态
    optional uint32                     _cur_game_id            = 4; // 当前游戏ID，不为0表示正在游戏中
    optional string                     _cur_game_addr          = 5; // 当前游戏地址，svrid#ip:port
    optional solo_game_type             _cur_game_type          = 6; // 当前游戏类型，游戏中或匹配中的
    optional solo_game_over_notify      _game_over_notify       = 7; // 游戏结束通知
    optional uint32                     _match_start_time       = 8; // 匹配开始时间
    repeated solo_game_type             _open_types             = 9; // 已开放的模式
    repeated uint32                     _grade_reward_flags     = 10; // 段位奖励领取标志
    optional uint32                     _last_hero_id           = 11; // 上次选择的英雄ID
}

// 开始匹配
message solo_match_start_reply {
    optional uint32     _expect_wait_time   = 1; // 预计等待时间（秒）
}

// 取消匹配
message solo_match_cancel_reply {

}

// 跳过引导
message solo_resolve_rookie_reply {
    optional result     _result     = 1;
}

// 开始新手引导
message solo_rookie_start_reply {
    optional solo_game_summary     _summary    = 1; // 摘要信息
}

// 完成新手引导
message solo_rookie_finish_reply {
    optional solo_game_start_notify    _notify  = 1; // 游戏开始通知
}

// 查询记录
message solo_query_records_reply {
    repeated solo_game_record    _records  = 1; // 游戏记录
}

// 选技记录
message solo_game_record {
    optional uint32                     _record_id          = 1; // 记录ID
    optional solo_game_type             _game_type          = 2; // 游戏类型
    optional uint32                     _game_id            = 3; // 游戏ID
    optional solo_game_user_settle      _settle             = 4; // 玩家结算
    optional bool                       _is_win             = 5; // 是否胜利
    optional uint32                     _old_score          = 6; // 原来的分数
    optional uint32                     _new_score          = 7; // 新的分数
    optional string                     _detail_key         = 8; // 详情键
    optional uint32                     _record_time        = 9; // 记录时间
}

// 查看记录详情
message solo_record_detail_reply {
    optional solo_dashboard _dashboard = 1; // 数据面板
}

// 领取段位奖励
message solo_grade_rewards_reply {
    repeated reward     _rewards    = 1; // 奖励列表
    optional uint32     _grade      = 2; // 段位
}


// 选技游戏中请求(长连接)
message solo_game_reply {
    optional solo_join_reply                _join               = 1;  // 加入游戏
    optional solo_loading_reply             _loading            = 2;  // 加载同步
    optional solo_choose_hero_reply         _choose_hero        = 3;  // 选择英雄
    optional solo_choose_power_reply        _choose_power       = 4;  // 选择能力
    optional solo_use_power_reply           _use_power          = 5;  // 使用能力
    optional solo_buy_card_reply            _buy_card           = 6;  // 购买卡片
    optional solo_shop_refresh_reply        _shop_refresh       = 7;  // 商店刷新
    optional solo_quit_reply                _quit               = 8;  // 退出游戏
    optional solo_battle_confirm_reply      _battle_confirm     = 9;  // 战斗确认
    optional solo_heartbeat_reply           _heartbeat          = 10; // 心跳
    optional solo_refresh_choices_reply     _refresh_choices    = 11; // 刷新选项
    optional solo_monitor_player_reply      _monitor_player     = 12; // 查看监控玩家信息
    optional solo_spectate_enter_reply      _spectate_enter     = 13; // 进入观战模式
    optional solo_emoji_reply               _emoji              = 14; // 表情返回
    optional solo_view_journal_reply        _view_journal       = 15; // 查看对战日志
    optional solo_view_dashboard_reply      _view_dashboard     = 16; // 查看数据面板

    optional string                       _error_code     = 51; // 错误码
}

// 选技摘要信息
message solo_game_summary {
    optional uint32                 _id         = 1; // 游戏ID
    optional solo_game_type         _game_type  = 2; // 游戏类型
    optional uint32                 _server_id  = 3; // 游戏所在svrID
    repeated solo_user_summary      _users      = 4; // 玩家信息
    optional solo_game_rules        _rules      = 5; // 规则
}

// 选技规则
message solo_game_rules {
    optional uint32     _max_hp                 = 1; // 最大血量
    repeated uint32     _active_factions        = 2; // 激活的卡片流派列表
    repeated uint32     _frozen_factions        = 3; // 冻结的卡片流派列表
}

// 加入游戏
message solo_join_reply {
    optional solo_game_summary     _summary    = 1; // 摘要信息
}

// 加载
message solo_loading_reply {

}


// 选择英雄
message solo_choose_hero_reply {
    optional uint32             _choose_id      = 1; // 选择ID
    optional uint32             _option_index   = 2; // 选项索引
    optional bool               _is_confirmed   = 3; // 是否确认选取
    optional bool               _is_auto        = 4; // 是否自动选取
}


// 选择能力
message solo_choose_power_reply {
    optional uint32             _power_pos      = 1; // 第几个能力
    optional uint32             _option_index   = 2; // 选项索引
    optional bool               _is_confirmed   = 3; // 是否确认选取
    optional bool               _is_auto        = 4; // 是否自动选取
    optional solo_power         _power          = 5; // 能力
}

// 使用能力
message solo_use_power_reply {
    optional result    _result = 1; // 结果
}

// 购买卡片
message solo_buy_card_reply {
    optional solo_card          _card               = 1; // 购买之后的卡片同步
    optional uint32             _gold               = 2; // 剩余金币同步
    repeated solo_faction       _factions           = 3; // 流派同步
    optional uint32             _level              = 4; // 玩家等级同步
}

// 刷新商店
message solo_shop_refresh_reply {
    optional solo_user_shop     _shop   = 1; // 商店信息
    optional uint32             _gold   = 2; // 剩余金币同步
}

// 退出游戏
message solo_quit_reply {
    optional result     _result  = 1;
}

// 战斗确认
message solo_battle_confirm_reply {
    enum confirm_result {
        ok          = 0; // 确认结果OK
        conflict    = 1; // 战斗结果冲突
    }
    optional confirm_result     _confirm_result = 1; // 确认结果
    optional battle_result      _battle_result  = 2; // 战斗结果
    optional uint32             _hp             = 3; // hp
    optional uint32             _gain_gold      = 4; // 战斗获得的金币
}

// 心跳
message solo_heartbeat_reply {

}


// 刷新选项
message solo_refresh_choices_reply {
    optional solo_game_action  _action        = 1; // 新的动作
}

// 查看监控玩家信息
message solo_monitor_player_reply {
    optional solo_user_summary      _user_summary       = 1; // 玩家信息
    optional solo_battle_team       _team               = 2; // 战斗信息
    repeated solo_power             _powers             = 3; // 能力列表
}

// 进入观战模式
message solo_spectate_enter_reply {
    optional solo_user_summary      _user_summary       = 1; // 玩家信息
    optional solo_battle_team       _team               = 2; // 战斗信息
    repeated solo_power             _powers             = 3; // 能力列表
}


// 发送表情
message solo_emoji_reply {
    optional result    _result = 1; // 结果
}


// 选技游戏效果
message solo_game_effect {
    optional solo_effect_modify_hp             _mod_hp              = 1;  // 修改血量
    optional solo_effect_gain_hero             _gain_hero           = 2;  // 获得英雄
    optional solo_effect_gain_gold             _gain_gold           = 3;  // 获得金币
    optional solo_effect_user_shop             _user_shop           = 4;  // 商店同步
    optional solo_effect_gain_cards            _gain_cards          = 5;  // 获得卡片
    optional solo_effect_gain_faction_exp      _gain_faction_exp    = 7;  // 选择英雄
    optional solo_effect_cost_gold             _cost_gold           = 8;  // 消耗金币
    optional solo_effect_new_power             _new_power           = 9;  // 新的能力
    optional solo_effect_user_damage           _user_damage         = 10; // 玩家伤害同步

    optional solo_power                        _power               = 51; // 哪个能力触发的
}

// 选技游戏效果，修改血量
message solo_effect_modify_hp {
    optional uint32             _max_hp         = 1; // 最大HP
    optional sint32             _mod_hp         = 2; // 当前HP变化量
}

// 选技游戏效果，获得英雄
message solo_effect_gain_hero {
    optional solo_hero         _heroes         = 1; // 获得英雄
}

// 选技游戏效果，获得金币
message solo_effect_gain_gold {
    optional uint32     _gold   = 1; // 获得金币
}

// 选技游戏效果，选择英雄
message solo_effect_choose_heroes {
    optional uint32     _gold   = 1; // 获得金币
}

// 选技效果，商店
message solo_effect_user_shop {
    optional solo_user_shop    _shop   = 1; // 同步商店
}

// 选技游戏效果，获得卡片
message solo_effect_gain_cards {
    repeated solo_card          _cards          = 1; // 获得卡片列表
    repeated solo_faction       _factions       = 2; // 流派经验同步
    optional uint32             _level          = 3; // 英雄等级同步
}

// 选技游戏效果，获得卡片流派经验
message solo_effect_gain_faction_exp {
    optional uint32             _faction        = 1; // 流派ID
    optional uint32             _exp            = 2; // 流派经验
    repeated solo_faction       _factions       = 3; // 流派经验同步
    optional uint32             _level          = 4; // 英雄等级同步
}


// 选技游戏效果，消耗金币
message solo_effect_cost_gold {
    optional uint32     _gold   = 1; // 消耗金币
}

// 选技游戏效果，新的能力
message solo_effect_new_power {
    optional solo_power _power = 1; // 新的能力
}

// 选技游戏效果，玩家伤害同步
message solo_effect_user_damage {
    optional uint32             _damage     = 1; // 伤害
}

// 选技游戏中的通知
message solo_game_notify {
    optional solo_match_timeout_notify  _match_timeout  = 1;  // 匹配超时
    optional solo_game_start_notify     _game_start     = 2;  // 游戏开始
    optional solo_join_timeout_notify   _join_timeout   = 3;  // 加入超时
    optional solo_loading_sync_notify   _loading_sync   = 4;  // 加载同步
    optional solo_wait_choose_notify    _wait_choose    = 5;  // 等待选择通知
    optional solo_round_sync_notify     _round_sync     = 6;  // 回合同步
    optional solo_game_rank_notify      _game_rank      = 7;  // 游戏排名通知
    optional solo_game_over_notify      _game_over      = 8;  // 游戏结束通知
    optional solo_user_status_notify    _user_status    = 9;  // 玩家状态同步
    optional solo_level_up_notify       _level_up       = 10; // 玩家升级
    optional solo_game_event_notify     _event          = 11; // 事件通知
    optional solo_game_action_notify    _action         = 12; // 动作通知
    optional solo_game_effect_notify    _effect         = 13; // 效果通知
}

// 匹配超时
message solo_match_timeout_notify {

}

// 游戏开始通知
message solo_game_start_notify {
    optional uint32     _game_id    = 1; // 游戏ID
    optional string     _game_addr  = 2; // 游戏地址，ip:port
}

// 游戏加入超时
message solo_join_timeout_notify {

}

// 加载同步通知
message solo_loading_user {
    optional solo_user_key     _user_key   = 1; // 玩家key
    optional uint32             _progress   = 2; // 进度
    optional bool               _is_finish  = 3; // 是否完成
}

// 加载同步通知
message solo_loading_sync_notify {
    repeated solo_loading_user     _users = 1; // 玩家
}

// 合成英雄通知
message solo_compose_hero_notify {
    optional solo_user_key     _user_key   = 1; // 玩家key
    optional uint32             _hid        = 2; // 英雄ID
}

// 玩家升级同步
message solo_level_up_notify {
    optional solo_user_key      _user_key   = 1; // 玩家key
    optional uint32             _level      = 2; // 等级
}


// 回合前等待选择通知
message solo_wait_choose_notify {
    optional uint32             _end_time           = 1; // 结束时间戳
    repeated uint32             _rest_choose_rounds = 2; // 剩余选择回合列表
}

// 回合同步通知
message solo_round_sync_notify {
    optional uint32                _round_num       = 1; // 当前回合数
    optional solo_round_start      _round_start     = 2; // 回合开始
    optional solo_round_wait       _round_wait      = 3; // 回合等待
    optional solo_round_prepare    _round_prepare   = 4; // 回合准备
    optional solo_round_lock       _round_lock      = 5; // 回合锁定
    optional solo_round_battle     _round_battle    = 6; // 回合战斗
    optional solo_round_over       _round_over      = 7; // 回合结束
}

// 玩家状态
enum solo_user_status {
    online  = 0; // 在线
    offline = 1; // 离线
    quit    = 2; // 退出
}

// 玩家状态同步通知
message solo_user_status_notify {
    optional solo_user_key     _user_key   = 1; // 玩家key
    optional solo_user_status  _status     = 2; // 玩家状态
}

// 商品卡片
message solo_goods_card {
    optional uint32     _index      = 1; // 卡片索引
    optional uint32     _cid        = 2; // 卡片ID
    optional uint32     _price      = 3; // 出售价格
}

// 英雄商店
message solo_user_shop {
    repeated solo_goods_card    _cards              = 1; // 所有卡片
    optional uint32             _refresh_cost       = 2; // 刷新消耗
    optional uint32             _random_cost        = 3; // 随机购买消耗
}

// 对手信息同步
message solo_oppo_user {
    optional solo_user_key      _user_key       = 1; // 玩家key
    optional solo_user_status   _status         = 2; // 玩家状态
    optional uint32             _hero_id        = 3; // 最大血量
    optional uint32             _max_hp         = 4; // 最大血量
    optional uint32             _hp             = 5; // 当前血量
    optional uint32             _level          = 7; // 等级
    optional uint32             _damage         = 8; // 可以造成的伤害
    optional uint32             _battle_group   = 9; // 战斗分组
}

// 玩家详情信息
message solo_user_detail {
    optional solo_user_key      _user_key           = 1;  // 玩家key
    optional bool               _is_dead            = 2;  // 是否已死亡
    optional uint32             _max_hp             = 3;  // 最大血量
    optional uint32             _hp                 = 4;  // 当前血量
    optional uint32             _gold               = 5;  // 金币
    optional uint32             _level              = 6;  // 等级
    optional uint32             _damage             = 7;  // 可以造成的伤害
    optional solo_battle_team   _team               = 8;  // 战斗信息
    repeated solo_power         _powers             = 9;  // 能力列表
    optional sint32             _combo              = 10; // >0 = 连胜, <0 = 连败
}

// 回合收入结算
message solo_round_income {
    optional uint32             _gold_base      = 1; // 获得的基本工资（显示用）
    optional uint32             _gold_inst      = 2; // 获得的利息（显示用）
    optional uint32             _gold_victory   = 3; // 获得的胜利奖励（显示用）
    optional uint32             _gold_combo_v   = 4; // 获得的连胜奖励（显示用）
    optional uint32             _gold_defeat    = 5; // 获得的连败奖励（显示用）
}

// 回合开始
message solo_round_start {
    optional solo_user_detail   _self_detail    = 1; // 自己的详细信息
    optional solo_round_income  _income         = 2; // 收入
    repeated solo_oppo_user     _oppos          = 3; // 对手信息同步
}

// 回合等待阶段
message solo_round_wait {
    optional uint32             _end_time           = 1; // 结束时间戳
    repeated uint32             _rest_choose_rounds = 2; // 剩余选择回合列表
}

// 锁定阶段
message solo_round_lock {

}

// 准备阶段
message solo_round_prepare {
    optional solo_oppo_type             _oppo_type  = 1; // 对手类型
    optional solo_user_shop             _user_shop  = 2; // 商店信息
    optional uint32                     _end_time   = 3; // 结束时间戳
}

// 战斗阶段
message solo_round_battle {
    repeated solo_battle_record     _records        = 1; // 战斗录像
    repeated solo_battle_event      _events         = 2; // 事件数组
    optional uint32                 _end_time       = 3; // 结束时间戳
    repeated solo_oppo_user         _oppos          = 5; // 对手信息同步
    optional uint32                 _group          = 6; // 战斗分组
}

// 回合结束
message solo_round_over {
    optional uint32                     _max_hp         = 1; // 最大血量同步
    optional uint32                     _hp             = 2; // 血量同步
    optional uint32                     _gold           = 3; // 金币同步
    optional uint32                     _end_time       = 4; // 结束时间戳
}

// 战斗记录
message solo_battle_record {
    optional uint32             _checkid        = 1;  // 战斗校验ID
    optional uint32             _gameid         = 2;  // 游戏ID
    optional uint32             _round          = 3;  // 第几回合
    optional solo_battle        _battle         = 4;  // 战斗信息
    optional battle_result      _result         = 5;  // 胜负结果
    optional uint32             _time           = 6;  // 战斗时长(毫秒)
}

// 选技游戏内战斗事件
message solo_battle_event {
    optional uint32                     _time   = 1; // 事件发生时间(毫秒)
    optional solo_event_battle_start    _start  = 2; // 战斗开始事件
    optional solo_event_battle_over     _over   = 3; // 战斗结束事件
    optional solo_event_combo_victory   _combo  = 4; // 连胜事件
    optional solo_event_block_victory   _block  = 5; // 终结连胜
}

/// 选技游戏动作事件
message solo_action_event {
    optional solo_event_choose_power    _choose_power   = 1; // 选择能力
    optional solo_event_emoji           _emoji          = 2; // 发表情
    optional solo_event_choose_hero     _choose_hero    = 3; // 选择棋子英雄
}

// 选技游戏效果事件
message solo_effect_event {
    optional solo_user_key         _user_key   = 1; // 玩家Key
    repeated solo_game_effect      _effects    = 2; // 效果列表
}

// 战斗开始事件
message solo_event_battle_start {
    optional solo_user_key     _user_key   = 1; // 玩家Key
    optional solo_battle_team  _team       = 2; // 队伍
    optional uint32             _hp         = 3; // 战斗开始时血量
    optional uint32             _level      = 4; // 等级
}

message solo_event_emoji {
    optional solo_user_key     _user_key   = 1; // 玩家Key
    optional string             _content    = 2; // 队伍
}

// 选择棋子英雄事件
message solo_event_choose_hero {
    optional solo_user_key      _user_key   = 1; // 玩家Key
    optional uint32             _hero_id    = 2; // 英雄实例ID
}

// 战斗结束事件
message solo_event_battle_over {
    optional solo_user_key      _user_key       = 1; // 玩家Key
    optional solo_oppo_type     _oppo_type      = 2; // 对手类型
    optional solo_user_key      _oppo_key       = 3; // 战斗对手Key,对手类型=player时有值
    optional battle_result      _battle_result  = 4; // 战斗结果
    optional uint32             _hp             = 5; // 战斗结束时血量
}

// 连胜事件
message solo_event_combo_victory {
    optional solo_user_key     _user_key       = 1; // 玩家Key
    optional uint32             _combo          = 2; // 连胜次数
}

// 连胜终结事件
message solo_event_block_victory {
    optional solo_user_key      _user_key       = 1; // 被终结的玩家Key
    optional solo_user_key      _oppo_key       = 2; // 终结者玩家Key
    optional uint32             _combo          = 3; // 被终结的连胜次数
}

// 选择能力事件
message solo_event_choose_power {
    optional solo_user_key      _user_key       = 1; // 选择的玩家Key
    optional solo_power         _power          = 2; // 能力
}

// 游戏事件通知
message solo_game_event_notify {
    repeated solo_battle_event   _events      = 1; // 战斗事件数组
    repeated solo_action_event   _actions     = 2; // 动作事件数组
    repeated solo_effect_event   _effects     = 3; // 效果事件数值
}

// 游戏结束结算时信息
message solo_game_user_settle {
    optional solo_user_summary      _user_summary       = 1; // 玩家信息
    optional uint32                 _rank               = 2; // 排名
    repeated solo_faction           _factions           = 3; // 流派列表
    repeated solo_power             _powers             = 4; // 能力列表

    optional empty_data             _extra              = 11; // 额外数据
}


// 游戏获得名次通知
message solo_game_rank_notify {
    optional uint32     _rank   = 1; // 获得名次
}

// 游戏结束通知
message solo_game_over_notify {
    optional solo_game_user_settle      _settle             = 1; // 玩家结算
    optional bool                       _is_win             = 2; // 是否胜利
    optional uint32                     _old_score          = 3; // 原来的分数
    optional sint32                     _base_score         = 4; // 获取的基础分数, 失去时为负
    optional sint32                     _extra_score        = 5; // 获取的额外分数, 失去时为负
    optional uint32                     _new_score          = 6; // 新的分数
}

// 游戏动作通知，需要客户端操作
message solo_game_action_notify {
    repeated solo_game_action      _actions    = 1; // 动作数组
}

// 游戏效果通知，需要客户端做表现同步
message solo_game_effect_notify {
    repeated solo_game_effect      _effects    = 1; // 效果数组
}


// 游戏动作
message solo_game_action {
    optional solo_action_choose_hero    _choose_hero    = 1; // 选择英雄
    optional solo_action_choose_power   _choose_power   = 2; // 选择能力

}

// 英雄选项
message solo_hero_option {
    optional uint32     _index              = 1; // 位置
    optional uint32     _hero_id            = 2; // 英雄ID
    optional bool       _is_time_limited    = 3; // 是否为限时英雄
}

// 选择棋子英雄
message solo_action_choose_hero {
    optional uint32                 _choose_id                  = 1; // 选择ID
    repeated solo_hero_option       _hero_options               = 2; // 英雄选项列表
    optional uint32                 _cur_free_refresh_times     = 3; // 当前免费刷新次数
    optional uint32                 _max_free_refresh_times     = 4; // 最大免费刷新次数
    optional uint32                 _cur_pay_refresh_times      = 5; // 当前付费刷新次数
    optional uint32                 _max_pay_refresh_times      = 6; // 最大付费刷新次数
    optional uint32                 _pay_coin_num               = 7; // 付费代币数量
}

// 能力选项
message solo_power_option {
    optional uint32     _index              = 1; // 位置
    optional uint32     _power_id           = 2; // 能力ID
    optional bool       _is_time_limited    = 3; // 是否为限时英雄
}

// 选择能力
message solo_action_choose_power {
    optional uint32                 _power_pos                      = 1; // 第几个能力
    repeated solo_power_option      _power_options                  = 2; // 能力选项列表
    optional uint32                 _cur_free_refresh_times         = 3; // 当前免费刷新次数
    optional uint32                 _max_free_refresh_times         = 4; // 最大免费刷新次数
    optional uint32                 _cur_pay_refresh_times          = 5; // 当前付费刷新次数
    optional uint32                 _max_pay_refresh_times          = 6; // 最大付费刷新次数
    optional uint32                 _pay_coin_num                   = 7; // 付费代币数量
}

// 选技回合对战日志
message solo_journal {
    optional uint32             _round      = 1; // 回合
    repeated solo_journal_entry _entries    = 2; // 日志列表
}

// 选技对战日志条目
message solo_journal_entry {
    optional uint32     _round      = 1; // 回合

    optional solo_journal_choose_hero       _choose_hero    = 11; // 选择英雄
    optional solo_journal_round_start       _round_start    = 12; // 回合开始
    optional solo_journal_choose_power      _choose_power   = 13; // 选择能力
    optional solo_journal_battle            _battle         = 14; // 战斗日志
    optional solo_journal_game_effect       _effect         = 15; // 游戏效果
    optional solo_journal_buy_card          _buy_card       = 16; // 购买卡片
}

// 选技对战日志选择英雄
message solo_journal_choose_hero {
    optional uint32     _hero_id    = 1; // 英雄ID
}


// 选技对战日志回合开始
message solo_journal_round_start {
    optional solo_round_income  _income     = 1; // 收入
}


// 选技对战日志选择能力
message solo_journal_choose_power {
    optional uint32     _power_pos  = 1; // 能力位置
    optional uint32     _power_id   = 2; // 能力ID
}


// 选技对战日志战斗
message solo_journal_battle {
    optional solo_oppo_type         _oppo_type        = 1;  // 战斗校验ID
    optional solo_user_summary      _oppo_user        = 2;  // 游戏玩家数据
    optional battle_result          _battle_result    = 3;  // 战斗结果
}

// 选技对战日志游戏效果
message solo_journal_game_effect {
    optional solo_game_effect     _effect = 1; // 游戏效果
}

// 选技对战日志购买卡片
message solo_journal_buy_card {
    enum buy_type {
        normal         = 1; // 普通购买
        random         = 2; // 随机购买
        power          = 3; // 使用能力购买
    }
    optional solo_card      _card       = 1; // 购买卡片
    optional buy_type       _type       = 2; // 购买方式，1=普通购买，2=随机购买，=3使用能力购买
    optional uint32         _power_id   = 3; // 使用的能力ID
    optional uint32         _cost_gold  = 4; // 消耗的金币
}

// 查看日志
message solo_view_journal_reply {
    repeated solo_journal     _journals = 1; // 日志列表
}

// 选技数据面板
message solo_dashboard {
    repeated solo_dashboard_user    _users      = 1; // 玩家列表
    optional uint32                 _round      = 2; // 回合数
    optional bool                   _is_over    = 3; // 是否游戏结束
}

// 选技数据面板玩家
message solo_dashboard_user {
    optional solo_user_summary      _summary        = 1; // 玩家key
    repeated solo_faction           _factions       = 2; // 流派列表
    repeated solo_power             _powers         = 3; // 能力列表
    optional solo_hero              _hero           = 4; // 英雄数据
}

// 查看数据面板
message solo_view_dashboard_reply {
    optional solo_dashboard     _dashboard = 1; // 数据面板
}

// 功能预告
message feature_preview_reply {
    optional feature_preview_open_panel_reply  _open_panel  = 1; // 打开面板
    optional feature_preview_reward_reply      _reward      = 2; // 领取奖励
}

// 打开功能预告面板
message feature_preview_open_panel_reply {
    repeated feature_preview_item    _items = 1; // 功能预告列表
}

// 功能预告条目
message feature_preview_item {
    optional uint32     _id         = 1; // id
    optional bool       _rewarded   = 2; // 是否已领取
}

// 领取功能预告奖励
message feature_preview_reward_reply {
    repeated uint32     _ids         = 1; // id
}


//=========================================================
// - 选技
//=========================================================